---
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseCard from '../components/CourseCard.astro';
import { COURSES } from '../data/courses';

const ASSESSMENTS = [
  {
    slug: 'phan-cung',
    name: 'Phần cứng Máy tính (OL-01)',
    icon: '🛠️',
    desc: 'Mô phỏng bàn kỹ thuật 7 bước, 50 câu trắc nghiệm tình huống, 20 câu vấn đáp & chuẩn in ấn A4',
    badge: 'Chuẩn TT55 - Mới',
    time: '15 - 180',
  },
  {
    slug: 'mang',
    name: 'Mạng Máy tính Căn bản',
    icon: '🌐',
    desc: 'Kiểm tra mô hình OSI, IP subnetting, dịch vụ mạng DHCP/DNS và định tuyến',
    badge: 'Trắc nghiệm 30 câu',
    time: '45',
  },
];
---

<BaseLayout title="Cổng Giảng Dạy & Thực Hành CNTT · CN. Phạm Tiến Đông">
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-primary-800 to-primary-900 text-white py-12 sm:py-16">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-700/60 border border-primary-500/40 text-xs font-semibold text-primary-200 mb-3">
        <span>💻</span>
        <span>Website Giảng Dạy Chuyên Ngành CNTT · CN. Phạm Tiến Đông</span>
      </span>
      <h1 class="text-3xl sm:text-5xl font-black mb-3 text-white tracking-tight">Cổng Giảng Dạy & Thực Hành CNTT</h1>
      <p class="text-primary-100 text-sm sm:text-base max-w-2xl mx-auto font-medium leading-relaxed">
        Giảng dạy chuyên ngành thực hành · Sát hạch đánh giá năng lực nghề · Quản lý hồ sơ lớp học & điểm số
      </p>

      <!-- 2 NÚT THAO TÁC 1-CHẠM NHANH CHO HỌC SINH -->
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-3xl mx-auto text-left">
        <!-- Nút 1: Vào bàn thực hành -->
        <a 
          href="/practice" 
          class="p-4 sm:p-5 rounded-2xl bg-white text-gray-900 shadow-xl hover:shadow-2xl hover:scale-[1.02] transition-all no-underline group flex items-center gap-4 border-2 border-indigo-200"
        >
          <div class="w-14 h-14 rounded-2xl bg-indigo-50 text-indigo-700 flex items-center justify-center text-3xl shrink-0 group-hover:scale-110 transition-transform">
            🛠️
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-xs font-black text-indigo-700 uppercase tracking-wide">Điểm Danh & Học Tập</span>
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            </div>
            <h3 class="text-base sm:text-lg font-black text-gray-900 group-hover:text-indigo-700 transition-colors">
              Bàn Thực Hành Kỹ Thuật
            </h3>
            <p class="text-xs text-gray-500 mt-0.5 line-clamp-2">
              Điểm danh theo buổi học, quy trình an toàn bàn máy & nộp kết quả thực hành tại xưởng.
            </p>
          </div>
        </a>

        <!-- Nút 2: Vào sát hạch đánh giá -->
        <a 
          href="/assessment/phan-cung" 
          class="p-4 sm:p-5 rounded-2xl bg-white text-gray-900 shadow-xl hover:shadow-2xl hover:scale-[1.02] transition-all no-underline group flex items-center gap-4 border-2 border-amber-200"
        >
          <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-700 flex items-center justify-center text-3xl shrink-0 group-hover:scale-110 transition-transform">
            📝
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-xs font-black text-amber-700 uppercase tracking-wide">Sát Hạch Trực Tuyến</span>
              <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-amber-100 text-amber-800">Chuẩn TT55</span>
            </div>
            <h3 class="text-base sm:text-lg font-black text-gray-900 group-hover:text-amber-700 transition-colors">
              Đánh Giá Năng Lực Nghề
            </h3>
            <p class="text-xs text-gray-500 mt-0.5 line-clamp-2">
              Bộ 100 câu trắc nghiệm tình huống, bốc thăm ca thi & có Trợ giảng AI giải thích câu sai.
            </p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Courses Grid -->
  <section class="max-w-5xl mx-auto px-4 py-10">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-900">Chương trình Môn học</h2>
        <p class="text-xs sm:text-sm text-gray-500 mt-0.5">Mỗi môn học được hỗ trợ một cổng tên miền phụ (subdomain) riêng biệt</p>
      </div>
      <a href="/courses" class="text-sm font-semibold text-primary-700 hover:underline">
        Tất cả môn →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {COURSES.map((course) => (
        <CourseCard
          title={course.name}
          slug={course.slug}
          description={course.desc}
          icon={course.icon}
          chapterCount={course.chapters.length}
          subdomain={course.subdomain}
        />
      ))}
    </div>
  </section>

  <!-- Assessment Section -->
  <section class="max-w-5xl mx-auto px-4 pb-14">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-900">Đánh giá năng lực chuyên môn</h2>
        <p class="text-xs sm:text-sm text-gray-500 mt-0.5">Kiểm tra trắc nghiệm kiến thức và chẩn đoán kỹ thuật theo chuẩn đầu ra</p>
      </div>
      <a href="/assessment" class="text-sm font-semibold text-primary-700 hover:underline">
        Xem chi tiết →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {ASSESSMENTS.map((exam) => (
        <a href={`/assessment/${exam.slug}`} class="card flex items-start gap-4 no-underline group hover:border-primary-400">
          <span class="text-3xl shrink-0 p-2.5 rounded-2xl bg-primary-50">{exam.icon}</span>
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-[11px] font-mono font-bold text-primary-800 bg-primary-50 px-2 py-0.5 rounded-full">
                {exam.badge}
              </span>
            </div>
            <h3 class="text-base font-bold text-gray-900 group-hover:text-primary-700 transition-colors mb-1">
              {exam.name}
            </h3>
            <p class="text-xs text-gray-500 mb-3 leading-relaxed">{exam.desc}</p>
            <div class="flex items-center gap-3 text-xs text-gray-500 font-medium">
              <span>⏱️ Thời gian: {exam.time} phút</span>
              <span>•</span>
              <span>🎯 Điểm đạt: ≥ 5.0</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
