---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  HARDWARE_METADATA,
  THREE_SURVIVAL_RULES,
  THREE_SAFETY_CHECKPOINTS,
} from '../../data/hardwareCurriculum';

export const prerender = false;
---

<BaseLayout title="Xưởng Thực Hành Kỹ Thuật - Mô Hình Kíp Thợ 3 Người & Xoay Vòng 2 Trạm">
  <section class="max-w-6xl mx-auto px-3 sm:px-4 py-6 sm:py-10" x-data="workshopMasterEngine">
    <!-- TOP HEADER -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-gray-200 pb-5">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-1.5">
          <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-indigo-100 text-indigo-900 font-extrabold text-xs uppercase tracking-wide border border-indigo-200">
            ⚡ MÔ HÌNH HUẤN LUYỆN 9+3 THỰC CHIẾN
          </span>
          <span class="text-xs text-gray-500 font-mono">
            Chuẩn ĐGNL Thông tư 55/2026/TT-BGDĐT
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight">
          Xưởng Huấn Luyện Kíp Thợ & Xoay Vòng 2 Trạm
        </h1>
        <p class="text-gray-600 text-xs sm:text-sm mt-1 max-w-2xl">
          Giải pháp chia nhóm nhỏ cho lớp 30 học sinh: 10 Kíp thợ 3 người · Xoay vòng Trạm cơ khí & Trạm cài Win · Luyện trắc nghiệm AI lúc chờ bàn máy.
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/assessment/phan-cung"
          class="btn-secondary text-xs font-bold px-4 py-2.5 rounded-xl border border-gray-300 shadow-sm flex items-center gap-1.5"
        >
          <span>🎯</span>
          <span>100 Câu Sát Hạch AI</span>
        </a>
        <button
          type="button"
          @click="openPrintJobTicket()"
          class="btn-primary text-xs font-bold px-4 py-2.5 rounded-xl shadow-sm flex items-center gap-1.5 bg-slate-900 hover:bg-slate-800 text-white"
        >
          <span>🖨️</span>
          <span>In Phiếu A4 Kíp Thợ</span>
        </button>
      </div>
    </div>

    <!-- MAIN VIEW MODE TABS -->
    <div class="flex flex-wrap gap-2 mb-6">
      <button
        type="button"
        @click="activeViewTab = 'crews'"
        class="px-4 py-3 rounded-2xl text-xs sm:text-sm font-extrabold transition-all flex items-center gap-2 border shadow-sm"
        :class="activeViewTab === 'crews'
          ? 'bg-indigo-700 text-white border-indigo-700 shadow-md ring-2 ring-indigo-200'
          : 'bg-white text-gray-700 border-gray-200 hover:bg-gray-50'"
      >
        <span>👥</span>
        <span>Mô Hình 10 Kíp Thợ (Lớp 30 Học Sinh)</span>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold" :class="activeViewTab === 'crews' ? 'bg-indigo-500 text-white' : 'bg-indigo-100 text-indigo-800'">
          Trọng Tâm
        </span>
      </button>

      <button
        type="button"
        @click="activeViewTab = 'attendance'"
        class="px-4 py-3 rounded-2xl text-xs sm:text-sm font-bold transition-all flex items-center gap-2 border shadow-sm"
        :class="activeViewTab === 'attendance'
          ? 'bg-indigo-700 text-white border-indigo-700 shadow-md'
          : 'bg-white text-gray-700 border-gray-200 hover:bg-gray-50'"
      >
        <span>📝</span>
        <span>Điểm Danh & Nộp Bài Thực Hành Buổi (Thường)</span>
      </button>
    </div>

    <!-- ==================================================================== -->
    <!-- VIEW 1: MÔ HÌNH 10 KÍP THỢ & XOAY VÒNG 2 TRẠM (30 HỌC SINH)         -->
    <!-- ==================================================================== -->
    <div x-show="activeViewTab === 'crews'" class="space-y-6">

      <!-- SƠ ĐỒ VẬN HÀNH TRỰC QUAN (FLOW DIAGRAM CARD) -->
      <div class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white rounded-3xl p-5 sm:p-7 shadow-xl border border-indigo-500/20">
        <div class="flex items-center justify-between gap-4 mb-4 border-b border-white/10 pb-3">
          <div class="flex items-center gap-2.5">
            <span class="text-2xl">🗺️</span>
            <div>
              <h2 class="text-base sm:text-lg font-black text-white tracking-wide">
                Quy Trình Tác Chiến Xưởng: 30 Học Sinh → 10 Kíp Thợ
              </h2>
              <p class="text-indigo-200 text-xs mt-0.5">
                Mỗi bàn máy 3 em: Thợ chính thao tác · Thợ phụ kiểm soát an toàn Poka-Yoke · Thư ký ghi chép
              </p>
            </div>
          </div>
          <span class="hidden sm:inline-flex items-center gap-1 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 font-mono text-xs font-bold border border-emerald-500/30">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            100% HOẠT ĐỘNG
          </span>
        </div>

        <!-- 4-Stage Visual Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-3 text-xs">
          <!-- Step 1: 30 Học sinh -->
          <div class="bg-white/10 backdrop-blur rounded-2xl p-4 border border-white/10 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="font-extrabold text-amber-300">BƯỚC 1: TỔ CHỨC</span>
                <span class="text-base">👨‍🎓</span>
              </div>
              <p class="font-bold text-white text-sm">Lớp 30 Học Sinh 9+3</p>
              <p class="text-slate-300 text-[11px] mt-1 leading-relaxed">
                Chia làm 10 Kíp thợ độc lập (3 học sinh / kíp). Mỗi em giữ 1 vai trò rõ ràng, không em nào ngồi chơi.
              </p>
            </div>
            <div class="mt-3 pt-2 border-t border-white/10 text-[11px] text-amber-200 font-medium">
              ✓ 10 Kíp thợ đánh số 1 đến 10
            </div>
          </div>

          <!-- Step 2: Trạm 1 -->
          <div class="bg-amber-500/15 backdrop-blur rounded-2xl p-4 border border-amber-400/30 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="font-extrabold text-amber-300">TRẠM 1: 5 KÍP ĐẦU</span>
                <span class="text-base">🔧</span>
              </div>
              <p class="font-bold text-white text-sm">Tháo Lắp & An Toàn Cơ Khí</p>
              <p class="text-slate-300 text-[11px] mt-1 leading-relaxed">
                Áp dụng 3 Điểm dừng Poka-Yoke: Rút điện xả tụ, tra keo hạt đậu xanh, kiểm tra lẫy RAM & nguồn CPU trước khi cấp điện.
              </p>
            </div>
            <div class="mt-3 pt-2 border-t border-amber-400/20 text-[11px] text-amber-300 font-bold">
              🛠️ 5 Bàn máy tháo lắp phần cứng
            </div>
          </div>

          <!-- Step 3: Trạm 2 -->
          <div class="bg-blue-500/15 backdrop-blur rounded-2xl p-4 border border-blue-400/30 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="font-extrabold text-blue-300">TRẠM 2: 5 KÍP SAU</span>
                <span class="text-base">💻</span>
              </div>
              <p class="font-bold text-white text-sm">WinPE, Driver & Bắt Bệnh</p>
              <p class="text-slate-300 text-[11px] mt-1 leading-relaxed">
                Boot USB WinPE, phân vùng GPT/UEFI ổ C/D, bung Windows 10/11, cài sạch Driver và test tải HWMonitor nhiệt độ &lt; 75°C.
              </p>
            </div>
            <div class="mt-3 pt-2 border-t border-blue-400/20 text-[11px] text-blue-300 font-bold">
              ⚡ 5 Bàn máy cứu hộ & hệ điều hành
            </div>
          </div>

          <!-- Step 4: Vùng Đệm -->
          <div class="bg-purple-500/15 backdrop-blur rounded-2xl p-4 border border-purple-400/30 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="font-extrabold text-purple-300">VÙNG ĐỆM: SMARTPHONE</span>
                <span class="text-base">📱</span>
              </div>
              <p class="font-bold text-white text-sm">Luyện 100 Câu Có AI Hỗ Trợ</p>
              <p class="text-slate-300 text-[11px] mt-1 leading-relaxed">
                Lúc chờ xoay trạm hoặc hoàn thành sớm: Học sinh mở điện thoại làm 100 câu trắc nghiệm thực tế, AI giải thích ví von đời thường.
              </p>
            </div>
            <div class="mt-3 pt-2 border-t border-purple-400/20 text-[11px] text-purple-300 font-bold">
              ⭐ Tận dụng 100% thời gian xưởng
            </div>
          </div>
        </div>
      </div>

      <!-- ĐIỀU PHỐI LỚP & CHIA KÍP TỰ ĐỘNG -->
      <div class="bg-white border border-gray-200 rounded-3xl p-5 sm:p-6 shadow-sm">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-gray-100 pb-4 mb-5">
          <div>
            <h2 class="text-base font-extrabold text-gray-900 flex items-center gap-2">
              <span>📋</span>
              <span>Bảng Điều Phối Lớp Học & Phân Bổ 10 Kíp Thợ</span>
            </h2>
            <p class="text-xs text-gray-500 mt-0.5">
              Chọn lớp học để tự động tải danh sách 30 học sinh và phân bổ đều vào 10 bàn máy
            </p>
          </div>

          <!-- Class Selector and Auto-assign buttons -->
          <div class="flex flex-wrap items-center gap-2.5">
            <div class="w-full sm:w-auto min-w-[200px]">
              <select
                x-model="selectedClassCode"
                @change="onClassSelectChange()"
                class="w-full px-3 py-2 border border-gray-300 rounded-xl text-xs sm:text-sm font-bold focus:ring-2 focus:ring-indigo-500 focus:outline-none"
              >
                <option value="">-- Chọn lớp chuyên ngành --</option>
                <template x-for="c in availableClasses" :key="c.id || c.class_code">
                  <option :value="c.class_name" x-text="(c.is_composite ? '🔗 [Lớp ghép] ' : '🏫 ') + c.class_code + ' - ' + c.class_name"></option>
                </template>
              </select>
            </div>

            <button
              type="button"
              @click="autoDistributeCrews()"
              class="btn-primary text-xs font-bold px-3.5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white flex items-center gap-1.5 shadow"
              title="Phân đều 30 học sinh vào 10 Kíp thợ (mỗi kíp 3 em: Thợ chính, Thợ phụ, Thư ký)"
            >
              <span>🎲</span>
              <span>Tự Động Chia 10 Kíp</span>
            </button>

            <button
              type="button"
              @click="rotateAllStations()"
              class="btn-secondary text-xs font-bold px-3.5 py-2.5 rounded-xl border border-gray-300 hover:bg-gray-100 flex items-center gap-1.5"
              title="Đảo vị trí xoay vòng: Kíp 1-5 chuyển sang Trạm 2, Kíp 6-10 chuyển sang Trạm 1"
            >
              <span>🔄</span>
              <span>Xoay Vòng 2 Trạm</span>
            </button>

            <button
              type="button"
              @click="saveCrewsToStorage()"
              class="text-xs font-bold px-3 py-2.5 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-300 hover:bg-emerald-100 flex items-center gap-1"
            >
              <span>💾</span>
              <span>Lưu Cấu Hình</span>
            </button>
          </div>
        </div>

        <!-- Student Count & Status Bar -->
        <div class="flex flex-wrap items-center justify-between gap-3 text-xs bg-gray-50 px-4 py-2.5 rounded-2xl border border-gray-200">
          <div class="flex items-center gap-2">
            <span class="font-bold text-gray-700">Học sinh nạp vào xưởng:</span>
            <span class="px-2.5 py-0.5 rounded-full bg-indigo-100 text-indigo-900 font-mono font-extrabold" x-text="studentsInClass.length + ' học sinh'"></span>
            <span x-show="studentsInClass.length > 0" class="text-emerald-600 font-medium">✓ Đã sẵn sàng phân công</span>
          </div>

          <div class="flex items-center gap-4 text-gray-500 font-medium">
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-md bg-amber-500 inline-block"></span>
              <span>Trạm 1: Tháo Lắp (<strong class="text-gray-900" x-text="countStation(1)"></strong> Kíp)</span>
            </span>
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-md bg-indigo-600 inline-block"></span>
              <span>Trạm 2: Cài Win (<strong class="text-gray-900" x-text="countStation(2)"></strong> Kíp)</span>
            </span>
          </div>
        </div>
      </div>

      <!-- LƯỚI 10 BÀN MÁY / 10 KÍP THỢ (10 WORKBENCHES GRID) -->
      <div>
        <div class="flex items-center justify-between mb-3 px-1">
          <h3 class="text-sm font-extrabold text-gray-900 flex items-center gap-2">
            <span>🎛️</span>
            <span>Danh Sách 10 Bàn Máy Kỹ Thuật (Bấm để chọn bàn thao tác & chấm điểm)</span>
          </h3>
          <span class="text-xs text-gray-500">Chạm vào Kíp thợ bất kỳ để vào bàn máy</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
          <template x-for="crew in crews" :key="crew.id">
            <div
              @click="selectCrew(crew.id)"
              class="cursor-pointer rounded-2xl p-3.5 transition-all border-2 text-left relative flex flex-col justify-between min-h-[145px]"
              :class="selectedCrewId === crew.id
                ? 'ring-4 ring-indigo-400 border-indigo-700 bg-white shadow-lg scale-[1.02]'
                : (crew.station === 1
                    ? 'bg-amber-50/60 border-amber-200 hover:border-amber-400 hover:bg-amber-50'
                    : 'bg-indigo-50/60 border-indigo-200 hover:border-indigo-400 hover:bg-indigo-50')"
            >
              <!-- Top Card Info -->
              <div>
                <div class="flex items-center justify-between gap-1 mb-1.5">
                  <span
                    class="font-black text-xs px-2 py-0.5 rounded-lg text-white"
                    :class="crew.station === 1 ? 'bg-amber-600' : 'bg-indigo-700'"
                    x-text="'BÀN ' + crew.id"
                  ></span>
                  
                  <span
                    class="text-[10px] font-bold px-1.5 py-0.5 rounded"
                    :class="crew.station === 1 ? 'bg-amber-100 text-amber-800' : 'bg-indigo-100 text-indigo-800'"
                    x-text="crew.station === 1 ? '🔧 Trạm 1' : '💻 Trạm 2'"
                  ></span>
                </div>

                <!-- 3 Members mini list -->
                <div class="space-y-1 text-[11px] text-gray-700 mt-2">
                  <div class="truncate font-semibold flex items-center gap-1">
                    <span class="text-[10px] text-gray-400">1.</span>
                    <span x-text="crew.members.operator.name || 'Chưa gán thợ chính'"></span>
                  </div>
                  <div class="truncate text-gray-500 flex items-center gap-1">
                    <span class="text-[10px] text-gray-400">2.</span>
                    <span x-text="crew.members.safety.name || 'Chưa gán an toàn'"></span>
                  </div>
                  <div class="truncate text-gray-500 flex items-center gap-1">
                    <span class="text-[10px] text-gray-400">3.</span>
                    <span x-text="crew.members.recorder.name || 'Chưa gán thư ký'"></span>
                  </div>
                </div>
              </div>

              <!-- Bottom Status Indicators -->
              <div class="mt-3 pt-2 border-t border-gray-200/60 flex items-center justify-between text-[11px]">
                <!-- Poka Yoke Status -->
                <span
                  class="font-bold flex items-center gap-1"
                  :class="isPokaYokePassed(crew) ? 'text-emerald-700' : 'text-rose-600'"
                >
                  <span x-text="isPokaYokePassed(crew) ? '✓ An toàn' : '⚠️ Cần kiểm tra'"></span>
                </span>

                <!-- Teacher Grade badge if any -->
                <template x-if="crew.teacherGrade && crew.teacherGrade.total > 0">
                  <span class="px-1.5 py-0.2 rounded bg-amber-400 text-amber-950 font-black font-mono" x-text="crew.teacherGrade.total + 'đ'"></span>
                </template>
              </div>
            </div>
          </template>
        </div>
      </div>

      <!-- ================================================================== -->
      <!-- BÀN MÁY CHI TIẾT ĐANG CHỌN (SELECTED WORKBENCH COCKPIT)            -->
      <!-- ================================================================== -->
      <template x-if="currentCrew">
        <div class="bg-white border-2 border-indigo-200 rounded-3xl p-5 sm:p-7 shadow-lg space-y-6">
          
          <!-- Cockpit Top Bar -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-100 pb-5">
            <div class="flex items-center gap-3.5">
              <div
                class="w-14 h-14 rounded-2xl flex items-center justify-center text-3xl font-black text-white shrink-0 shadow-md"
                :class="currentCrew.station === 1 ? 'bg-amber-600' : 'bg-indigo-700'"
                x-text="currentCrew.id"
              ></div>
              <div>
                <div class="flex items-center gap-2">
                  <h2 class="text-xl sm:text-2xl font-black text-gray-900 tracking-tight" x-text="'Bàn Máy Số ' + currentCrew.id + ' — ' + currentCrew.name"></h2>
                  <span
                    class="px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider text-white"
                    :class="currentCrew.station === 1 ? 'bg-amber-600' : 'bg-indigo-700'"
                    x-text="currentCrew.station === 1 ? 'Trạm 1: Tháo Lắp Cơ Khí' : 'Trạm 2: Cài Win PE & Bắt Bệnh'"
                  ></span>
                </div>
                <p class="text-xs text-gray-500 mt-1">
                  Đang thao tác tại xưởng thực hành · Nhấn nút bên phải để hoán đổi trạm xoay vòng
                </p>
              </div>
            </div>

            <!-- Station Switcher Button -->
            <div class="flex items-center gap-2">
              <button
                type="button"
                @click="toggleCrewStation(currentCrew.id)"
                class="btn-secondary text-xs font-extrabold px-4 py-2.5 rounded-xl border border-indigo-300 text-indigo-800 bg-indigo-50 hover:bg-indigo-100 flex items-center gap-1.5 shadow-sm"
              >
                <span>🔄</span>
                <span x-text="currentCrew.station === 1 ? 'Chuyển Sang Trạm 2 (Cài Win)' : 'Chuyển Sang Trạm 1 (Tháo Lắp)'"></span>
              </button>
            </div>
          </div>

          <!-- THÀNH VIÊN KÍP THỢ (3 EM / KÍP) -->
          <div>
            <h3 class="text-xs font-black uppercase tracking-wider text-gray-500 mb-3 flex items-center gap-1.5">
              <span>👥</span>
              <span>Phân Công 3 Thành Viên Kíp Thợ (Có Thể Chỉnh Sửa Trực Tiếp)</span>
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <!-- Member 1: Thợ chính -->
              <div class="bg-gray-50 border border-gray-200 rounded-2xl p-3.5 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="inline-flex items-center gap-1 text-xs font-extrabold text-indigo-900">
                    <span>🛠️</span>
                    <span>Thợ Chính (Operator)</span>
                  </span>
                  <span class="text-[10px] bg-indigo-100 text-indigo-800 px-2 py-0.5 rounded-full font-bold">Thao tác máy</span>
                </div>
                <input
                  type="text"
                  list="workshop-students-list"
                  x-model="currentCrew.members.operator.name"
                  placeholder="Chọn họ tên học sinh 1..."
                  class="w-full px-3 py-2 border border-gray-300 rounded-xl text-xs sm:text-sm font-bold focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-white"
                />
                <p class="text-[11px] text-gray-500">Cầm tua-vít tháo lắp ốc chéo, cắm linh kiện hoặc trực tiếp cài Win.</p>
              </div>

              <!-- Member 2: Thợ phụ / An toàn -->
              <div class="bg-gray-50 border border-gray-200 rounded-2xl p-3.5 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="inline-flex items-center gap-1 text-xs font-extrabold text-amber-900">
                    <span>🛡️</span>
                    <span>Thợ Phụ / An Toàn</span>
                  </span>
                  <span class="text-[10px] bg-amber-100 text-amber-900 px-2 py-0.5 rounded-full font-bold">Poka-Yoke</span>
                </div>
                <input
                  type="text"
                  list="workshop-students-list"
                  x-model="currentCrew.members.safety.name"
                  placeholder="Chọn họ tên học sinh 2..."
                  class="w-full px-3 py-2 border border-gray-300 rounded-xl text-xs sm:text-sm font-bold focus:ring-2 focus:ring-amber-500 focus:outline-none bg-white"
                />
                <p class="text-[11px] text-gray-500">Cầm điện thoại kiểm tra 3 Điểm dừng an toàn, lột nilon & tra keo hạt đậu.</p>
              </div>

              <!-- Member 3: Thư ký -->
              <div class="bg-gray-50 border border-gray-200 rounded-2xl p-3.5 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="inline-flex items-center gap-1 text-xs font-extrabold text-purple-900">
                    <span>📝</span>
                    <span>Thư Ký Kỹ Thuật</span>
                  </span>
                  <span class="text-[10px] bg-purple-100 text-purple-900 px-2 py-0.5 rounded-full font-bold">Ghi chép</span>
                </div>
                <input
                  type="text"
                  list="workshop-students-list"
                  x-model="currentCrew.members.recorder.name"
