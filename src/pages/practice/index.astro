            </div>

            <!-- Submit Grade Button -->
            <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2">
              <div class="text-xs text-gray-500">
                <span x-show="currentCrew.teacherGrade.gradedAt" class="text-emerald-700 font-bold" x-text="'✓ Đã chấm lúc: ' + currentCrew.teacherGrade.gradedAt"></span>
                <span x-show="!currentCrew.teacherGrade.gradedAt">Chưa gửi kết quả lên hệ thống CSDL</span>
              </div>

              <button
                type="button"
                @click="submitTeacherGradeForCrew()"
                :disabled="isSubmittingGrade"
                class="btn-primary w-full sm:w-auto px-6 py-3 rounded-2xl bg-indigo-700 hover:bg-indigo-800 text-white font-extrabold text-xs sm:text-sm shadow-md flex items-center justify-center gap-2"
              >
                <span>💾</span>
                <span x-text="isSubmittingGrade ? 'Đang lưu CSDL...' : 'Lưu Điểm Kíp Thợ (Cho Cả 3 Học Sinh)'"></span>
              </button>
            </div>
          </div>
        </div>
      </template>

      <!-- ================================================================== -->
      <!-- VÙNG ĐỆM: LUYỆN TRẮC NGHIỆM AI LÚC CHỜ XOAY TRẠM                   -->
      <!-- ================================================================== -->
      <div class="bg-gradient-to-r from-purple-900 via-indigo-950 to-slate-900 text-white rounded-3xl p-6 sm:p-7 shadow-lg flex flex-col sm:flex-row items-center justify-between gap-5 border border-purple-500/30">
        <div class="space-y-1.5 text-center sm:text-left">
          <div class="flex items-center justify-center sm:justify-start gap-2">
            <span class="px-2.5 py-0.5 rounded-full bg-purple-400 text-purple-950 font-black text-xs uppercase tracking-wide">
              📱 VÙNG ĐỆM THỜI GIAN THỰC HÀNH
            </span>
            <span class="text-xs text-purple-200">100 Câu Sát Hạch Thực Tế</span>
          </div>
          <h3 class="text-lg sm:text-xl font-black text-white">
            Kíp Đang Chờ Bàn Máy Hoặc Đã Xong Sớm?
          </h3>
          <p class="text-xs sm:text-sm text-purple-200 max-w-xl leading-relaxed">
            Mở điện thoại làm ngay 100 câu trắc nghiệm tình huống kỹ thuật. Mỗi câu làm sai đều có Trợ giảng AI phân tích lý do bằng hình ảnh đời thường!
          </p>
        </div>

        <a
          href="/assessment/phan-cung"
          class="btn-primary px-6 py-3.5 rounded-2xl bg-white text-indigo-950 hover:bg-purple-50 font-black text-xs sm:text-sm shadow-lg shrink-0 flex items-center gap-2 no-underline"
        >
          <span>🎯</span>
          <span>Luyện Trắc Nghiệm AI Ngay →</span>
        </a>
      </div>
    </div>

    <!-- ==================================================================== -->
    <!-- VIEW 2: ĐIỂM DANH & NỘP BÀI THỰC HÀNH BUỔI HỌC (TRUYỀN THỐNG)        -->
    <!-- ==================================================================== -->
    <div x-show="activeViewTab === 'attendance'" class="space-y-6">
      <div class="bg-white border border-gray-200 rounded-3xl p-6 sm:p-8 shadow-sm">
        <div class="border-b border-gray-100 pb-3 mb-5">
          <h2 class="text-base font-bold text-gray-900">Điểm danh & Nộp bài thực hành theo buổi</h2>
          <p class="text-xs text-gray-500">Dành cho sinh viên các lớp Tin học ứng dụng & Mạng máy tính</p>
        </div>

        <form @submit.prevent="startPractice()" x-show="!started" class="space-y-5">
          <!-- Chọn lớp -->
          <div>
            <label for="class-select" class="block text-xs font-bold text-gray-700 mb-1">Lớp chuyên ngành (*)</label>
            <select
              id="class-select"
              x-model="selectedClassName"
              @change="onClassChange()"
              required
              class="w-full border border-gray-300 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 font-medium"
            >
              <option value="">-- Chọn lớp của bạn --</option>
              <template x-for="c in availableClasses" :key="c.id || c.class_code">
                <option :value="c.class_name" x-text="(c.is_composite ? '🔗 [Lớp ghép] ' : '🏫 ') + c.class_code + ' - ' + c.class_name"></option>
              </template>
            </select>
          </div>

          <!-- Chọn buổi học -->
          <div>
            <label for="session-select" class="block text-xs font-bold text-gray-700 mb-1">Buổi thực hành (*)</label>
            <select
              id="session-select"
              x-model="selectedSession"
              required
              class="w-full border border-gray-300 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
            >
              <option value="">-- Chọn buổi học --</option>
              <option value="Buổi 1: Thao tác chuột, bàn phím & gõ Telex 10 ngón">Buổi 1: Thao tác chuột, bàn phím & gõ Telex 10 ngón</option>
              <option value="Buổi 2: Soạn thảo văn bản hành chính & Đơn từ">Buổi 2: Soạn thảo văn bản hành chính & Đơn từ</option>
              <option value="Buổi 3: Bảng biểu & Biểu mẫu quản lý">Buổi 3: Bảng biểu & Biểu mẫu quản lý</option>
              <option value="Buổi 4: Bảng tính Excel & Hàm thống kê căn bản">Buổi 4: Bảng tính Excel & Hàm thống kê căn bản</option>
              <option value="Buổi 5: Xử lý logic hàm điều kiện IF/VLOOKUP">Buổi 5: Xử lý logic hàm điều kiện IF/VLOOKUP</option>
              <option value="Buổi 6: Thực hành Phần cứng máy tính">Buổi 6: Thực hành Phần cứng máy tính</option>
            </select>
          </div>

          <!-- Nhập tên -->
          <div>
            <label for="student-name" class="block text-xs font-bold text-gray-700 mb-1">Họ và tên sinh viên (*)</label>
            <input
              id="student-name"
              type="text"
              list="student-picker-list"
              x-model="studentName"
              required
              placeholder="Chọn hoặc nhập họ tên của bạn..."
              class="w-full border border-gray-300 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
            />
            <datalist id="student-picker-list">
              <template x-for="st in studentsInClass" :key="st.id || st.full_name">
                <option :value="st.full_name" :label="(st.student_code ? ('[' + st.student_code + '] ') : '') + st.full_name + (st.date_of_birth ? (' · ' + st.date_of_birth) : '')"></option>
              </template>
            </datalist>
            <span class="text-[11px] text-gray-500 mt-1 block">💡 Khi chọn lớp, danh sách học sinh của lớp sẽ tự động hiện ra gợi ý để em chọn nhanh.</span>
          </div>

          <button type="submit" class="btn-primary w-full py-3 text-sm font-bold shadow">
            Bắt Đầu Buổi Thực Hành
          </button>
        </form>

        <!-- Practice content area -->
        <div x-show="started" x-cloak>
          <div class="text-center py-10 space-y-3">
            <span class="text-5xl block mb-2">💻</span>
            <h2 class="text-lg font-bold text-gray-800">Đã Vào Buổi Thực Hành Thành Công</h2>
            <div class="inline-block p-3 rounded-2xl bg-gray-50 border border-gray-200 text-xs text-left max-w-sm w-full space-y-1 my-2">
              <p><strong>Sinh viên:</strong> <span x-text="studentName"></span></p>
              <p><strong>Lớp:</strong> <span x-text="selectedClassName"></span></p>
              <p><strong>Buổi học:</strong> <span x-text="selectedSession"></span></p>
            </div>
            <p class="text-gray-500 text-xs max-w-md mx-auto leading-relaxed">
              Hệ thống đã ghi nhận thông tin điểm danh của em vào CSDL Cloudflare D1. Vui lòng làm theo hướng dẫn bài tập trên máy hoặc tại phiếu giao việc của giảng viên.
            </p>
            <div class="pt-3">
              <button @click="started = false" class="btn-secondary text-xs px-4 py-2 font-bold">← Quay lại danh sách buổi</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div
      x-show="toastMessage"
      x-cloak
      x-transition
      class="fixed bottom-6 right-6 z-50 bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-2xl flex items-center gap-3 border border-slate-700 text-xs font-bold"
    >
      <span class="text-emerald-400 text-base">✓</span>
      <span x-text="toastMessage"></span>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  document.addEventListener('alpine:init', () => {
    Alpine.data('workshopMasterEngine', () => ({
      activeViewTab: 'crews',
      availableClasses: [],
      selectedClassCode: '',
      studentsInClass: [],
      selectedCrewId: 1,
      isSubmittingGrade: false,
      toastMessage: '',

      // View 2 traditional state
      started: false,
      selectedClassName: '',
      selectedSession: '',
      studentName: '',

      // 7 Hardware Steps
      hardwareSteps: [
        { title: 'Chẩn đoán & Tháo vỏ case', desc: 'Tiếp nhận máy, quan sát dấu hiệu chập cháy, tháo nắp hông case cẩn thận.' },
        { title: 'Tháo Bộ nguồn (PSU)', desc: 'Rút đầu cắm 24-pin mainboard và 4/8-pin CPU (bóp lẫy khóa, không giật dây).' },
        { title: 'Tháo Card VGA & Ổ đĩa', desc: 'Mở ốc chặn khe PCIe, gạt lẫy socket rồi rút card thẳng đứng. Tháo SSD/HDD.' },
        { title: 'Tháo Thanh RAM & Vệ sinh', desc: 'Bóp 2 đầu lẫy khe RAM nhẹ nhàng. Dùng gôm tẩy vệ sinh chân tiếp xúc màu vàng.' },
        { title: 'Tháo Tản nhiệt & CPU', desc: 'Tháo ốc tản nhiệt chéo hình chữ X đều lực. Gạt thanh khóa socket nâng nhẹ CPU.' },
        { title: 'Vệ sinh 5S & Tra keo tản nhiệt', desc: 'Lau sạch keo cũ, bóc seal nilon, tra keo chuẩn 1 hạt đậu xanh ngay giữa CPU.' },
        { title: 'Lắp ráp ngược lại & Vào BIOS', desc: 'Lắp đúng khớp Poka-Yoke, lẫy RAM kêu tách, cắm nguồn phụ CPU và kích nguồn vào BIOS.' },
      ],

      // 5 WinPE Steps
      winSteps: [
        { title: 'Boot vào USB WinPE Cứu hộ', desc: 'Bấm phím tắt Boot Menu (F12/F11/F8/Esc) khởi động vào môi trường Mini Windows.' },
        { title: 'Kiểm tra ổ đĩa & Phân vùng GPT/UEFI', desc: 'Mở Partition Wizard: Chia ổ C hệ điều hành >= 60GB và ổ D chứa dữ liệu học tập.' },
        { title: 'Bung file Windows 10/11 sạch', desc: 'Cài đặt hệ điều hành sạch không kèm mã độc hoặc phần mềm rác theo yêu cầu khách.' },
        { title: 'Cài đặt Driver chuẩn', desc: 'Mở Device Manager kiểm tra không còn bất kỳ dấu chấm than màu vàng (⚠️).' },
        { title: 'Đo nhiệt độ test tải CPU với HWMonitor', desc: 'Chạy thử tải máy hoạt động êm ái, nhiệt độ CPU ổn định dưới 75°C.' },
      ],

      // 10 Kíp thợ ban đầu
      crews: [],

      init() {
        this.initDefaultCrews();
        this.loadClasses();
        this.loadSavedCrews();
      },

      initDefaultCrews() {
        const initial = [];
        for (let i = 1; i <= 10; i++) {
          initial.push({
            id: i,
            name: 'Kíp ' + i,
            station: i <= 5 ? 1 : 2, // 1-5 Trạm 1; 6-10 Trạm 2
            members: {
              operator: { name: '', code: '', role: 'Thợ chính' },
              safety: { name: '', code: '', role: 'Thợ phụ / An toàn' },
              recorder: { name: '', code: '', role: 'Thư ký kỹ thuật' },
            },
            safetyChecks: {
              rule1_power_discharge: false,
              rule2_thermal_paste: false,
              rule3_cable_ram_seated: false,
            },
            stepsCompleted: [false, false, false, false, false, false, false],
            specs: {
              cpu: '',
              ram: '',
              storage: '',
              temperature: '',
            },
            teacherGrade: {
              safety: 2.0,
              assembly: 2.0,
              winInstall: 3.0,
              driverTemp: 2.0,
              workplace5s: 1.0,
              total: 10.0,
              gradedAt: '',
            },
          });
        }
        this.crews = initial;
      },

      get currentCrew() {
        return this.crews.find(c => c.id === this.selectedCrewId) || this.crews[0];
      },

      selectCrew(id) {
        this.selectedCrewId = id;
      },

      countStation(stationNum) {
        return this.crews.filter(c => c.station === stationNum).length;
      },

      isPokaYokePassed(crew) {
        if (!crew || !crew.safetyChecks) return false;
        return crew.safetyChecks.rule1_power_discharge &&
               crew.safetyChecks.rule2_thermal_paste &&
               crew.safetyChecks.rule3_cable_ram_seated;
      },

      countCompletedSteps(crew) {
        if (!crew || !crew.stepsCompleted) return 0;
        return crew.stepsCompleted.filter(Boolean).length;
      },

      countCompletedWinSteps(crew) {
        if (!crew || !crew.stepsCompleted) return 0;
        return crew.stepsCompleted.slice(0, 5).filter(Boolean).length;
      },

      calcCurrentCrewTotal() {
        const c = this.currentCrew;
        if (!c || !c.teacherGrade) return 0;
        const g = c.teacherGrade;
        const total = (Number(g.safety) || 0) + (Number(g.assembly) || 0) + (Number(g.winInstall) || 0) + (Number(g.driverTemp) || 0) + (Number(g.workplace5s) || 0);
        return Math.round(total * 10) / 10;
      },

      toggleCrewStation(crewId) {
        const crew = this.crews.find(c => c.id === crewId);
        if (crew) {
          crew.station = crew.station === 1 ? 2 : 1;
          this.showToast(`Đã chuyển Bàn ${crew.id} sang Trạm ${crew.station}!`);
          this.saveCrewsToStorage();
        }
      },

      rotateAllStations() {
        this.crews.forEach(c => {
          c.station = c.station === 1 ? 2 : 1;
        });
        this.showToast('Đã xoay vòng toàn bộ 10 bàn máy!');
        this.saveCrewsToStorage();
      },

      async loadClasses() {
        const localClasses = localStorage.getItem('BMTC_CLASSES');
        if (localClasses) {
          try {
            this.availableClasses = JSON.parse(localClasses);
          } catch(e){}
        }
        try {
          const res = await fetch('/api/classes');
          const data = await res.json();
          if (data && data.ok && Array.isArray(data.data) && data.data.length > 0) {
            this.availableClasses = data.data;
          }
        } catch(e){}

        // Tự động chọn lớp 03THA9 hoặc lớp đầu tiên nếu có
        if (this.availableClasses.length > 0 && !this.selectedClassCode) {
          const target = this.availableClasses.find(c => c.class_code === '03THA9' || c.class_name?.includes('03THA9')) || this.availableClasses[0];
          this.selectedClassCode = target.class_name;
          this.onClassSelectChange();
        }
      },

      async onClassSelectChange() {
        if (!this.selectedClassCode) {
          this.studentsInClass = [];
          return;
        }

        let foundLocal = false;
        try {
          const allStudentsStore = JSON.parse(localStorage.getItem('BMTC_STUDENTS') || '{}');
          const targetCls = (this.availableClasses || []).find(c => c.class_name === this.selectedClassCode || c.class_code === this.selectedClassCode);
          if (targetCls && allStudentsStore[targetCls.id]) {
            this.studentsInClass = allStudentsStore[targetCls.id];
            foundLocal = true;
          }
        } catch(e){}

        try {
          const res = await fetch('/api/classes?code=' + encodeURIComponent(this.selectedClassCode));
          const data = await res.json();
          if (data && data.ok && Array.isArray(data.data) && (data.from_d1 || !foundLocal)) {
            this.studentsInClass = data.data;
          }
        } catch(e){}
      },

      autoDistributeCrews() {
        if (!this.studentsInClass || this.studentsInClass.length === 0) {
          alert('Chưa có danh sách học sinh cho lớp này. Vui lòng chọn lớp đã nạp học sinh!');
          return;
        }

        const pool = [...this.studentsInClass];
        for (let i = 0; i < 10; i++) {
          const c = this.crews[i];
          const st1 = pool[i * 3] || { full_name: `Học sinh ${i * 3 + 1}` };
          const st2 = pool[i * 3 + 1] || { full_name: `Học sinh ${i * 3 + 2}` };
          const st3 = pool[i * 3 + 2] || { full_name: `Học sinh ${i * 3 + 3}` };

          c.members.operator.name = st1.full_name;
          c.members.operator.code = st1.student_code || '';
          c.members.safety.name = st2.full_name;
          c.members.safety.code = st2.student_code || '';
          c.members.recorder.name = st3.full_name;
          c.members.recorder.code = st3.student_code || '';
        }

        this.showToast('Đã tự động phân bổ 30 học sinh vào 10 Kíp thợ!');
        this.saveCrewsToStorage();
      },

      saveCrewsToStorage() {
        try {
          localStorage.setItem('BMTC_WORKSHOP_CREWS', JSON.stringify({
            className: this.selectedClassCode,
            crews: this.crews,
            savedAt: new Date().toISOString()
          }));
          this.showToast('Đã lưu cấu hình 10 Kíp thợ vào máy!');
        } catch(e){}
      },

      loadSavedCrews() {
        try {
          const raw = localStorage.getItem('BMTC_WORKSHOP_CREWS');
          if (raw) {
            const data = JSON.parse(raw);
            if (data && Array.isArray(data.crews) && data.crews.length === 10) {
              this.crews = data.crews;
              if (data.className) this.selectedClassCode = data.className;
            }
          }
        } catch(e){}
      },

      async submitTeacherGradeForCrew() {
        const c = this.currentCrew;
        if (!c) return;

        const totalScore = this.calcCurrentCrewTotal();
        c.teacherGrade.total = totalScore;
        c.teacherGrade.gradedAt = new Date().toLocaleTimeString('vi-VN');

        const members = [c.members.operator, c.members.safety, c.members.recorder].filter(m => m && m.name && m.name.trim());
        if (members.length === 0) {
          alert('Kíp thợ này chưa có tên học sinh nào!');
          return;
        }

        this.isSubmittingGrade = true;

        try {
          // Lưu đồng bộ cho cả 3 học sinh trong kíp lên CSDL Cloudflare
          const sessionName = `Ôn thi ĐGNL - Kíp ${c.id} (${c.station === 1 ? 'Trạm 1: Tháo lắp' : 'Trạm 2: Cài Win'})`;
          
          for (const m of members) {
            await fetch('/api/scores', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                className: this.selectedClassCode || '03THA9',
                sessionName: sessionName,
                studentName: m.name,
                studentCode: m.code || '',
                originalClass: this.selectedClassCode || '03THA9',
                station: c.station === 1 ? 'Trạm 1: Tháo lắp cơ khí' : 'Trạm 2: Cài Win PE & Driver',
                score: totalScore,
                details: {
                  crewId: c.id,
                  crewRole: m.role || '',
                  rubric: c.teacherGrade,
                  pokaYokePassed: this.isPokaYokePassed(c),
                  specs: c.specs,
                  submittedAt: new Date().toISOString()
                }
              })
            }).catch(() => {});
          }

          this.saveCrewsToStorage();
          this.showToast(`Đã lưu điểm ${totalScore}đ cho Kíp ${c.id} (3 học sinh) thành công!`);
        } catch(e) {
          alert('Lỗi khi lưu điểm: ' + (e.message || 'Vui lòng thử lại'));
        } finally {
          this.isSubmittingGrade = false;
        }
      },

      showToast(msg) {
        this.toastMessage = msg;
        setTimeout(() => {
          this.toastMessage = '';
        }, 3000);
      },

      openPrintJobTicket() {
        const c = this.currentCrew;
        const printWindow = window.open('', '_blank');
        if (!printWindow) return;

        const html = `
          <!DOCTYPE html>
          <html lang="vi">
          <head>
            <meta charset="utf-8">
            <title>Phiếu Giao Việc Kíp Thợ A4 - Bàn ${c.id}</title>
            <style>
              body { font-family: 'Times New Roman', serif; margin: 25mm 20mm; color: #000; line-height: 1.4; font-size: 13pt; }
              .header { text-align: center; margin-bottom: 20px; }
              .header h3 { margin: 0; font-size: 13pt; font-weight: normal; }
              .header h2 { margin: 5px 0; font-size: 14pt; font-weight: bold; }
              .line { width: 150px; height: 1px; background: #000; margin: 5px auto; }
              .title { text-align: center; margin: 25px 0 15px; }
              .title h1 { margin: 0; font-size: 16pt; font-weight: bold; }
              .title p { margin: 5px 0; font-style: italic; font-size: 11pt; }
              .box { border: 1px solid #000; padding: 10px; margin: 15px 0; border-radius: 4px; }
              table { width: 100%; border-collapse: collapse; margin: 15px 0; font-size: 12pt; }
              th, td { border: 1px solid #000; padding: 8px; text-align: left; }
              th { background: #f0f0f0; text-align: center; }
              .signatures { display: flex; justify-content: space-between; margin-top: 40px; text-align: center; }
              .signatures div { width: 45%; }
              @media print {
                body { margin: 10mm; }
                .no-print { display: none; }
              }
            </style>
          </head>
          <body>
            <div class="header">
              <h3>TRƯỜNG CAO ĐẲNG BUÔN MA THUỘT — KHOA CNTT</h3>
