            </div>
          </body>
          </html>
        `;

        printWindow.document.write(html);
        printWindow.document.close();
      },

      // View 2 Traditional Handlers
      async onClassChange() {
        if (!this.selectedClassName) return;
        this.selectedClassCode = this.selectedClassName;
        await this.onClassSelectChange();
      },

      async startPractice() {
        this.started = true;
        try {
          const rawName = (this.studentName || '').trim();
          const matched = this.studentsInClass.find(st =>
            (st.full_name && st.full_name.toLowerCase() === rawName.toLowerCase()) ||
            (st.student_code && st.student_code.toLowerCase() === rawName.toLowerCase())
          );
          const finalName = matched && matched.student_code
            ? `[${matched.student_code}] ${matched.full_name}`
            : rawName;

          fetch('/api/scores', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              className: this.selectedClassName,
              sessionName: this.selectedSession,
              studentName: finalName,
              studentCode: matched ? (matched.student_code || '') : '',
              originalClass: matched ? (matched.original_class || this.selectedClassName) : this.selectedClassName,
              score: 10.0,
              details: { type: 'DiemDanhThucHanh', timestamp: new Date().toISOString() }
            })
          }).catch(() => {});
        } catch (e) {}
      }
    }));
  });
</script>
