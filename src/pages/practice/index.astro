                  <th>Tiêu chí đánh giá</th>
                  <th>Điểm tối đa</th>
                  <th>Điểm đạt được</th>
                </tr>
              </thead>
              <tbody>
                <tr><td align="center">1</td><td>Kỷ luật 5S & Tuân thủ Poka-Yoke 3 điểm dừng</td><td align="center">2.0</td><td align="center"><strong>${c.teacherGrade.safety}</strong></td></tr>
                <tr><td align="center">2</td><td>Kỹ thuật tháo lắp & Tra keo tản nhiệt hạt đậu xanh</td><td align="center">2.0</td><td align="center"><strong>${c.teacherGrade.assembly}</strong></td></tr>
                <tr><td align="center">3</td><td>Cài đặt WinPE, phân vùng GPT/UEFI sạch</td><td align="center">3.0</td><td align="center"><strong>${c.teacherGrade.winInstall}</strong></td></tr>
                <tr><td align="center">4</td><td>Cài đặt Driver sạch & Đo nhiệt độ test tải &lt; 75°C</td><td align="center">2.0</td><td align="center"><strong>${c.teacherGrade.driverTemp}</strong></td></tr>
                <tr><td align="center">5</td><td>Tác phong công nghiệp & Biên bản bàn giao</td><td align="center">1.0</td><td align="center"><strong>${c.teacherGrade.workplace5s}</strong></td></tr>
                <tr><td colspan="2" align="right"><strong>TỔNG ĐIỂM THỰC HÀNH KÍP THỢ:</strong></td><td align="center"><strong>10.0</strong></td><td align="center"><strong style="font-size:14pt; color:#b91c1c;">${this.calcCurrentCrewTotal()}</strong></td></tr>
