---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  HARDWARE_METADATA,
  THREE_SURVIVAL_RULES,
  THREE_SAFETY_CHECKPOINTS,
} from '../../data/hardwareCurriculum';

export const prerender = false;
---

<BaseLayout title="Xưởng Thực Hành Kỹ Thuật - 10 Bàn Máy 3 Người">
  <section class="max-w-5xl mx-auto px-4 py-6 sm:py-8" x-data="workshopEngine">
    
    <!-- TOP MINIMALIST BAR (SHADCN / DUB STYLE) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-5 mb-6">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
            MÔN: {HARDWARE_METADATA.courseCode}
          </span>
          <span class="text-xs text-slate-500 font-medium">Chuẩn TT55 · 30 Học sinh 9+3</span>
        </div>
        <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
          Phòng Huấn Luyện Kỹ Thuật Viên & 10 Bàn Máy
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
          10 Nhóm KTV (3 KTV / Bàn) · 2 Trạm xoay vòng · Kiểm soát an toàn Poka-Yoke
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2.5 shrink-0">
        <a
          href="/assessment/phan-cung?mode=mcq"
          class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-800 transition-colors border border-slate-200 no-underline shadow-sm"
        >
          <span>📱</span>
          <span>100 Câu Sát Hạch AI</span>
        </a>

        <!-- TEACHER COCKPIT TRIGGER BUTTON (PROGRESSIVE DISCLOSURE) -->
        <button
          type="button"
          @click="showTeacherModal = true"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-bold bg-slate-900 hover:bg-slate-800 text-white transition-colors shadow-sm"
        >
          <span>🔐</span>
          <span>Bảng Của Thầy</span>
        </button>
      </div>
    </div>

    <!-- MAIN VIEW TABS: COMPACT TOGGLE -->
    <div class="flex items-center justify-between gap-2 mb-6">
      <div class="inline-flex p-1 rounded-xl bg-slate-100 border border-slate-200 text-xs font-bold">
        <button
          type="button"
          @click="activeTab = 'workbench'"
          class="px-3.5 py-1.5 rounded-lg transition-all"
          :class="activeTab === 'workbench' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-600 hover:text-slate-900'"
        >
          👥 10 Bàn Máy (Học Sinh)
        </button>
        <button
          type="button"
          @click="activeTab = 'attendance'"
          class="px-3.5 py-1.5 rounded-lg transition-all"
          :class="activeTab === 'attendance' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-600 hover:text-slate-900'"
        >
          📝 Điểm Danh Buổi
        </button>
      </div>

      <!-- Quick status indicator -->
      <div class="text-[11px] text-slate-500 hidden sm:flex items-center gap-3">
        <span class="flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          <span>Trạm 1: Tháo Lắp (<strong x-text="countStation(1)"></strong>)</span>
        </span>
        <span class="flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-blue-600"></span>
          <span>Trạm 2: Cài Win (<strong x-text="countStation(2)"></strong>)</span>
        </span>
      </div>
    </div>

    <!-- ==================================================================== -->
    <!-- TAB 1: 10 BÀN MÁY KỸ THUẬT (STUDENT-FIRST WORKBENCH)                 -->
    <!-- ==================================================================== -->
    <div x-show="activeTab === 'workbench'" class="space-y-6">
      
      <!-- SCREEN 1: CHỌN BÀN MÁY (KHI CHƯA CHỌN BÀN) -->
      <div x-show="!activeCrewDetail" class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-sm sm:text-base font-extrabold text-slate-800">
            Chọn bàn máy của em (Chạm vào bàn để bắt đầu thao tác)
          </h2>
          <span class="text-xs text-slate-500">Lớp: <strong class="text-slate-800" x-text="selectedClassName || '03THA9'"></strong></span>
        </div>

        <!-- 10 CLEAN WORKBENCH CARDS (SHADCN CARD STYLE) -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
          <template x-for="c in crews" :key="c.id">
            <div
              @click="openCrewDetail(c.id)"
              class="cursor-pointer bg-white rounded-2xl p-4 border border-slate-200 hover:border-slate-400 hover:shadow-md transition-all text-left flex flex-col justify-between min-h-[140px] group"
            >
              <div>
                <!-- Top Badge -->
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-black text-slate-900 group-hover:text-blue-600 transition-colors" x-text="'BÀN ' + c.id"></span>
                  <span
                    class="text-[10px] font-bold px-2 py-0.5 rounded-full"
                    :class="c.station === 1 ? 'bg-amber-50 text-amber-800 border border-amber-200' : 'bg-blue-50 text-blue-800 border border-blue-200'"
                    x-text="c.station === 1 ? 'Trạm 1' : 'Trạm 2'"
                  ></span>
                </div>

                <!-- 3 Names mini -->
                <div class="text-[11px] text-slate-600 space-y-1">
                  <p class="truncate font-semibold text-slate-800" x-text="c.members.operator.name || 'KTV 1 (Thao tác)'"></p>
                  <p class="truncate text-slate-500 text-[10px]" x-text="c.members.safety.name || 'KTV 2 (An toàn)'"></p>
                  <p class="truncate text-slate-400 text-[10px]" x-text="c.members.recorder.name || 'KTV 3 (Báo cáo)'"></p>
                </div>
              </div>

              <!-- Bottom Safety Indicator -->
              <div class="mt-3 pt-2 border-t border-slate-100 flex items-center justify-between text-[10px]">
                <span :class="isSafe(c) ? 'text-emerald-700 font-bold' : 'text-slate-400'">
                  <span x-text="isSafe(c) ? '✓ An toàn' : '○ Chưa test'"></span>
                </span>
                <span class="text-blue-600 font-bold group-hover:translate-x-0.5 transition-transform">Vào bàn →</span>
              </div>
            </div>
          </template>
        </div>

        <!-- BUFFER CALLOUT (CLEAN & MINIMALIST) -->
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-2.5 text-center sm:text-left">
            <span class="text-xl">📱</span>
            <div>
              <p class="font-bold text-slate-800">Đang chờ bàn máy hoặc đã làm xong sớm?</p>
              <p class="text-slate-500 mt-0.5">Mở điện thoại luyện ngay ngân hàng 100 câu hỏi trắc nghiệm tình huống kỹ thuật có AI hỗ trợ.</p>
            </div>
          </div>
          <a
            href="/assessment/phan-cung?mode=mcq"
            class="px-4 py-2 rounded-xl bg-white hover:bg-slate-100 text-slate-900 font-bold border border-slate-300 shadow-sm shrink-0 no-underline"
          >
            Luyện trắc nghiệm AI →
          </a>
        </div>
      </div>

      <!-- SCREEN 2: BÀN MÁY CHI TIẾT ĐANG CHỌN (MINIMALIST COCKPIT) -->
      <template x-if="activeCrewDetail">
        <div class="space-y-5">
          <!-- Back button & Bench Title Bar -->
          <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <button
                type="button"
                @click="activeCrewDetail = null"
                class="px-3 py-1.5 rounded-xl border border-slate-200 hover:bg-slate-100 text-xs font-bold text-slate-700 transition-colors"
              >
                ← Chọn bàn khác
              </button>
              <div>
                <div class="flex items-center gap-2">
                  <h2 class="text-lg sm:text-xl font-black text-slate-900" x-text="'Bàn Máy Số ' + activeCrewDetail.id + ' (' + activeCrewDetail.name + ')'"></h2>
                  <span
                    class="px-2.5 py-0.5 rounded-full text-xs font-bold"
                    :class="activeCrewDetail.station === 1 ? 'bg-amber-100 text-amber-900 border border-amber-200' : 'bg-blue-100 text-blue-900 border border-blue-200'"
                    x-text="activeCrewDetail.station === 1 ? 'Trạm 1: Tháo Lắp Cơ Khí' : 'Trạm 2: Cài Win PE'"
                  ></span>
                </div>
                <p class="text-xs text-slate-500 mt-0.5">
                  KTV 1 (Thao tác): <strong class="text-slate-800" x-text="activeCrewDetail.members.operator.name || 'Chưa gán'"></strong> · 
                  KTV 2 (An toàn): <strong class="text-slate-800" x-text="activeCrewDetail.members.safety.name || 'Chưa gán'"></strong> · 
                  KTV 3 (Báo cáo): <strong class="text-slate-800" x-text="activeCrewDetail.members.recorder.name || 'Chưa gán'"></strong>
                </p>
              </div>
            </div>

            <!-- Switch Station Button -->
            <button
              type="button"
              @click="toggleStation(activeCrewDetail.id)"
              class="text-xs font-bold px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-200 transition-colors"
            >
              🔄 Đổi sang <span x-text="activeCrewDetail.station === 1 ? 'Trạm 2 (Cài Win)' : 'Trạm 1 (Tháo Lắp)'"></span>
            </button>
          </div>

          <!-- POKA-YOKE 3 CHECKPOINTS (CLEAN SHADCN TACTILE CARDS) -->
          <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
              <div>
                <h3 class="text-sm sm:text-base font-extrabold text-slate-900 flex items-center gap-2">
                  <span>🛑</span>
                  <span>Poka-Yoke: 3 Điểm Dừng An Toàn Bắt Buộc</span>
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">KTV 2 kiểm tra và chạm tick xác nhận trên điện thoại trước khi cắm điện</p>
              </div>

              <!-- Status Badge -->
              <span
                class="px-3 py-1 rounded-xl text-xs font-black transition-all"
                :class="isSafe(activeCrewDetail) ? 'bg-emerald-600 text-white' : 'bg-slate-100 text-slate-600 border border-slate-200'"
                x-text="isSafe(activeCrewDetail) ? '✓ ĐỦ ĐIỀU KIỆN BẬT NGUỒN' : '⚠️ CẤM CẮM ĐIỆN'"
              ></span>
            </div>

            <!-- 3 Big Chunky Checkboxes (Tactile min 48px) -->
            <div class="space-y-2.5">
              <label class="flex items-center gap-3 p-3.5 rounded-xl border transition-all cursor-pointer select-none"
                :class="activeCrewDetail.safetyChecks.rule1_power_discharge ? 'bg-emerald-50/60 border-emerald-300 text-slate-900' : 'bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100/70'"
              >
                <input
                  type="checkbox"
                  x-model="activeCrewDetail.safetyChecks.rule1_power_discharge"
                  @change="autoSave()"
                  class="w-5 h-5 rounded text-blue-600 focus:ring-blue-500 shrink-0"
                />
                <div class="text-xs sm:text-sm">
                  <p class="font-bold">1. Rút nguồn 220V + Bấm Power 3 lần xả tụ + Chạm vỏ case xả tĩnh điện</p>
                  <p class="text-xs text-slate-500 mt-0.5">Mọi ốc vít đã được gom vào khay từ tính, không để lăn lóc trên bàn.</p>
                </div>
              </label>

              <label class="flex items-center gap-3 p-3.5 rounded-xl border transition-all cursor-pointer select-none"
                :class="activeCrewDetail.safetyChecks.rule2_thermal_paste ? 'bg-emerald-50/60 border-emerald-300 text-slate-900' : 'bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100/70'"
              >
                <input
                  type="checkbox"
                  x-model="activeCrewDetail.safetyChecks.rule2_thermal_paste"
                  @change="autoSave()"
                  class="w-5 h-5 rounded text-blue-600 focus:ring-blue-500 shrink-0"
                />
                <div class="text-xs sm:text-sm">
                  <p class="font-bold">2. Bóc nilon bảo vệ đáy tản nhiệt + Tra keo chuẩn đúng "1 hạt đậu xanh"</p>
                  <p class="text-xs text-slate-500 mt-0.5">Không bôi tràn lan ra socket CPU, đặt đế tản nhiệt ép đều lực.</p>
                </div>
              </label>

              <label class="flex items-center gap-3 p-3.5 rounded-xl border transition-all cursor-pointer select-none"
                :class="activeCrewDetail.safetyChecks.rule3_cable_ram_seated ? 'bg-emerald-50/60 border-emerald-300 text-slate-900' : 'bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100/70'"
              >
                <input
                  type="checkbox"
                  x-model="activeCrewDetail.safetyChecks.rule3_cable_ram_seated"
                  @change="autoSave()"
                  class="w-5 h-5 rounded text-blue-600 focus:ring-blue-500 shrink-0"
                />
                <div class="text-xs sm:text-sm">
                  <p class="font-bold">3. Khớp cắm nguồn CPU (4/8-pin) + Lẫy 2 đầu RAM sập kêu "tách"</p>
                  <p class="text-xs text-slate-500 mt-0.5">Không bao giờ ép khi cắm. Bắt ốc tản nhiệt chéo hình chữ X đều tay.</p>
                </div>
              </label>
            </div>
          </div>

          <!-- STATION TASK DETAILS (CLEAN CHECKLIST) -->
          <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm space-y-4">
            
            <!-- TRẠM 1 CONTENT -->
            <div x-show="activeCrewDetail.station === 1" class="space-y-4">
              <div class="flex items-center justify-between">
                <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
                  <span>🔧</span>
                  <span>7 Bước Tháo Lắp Chuẩn Kỹ Thuật Viên Nhật Bản</span>
                </h3>
                <span class="text-xs font-mono font-bold text-slate-500" x-text="countDoneSteps(activeCrewDetail) + '/7 hoàn thành'"></span>
              </div>

              <div class="space-y-2">
                <template x-for="(st, sIdx) in hardwareSteps" :key="sIdx">
                  <label class="flex items-center gap-3 p-3 rounded-xl border transition-all cursor-pointer select-none"
                    :class="activeCrewDetail.stepsCompleted[sIdx] ? 'bg-blue-50/50 border-blue-200 text-slate-900' : 'bg-slate-50/60 border-slate-200 text-slate-600 hover:bg-slate-100/50'"
                  >
                    <input
                      type="checkbox"
                      x-model="activeCrewDetail.stepsCompleted[sIdx]"
                      @change="autoSave()"
                      class="w-4 h-4 rounded text-blue-600 focus:ring-blue-500 shrink-0"
                    />
                    <div class="text-xs">
                      <span class="font-bold text-slate-900" x-text="(sIdx + 1) + '. ' + st.title"></span>
                      <span class="text-slate-500 ml-1.5" x-text="'— ' + st.desc"></span>
                    </div>
                  </label>
                </template>
              </div>
            </div>

            <!-- TRẠM 2 CONTENT -->
            <div x-show="activeCrewDetail.station === 2" class="space-y-4">
              <!-- Boot Menu Hotkeys pill -->
              <div class="bg-slate-900 text-white rounded-xl p-3.5 flex flex-wrap items-center justify-between gap-3 text-xs">
                <span class="font-bold text-slate-200">Phím Boot Menu nhanh:</span>
                <div class="flex flex-wrap items-center gap-2 font-mono">
                  <span class="px-2 py-0.5 rounded bg-slate-800 border border-slate-700">Gigabyte/Dell: <strong class="text-amber-300">F12</strong></span>
                  <span class="px-2 py-0.5 rounded bg-slate-800 border border-slate-700">MSI: <strong class="text-emerald-300">F11</strong></span>
                  <span class="px-2 py-0.5 rounded bg-slate-800 border border-slate-700">Asus: <strong class="text-sky-300">F8</strong></span>
                  <span class="px-2 py-0.5 rounded bg-slate-800 border border-slate-700">HP: <strong class="text-rose-300">Esc→F9</strong></span>
                  <span class="px-2 py-0.5 rounded bg-slate-800 border border-slate-700">BIOS: <strong class="text-white">Del/F2</strong></span>
                </div>
              </div>

              <div class="flex items-center justify-between pt-1">
                <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
                  <span>💻</span>
                  <span>5 Bước Cài Đặt WinPE, Driver & Đo Tải HWMonitor</span>
                </h3>
                <span class="text-xs font-mono font-bold text-slate-500" x-text="countDoneWinSteps(activeCrewDetail) + '/5 hoàn thành'"></span>
              </div>

              <div class="space-y-2">
                <template x-for="(wst, wIdx) in winSteps" :key="wIdx">
                  <label class="flex items-center gap-3 p-3 rounded-xl border transition-all cursor-pointer select-none"
                    :class="activeCrewDetail.stepsCompleted[wIdx] ? 'bg-blue-50/50 border-blue-200 text-slate-900' : 'bg-slate-50/60 border-slate-200 text-slate-600 hover:bg-slate-100/50'"
                  >
                    <input
                      type="checkbox"
                      x-model="activeCrewDetail.stepsCompleted[wIdx]"
                      @change="autoSave()"
                      class="w-4 h-4 rounded text-blue-600 focus:ring-blue-500 shrink-0"
                    />
                    <div class="text-xs">
                      <span class="font-bold text-slate-900" x-text="(wIdx + 1) + '. ' + wst.title"></span>
                      <span class="text-slate-500 ml-1.5" x-text="'— ' + wst.desc"></span>
                    </div>
                  </label>
                </template>
              </div>
            </div>

            <!-- Secretary Quick Note Form -->
            <div class="pt-3 border-t border-slate-100">
              <span class="text-xs font-bold text-slate-700 block mb-2">Thư ký ghi chép nhanh thông số máy:</span>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
                <input type="text" x-model="activeCrewDetail.specs.cpu" @change="autoSave()" placeholder="CPU & Mainboard" class="px-2.5 py-1.5 rounded-lg border border-slate-300 font-medium bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900" />
                <input type="text" x-model="activeCrewDetail.specs.ram" @change="autoSave()" placeholder="RAM (VD: 8GB)" class="px-2.5 py-1.5 rounded-lg border border-slate-300 font-medium bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900" />
                <input type="text" x-model="activeCrewDetail.specs.storage" @change="autoSave()" placeholder="Ổ cứng SSD/HDD" class="px-2.5 py-1.5 rounded-lg border border-slate-300 font-medium bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900" />
                <input type="text" x-model="activeCrewDetail.specs.temperature" @change="autoSave()" placeholder="Nhiệt độ test tải (°C)" class="px-2.5 py-1.5 rounded-lg border border-slate-300 font-medium bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900" />
              </div>
            </div>
          </div>

          <!-- Bottom Action -->
          <div class="flex items-center justify-between text-xs text-slate-500 pt-2">
            <span>Dữ liệu bàn máy được lưu trữ tự động trên thiết bị</span>
            <button
              type="button"
              @click="activeCrewDetail = null"
              class="px-4 py-2 rounded-xl bg-slate-900 text-white font-bold hover:bg-slate-800 transition-colors"
            >
              ✓ Xong, quay lại danh sách bàn
            </button>
          </div>
        </div>
      </template>
    </div>

    <!-- ==================================================================== -->
    <!-- TAB 2: ĐIỂM DANH BUỔI HỌC (TRUYỀN THỐNG)                             -->
    <!-- ==================================================================== -->
    <div x-show="activeTab === 'attendance'" class="space-y-4">
      <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-7 shadow-sm max-w-xl mx-auto">
        <h2 class="text-base font-bold text-slate-900 mb-1">Điểm danh buổi thực hành</h2>
        <p class="text-xs text-slate-500 mb-4">Dành cho sinh viên nộp bài tập điểm danh theo từng buổi học</p>

        <form @submit.prevent="submitAttendance()" class="space-y-4 text-xs">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Lớp học (*)</label>
            <select x-model="selectedClassName" required class="w-full px-3 py-2 border border-slate-300 rounded-xl font-medium focus:outline-none focus:ring-2 focus:ring-slate-900">
              <template x-for="c in availableClasses" :key="c.id || c.class_code">
                <option :value="c.class_name" x-text="c.class_code + ' - ' + c.class_name"></option>
              </template>
            </select>
          </div>

          <div>
            <label class="block font-bold text-slate-700 mb-1">Buổi thực hành (*)</label>
            <select x-model="attendanceSession" required class="w-full px-3 py-2 border border-slate-300 rounded-xl font-medium focus:outline-none focus:ring-2 focus:ring-slate-900">
              <option value="Buổi 1: Thao tác chuột, bàn phím & gõ 10 ngón">Buổi 1: Thao tác chuột, bàn phím & gõ 10 ngón</option>
              <option value="Buổi 2: Soạn thảo văn bản hành chính">Buổi 2: Soạn thảo văn bản hành chính</option>
              <option value="Buổi 3: Bảng biểu & Biểu mẫu quản lý">Buổi 3: Bảng biểu & Biểu mẫu quản lý</option>
              <option value="Buổi 4: Bảng tính Excel căn bản">Buổi 4: Bảng tính Excel căn bản</option>
              <option value="Buổi 5: Xử lý logic hàm IF/VLOOKUP">Buổi 5: Xử lý logic hàm IF/VLOOKUP</option>
              <option value="Buổi 6: Thực hành Phần cứng máy tính">Buổi 6: Thực hành Phần cứng máy tính</option>
            </select>
          </div>

          <div>
            <label class="block font-bold text-slate-700 mb-1">Họ và tên sinh viên (*)</label>
            <input type="text" x-model="attendanceStudentName" required placeholder="Nhập họ và tên của em..." class="w-full px-3 py-2 border border-slate-300 rounded-xl font-semibold focus:outline-none focus:ring-2 focus:ring-slate-900" />
          </div>

          <button type="submit" class="w-full py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold transition-colors">
            Xác Nhận Điểm Danh
          </button>
        </form>
      </div>
    </div>

    <!-- ==================================================================== -->
    <!-- MODAL BẢNG CỦA THẦY (TEACHER COCKPIT - PROGRESSIVE DISCLOSURE)        -->
    <!-- ==================================================================== -->
    <div
      x-show="showTeacherModal"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-slate-900/60 backdrop-blur-sm"
    >
      <div
        @click.away="showTeacherModal = false"
        class="bg-white rounded-3xl border border-slate-200 shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto p-5 sm:p-7 space-y-5"
      >
        <!-- Modal Header -->
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <div class="flex items-center gap-2">
            <span class="text-2xl">🔐</span>
            <div>
              <h3 class="text-base font-black text-slate-900">Bảng Điều Phối Của Giảng Viên</h3>
              <p class="text-xs text-slate-500">CN. Phạm Tiến Đồng · Quản trị xưởng 10 bàn máy</p>
            </div>
          </div>
          <button
            type="button"
            @click="showTeacherModal = false"
            class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold flex items-center justify-center text-sm"
          >
            ✕
          </button>
        </div>

        <!-- 1. Chọn Lớp & Nạp Danh Sách -->
        <div class="space-y-2 text-xs">
          <label class="block font-bold text-slate-700">Lớp chuyên ngành huấn luyện:</label>
          <div class="flex flex-wrap items-center gap-2">
            <select
              x-model="selectedClassName"
              @change="onClassChange()"
              class="flex-1 min-w-[200px] px-3 py-2 border border-slate-300 rounded-xl font-bold focus:outline-none focus:ring-2 focus:ring-slate-900"
            >
              <template x-for="c in availableClasses" :key="c.id || c.class_code">
                <option :value="c.class_name" x-text="c.class_code + ' - ' + c.class_name"></option>
              </template>
            </select>
            <span class="px-2.5 py-1 rounded-lg bg-slate-100 font-mono font-bold text-slate-700" x-text="studentsInClass.length + ' học sinh'"></span>
          </div>
        </div>

        <!-- 2. Thao Tác 1-Chạm Nhanh -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-1">
          <button
            type="button"
            @click="autoDistributeCrews()"
            class="px-3.5 py-2.5 rounded-xl bg-blue-50 text-blue-800 border border-blue-200 font-bold text-xs hover:bg-blue-100 flex items-center justify-center gap-1.5 transition-colors"
          >
            <span>🎲</span>
            <span>Tự Động Chia 10 Kíp</span>
          </button>

          <button
            type="button"
            @click="rotateAllStations()"
            class="px-3.5 py-2.5 rounded-xl bg-amber-50 text-amber-800 border border-amber-200 font-bold text-xs hover:bg-amber-100 flex items-center justify-center gap-1.5 transition-colors"
          >
            <span>🔄</span>
            <span>Xoay Vòng 2 Trạm</span>
          </button>

          <button
            type="button"
            @click="openPrintA4()"
            class="px-3.5 py-2.5 rounded-xl bg-slate-100 text-slate-800 border border-slate-300 font-bold text-xs hover:bg-slate-200 flex items-center justify-center gap-1.5 transition-colors"
          >
            <span>🖨️</span>
            <span>In Phiếu A4 Bàn Máy</span>
          </button>
        </div>

        <!-- 3. Chấm Điểm 1-Chạm Nhanh Từng Bàn -->
        <div class="border-t border-slate-100 pt-4 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-800">Chấm điểm nhanh bàn máy:</span>
            <div class="flex items-center gap-1">
              <template x-for="i in 10" :key="i">
                <button
                  type="button"
                  @click="teacherGradeBench = i"
                  class="w-6 h-6 rounded text-[10px] font-bold border transition-colors"
                  :class="teacherGradeBench === i ? 'bg-slate-900 text-white border-slate-900' : 'bg-slate-100 text-slate-600 border-slate-200'"
                  x-text="i"
                ></button>
              </template>
            </div>
          </div>

          <!-- Grade Rubric Pill Selector -->
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-xs space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-bold text-slate-800" x-text="'Bàn ' + teacherGradeBench + ' (' + (crews[teacherGradeBench - 1]?.name || '') + ')'"></span>
              <span class="font-mono font-black text-sm text-slate-900" x-text="'Tổng: ' + calcGradeTotal() + ' / 10.0 đ'"></span>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 text-[11px]">
              <div>
                <span class="text-slate-500 block mb-1">5S & Poka-Yoke (2đ)</span>
                <select x-model="tempGrade.safety" class="w-full px-2 py-1 rounded border border-slate-300 bg-white font-bold">
                  <option value="1.0">1.0 đ</option>
                  <option value="1.5">1.5 đ</option>
                  <option value="2.0">2.0 đ</option>
                </select>
              </div>
              <div>
                <span class="text-slate-500 block mb-1">Tháo lắp & Keo (2đ)</span>
                <select x-model="tempGrade.assembly" class="w-full px-2 py-1 rounded border border-slate-300 bg-white font-bold">
                  <option value="1.0">1.0 đ</option>
                  <option value="1.5">1.5 đ</option>
                  <option value="2.0">2.0 đ</option>
                </select>
              </div>
              <div>
                <span class="text-slate-500 block mb-1">Cài WinPE (3đ)</span>
                <select x-model="tempGrade.winInstall" class="w-full px-2 py-1 rounded border border-slate-300 bg-white font-bold">
                  <option value="1.5">1.5 đ</option>
                  <option value="2.5">2.5 đ</option>
                  <option value="3.0">3.0 đ</option>
                </select>
              </div>
              <div>
                <span class="text-slate-500 block mb-1">Driver & Tải (2đ)</span>
                <select x-model="tempGrade.driverTemp" class="w-full px-2 py-1 rounded border border-slate-300 bg-white font-bold">
                  <option value="1.0">1.0 đ</option>
                  <option value="1.5">1.5 đ</option>
                  <option value="2.0">2.0 đ</option>
                </select>
              </div>
              <div>
                <span class="text-slate-500 block mb-1">Tác phong A4 (1đ)</span>
                <select x-model="tempGrade.workplace5s" class="w-full px-2 py-1 rounded border border-slate-300 bg-white font-bold">
                  <option value="0.5">0.5 đ</option>
                  <option value="1.0">1.0 đ</option>
                </select>
              </div>
            </div>

            <button
              type="button"
              @click="saveGradeForBench()"
              class="w-full py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs transition-colors flex items-center justify-center gap-1.5 shadow-sm"
            >
              <span>💾</span>
              <span>Lưu Điểm Cho Cả 3 Học Sinh Bàn Này Lên CSDL</span>
            </button>
          </div>
        </div>

        <!-- Footer -->
        <div class="flex justify-end pt-2">
          <button
            type="button"
            @click="showTeacherModal = false"
            class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs"
          >
            Đóng bảng quản lý
          </button>
        </div>
      </div>
    </div>

    <!-- TOAST -->
    <div
      x-show="toast"
      x-cloak
      class="fixed bottom-5 right-5 z-50 bg-slate-900 text-white px-4 py-2.5 rounded-2xl shadow-xl text-xs font-bold border border-slate-700 flex items-center gap-2"
    >
      <span class="text-emerald-400">✓</span>
      <span x-text="toast"></span>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  document.addEventListener('alpine:init', () => {
    Alpine.data('workshopEngine', () => ({
      activeTab: 'workbench',
      showTeacherModal: false,
      activeCrewDetail: null,
      selectedClassName: '',
      availableClasses: [],
      studentsInClass: [],
      toast: '',

      // Attendance traditional
      attendanceSession: 'Buổi 6: Thực hành Phần cứng máy tính',
      attendanceStudentName: '',

      // Teacher grade
      teacherGradeBench: 1,
      tempGrade: {
        safety: 2.0,
        assembly: 2.0,
        winInstall: 3.0,
        driverTemp: 2.0,
        workplace5s: 1.0,
      },

      hardwareSteps: [
        { title: 'Chẩn đoán & Tháo vỏ case', desc: 'Quan sát dấu hiệu chập cháy, tháo nắp hông cẩn thận.' },
        { title: 'Tháo Bộ nguồn (PSU)', desc: 'Rút đầu cắm 24-pin và 4/8-pin CPU (bóp lẫy khóa, không giật dây).' },
        { title: 'Tháo Card VGA & Ổ đĩa', desc: 'Mở ốc chặn khe PCIe, gạt lẫy socket rồi rút card thẳng đứng.' },
        { title: 'Tháo Thanh RAM & Vệ sinh', desc: 'Bóp 2 đầu lẫy nhẹ nhàng, dùng gôm tẩy vệ sinh chân tiếp xúc vàng.' },
        { title: 'Tháo Tản nhiệt & CPU', desc: 'Tháo ốc chéo hình chữ X đều lực, gạt thanh khóa socket nâng nhẹ CPU.' },
        { title: 'Vệ sinh 5S & Tra keo tản nhiệt', desc: 'Lau sạch keo cũ, tra keo chuẩn 1 hạt đậu xanh ngay giữa CPU.' },
        { title: 'Lắp ráp ngược lại & Vào BIOS', desc: 'Lắp đúng khớp Poka-Yoke, lẫy RAM kêu tách và kích nguồn kiểm tra.' },
      ],

      winSteps: [
        { title: 'Boot vào USB WinPE Cứu hộ', desc: 'Bấm phím Boot Menu (F12/F11/F8/Esc) vào Mini Windows.' },
        { title: 'Kiểm tra ổ đĩa & Phân vùng GPT/UEFI', desc: 'Mở Partition Wizard: Chia ổ C >= 60GB và ổ D chứa dữ liệu.' },
        { title: 'Bung file Windows 10/11 sạch', desc: 'Cài đặt hệ điều hành sạch không kèm mã độc hoặc phần mềm rác.' },
        { title: 'Cài đặt Driver chuẩn', desc: 'Mở Device Manager kiểm tra không còn dấu chấm than vàng (⚠️).' },
        { title: 'Đo nhiệt độ test tải với HWMonitor', desc: 'Chạy thử tải máy êm ái, nhiệt độ CPU ổn định dưới 75°C.' },
      ],

      crews: [],

      init() {
        this.initCrews();
        this.loadClasses();
        this.loadSaved();
      },

      initCrews() {
        const arr = [];
        for (let i = 1; i <= 10; i++) {
          arr.push({
            id: i,
            name: 'Nhóm KTV ' + i,
            station: i <= 5 ? 1 : 2,
            members: {
              operator: { name: '', role: 'KTV 1 (Thao tác)' },
              safety: { name: '', role: 'KTV 2 (An toàn)' },
              recorder: { name: '', role: 'KTV 3 (Báo cáo)' },
            },
            safetyChecks: {
              rule1_power_discharge: false,
              rule2_thermal_paste: false,
              rule3_cable_ram_seated: false,
            },
            stepsCompleted: [false, false, false, false, false, false, false],
            specs: { cpu: '', ram: '', storage: '', temperature: '' },
            grade: 10.0,
          });
        }
        this.crews = arr;
      },

      openCrewDetail(id) {
        this.activeCrewDetail = this.crews.find(c => c.id === id) || null;
      },

      countStation(st) {
        return this.crews.filter(c => c.station === st).length;
      },

      isSafe(c) {
        if (!c || !c.safetyChecks) return false;
        return c.safetyChecks.rule1_power_discharge &&
               c.safetyChecks.rule2_thermal_paste &&
               c.safetyChecks.rule3_cable_ram_seated;
      },

      countDoneSteps(c) {
        return c?.stepsCompleted?.filter(Boolean).length || 0;
      },

      countDoneWinSteps(c) {
        return c?.stepsCompleted?.slice(0, 5).filter(Boolean).length || 0;
      },

      toggleStation(crewId) {
        const c = this.crews.find(cr => cr.id === crewId);
        if (c) {
          c.station = c.station === 1 ? 2 : 1;
          this.autoSave();
          this.showMsg(`Đã đổi Bàn ${c.id} sang Trạm ${c.station}!`);
        }
      },

      rotateAllStations() {
        this.crews.forEach(c => {
          c.station = c.station === 1 ? 2 : 1;
        });
        this.autoSave();
        this.showMsg('Đã xoay vòng toàn bộ 10 bàn máy!');
      },

      calcGradeTotal() {
        const g = this.tempGrade;
        const total = Number(g.safety) + Number(g.assembly) + Number(g.winInstall) + Number(g.driverTemp) + Number(g.workplace5s);
        return Math.round(total * 10) / 10;
      },

      async loadClasses() {
        try {
          const raw = localStorage.getItem('BMTC_CLASSES');
          if (raw) this.availableClasses = JSON.parse(raw);
          const res = await fetch('/api/classes');
          const data = await res.json();
          if (data && data.ok && Array.isArray(data.data)) {
            this.availableClasses = data.data;
          }
        } catch(e){}

        if (this.availableClasses.length > 0 && !this.selectedClassName) {
          const t = this.availableClasses.find(c => c.class_code === '03THA9' || c.class_name?.includes('03THA9')) || this.availableClasses[0];
          this.selectedClassName = t.class_name;
          this.onClassChange();
        }
      },

      async onClassChange() {
        if (!this.selectedClassName) return;
        try {
          const allStore = JSON.parse(localStorage.getItem('BMTC_STUDENTS') || '{}');
          const tCls = this.availableClasses.find(c => c.class_name === this.selectedClassName || c.class_code === this.selectedClassName);
          if (tCls && allStore[tCls.id]) {
            this.studentsInClass = allStore[tCls.id];
          }
        } catch(e){}

        try {
          const res = await fetch('/api/classes?code=' + encodeURIComponent(this.selectedClassName));
          const data = await res.json();
          if (data && data.ok && Array.isArray(data.data)) {
            this.studentsInClass = data.data;
          }
        } catch(e){}
      },

      autoDistributeCrews() {
        if (!this.studentsInClass || this.studentsInClass.length === 0) {
          alert('Chưa có danh sách học sinh. Vui lòng chọn lớp đã nạp học sinh!');
          return;
        }
        const list = [...this.studentsInClass];
        for (let i = 0; i < 10; i++) {
          const c = this.crews[i];
          c.members.operator.name = list[i * 3]?.full_name || `Học sinh ${i * 3 + 1}`;
          c.members.safety.name = list[i * 3 + 1]?.full_name || `Học sinh ${i * 3 + 2}`;
          c.members.recorder.name = list[i * 3 + 2]?.full_name || `Học sinh ${i * 3 + 3}`;
        }
        this.autoSave();
        this.showMsg('Đã tự động chia 30 học sinh vào 10 nhóm KTV!');
      },

      async saveGradeForBench() {
        const c = this.crews[this.teacherGradeBench - 1];
        if (!c) return;

        const total = this.calcGradeTotal();
        c.grade = total;

        const members = [c.members.operator, c.members.safety, c.members.recorder].filter(m => m && m.name && m.name.trim());
        if (members.length === 0) {
          alert('Bàn này chưa có tên học sinh!');
          return;
        }

        for (const m of members) {
          await fetch('/api/scores', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              className: this.selectedClassName || '03THA9',
              sessionName: `Sát hạch - Bàn ${c.id} (${c.station === 1 ? 'Trạm 1: Tháo lắp' : 'Trạm 2: Cài Win'})`,
              studentName: m.name,
              score: total,
              details: { benchId: c.id, role: m.role, rubric: this.tempGrade, safe: this.isSafe(c) }
            })
          }).catch(() => {});
        }

        this.autoSave();
        this.showMsg(`Đã lưu điểm ${total}đ cho Bàn ${c.id} thành công!`);
      },

      autoSave() {
        try {
          localStorage.setItem('BMTC_WORKSHOP_CREWS', JSON.stringify({
            className: this.selectedClassName,
            crews: this.crews
          }));
        } catch(e){}
      },

      loadSaved() {
        try {
          const raw = localStorage.getItem('BMTC_WORKSHOP_CREWS');
          if (raw) {
            const data = JSON.parse(raw);
            if (data && Array.isArray(data.crews)) {
              this.crews = data.crews;
              if (data.className) this.selectedClassName = data.className;
            }
          }
        } catch(e){}
      },

      showMsg(m) {
        this.toast = m;
        setTimeout(() => { this.toast = ''; }, 2800);
      },

      openPrintA4() {
        const c = this.crews[this.teacherGradeBench - 1] || this.crews[0];
        const w = window.open('', '_blank');
        if (!w) return;
        w.document.write(`
          <!DOCTYPE html>
          <html>
          <head>
            <meta charset="utf-8">
            <title>Phiếu Nghiệm Thu Kỹ Thuật Viên - Bàn ${c.id}</title>
            <style>
              body { font-family: 'Times New Roman', serif; margin: 25mm 20mm; color: #000; font-size: 13pt; line-height: 1.4; }
              .center { text-align: center; }
              table { width: 100%; border-collapse: collapse; margin: 15px 0; }
              th, td { border: 1px solid #000; padding: 6px 10px; }
              th { background: #f5f5f5; }
            </style>
          </head>
          <body>
            <div class="center">
              <h3>BỘ MÔN: ÔN LUYỆN NĂNG LỰC NGHỀ PHẦN CỨNG MÁY TÍNH</h3>
              <h2>PHIẾU NGHIỆM THU KỸ THUẬT VIÊN (CHUẨN TT55)</h2>
              <hr style="width: 200px; margin: 5px auto;">
            </div>
            <p><strong>Lớp:</strong> ${this.selectedClassName || '03THA9'} &nbsp;&nbsp;&nbsp;&nbsp; <strong>Bàn máy:</strong> Số ${c.id} (${c.name})</p>
            <p><strong>Trạm thực hành:</strong> ${c.station === 1 ? 'Trạm 1: Tháo Lắp Cơ Khí' : 'Trạm 2: Cài Win PE & Driver'}</p>
            <p><strong>1. KTV 1 (Thao tác chính):</strong> ${c.members.operator.name || '................................'}</p>
            <p><strong>2. KTV 2 (Kiểm soát an toàn):</strong> ${c.members.safety.name || '................................'}</p>
            <p><strong>3. KTV 3 (Báo cáo kỹ thuật):</strong> ${c.members.recorder.name || '................................'}</p>
            <table>
              <tr><th>Tiêu chí đánh giá</th><th>Điểm tối đa</th><th>Điểm đạt</th></tr>
              <tr><td>5S & An toàn Poka-Yoke 3 điểm dừng</td><td align="center">2.0</td><td align="center">${this.tempGrade.safety}</td></tr>
              <tr><td>Kỹ thuật tháo lắp & Tra keo hạt đậu xanh</td><td align="center">2.0</td><td align="center">${this.tempGrade.assembly}</td></tr>
              <tr><td>Cài WinPE, phân vùng GPT/UEFI sạch</td><td align="center">3.0</td><td align="center">${this.tempGrade.winInstall}</td></tr>
              <tr><td>Driver sạch & Đo nhiệt độ test tải &lt; 75°C</td><td align="center">2.0</td><td align="center">${this.tempGrade.driverTemp}</td></tr>
              <tr><td>Tác phong công nghiệp & Biên bản bàn giao</td><td align="center">1.0</td><td align="center">${this.tempGrade.workplace5s}</td></tr>
              <tr><td align="right"><strong>TỔNG ĐIỂM ĐÁNH GIÁ:</strong></td><td align="center"><strong>10.0</strong></td><td align="center"><strong style="font-size:14pt;">${this.calcGradeTotal()}</strong></td></tr>
            </table>
            <div style="display:flex; justify-content:space-between; margin-top:40px; text-align:center;">
              <div style="width:45%;"><p><strong>ĐẠI DIỆN NHÓM KTV</strong><br><br><br><br>${c.members.operator.name || 'KTV 1'}</p></div>
              <div style="width:45%;"><p><strong>GIẢNG VIÊN HƯỚNG DẪN</strong><br><br><br><br><strong>CN. Phạm Tiến Đồng</strong></p></div>
            </div>
            <div style="text-align:center; margin-top:30px;"><button onclick="window.print()" style="padding:8px 16px; font-weight:bold; cursor:pointer;">IN PHIẾU (CTRL+P)</button></div>
          </body>
          </html>
        `);
        w.document.close();
      },

      async submitAttendance() {
        if (!this.attendanceStudentName.trim()) return;
        await fetch('/api/scores', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            className: this.selectedClassName,
            sessionName: this.attendanceSession,
            studentName: this.attendanceStudentName.trim(),
            score: 10.0,
            details: { type: 'DiemDanhBuoi' }
          })
        }).catch(() => {});
        this.showMsg('Đã ghi nhận điểm danh thành công!');
        this.attendanceStudentName = '';
      }
    }));
  });
</script>
