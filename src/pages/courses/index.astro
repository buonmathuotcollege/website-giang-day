---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CourseCard from '../../components/CourseCard.astro';
import LessonQuickSearch from '../../components/courses/LessonQuickSearch.astro';
import { COURSES } from '../../data/courses';
---

<BaseLayout
  title="Danh Mục Môn Học & Chương Trình Đào Tạo CNTT · CN. Phạm Tiến Đông"
  description="Chương trình 6 môn học cốt lõi CNTT, tài liệu bài giảng điện tử và hệ thống chuyên trang con trực thuộc cổng phamtiendong.name.vn."
>
  <section class="max-w-5xl mx-auto px-4 py-6 sm:py-8 space-y-6">
    <Breadcrumb items={[
      { label: 'Trang chủ', href: '/' },
      { label: 'Danh mục Môn học', href: '' },
    ]} />

    <div class="mt-2 mb-4">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Chương trình Đào tạo Chuyên ngành CNTT</h1>
      <p class="text-slate-600 mt-2 text-xs sm:text-sm leading-relaxed">
        Hệ thống 6 môn học cốt lõi từ cơ bản đến nâng cao, tích hợp cổng tên miền phụ (subdomain) cho từng môn.
      </p>
    </div>

    <!-- THANH TÌM KIẾM NHANH TỪ KHÓA BÀI HỌC -->
    <LessonQuickSearch />

    <!-- 6 MÔN HỌC CỐT LÕI -->
    <div>
      <h2 class="text-lg sm:text-xl font-black text-slate-900 mb-4 flex items-center gap-2">
        <span>📚</span>
        <span>6 Môn Học Nền Tảng Trong Chương Trình</span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {COURSES.map((course) => (
          <CourseCard
            title={course.name}
            slug={course.slug}
            description={course.desc}
            icon={course.icon}
            chapterCount={course.chapters.length}
            subdomain={course.subdomain}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
