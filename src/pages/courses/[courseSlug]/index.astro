---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { COURSES } from '../../../data/courses';
import {
  HARDWARE_METADATA,
  THREE_SURVIVAL_RULES,
  THREE_SAFETY_CHECKPOINTS,
  FIVE_CLASSIC_CASES,
  LEGO_PARTS,
  FOUR_WIRES,
} from '../../../data/hardwareCurriculum';

export const prerender = true;

export function getStaticPaths() {
  return COURSES.map((course) => ({
    params: { courseSlug: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props;
const isHardware = course.slug === 'phan-cung-may-tinh';
---

<BaseLayout title={`${course.name} - Cổng Giảng Dạy CNTT`}>
  <section class="max-w-5xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { label: 'Trang chủ', href: '/' },
      { label: 'Môn học', href: '/courses' },
      { label: course.name, href: '' },
    ]} />

    <!-- Main Course Header -->
    <div class="mt-6 mb-8 bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div class="flex items-center gap-4">
          <span class="text-5xl">{course.icon}</span>
          <div>
            <span class="inline-block px-3 py-0.5 bg-primary-100 text-primary-800 text-xs font-bold rounded-full uppercase tracking-wider mb-1">
              {isHardware ? 'Môn thi tay nghề trọng điểm' : 'Môn học chuyên ngành'}
            </span>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900">{course.name}</h1>
            <p class="text-xs text-primary-700 font-mono mt-0.5">🌐 Tên miền phụ: {course.subdomain}.phamtiendong.name.vn</p>
          </div>
        </div>

        {isHardware && (
          <div class="flex flex-col sm:items-end gap-2">
            <a href="/assessment/phan-cung" class="btn-primary text-sm px-5 py-2.5 shadow-md flex items-center gap-2 text-center justify-center font-bold">
              <span>⚡ Mở Mô phỏng Đánh giá Tay nghề</span>
              <span>→</span>
            </a>
            <span class="text-[11px] text-gray-500 font-mono text-center sm:text-right">Rubric 10đ · Chuẩn Thông tư 55</span>
          </div>
        )}
      </div>

      <p class="text-gray-600 text-sm sm:text-base leading-relaxed">{course.desc}</p>

      {isHardware && (
        <div class="mt-4 pt-4 border-t border-gray-100 flex flex-wrap items-center gap-4 text-xs text-gray-600">
          <div><strong class="text-gray-900">Giảng viên huấn luyện:</strong> {HARDWARE_METADATA.teacher}</div>
          <div class="hidden sm:inline">•</div>
          <div><strong class="text-gray-900">Đơn vị:</strong> {HARDWARE_METADATA.institution}</div>
          <div class="hidden sm:inline">•</div>
          <div><strong class="text-gray-900">Chuẩn đầu ra:</strong> {HARDWARE_METADATA.standard}</div>
        </div>
      )}
    </div>

    {isHardware ? (
      <!-- SPECIAL PRACTICAL WORKSHOP PORTAL FOR HARDWARE -->
      <div class="space-y-8 mb-10">
        <!-- Mentor Advice Banner -->
        <div class="bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200 rounded-2xl p-6">
          <div class="flex items-start gap-4">
            <span class="text-3xl">👨‍🏫</span>
            <div>
              <h3 class="text-base font-bold text-amber-900 uppercase tracking-wide">
                Lời dặn cốt lõi dành cho Kỹ thuật viên:
              </h3>
              <p class="text-sm text-amber-800 mt-2 leading-relaxed">
                "Đừng sợ cái thùng máy tính! Người ngoài nhìn vào thùng máy thấy lắm dây nhợ thì hoang mang, nhưng với kỹ thuật viên, máy tính chỉ như <strong>bộ đồ chơi Lego với đúng 5 món đồ lớn ghép lại</strong>. Nhà sản xuất đã làm sẵn các 'rãnh khuyết' và khuôn cắm chống ngược chiều. Cắm đúng thì ấn nhẹ tay là sập khóa; thấy cấn tay tức là ngược chiều — chỉ cần xoay lại, tuyệt đối không dùng bạo lực!"
              </p>
              <div class="mt-3 flex flex-wrap gap-2 text-xs font-semibold text-amber-900">
                <span class="bg-amber-100 px-2.5 py-1 rounded-md">Quy trình 7 bước: NHẬN – CỨU – BẮT – SẠCH – CÀI – THỬ – GIAO</span>
                <span class="bg-amber-100 px-2.5 py-1 rounded-md">3 Luật sống còn</span>
                <span class="bg-amber-100 px-2.5 py-1 rounded-md">3 Điểm dừng an toàn</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 3 Survival Rules -->
        <div>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-bold text-gray-900 flex items-center gap-2">
              <span>🚨</span>
              <span>3 Luật An Toàn Sống Còn (Không Được Vi Phạm)</span>
            </h2>
            <span class="text-xs text-red-600 font-semibold bg-red-50 border border-red-200 px-2.5 py-1 rounded-full">
              Vi phạm = 0đ An toàn khi sát hạch
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {THREE_SURVIVAL_RULES.map((rule, idx) => (
              <div class="bg-white border-2 border-red-200 hover:border-red-400 rounded-xl p-5 shadow-sm flex flex-col justify-between transition-colors">
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-bold font-mono text-red-700 bg-red-50 px-2 py-0.5 rounded">
                      QUY TẮC #0{idx + 1}
                    </span>
                    <span class="text-lg">⚡</span>
                  </div>
                  <h3 class="font-bold text-gray-900 text-base mb-1">{rule.name}</h3>
                  <p class="text-xs text-primary-700 font-medium mb-3">{rule.tagline}</p>
                  <p class="text-xs text-gray-600 leading-relaxed">{rule.detail}</p>
                </div>
                <div class="mt-4 pt-3 border-t border-red-100">
                  <p class="text-[11px] text-red-700 font-medium">⚠️ {rule.danger}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- 3 Safety Checkpoints -->
        <div>
          <h2 class="text-xl font-bold text-gray-900 flex items-center gap-2 mb-4">
            <span>🛑</span>
            <span>3 Điểm Dừng An Toàn (Giáo viên bắt buộc ký duyệt tại bàn)</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {THREE_SAFETY_CHECKPOINTS.map((cp) => (
              <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
                <div class="flex items-center gap-2 mb-2">
                  <span class="w-6 h-6 rounded-full bg-blue-100 text-blue-800 text-xs font-bold flex items-center justify-center">
                    {cp.step}
                  </span>
                  <h3 class="text-xs font-bold text-gray-900">{cp.name}</h3>
                </div>
                <p class="text-xs text-gray-500 font-medium mb-2 italic">Thời điểm: {cp.rule}</p>
                <p class="text-xs text-gray-700 leading-relaxed mb-3">{cp.condition}</p>
                <div class="bg-gray-50 p-2.5 rounded-lg border border-gray-100 text-[11px] text-gray-600">
                  ✍️ <strong>Ký duyệt:</strong> {cp.signoff}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- 5 Classic Cases Quick Reference -->
        <div>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-bold text-gray-900 flex items-center gap-2">
              <span>🩺</span>
              <span>5 Ca Bệnh Thực Tế Chiếm 85% Sự Cố Tại Xưởng</span>
            </h2>
            <span class="text-xs text-gray-500 font-mono">Quy trình chẩn đoán 60 giây</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {FIVE_CLASSIC_CASES.map((cs) => (
              <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm hover:shadow transition-shadow">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="text-xs font-bold px-2 py-0.5 bg-blue-50 text-blue-700 rounded font-mono">{cs.code}</span>
                  <span class="text-[11px] text-gray-500 font-medium">Dụng cụ: {cs.tool}</span>
                </div>
                <h3 class="text-sm font-bold text-gray-900 mb-1.5">{cs.name}</h3>
                <div class="text-xs space-y-1 text-gray-600">
                  <p><strong class="text-gray-800">Triệu chứng:</strong> {cs.symptom}</p>
                  <p><strong class="text-gray-800">Gốc bệnh:</strong> {cs.cause}</p>
                  <p class="text-primary-800 font-medium"><strong class="text-gray-800">Cách xử lý:</strong> {cs.action}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Lego Model: 5 Parts & 4 Wires -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
          <h2 class="text-xl font-bold text-gray-900 flex items-center gap-2 mb-2">
            <span>🧩</span>
            <span>Mô Hình Lego: 5 Món Đồ Lớn & 4 Sợi Dây Nguồn</span>
          </h2>
          <p class="text-xs text-gray-500 mb-4">Mở thùng máy ra, chỉ cần quan sát đúng 5 bộ phận và 4 sợi dây cơ bản này là làm chủ toàn bộ cỗ máy.</p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <h3 class="text-sm font-bold text-gray-800 mb-2 uppercase tracking-wide text-primary-700">5 Món Lớn Trong Máy</h3>
              <div class="space-y-2">
                {LEGO_PARTS.map((p) => (
                  <div class="p-2.5 rounded-lg border border-gray-100 bg-gray-50 text-xs">
                    <div class="flex justify-between font-bold text-gray-900 mb-0.5">
                      <span>{p.name}</span>
                      <span class="text-primary-700 font-normal italic">({p.metaphor})</span>
                    </div>
                    <p class="text-gray-600 text-[11px]">{p.note}</p>
                  </div>
                ))}
              </div>
            </div>

            <div>
              <h3 class="text-sm font-bold text-gray-800 mb-2 uppercase tracking-wide text-primary-700">4 Sợi Dây Nguồn Cần Nhớ</h3>
              <div class="space-y-2">
                {FOUR_WIRES.map((w) => (
                  <div class="p-2.5 rounded-lg border border-gray-100 bg-gray-50 text-xs">
                    <span class="font-bold text-gray-900 block mb-0.5">{w.wire}</span>
                    <p class="text-gray-600 text-[11px]">{w.to}</p>
                  </div>
                ))}
              </div>

              <!-- Quick action box -->
              <div class="mt-4 p-4 rounded-xl bg-primary-50 border border-primary-200 text-center">
                <p class="text-xs text-primary-900 font-semibold mb-2">Sẵn sàng bước vào ca làm việc thực tế tại xưởng?</p>
                <a href="/assessment/phan-cung" class="btn-primary text-xs px-4 py-2 inline-flex items-center gap-1.5 font-bold">
                  <span>⚡ Làm bài mô phỏng sát hạch nghề 10 điểm</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Question Bank Showcase Banner -->
        <div class="bg-gradient-to-r from-primary-900 to-indigo-950 text-white rounded-2xl p-6 sm:p-8 shadow-md">
          <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-5">
            <div>
              <span class="inline-block px-3 py-1 bg-white/20 text-white text-xs font-mono font-bold rounded-full mb-2">
                HỆ THỐNG ĐÁNH GIÁ NĂNG LỰC TOÀN DIỆN
              </span>
              <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight">
                Ngân Hàng Đề Thi, Câu Hỏi Tình Huống & Vấn Đáp Thực Chiến
              </h2>
              <p class="text-xs sm:text-sm text-primary-200 mt-1 max-w-2xl leading-relaxed">
                Hệ thống đề thi cá nhân hóa: <strong>100 câu hỏi trắc nghiệm tình huống</strong>, <strong>20 câu hỏi vấn đáp tại bàn máy</strong>, <strong>12 tình huống lắp ráp & cài Win thực tế</strong> và <strong>6 Ca bệnh chẩn đoán độc lập</strong> giúp mỗi học sinh khi vào thi đều nhận một bộ đề riêng biệt!
              </p>
            </div>

            <div class="flex flex-col sm:flex-row gap-2.5 w-full md:w-auto">
              <a href="/assessment/phan-cung" class="px-5 py-3 bg-accent-500 hover:bg-accent-600 text-white font-bold rounded-xl text-xs text-center transition-all shadow-md">
                ⚡ Vào Phòng Thi Sát Hạch
              </a>
            </div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6 pt-5 border-t border-white/10 text-center">
            <div class="bg-white/10 p-3 rounded-xl border border-white/10">
              <span class="text-2xl font-extrabold block font-mono text-amber-300">100 Câu</span>
              <span class="text-[11px] text-white/80">Trắc nghiệm tình huống</span>
            </div>
            <div class="bg-white/10 p-3 rounded-xl border border-white/10">
              <span class="text-2xl font-extrabold block font-mono text-emerald-300">20 Câu</span>
              <span class="text-[11px] text-white/80">Vấn đáp tại bàn máy</span>
            </div>
            <div class="bg-white/10 p-3 rounded-xl border border-white/10">
              <span class="text-2xl font-extrabold block font-mono text-sky-300">12 Ca</span>
              <span class="text-[11px] text-white/80">Lắp ráp & Cài Win</span>
            </div>
            <div class="bg-white/10 p-3 rounded-xl border border-white/10">
              <span class="text-2xl font-extrabold block font-mono text-purple-300">6 Đề</span>
              <span class="text-[11px] text-white/80">Ca bệnh xưởng A-Z</span>
            </div>
          </div>
        </div>

        <!-- 8 Practical Chapters -->
        <div>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-bold text-gray-900">
              Chi tiết 8 Bài Học Thực Chiến (Theo Quy Trình 7 Bước)
            </h2>
            <span class="text-xs text-gray-500 font-mono">36-40 giờ thực hành</span>
          </div>

          <ol class="space-y-3">
            {course.chapters.map((ch, idx) => (
              <li>
                <a href={`/courses/${course.slug}/${ch.slug}`} class="card flex items-start gap-4 no-underline group hover:border-primary-400">
                  <span class="flex-shrink-0 w-11 h-11 rounded-xl bg-primary-100 text-primary-800 font-bold flex items-center justify-center text-sm group-hover:bg-primary-600 group-hover:text-white transition-colors">
                    {idx + 1}
                  </span>
                  <div class="flex-1">
                    <h3 class="text-base font-bold text-gray-900 group-hover:text-primary-700 transition-colors">{ch.title}</h3>
                    <p class="text-sm text-gray-500 mt-1 leading-relaxed">{ch.description}</p>
                  </div>
                  <span class="text-gray-400 group-hover:text-primary-600 text-sm font-semibold self-center whitespace-nowrap">
                    Xem bài học →
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    ) : (
      <!-- STANDARD COURSE VIEW FOR OTHER 5 COURSES -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-bold text-gray-900">Nội dung chương trình ({course.chapters.length} chương)</h2>
          <a href="/assessment" class="text-xs sm:text-sm font-semibold text-primary-700 hover:underline">
            Làm bài kiểm tra môn này →
          </a>
        </div>

        <ol class="space-y-3">
          {course.chapters.map((ch, idx) => (
            <li>
              <a href={`/courses/${course.slug}/${ch.slug}`} class="card flex items-start gap-4 no-underline group hover:border-primary-400">
                <span class="flex-shrink-0 w-10 h-10 rounded-xl bg-primary-100 text-primary-800 font-bold flex items-center justify-center text-sm group-hover:bg-primary-600 group-hover:text-white transition-colors">
                  {idx + 1}
                </span>
                <div class="flex-1">
                  <h3 class="text-base font-bold text-gray-900 group-hover:text-primary-700 transition-colors">{ch.title}</h3>
                  <p class="text-sm text-gray-500 mt-0.5">{ch.description}</p>
                </div>
                <span class="text-gray-400 group-hover:text-primary-600 text-sm font-semibold self-center">
                  Vào học →
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    )}
  </section>
</BaseLayout>
