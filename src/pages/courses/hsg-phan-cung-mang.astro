---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HsgHardwareNetworkMaster from '../../components/courses/HsgHardwareNetworkMaster.astro';

export const prerender = true;

const title = "Thi Học Sinh Giỏi Phần Cứng & Mạng (Bồi Dưỡng Đội Tuyển HSG)";
const description = "Chuyên đề 02 bồi dưỡng đội tuyển HSG cấp trường: Luyện phản xạ Subnetting 30 giây Magic Number, ngân hàng 54 câu hỏi vận dụng cao và Sa bàn mô phỏng dự án thi công trọn gói 180 - 240 phút.";
---

<BaseLayout title={title} description={description}>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
    <div class="mb-4">
      <Breadcrumb items={[
        { label: 'Trang chủ', href: '/' },
        { label: 'Luyện thi HSG', href: '/assessment/hsg' },
        { label: 'Chuyên đề 02 (HSG Phần Cứng & Mạng)', href: '/courses/hsg-phan-cung-mang' },
      ]} />
    </div>

    <HsgHardwareNetworkMaster />
  </main>
</BaseLayout>
