---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Bảng điểm Thực hành - Quản trị Giảng viên">
  <section class="max-w-6xl mx-auto px-4 py-8" x-data="{
    scores: [],
    loading: true,
    filterClass: '',
    async fetchScores() {
      this.loading = true;
      try {
        const url = this.filterClass ? `/api/scores?class=${encodeURIComponent(this.filterClass)}` : '/api/scores';
        const res = await fetch(url);
        const data = await res.json();
        this.scores = data.data || [];
      } catch (e) {
        this.scores = [];
      } finally {
        this.loading = false;
      }
    },
    exportCSV() {
      if (!this.scores.length) return alert('Không có dữ liệu để xuất');
      let csv = 'STT,Ngay,Lop,Buoi,So may,Ho ten,Diem,Trang thai\n';
      this.scores.forEach((s, idx) => {
        csv += `${idx + 1},${s.date_only || ''},${s.class_name || ''},${s.session_name || ''},${s.station || ''},'${s.student_name || ''}',${s.score || 0},${s.status || ''}\n`;
      });
      const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = `BangDiem_${new Date().toISOString().slice(0,10)}.csv`;
      link.click();
    }
  }" x-init="fetchScores()">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
          <a href="/admin" class="hover:underline">Quản trị</a>
          <span>/</span>
          <span class="text-gray-900 font-medium">Bảng điểm</span>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">Bảng điểm Thực hành & Đánh giá</h1>
      </div>
      <div class="flex gap-2">
        <button @click="fetchScores()" class="btn-secondary text-sm">🔄 Làm mới</button>
        <button @click="exportCSV()" class="btn-primary text-sm bg-green-600 hover:bg-green-700">📥 Xuất file Excel (CSV)</button>
      </div>
    </div>

    <!-- Filter Bar -->
    <div class="card mb-6 flex flex-wrap items-center gap-4 py-3">
      <div class="flex items-center gap-2">
        <label for="filter-class" class="text-xs font-semibold text-gray-600 uppercase">Lọc theo lớp:</label>
        <select id="filter-class" x-model="filterClass" @change="fetchScores()" class="border border-gray-300 rounded-lg px-3 py-1.5 text-sm">
          <option value="">-- Tất cả các lớp --</option>
          <option value="Tin học ứng dụng K26A">Tin học ứng dụng K26A</option>
          <option value="Tin học ứng dụng K26B">Tin học ứng dụng K26B</option>
          <option value="Quản trị mạng K26">Quản trị mạng K26</option>
        </select>
      </div>
      <span class="text-xs text-gray-500" x-text="`Tổng số bản ghi: ${scores.length}`"></span>
    </div>

    <!-- Table -->
    <div class="card overflow-x-auto p-0">
      <table class="w-full text-left text-sm border-collapse">
        <thead class="bg-gray-100 text-gray-700 font-semibold border-b border-gray-200">
          <tr>
            <th class="p-3 text-center w-12">#</th>
            <th class="p-3">Ngày</th>
            <th class="p-3">Lớp</th>
            <th class="p-3">Buổi học / Bài</th>
            <th class="p-3 text-center">Máy</th>
            <th class="p-3">Họ và tên</th>
            <th class="p-3 text-center">Điểm</th>
            <th class="p-3 text-center">Trạng thái</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <template x-if="loading">
            <tr>
              <td colspan="8" class="p-6 text-center text-gray-500">Đang tải dữ liệu bảng điểm...</td>
            </tr>
          </template>
          <template x-if="!loading && scores.length === 0">
            <tr>
              <td colspan="8" class="p-8 text-center text-gray-500">
                Chưa có dữ liệu bài nộp nào.
              </td>
            </tr>
          </template>
          <template x-for="(item, index) in scores" :key="item.id || index">
            <tr class="hover:bg-gray-50">
              <td class="p-3 text-center text-gray-500" x-text="index + 1"></td>
              <td class="p-3 text-gray-600 text-xs" x-text="item.date_only || '-'"></td>
              <td class="p-3 font-medium text-gray-900" x-text="item.class_name || item.className || '-'"></td>
              <td class="p-3 text-gray-700" x-text="item.session_name || item.sessionName || '-'"></td>
              <td class="p-3 text-center text-gray-600" x-text="item.station || '-'"></td>
              <td class="p-3 font-semibold text-gray-900" x-text="item.student_name || item.studentName || '-'"></td>
              <td class="p-3 text-center font-bold text-primary-700" x-text="item.score ?? 10"></td>
              <td class="p-3 text-center">
                <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold"
                  :class="(item.status === 'Đạt' || item.status === 'ĐẠT') ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800'"
                  x-text="item.status || 'Đạt'">
                </span>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
