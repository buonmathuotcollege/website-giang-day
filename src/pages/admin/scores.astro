---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Bảng điểm Thực hành & Đánh giá Năng lực - Quản trị Giảng viên">
  <section class="max-w-6xl mx-auto px-4 py-8" x-data="scoresManager">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 border-b border-gray-200 pb-5">
      <div>
        <div class="flex items-center gap-2 text-xs text-gray-500 mb-1">
          <a href="/admin" class="hover:underline text-primary-700 font-semibold">Bảng điều khiển Giảng viên</a>
          <span>/</span>
          <a href="/admin/classes" class="hover:underline text-primary-700 font-semibold">Lớp học</a>
          <span>/</span>
          <span class="text-gray-900 font-medium">Bảng điểm & Sát hạch</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight flex items-center gap-2.5">
          <span>📊</span>
          <span>Bảng Điểm Thực Hành & Đánh Giá Năng Lực</span>
        </h1>
        <p class="text-xs sm:text-sm text-gray-500 mt-1">
          Đồng bộ tự động từ Cloudflare D1 · Hỗ trợ <strong>Lớp chính khóa & Lớp ghép liên lớp</strong> · Tách bảng điểm theo Lớp gốc
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 self-start sm:self-center">
        <button
          type="button"
          @click="fetchScores()"
          class="btn-secondary text-xs sm:text-sm px-3.5 py-2 font-bold flex items-center gap-1.5"
        >
          <span>🔄</span>
          <span>Làm mới</span>
        </button>

        <button
          type="button"
          @click="exportCSV()"
          class="btn-primary text-xs sm:text-sm px-4 py-2 font-bold bg-emerald-600 hover:bg-emerald-700 shadow-sm flex items-center gap-1.5"
        >
          <span>📥</span>
          <span>Xuất Excel (CSV)</span>
        </button>

        <button
          type="button"
          @click="exportByOriginalClass()"
          x-show="hasCompositeRecords"
          class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold bg-purple-700 hover:bg-purple-800 text-white shadow-sm flex items-center gap-1.5 transition-all"
          title="Tự động chia tách bảng điểm theo từng lớp sinh hoạt gốc để nộp về phòng Đào tạo"
        >
          <span>📑</span>
          <span>Tách Theo Lớp Gốc</span>
        </button>
      </div>
    </div>

    <!-- Filter & Stats Bar -->
    <div class="card p-4 mb-6 space-y-3">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <!-- Lọc theo Lớp thi / Ca ghép -->
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Lớp thi / Ca sát hạch:</label>
          <select
            x-model="filterClass"
            @change="fetchScores()"
            class="w-full border border-gray-300 rounded-xl px-3 py-1.5 text-xs font-semibold focus:ring-2 focus:ring-primary-500 bg-white"
          >
            <option value="">-- Tất cả các lớp / ca thi --</option>
            <template x-for="c in availableClasses" :key="c.id || c.class_code">
              <option :value="c.class_name" x-text="(c.is_composite ? '🔗 [Ghép] ' : '🏫 ') + c.class_name"></option>
            </template>
          </select>
        </div>

        <!-- Lọc theo Lớp gốc (Dành cho lớp ghép) -->
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Lớp gốc (Lớp sinh hoạt):</label>
          <select
            x-model="filterOriginalClass"
            class="w-full border border-gray-300 rounded-xl px-3 py-1.5 text-xs font-semibold focus:ring-2 focus:ring-primary-500 bg-white"
          >
            <option value="">-- Tất cả các lớp gốc --</option>
            <template x-for="orig in uniqueOriginalClasses" :key="orig">
              <option :value="orig" x-text="orig"></option>
            </template>
          </select>
        </div>

        <!-- Tìm kiếm theo MSHS hoặc Họ tên -->
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Tìm MSHS hoặc Họ tên:</label>
          <input
            type="text"
            x-model="searchQuery"
            placeholder="Gõ tên hoặc MSHS..."
            class="w-full border border-gray-300 rounded-xl px-3 py-1.5 text-xs focus:ring-2 focus:ring-primary-500 bg-white"
          />
        </div>
      </div>

      <!-- Quick Summary Badges -->
      <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-gray-100 text-xs">
        <div class="flex items-center gap-3 text-gray-600">
          <span>Tổng số bài nộp: <strong class="text-gray-900 font-mono" x-text="filteredScores.length"></strong></span>
          <span>·</span>
          <span>Đạt: <strong class="text-emerald-700 font-mono" x-text="filteredScores.filter(s => (s.score || 0) >= 5.0).length"></strong></span>
          <span>·</span>
          <span>Cần rèn luyện: <strong class="text-rose-700 font-mono" x-text="filteredScores.filter(s => (s.score || 0) < 5.0).length"></strong></span>
        </div>

        <span class="text-[11px] text-gray-400 font-mono">Dữ liệu thời gian thực Cloudflare D1</span>
      </div>
    </div>

    <!-- Main Table -->
    <div class="card overflow-x-auto p-0 shadow-sm border border-gray-200 rounded-2xl">
      <table class="w-full text-left text-xs border-collapse">
        <thead class="bg-gray-100 text-gray-700 uppercase font-mono border-b border-gray-200">
          <tr>
            <th class="p-3 text-center w-12">#</th>
            <th class="p-3 w-24">Ngày</th>
            <th class="p-3">Lớp thi / Ca ghép</th>
            <th class="p-3 w-28">Lớp gốc</th>
            <th class="p-3 w-28">MSHS</th>
            <th class="p-3">Họ và tên học sinh</th>
            <th class="p-3">Bài sát hạch / Buổi học</th>
            <th class="p-3 text-center w-24">Bàn máy</th>
            <th class="p-3 text-center w-16">Điểm</th>
            <th class="p-3 text-center w-24">Trạng thái</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <template x-if="loading">
            <tr>
              <td colspan="10" class="p-8 text-center text-gray-400">
                Đang tải dữ liệu điểm từ Cloudflare D1...
              </td>
            </tr>
          </template>

          <template x-if="!loading && filteredScores.length === 0">
            <tr>
              <td colspan="10" class="p-10 text-center text-gray-500 space-y-2">
                <span class="text-3xl block">📋</span>
                <p class="font-bold text-gray-700">Chưa có kết quả nộp bài nào phù hợp</p>
                <p class="text-xs text-gray-400">Khi sinh viên làm bài kiểm tra hoặc sát hạch, điểm số sẽ xuất hiện ngay tại đây.</p>
              </td>
            </tr>
          </template>

          <template x-for="(item, index) in filteredScores" :key="item.id || index">
            <tr class="hover:bg-blue-50/40 transition-colors">
              <td class="p-3 text-center font-mono text-gray-500" x-text="index + 1"></td>
              <td class="p-3 font-mono text-gray-600" x-text="item.date_only || '-'"></td>
              <td class="p-3 font-semibold text-gray-900">
                <span x-text="item.class_name || item.className || '-'"></span>
              </td>
              <td class="p-3">
                <span
                  class="px-2 py-0.5 rounded font-mono font-bold text-[11px]"
                  :class="item.original_class ? 'bg-purple-100 text-purple-900 border border-purple-200' : 'text-gray-400'"
                  x-text="item.original_class || extractOriginalClass(item) || '-'"
                ></span>
              </td>
              <td class="p-3 font-mono font-bold text-primary-700" x-text="item.student_code || extractMSHS(item) || '-'"></td>
              <td class="p-3 font-bold text-gray-900" x-text="cleanStudentName(item)"></td>
              <td class="p-3 text-gray-700" x-text="item.session_name || item.sessionName || '-'"></td>
              <td class="p-3 text-center font-mono text-gray-600" x-text="item.station || '-'"></td>
              <td class="p-3 text-center font-bold text-sm" :class="(item.score ?? 10) >= 5 ? 'text-primary-700' : 'text-rose-600'" x-text="item.score ?? 10"></td>
              <td class="p-3 text-center">
                <span
                  class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold"
                  :class="((item.score ?? 10) >= 5.0 || item.status === 'Đạt' || item.status === 'ĐẠT') ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'"
                  x-text="item.status || ((item.score ?? 10) >= 5 ? 'Đạt' : 'Cần rèn luyện')"
                ></span>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  document.addEventListener('alpine:init', () => {
    Alpine.data('scoresManager', () => ({
      scores: [],
      availableClasses: [],
      loading: true,
      filterClass: '',
      filterOriginalClass: '',
      searchQuery: '',

      init() {
        const urlParams = new URLSearchParams(window.location.search);
        const classParam = urlParams.get('class');
        if (classParam) {
          this.filterClass = classParam;
        }
        this.fetchClasses();
        this.fetchScores();
      },

      async fetchClasses() {
        try {
          const res = await fetch('/api/classes');
          const data = await res.json();
          this.availableClasses = data.data || [];
        } catch (e) {
          this.availableClasses = [];
        }
      },

      async fetchScores() {
        this.loading = true;
        try {
          const url = this.filterClass ? `/api/scores?class=${encodeURIComponent(this.filterClass)}` : '/api/scores';
          const res = await fetch(url);
          const data = await res.json();
          this.scores = data.data || [];
        } catch (e) {
          this.scores = [];
        } finally {
          this.loading = false;
        }
      },

      get hasCompositeRecords() {
        return this.scores.some(s => s.original_class || (s.class_name && s.class_name.toLowerCase().includes('ghép')));
      },

      get uniqueOriginalClasses() {
        const set = new Set();
        this.scores.forEach(s => {
          const orig = s.original_class || this.extractOriginalClass(s);
          if (orig && orig !== '-') set.add(orig);
        });
        return Array.from(set);
      },

      get filteredScores() {
        const q = (this.searchQuery || '').trim().toLowerCase();
        const origFilter = (this.filterOriginalClass || '').trim();

        return this.scores.filter(item => {
          const orig = item.original_class || this.extractOriginalClass(item) || '';
          if (origFilter && orig !== origFilter) {
            return false;
          }
          if (!q) return true;

          const rawName = (item.student_name || item.studentName || '').toLowerCase();
          const code = (item.student_code || this.extractMSHS(item) || '').toLowerCase();
          const sess = (item.session_name || item.sessionName || '').toLowerCase();
          return rawName.includes(q) || code.includes(q) || sess.includes(q) || orig.toLowerCase().includes(q);
        });
      },

      extractMSHS(item) {
        if (item.student_code) return item.student_code;
        const name = item.student_name || item.studentName || '';
        const match = name.match(/\[([A-Za-z0-9_\-]+)\]/);
        return match ? match[1] : '';
      },

      extractOriginalClass(item) {
        if (item.original_class) return item.original_class;
        const name = item.student_name || item.studentName || '';
        const match = name.match(/\(Lớp gốc:\s*([^\)]+)\)/i);
        return match ? match[1].trim() : '';
      },

      cleanStudentName(item) {
        let name = item.student_name || item.studentName || '-';
        name = name.replace(/\[[A-Za-z0-9_\-]+\]/, '').replace(/\(Lớp gốc:[^\)]+\)/i, '').trim();
        return name || '-';
      },

      exportCSV() {
        if (!this.filteredScores.length) return alert('Không có dữ liệu để xuất!');
        const headers = ['STT', 'Ngay', 'Lop_Thi_Ghep', 'Lop_Goc', 'MSHS', 'Ho_Va_Ten', 'Bai_Sat_Hach', 'Ban_May', 'Diem', 'Trang_Thai'];
        const rows = this.filteredScores.map((s, idx) => [
          idx + 1,
          `"${s.date_only || ''}"`,
          `"${s.class_name || s.className || ''}"`,
          `"${s.original_class || this.extractOriginalClass(s) || ''}"`,
          `"${s.student_code || this.extractMSHS(s) || ''}"`,
          `"${this.cleanStudentName(s)}"`,
          `"${s.session_name || s.sessionName || ''}"`,
          `"${s.station || ''}"`,
          s.score ?? 10,
          `"${s.status || ((s.score ?? 10) >= 5 ? 'Đạt' : 'Cần rèn luyện')}"`
        ]);

        const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\r\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        const filename = `BangDiem_${(this.filterClass ? this.filterClass.replace(/[^A-Za-z0-9]/g, '_') : 'TatCa')}_${new Date().toISOString().slice(0, 10)}.csv`;
        link.href = URL.createObjectURL(blob);
        link.download = filename;
        link.click();
      },

      // Tự động tách bảng điểm theo từng Lớp gốc
      exportByOriginalClass() {
        const groups = {};
        this.scores.forEach(s => {
          const orig = s.original_class || this.extractOriginalClass(s) || s.class_name || 'LopChung';
          if (!groups[orig]) groups[orig] = [];
          groups[orig].push(s);
        });

        const origKeys = Object.keys(groups);
        if (origKeys.length === 0) return alert('Không tìm thấy thông tin Lớp gốc để chia tách!');

        origKeys.forEach(origClass => {
          const list = groups[origClass];
          const headers = ['STT', 'MSHS', 'Ho_Va_Ten', 'Lop_Goc', 'Ca_Sat_Hach', 'Ngay', 'Diem', 'Trang_Thai'];
          const rows = list.map((s, idx) => [
            idx + 1,
            `"${s.student_code || this.extractMSHS(s) || ''}"`,
            `"${this.cleanStudentName(s)}"`,
            `"${origClass}"`,
            `"${s.class_name || ''}"`,
            `"${s.date_only || ''}"`,
            s.score ?? 10,
            `"${s.status || 'Đạt'}"`
          ]);

          const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\r\n');
          const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
          const link = document.createElement('a');
          link.href = URL.createObjectURL(blob);
          link.download = `BangDiem_LopGoc_${origClass.replace(/[^A-Za-z0-9]/g, '_')}_${new Date().toISOString().slice(0, 10)}.csv`;
          link.click();
        });

        alert(`✅ Đã xuất riêng ${origKeys.length} file bảng điểm theo từng Lớp sinh hoạt gốc!`);
      }
    }));
  });
</script>
