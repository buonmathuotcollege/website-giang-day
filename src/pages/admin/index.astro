---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Trang quản trị - Cổng Giảng Dạy CNTT">
  <section class="max-w-4xl mx-auto px-4 py-10" x-data="{ loggedIn: false, secret: '' }">
    <!-- Login form -->
    <div x-show="!loggedIn" class="max-w-sm mx-auto">
      <div class="text-center mb-8">
        <span class="text-5xl mb-3 block">🔐</span>
        <h1 class="text-2xl font-bold mb-1">Trang quản trị Giảng viên</h1>
        <p class="text-gray-500 text-sm">Nhập mã bí mật để đăng nhập</p>
      </div>
      <form @submit.prevent="if (secret.trim()) loggedIn = true" class="card space-y-4">
        <div>
          <label for="secret-code" class="block text-sm font-semibold text-gray-700 mb-1">Mã bí mật</label>
          <input id="secret-code" type="password" x-model="secret" required placeholder="Nhập mã bí mật"
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
        </div>
        <button type="submit" class="btn-primary w-full">Đăng nhập</button>
      </form>
    </div>

    <!-- Dashboard -->
    <div x-show="loggedIn" x-cloak>
      <div class="flex items-center justify-between mb-8">
        <h1 class="text-2xl font-bold">Trang quản trị Giảng viên</h1>
        <button @click="loggedIn = false; secret = ''" class="btn-secondary text-sm">Đăng xuất</button>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-8">
        <div class="card text-center">
          <p class="text-3xl font-bold text-primary-700">4</p>
          <p class="text-sm text-gray-500 mt-1">Số lớp</p>
        </div>
        <div class="card text-center">
          <p class="text-3xl font-bold text-green-600">128</p>
          <p class="text-sm text-gray-500 mt-1">Số học sinh</p>
        </div>
        <div class="card text-center">
          <p class="text-3xl font-bold text-orange-500">15</p>
          <p class="text-sm text-gray-500 mt-1">Bài nộp hôm nay</p>
        </div>
      </div>

      <!-- Quick links -->
      <h2 class="mb-4">Chức năng</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href="/admin/classes" class="card flex items-center gap-3 no-underline">
          <span class="text-2xl">📋</span>
          <div>
            <h3 class="font-semibold text-gray-900">Quản lý lớp</h3>
            <p class="text-xs text-gray-500">Xem danh sách lớp, thêm/sửa/xóa lớp</p>
          </div>
        </a>
        <a href="/admin/scores" class="card flex items-center gap-3 no-underline">
          <span class="text-2xl">📊</span>
          <div>
            <h3 class="font-semibold text-gray-900">Bảng điểm</h3>
            <p class="text-xs text-gray-500">Xem và xuất bảng điểm các lớp</p>
          </div>
        </a>
        <a href="/admin/content" class="card flex items-center gap-3 no-underline">
          <span class="text-2xl">📝</span>
          <div>
            <h3 class="font-semibold text-gray-900">Nội dung bài giảng</h3>
            <p class="text-xs text-gray-500">Quản lý nội dung môn học và bài tập</p>
          </div>
        </a>
        <a href="/admin/assessments" class="card flex items-center gap-3 no-underline">
          <span class="text-2xl">✅</span>
          <div>
            <h3 class="font-semibold text-gray-900">Đánh giá năng lực</h3>
            <p class="text-xs text-gray-500">Quản lý ngân hàng câu hỏi và kết quả thi</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
