---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Quản lý Lớp học - Quản trị Giảng viên">
  <section class="max-w-5xl mx-auto px-4 py-8" x-data="{
    classes: [],
    loading: true,
    async fetchClasses() {
      this.loading = true;
      try {
        const res = await fetch('/api/classes');
        const data = await res.json();
        this.classes = data.data || [];
      } catch (e) {
        this.classes = [];
      } finally {
        this.loading = false;
      }
    }
  }" x-init="fetchClasses()">
    <div class="flex items-center justify-between mb-6">
      <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
          <a href="/admin" class="hover:underline">Quản trị</a>
          <span>/</span>
          <span class="text-gray-900 font-medium">Lớp học</span>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">Danh sách Lớp học</h1>
      </div>
      <a href="/admin" class="btn-secondary text-sm">← Về Dashboard</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <template x-for="c in classes" :key="c.id || c.class_code">
        <div class="card flex items-start justify-between">
          <div>
            <span class="text-xs font-semibold px-2 py-0.5 rounded bg-primary-100 text-primary-800" x-text="c.class_code"></span>
            <h3 class="text-base font-bold text-gray-900 mt-2" x-text="c.class_name"></h3>
            <p class="text-xs text-gray-500 mt-1" x-text="`Niên khóa: ${c.academic_year || '2026-2027'}`"></p>
          </div>
          <a :href="`/admin/scores?class=${encodeURIComponent(c.class_name)}`" class="text-xs font-semibold text-primary-700 hover:underline">
            Xem điểm →
          </a>
        </div>
      </template>
    </div>
  </section>
</BaseLayout>
