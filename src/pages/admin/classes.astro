---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Quản lý Lớp học & Học sinh - Cổng Giảng Dạy CNTT">
  <section class="max-w-6xl mx-auto px-4 py-8" x-data="classesManager">
    <!-- Toast Notification -->
    <div
      x-show="toast.show"
      x-cloak
      x-transition
      class="fixed bottom-5 right-5 z-50 px-4 py-3 rounded-2xl shadow-xl border text-xs sm:text-sm font-semibold flex items-center gap-2"
      :class="toast.isError ? 'bg-rose-50 border-rose-200 text-rose-800' : 'bg-emerald-50 border-emerald-200 text-emerald-800'"
    >
      <span x-text="toast.message"></span>
    </div>

    <!-- Header bar -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 border-b border-gray-200 pb-5">
      <div>
        <div class="flex items-center gap-2 text-xs text-gray-500 mb-1">
          <a href="/admin" class="hover:underline text-primary-700 font-semibold">Bảng điều khiển Giảng viên</a>
          <span>/</span>
          <span class="text-gray-900 font-medium">Quản lý Lớp học & Học sinh</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight flex items-center gap-2.5">
          <span>👥</span>
          <span>Hồ Sơ Lớp Học & Học Sinh Chuẩn Đại Học</span>
        </h1>
        <p class="text-xs sm:text-sm text-gray-500 mt-1">
          Cloudflare D1 (SQLite Edge) · Quản lý đầy đủ MSHS, Họ tên, Ngày sinh, Giới tính · Nhập nhanh 1-Click từ Excel
        </p>
      </div>

      <div class="flex items-center gap-2.5 self-end sm:self-center">
        <button
          type="button"
          @click="showCreateClassModal = true"
          class="btn-primary text-xs sm:text-sm px-4 py-2.5 font-bold flex items-center gap-1.5 shadow-sm"
        >
          <span>➕</span>
          <span>Tạo Lớp Mới</span>
        </button>

        <button
          type="button"
          @click="openImportModal()"
          class="btn-secondary text-xs sm:text-sm px-4 py-2.5 font-bold flex items-center gap-1.5 shadow-sm border-gray-300 hover:bg-gray-50"
        >
          <span>📋</span>
          <span>Dán Học Sinh từ Excel</span>
        </button>
      </div>
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
      <div class="card p-4 flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center text-xl shrink-0">
          🏫
        </div>
        <div>
          <span class="text-xs text-gray-500 block">Tổng số lớp giảng dạy</span>
          <strong class="text-xl font-bold text-gray-900 font-mono" x-text="classes.length"></strong>
        </div>
      </div>

      <div class="card p-4 flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl shrink-0">
          🎓
        </div>
        <div>
          <span class="text-xs text-gray-500 block">Tổng số học sinh đã nạp</span>
          <strong class="text-xl font-bold text-emerald-800 font-mono" x-text="classes.reduce((sum, c) => sum + (c.student_count || 0), 0)"></strong>
        </div>
      </div>

      <div class="card p-4 flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center text-xl shrink-0">
          📅
        </div>
        <div>
          <span class="text-xs text-gray-500 block">Niên khóa & Hệ đào tạo</span>
          <strong class="text-sm font-bold text-gray-800">2026 - 2027 (Trung cấp 9+3)</strong>
        </div>
      </div>
    </div>

    <!-- Class Grid -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-base font-bold text-gray-900">Danh Sách Lớp Chuyên Ngành</h2>
        <span class="text-xs text-gray-500" x-text="'Hiển thị ' + classes.length + ' lớp học'"></span>
      </div>

      <!-- Loading skeleton -->
      <div x-show="loading" class="text-center py-10 text-gray-400 text-sm">
        Đang tải dữ liệu lớp học từ Cloudflare D1...
      </div>

      <!-- Empty state -->
      <div x-show="!loading && classes.length === 0" class="card text-center py-12 space-y-3">
        <span class="text-4xl block">📂</span>
        <h3 class="text-base font-bold text-gray-800">Chưa có lớp học nào</h3>
        <p class="text-xs text-gray-500 max-w-sm mx-auto">Thầy bấm vào nút "Tạo Lớp Mới" ở góc trên để tạo lớp đầu tiên nhé!</p>
      </div>

      <!-- Classes cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" x-show="!loading && classes.length > 0">
        <template x-for="c in classes" :key="c.id || c.class_code">
          <div class="card p-5 flex flex-col justify-between space-y-4 hover:border-primary-400 transition-all shadow-xs">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-primary-100 text-primary-800" x-text="c.class_code"></span>
                <span
                  class="text-[11px] font-mono px-2 py-0.5 rounded-full font-bold"
                  :class="c.student_count > 0 ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-100 text-gray-500'"
                  x-text="c.student_count > 0 ? (c.student_count + ' Học sinh') : 'Chưa có HS'"
                ></span>
              </div>

              <h3 class="text-base font-bold text-gray-900 leading-snug" x-text="c.class_name"></h3>
              <p class="text-xs text-gray-500 mt-1" x-text="'Niên khóa: ' + (c.academic_year || '2026-2027')"></p>
            </div>

            <!-- Action buttons -->
            <div class="pt-3 border-t border-gray-100 flex flex-wrap items-center justify-between gap-2 text-xs">
              <div class="flex items-center gap-1.5">
                <button
                  type="button"
                  @click="viewClassStudents(c)"
                  class="px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold transition-colors flex items-center gap-1"
                  title="Xem và chỉnh sửa danh sách học sinh"
                >
                  <span>👥</span>
                  <span>DS Lớp</span>
                </button>

                <button
                  type="button"
                  @click="openImportModal(c)"
                  class="px-2.5 py-1.5 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold transition-colors flex items-center gap-1"
                  title="Dán nhanh danh sách học sinh từ Excel vào lớp này"
                >
                  <span>📥</span>
                  <span>Nạp Excel</span>
                </button>
              </div>

              <div class="flex items-center gap-2">
                <a
                  :href="'/admin/scores?class=' + encodeURIComponent(c.class_name)"
                  class="text-primary-700 hover:underline font-bold"
                >
                  Bảng điểm →
                </a>

                <button
                  type="button"
                  @click="deleteClass(c)"
                  class="text-gray-400 hover:text-rose-600 p-1 rounded"
                  title="Xóa lớp học"
                >
                  🗑️
                </button>
              </div>
            </div>
          </div>
        </template>
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- MODAL 1: TẠO LỚP HỌC MỚI                                       -->
    <!-- ============================================================== -->
    <div
      x-show="showCreateClassModal"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4"
    >
      <div
        class="bg-white rounded-3xl p-6 sm:p-7 max-w-md w-full shadow-2xl border border-gray-200 space-y-4"
        @click.away="showCreateClassModal = false"
      >
        <div class="flex items-center justify-between border-b pb-3">
          <h3 class="font-extrabold text-gray-900 text-base flex items-center gap-2">
            <span>🏫</span>
            <span>Tạo Lớp Học Mới</span>
          </h3>
          <button @click="showCreateClassModal = false" class="text-gray-400 hover:text-gray-600 text-lg">✕</button>
        </div>

        <form @submit.prevent="createClass()" class="space-y-3.5 text-xs sm:text-sm">
          <div>
            <label class="block font-bold text-gray-700 mb-1">Mã lớp viết tắt (*)</label>
            <input
              type="text"
              x-model="newClass.code"
              required
              placeholder="Ví dụ: THUD_K26A, OTO_93..."
              class="w-full px-3 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 font-mono text-sm"
            />
            <span class="text-[11px] text-gray-500 mt-0.5 block">Nên viết hoa liền không dấu</span>
          </div>

          <div>
            <label class="block font-bold text-gray-700 mb-1">Tên lớp đầy đủ (*)</label>
            <input
              type="text"
              x-model="newClass.name"
              required
              placeholder="Ví dụ: Tin học ứng dụng K26A"
              class="w-full px-3 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 text-sm"
            />
          </div>

          <div>
            <label class="block font-bold text-gray-700 mb-1">Niên khóa đào tạo</label>
            <input
              type="text"
              x-model="newClass.academicYear"
              placeholder="2026-2027"
              class="w-full px-3 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 text-sm"
            />
          </div>

          <div class="flex justify-end gap-2 pt-3 border-t">
            <button
              type="button"
              @click="showCreateClassModal = false"
              class="btn-secondary text-xs px-4 py-2"
            >
              Hủy
            </button>
            <button
              type="submit"
              class="btn-primary text-xs px-5 py-2 font-bold shadow"
            >
              Xác Nhận Tạo Lớp
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- MODAL 2: NHẬP HỌC SINH TỪ EXCEL (1-CLICK PASTE)                -->
    <!-- Chuẩn thông tin Đại học: MSHS, Họ tên, Ngày sinh, Giới tính     -->
    <!-- ============================================================== -->
    <div
      x-show="showImportModal"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4"
    >
      <div
        class="bg-white rounded-3xl p-6 sm:p-8 max-w-3xl w-full shadow-2xl border border-gray-200 space-y-4 max-h-[92vh] overflow-y-auto"
        @click.away="showImportModal = false"
      >
        <div class="flex items-center justify-between border-b pb-3">
          <div>
            <h3 class="font-extrabold text-gray-900 text-base sm:text-lg flex items-center gap-2">
              <span>📋</span>
              <span>Dán Danh Sách Học Sinh Từ Excel (Chuẩn Đại Học)</span>
            </h3>
            <p class="text-xs text-gray-500 mt-0.5">
              Hệ thống tự động bóc tách các cột: <strong>STT | MSHS | Họ và tên | Ngày sinh | Giới tính</strong>
            </p>
          </div>
          <button @click="showImportModal = false" class="text-gray-400 hover:text-gray-600 text-lg">✕</button>
        </div>

        <div class="space-y-4 text-xs sm:text-sm">
          <!-- Chọn lớp nhận danh sách -->
          <div>
            <label class="block font-bold text-gray-700 mb-1">Nạp vào Lớp học:</label>
            <select
              x-model="importData.classId"
              @change="onImportClassChange()"
              class="w-full px-3 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 font-semibold"
            >
              <template x-for="c in classes" :key="c.id">
                <option :value="c.id" x-text="c.class_code + ' - ' + c.class_name"></option>
              </template>
            </select>
          </div>

          <!-- Mẫu định dạng tham khảo -->
          <div class="bg-blue-50/60 border border-blue-200/80 rounded-2xl p-3.5 text-xs text-blue-900 space-y-1">
            <div class="font-bold flex items-center gap-1.5 text-blue-950">
              <span>💡</span>
              <span>Định dạng khuyên dùng (Dán trực tiếp từ bảng tính Excel / vnEdu / SMAS):</span>
            </div>
            <p class="text-[11px] text-blue-800 font-mono">
              STT [Tab] MSHS [Tab] Họ và tên [Tab] Ngày sinh [Tab] Giới tính
            </p>
            <p class="text-[11px] text-blue-700">
              * Nếu file Excel của trường chưa có cột MSHS, hệ thống sẽ <strong>tự động sinh mã chuẩn</strong> theo lớp (ví dụ: <code class="bg-white px-1 py-0.5 rounded text-blue-900 font-mono">THUD_K26A-01</code>) để không bao giờ bị trùng tên.
            </p>
          </div>

          <!-- Textarea dán từ excel -->
          <div>
            <label class="block font-bold text-gray-700 mb-1">Dán dữ liệu từ file Excel vào đây:</label>
            <textarea
              x-model="importData.rawText"
              @input="parseExcelText()"
              rows="6"
              placeholder="Ví dụ dán từ Excel:&#10;1	24TH0101	Nguyễn Văn An	15/04/2009	Nam&#10;2	24TH0102	Trần Thị Bích	20/08/2009	Nữ&#10;3	24TH0103	Lê Hoàng Cường	03/11/2008	Nam&#10;4	24TH0104	Phạm Mỹ Dung	12/01/2009	Nữ"
              class="w-full px-3 py-2 border border-gray-300 rounded-xl font-mono text-xs focus:ring-2 focus:ring-primary-500 leading-relaxed"
            ></textarea>
          </div>

          <!-- Tùy chọn ghi đè -->
          <label class="flex items-center gap-2 cursor-pointer select-none">
            <input type="checkbox" x-model="importData.overwrite" class="rounded text-primary-700 w-4 h-4" />
            <span class="text-xs text-gray-700 font-medium">Ghi đè danh sách (Xóa sạch danh sách cũ của lớp này trước khi nạp mới)</span>
          </label>

          <!-- Live Preview Table -->
          <div x-show="importData.parsedStudents.length > 0" class="border border-gray-200 rounded-2xl p-4 bg-gray-50 space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-bold text-gray-800 text-xs">
                Xem trước kết quả nhận diện:
                <span class="text-emerald-700 font-extrabold" x-text="importData.parsedStudents.length + ' học sinh'"></span>
              </span>
              <span class="text-[11px] text-gray-500 font-mono">Chuẩn CSDL Cloudflare D1</span>
            </div>

            <div class="max-h-52 overflow-y-auto border border-gray-200 rounded-xl bg-white shadow-inner">
              <table class="w-full text-xs text-left">
                <thead class="bg-gray-100 text-gray-600 font-mono sticky top-0 border-b border-gray-200">
                  <tr>
                    <th class="py-2 px-3 w-14 text-center">STT</th>
                    <th class="py-2 px-3 w-28">MSHS</th>
                    <th class="py-2 px-3">Họ và tên học sinh</th>
                    <th class="py-2 px-3 w-28">Ngày sinh</th>
                    <th class="py-2 px-3 w-20 text-center">Giới tính</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                  <template x-for="st in importData.parsedStudents.slice(0, 20)" :key="st.student_number + '-' + st.student_code">
                    <tr class="hover:bg-blue-50/50">
                      <td class="py-1.5 px-3 text-center font-mono text-gray-500" x-text="st.student_number"></td>
                      <td class="py-1.5 px-3 font-mono font-bold text-primary-700" x-text="st.student_code"></td>
                      <td class="py-1.5 px-3 font-semibold text-gray-900" x-text="st.full_name"></td>
                      <td class="py-1.5 px-3 font-mono text-gray-600" x-text="st.date_of_birth || '-'"></td>
                      <td class="py-1.5 px-3 text-center">
                        <span
                          class="px-2 py-0.5 rounded-full text-[10px] font-bold"
                          :class="st.gender === 'Nữ' ? 'bg-pink-100 text-pink-700' : 'bg-blue-100 text-blue-700'"
                          x-text="st.gender"
                        ></span>
                      </td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>

            <p x-show="importData.parsedStudents.length > 20" class="text-[11px] text-gray-500 italic text-center">
              ... và <span x-text="importData.parsedStudents.length - 20"></span> học sinh nữa tiếp theo.
            </p>
          </div>

          <!-- Submit Buttons -->
          <div class="flex justify-end gap-2.5 pt-3 border-t">
            <button
              type="button"
              @click="showImportModal = false"
              class="btn-secondary text-xs px-4 py-2"
            >
              Đóng
            </button>

            <button
              type="button"
              @click="submitImport()"
              :disabled="importData.parsedStudents.length === 0"
              class="btn-primary text-xs px-5 py-2.5 font-bold shadow-md bg-emerald-600 hover:bg-emerald-700 flex items-center gap-1.5"
              :class="importData.parsedStudents.length === 0 ? 'opacity-50 cursor-not-allowed' : ''"
            >
              <span>💾</span>
              <span>Lưu vào CSDL Cloudflare D1</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- MODAL 3: XEM VÀ QUẢN LÝ DANH SÁCH HỌC SINH CỦA LỚP            -->
    <!-- Chuẩn Đại học: Tìm kiếm, lọc, sửa, xóa, xuất CSV                -->
    <!-- ============================================================== -->
    <div
      x-show="showStudentListModal"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4"
    >
      <div
        class="bg-white rounded-3xl p-6 sm:p-8 max-w-4xl w-full shadow-2xl border border-gray-200 space-y-4 max-h-[92vh] overflow-y-auto"
        @click.away="showStudentListModal = false"
      >
        <!-- Modal Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b pb-3">
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xl">🎓</span>
              <h3 class="font-extrabold text-gray-900 text-base sm:text-lg">
                <span x-text="selectedClass ? selectedClass.class_name : 'Danh Sách Học Sinh'"></span>
              </h3>
            </div>
            <div class="flex items-center gap-2 text-xs text-gray-500 font-mono mt-0.5">
              <span>Mã lớp: <strong class="text-primary-800" x-text="selectedClass ? selectedClass.class_code : ''"></strong></span>
              <span>·</span>
              <span>Niên khóa: <span x-text="selectedClass ? selectedClass.academic_year : '2026-2027'"></span></span>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <!-- Xuất file CSV / Excel -->
            <button
              type="button"
              @click="exportStudentsCSV()"
              :disabled="selectedClassStudents.length === 0"
              class="px-3 py-1.5 rounded-xl border border-gray-300 text-gray-700 hover:bg-gray-100 text-xs font-bold flex items-center gap-1 shadow-2xs"
              :class="selectedClassStudents.length === 0 ? 'opacity-50 cursor-not-allowed' : ''"
              title="Xuất danh sách lớp ra file Excel (CSV chuẩn UTF-8)"
            >
              <span>📊</span>
              <span>Xuất Excel</span>
            </button>

            <!-- Nút Thêm 1 học sinh lẻ -->
            <button
              type="button"
              @click="openAddStudentModal()"
              class="btn-primary text-xs px-3.5 py-1.5 font-bold flex items-center gap-1 shadow-xs"
            >
              <span>➕</span>
              <span>Thêm HS</span>
            </button>

            <button @click="showStudentListModal = false" class="text-gray-400 hover:text-gray-600 text-lg p-1">✕</button>
          </div>
        </div>

        <!-- Filter & Search Toolbar -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 bg-gray-50 p-3 rounded-2xl border border-gray-200">
          <div class="flex items-center gap-2">
            <span class="text-xs text-gray-600 font-medium">Sĩ số:</span>
            <span class="px-2 py-0.5 rounded-full bg-primary-100 text-primary-900 font-bold font-mono text-xs" x-text="selectedClassStudents.length + ' học sinh'"></span>
            <span class="text-gray-300">|</span>
            <span class="text-[11px] text-blue-700 font-semibold" x-text="'👦 ' + countGender('Nam') + ' Nam'"></span>
            <span class="text-[11px] text-pink-700 font-semibold" x-text="'👧 ' + countGender('Nữ') + ' Nữ'"></span>
          </div>

          <div class="flex items-center gap-2">
            <!-- Search input -->
            <div class="relative grow sm:grow-0 sm:w-64">
              <input
                type="text"
                x-model="studentFilterText"
                placeholder="Tìm MSHS hoặc Họ tên..."
                class="w-full pl-8 pr-3 py-1.5 border border-gray-300 rounded-xl text-xs focus:ring-2 focus:ring-primary-500 focus:outline-none bg-white"
              />
              <span class="absolute left-2.5 top-1.5 text-gray-400 text-xs">🔍</span>
            </div>

            <!-- Nạp Excel modal button -->
            <button
              type="button"
              @click="showStudentListModal = false; openImportModal(selectedClass);"
              class="px-2.5 py-1.5 rounded-xl bg-blue-100 hover:bg-blue-200 text-blue-800 text-xs font-bold whitespace-nowrap"
            >
              📥 Nạp Excel
            </button>
          </div>
        </div>

        <!-- Student Table -->
        <div class="space-y-4 text-xs sm:text-sm">
          <!-- Loading skeleton -->
          <div x-show="loadingStudents" class="text-center py-10 text-gray-400 text-xs">
            Đang tải danh sách học sinh từ CSDL D1...
          </div>

          <!-- Empty state -->
          <div x-show="!loadingStudents && selectedClassStudents.length === 0" class="p-8 text-center text-gray-500 border border-dashed rounded-2xl bg-gray-50 space-y-2">
            <span class="text-3xl block">📋</span>
            <p class="font-bold text-gray-700">Lớp này chưa có danh sách học sinh</p>
            <p class="text-xs text-gray-500">Thầy bấm nút "Nạp Excel" để dán danh sách hoặc bấm "Thêm HS" để nhập từng em nhé!</p>
          </div>

          <!-- Main Table -->
          <div x-show="!loadingStudents && selectedClassStudents.length > 0" class="border border-gray-200 rounded-2xl overflow-hidden shadow-2xs">
            <div class="max-h-[50vh] overflow-y-auto">
              <table class="w-full text-xs text-left">
                <thead class="bg-gray-100 text-gray-700 uppercase font-mono sticky top-0 border-b border-gray-200">
                  <tr>
                    <th class="py-2.5 px-3 w-14 text-center">STT</th>
                    <th class="py-2.5 px-3 w-28">MSHS</th>
                    <th class="py-2.5 px-4">Họ và tên học sinh</th>
                    <th class="py-2.5 px-3 w-28">Ngày sinh</th>
                    <th class="py-2.5 px-3 w-20 text-center">Giới tính</th>
                    <th class="py-2.5 px-3 w-24 text-center">Trạng thái</th>
                    <th class="py-2.5 px-3 text-right w-24">Thao tác</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                  <template x-for="(stu, idx) in filteredStudents" :key="stu.id || (stu.student_code + '-' + idx)">
                    <tr class="hover:bg-blue-50/40 transition-colors">
                      <td class="py-2 px-3 text-center font-mono text-gray-500" x-text="stu.student_number || (idx + 1)"></td>
                      <td class="py-2 px-3 font-mono font-bold text-primary-700" x-text="stu.student_code || '-'"></td>
                      <td class="py-2 px-4 font-semibold text-gray-900" x-text="stu.full_name"></td>
                      <td class="py-2 px-3 font-mono text-gray-600">
                        <span x-show="stu.date_of_birth" x-text="'📅 ' + stu.date_of_birth"></span>
                        <span x-show="!stu.date_of_birth" class="text-gray-400 italic">Chưa có</span>
                      </td>
                      <td class="py-2 px-3 text-center">
                        <span
                          class="px-2 py-0.5 rounded-full text-[10px] font-bold inline-block"
                          :class="stu.gender === 'Nữ' ? 'bg-pink-100 text-pink-700' : 'bg-blue-100 text-blue-700'"
                          x-text="stu.gender || 'Nam'"
                        ></span>
                      </td>
                      <td class="py-2 px-3 text-center">
                        <span
                          class="px-2 py-0.5 rounded-full text-[10px] font-bold inline-block"
                          :class="stu.status === 'Đang học' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'"
                          x-text="stu.status || 'Đang học'"
                        ></span>
                      </td>
                      <td class="py-2 px-3 text-right">
                        <div class="flex items-center justify-end gap-1.5">
                          <button
                            type="button"
                            @click="openEditStudentModal(stu)"
                            class="text-blue-600 hover:text-blue-800 p-1 hover:bg-blue-50 rounded"
                            title="Sửa thông tin học sinh"
                          >
                            ✏️
                          </button>
                          <button
                            type="button"
                            @click="deleteStudent(stu.id)"
                            class="text-rose-500 hover:text-rose-700 p-1 hover:bg-rose-50 rounded"
                            title="Xóa học sinh này"
                          >
                            🗑️
                          </button>
                        </div>
                      </td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>

            <!-- No search results -->
            <div x-show="filteredStudents.length === 0 && selectedClassStudents.length > 0" class="py-8 text-center text-gray-500 text-xs">
              Không tìm thấy học sinh nào khớp với từ khóa "<span class="font-bold text-gray-800" x-text="studentFilterText"></span>"
            </div>
          </div>

          <div class="flex items-center justify-between pt-2 border-t text-xs text-gray-500">
            <span>Hiển thị <strong x-text="filteredStudents.length"></strong> / <span x-text="selectedClassStudents.length"></span> học sinh</span>
            <button
              type="button"
              @click="showStudentListModal = false"
              class="btn-secondary text-xs px-4 py-2"
            >
              Đóng
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- MODAL 4: THÊM HOẶC CHỈNH SỬA THÔNG TIN 1 HỌC SINH             -->
    <!-- ============================================================== -->
    <div
      x-show="showStudentEditModal"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4"
    >
      <div
        class="bg-white rounded-3xl p-6 sm:p-7 max-w-md w-full shadow-2xl border border-gray-200 space-y-4"
        @click.away="showStudentEditModal = false"
      >
        <div class="flex items-center justify-between border-b pb-3">
          <h3 class="font-extrabold text-gray-900 text-base flex items-center gap-2">
            <span>🎓</span>
            <span x-text="studentForm.id ? 'Chỉnh Sửa Hồ Sơ Học Sinh' : 'Thêm Học Sinh Mới'"></span>
          </h3>
          <button @click="showStudentEditModal = false" class="text-gray-400 hover:text-gray-600 text-lg">✕</button>
        </div>

        <form @submit.prevent="saveSingleStudent()" class="space-y-3.5 text-xs sm:text-sm">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-gray-700 mb-1">Số thứ tự (STT)</label>
              <input
                type="number"
                min="1"
                x-model.number="studentForm.student_number"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-xl font-mono text-sm focus:ring-2 focus:ring-primary-500"
              />
            </div>

            <div>
              <label class="block font-bold text-gray-700 mb-1">Mã số HS (MSHS) (*)</label>
              <input
                type="text"
                x-model="studentForm.student_code"
                placeholder="24TH0101..."
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-xl font-mono text-sm uppercase focus:ring-2 focus:ring-primary-500"
              />
            </div>
          </div>

          <div>
            <label class="block font-bold text-gray-700 mb-1">Họ và tên học sinh (*)</label>
            <input
              type="text"
              x-model="studentForm.full_name"
              placeholder="Ví dụ: Nguyễn Văn An"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 font-semibold"
            />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-gray-700 mb-1">Ngày sinh (DD/MM/YYYY)</label>
              <input
                type="text"
                x-model="studentForm.date_of_birth"
                placeholder="15/04/2009"
                class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm font-mono focus:ring-2 focus:ring-primary-500"
              />
            </div>

            <div>
              <label class="block font-bold text-gray-700 mb-1">Giới tính</label>
              <select
                x-model="studentForm.gender"
                class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-primary-500"
              >
                <option value="Nam">Nam</option>
                <option value="Nữ">Nữ</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-gray-700 mb-1">Số điện thoại liên hệ</label>
              <input
                type="text"
                x-model="studentForm.phone"
                placeholder="0912..."
                class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm font-mono focus:ring-2 focus:ring-primary-500"
              />
            </div>

            <div>
              <label class="block font-bold text-gray-700 mb-1">Trạng thái học</label>
              <select
                x-model="studentForm.status"
                class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-primary-500"
              >
                <option value="Đang học">Đang học</option>
                <option value="Bảo lưu">Bảo lưu</option>
                <option value="Nghỉ học">Nghỉ học</option>
              </select>
            </div>
          </div>

          <div class="flex justify-end gap-2 pt-3 border-t">
            <button
              type="button"
              @click="showStudentEditModal = false"
              class="btn-secondary text-xs px-4 py-2"
            >
              Hủy
            </button>
            <button
              type="submit"
              class="btn-primary text-xs px-5 py-2 font-bold shadow bg-emerald-600 hover:bg-emerald-700"
            >
              <span>💾 Lưu Thông Tin</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  document.addEventListener('alpine:init', () => {
    Alpine.data('classesManager', () => ({
      classes: [],
      loading: true,

      showCreateClassModal: false,
      showImportModal: false,
      showStudentListModal: false,
      showStudentEditModal: false,

      newClass: {
        code: '',
        name: '',
        academicYear: '2026-2027'
      },

      importData: {
        classId: '',
        rawText: '',
        overwrite: true,
        parsedStudents: []
      },

      selectedClass: null,
      selectedClassStudents: [],
      loadingStudents: false,
      studentFilterText: '',

      studentForm: {
        id: null,
        class_id: '',
        student_number: 1,
        student_code: '',
        full_name: '',
        date_of_birth: '',
        gender: 'Nam',
        phone: '',
        status: 'Đang học'
      },

      toast: { show: false, message: '', isError: false },
      showToast(msg, isErr = false) {
        this.toast = { show: true, message: msg, isError: isErr };
        setTimeout(() => { this.toast.show = false; }, 4000);
      },

      init() {
        this.fetchClasses();
      },

      // Computed filter cho danh sách học sinh theo MSHS hoặc Tên
      get filteredStudents() {
        const query = (this.studentFilterText || '').trim().toLowerCase();
        if (!query) return this.selectedClassStudents;
        return this.selectedClassStudents.filter(stu => {
          const name = (stu.full_name || '').toLowerCase();
          const code = (stu.student_code || '').toLowerCase();
          return name.includes(query) || code.includes(query);
        });
      },

      countGender(g) {
        return this.selectedClassStudents.filter(s => (s.gender || 'Nam') === g).length;
      },

      async fetchClasses() {
        this.loading = true;
        try {
          const res = await fetch('/api/classes');
          const data = await res.json();
          this.classes = data.data || [];
        } catch (e) {
          this.classes = [];
        } finally {
          this.loading = false;
        }
      },

      async createClass() {
        if (!this.newClass.code.trim() || !this.newClass.name.trim()) {
          alert('Vui lòng nhập đầy đủ Mã lớp và Tên lớp!');
          return;
        }
        try {
          const res = await fetch('/api/classes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'create_class',
              class_code: this.newClass.code,
              class_name: this.newClass.name,
              academic_year: this.newClass.academicYear
            })
          });
          const data = await res.json();
          if (data.ok) {
            this.showToast('✅ Đã tạo lớp học mới thành công!');
            this.showCreateClassModal = false;
            this.newClass = { code: '', name: '', academicYear: '2026-2027' };
            await this.fetchClasses();
          } else {
            alert('Lỗi: ' + data.error);
          }
        } catch (err) {
          alert('Lỗi kết nối máy chủ!');
        }
      },

      openImportModal(cls = null) {
        if (cls) {
          this.importData.classId = cls.id;
        } else if (this.classes.length > 0 && !this.importData.classId) {
          this.importData.classId = this.classes[0].id;
        }
        this.importData.rawText = '';
        this.importData.parsedStudents = [];
        this.showImportModal = true;
      },

      onImportClassChange() {
        // Cập nhật lại MSHS tự sinh nếu cần
        if (this.importData.rawText) {
          this.parseExcelText();
        }
      },

      // Bóc tách dữ liệu Clipboard / Excel đa cột thông minh (Poka-Yoke)
      parseExcelText() {
        const text = this.importData.rawText.trim();
        if (!text) {
          this.importData.parsedStudents = [];
          return;
        }

        const currentClass = this.classes.find(c => c.id === this.importData.classId);
        const classPrefix = currentClass ? currentClass.class_code.replace(/[^A-Za-z0-9]/g, '') : 'HS';

        const lines = text.split(/\r?\n/);
        const results = [];
        let autoIndex = 1;

        for (const line of lines) {
          const trimmed = line.trim();
          if (!trimmed) continue;

          // Bỏ qua dòng tiêu đề nếu người dùng quét trúng cả hàng Header của bảng
          const lower = trimmed.toLowerCase();
          if (
            (lower.includes('stt') && lower.includes('họ')) ||
            (lower.includes('mã') && lower.includes('tên')) ||
            (lower.includes('mshs') && lower.includes('ngày'))
          ) {
            continue;
          }

          const parts = trimmed.split(/\t+/).map(p => p.trim()).filter(Boolean);

          let stt = autoIndex;
          let stuCode = '';
          let fullName = '';
          let dob = '';
          let gender = 'Nam';
          let phone = '';

          // Trích xuất ngày sinh nếu có dạng DD/MM/YYYY hoặc DD-MM-YYYY
          const dobRegex = /\b(\d{1,2}[\/\-\.]\d{1,2}[\/\-\.]\d{2,4})\b/;
          const dobMatch = trimmed.match(dobRegex);
          if (dobMatch) {
            dob = dobMatch[1].replace(/[\-\.]/g, '/');
          }

          // Trích xuất giới tính Nam / Nữ
          if (/\b(Nữ|Nu|Female|F)\b/i.test(trimmed)) {
            gender = 'Nữ';
          } else if (/\b(Nam|Male|M)\b/i.test(trimmed)) {
            gender = 'Nam';
          }

          // Trích xuất số điện thoại
          const phoneMatch = trimmed.match(/\b(0\d{9,10})\b/);
          if (phoneMatch) {
            phone = phoneMatch[1];
          }

          if (parts.length >= 3) {
            // Định dạng nhiều cột:
            // Cột 0 thường là STT
            const parsedStt = parseInt(parts[0].replace(/[^0-9]/g, ''));
            if (!isNaN(parsedStt)) {
              stt = parsedStt;
              autoIndex = stt + 1;
            } else {
              stt = autoIndex++;
            }

            // Kiểm tra cột 1: Có phải là Mã số học sinh (MSHS) không?
            // MSHS thường là chuỗi chữ số hoặc mã alphanumeric, ví dụ 24TH0101, BMT-01, 10294...
            const col1 = parts[1];
            const isCode = /^[A-Za-z0-9_\-\.]{3,15}$/.test(col1) && !dobRegex.test(col1) && !/^(nam|nữ|nu)$/i.test(col1);

            if (isCode) {
              stuCode = col1.toUpperCase();
              // Cột 2 là Họ tên
              fullName = parts[2];
            } else {
              // Cột 1 chính là Họ và tên
              fullName = col1;
            }

            // Nếu file Excel tách Họ đệm và Tên (ví dụ cột 2 là Họ đệm, cột 3 là Tên)
            if (parts.length >= 4 && isCode && !dobRegex.test(parts[3]) && !/^(nam|nữ|nu)$/i.test(parts[3])) {
              // Ghép họ và tên
              fullName = (parts[2] + ' ' + parts[3]).trim();
            }
          } else if (parts.length === 2) {
            // 2 cột: Thường là STT và Họ tên, hoặc MSHS và Họ tên
            const num0 = parseInt(parts[0].replace(/[^0-9]/g, ''));
            if (!isNaN(num0) && num0 < 1000) {
              stt = num0;
              autoIndex = stt + 1;
              fullName = parts[1];
            } else if (/^[A-Za-z0-9_\-]{3,15}$/.test(parts[0])) {
              stuCode = parts[0].toUpperCase();
              fullName = parts[1];
              stt = autoIndex++;
            } else {
              fullName = parts.join(' ');
              stt = autoIndex++;
            }
          } else {
            // 1 cột duy nhất: Thử tách số ở đầu (1. Nguyễn Văn An)
            const dotMatch = trimmed.match(/^(\d+)[\.\s\-\:]+(.+)$/);
            if (dotMatch) {
              stt = parseInt(dotMatch[1]) || autoIndex++;
              fullName = dotMatch[2].trim();
            } else {
              stt = autoIndex++;
              fullName = trimmed;
            }
          }

          // Dọn dẹp họ tên (xóa bỏ ngày sinh hay giới tính lọt vào tên nếu có)
          fullName = fullName
            .replace(dobRegex, '')
            .replace(/\b(Nam|Nữ|Nu)\b/gi, '')
            .replace(/\s+/g, ' ')
            .trim();

          // Nếu chưa có MSHS, tự sinh mã chuẩn đại học: e.g. THUDK26A-01
          if (!stuCode) {
            stuCode = classPrefix + '-' + String(stt).padStart(2, '0');
          }

          if (fullName) {
            results.push({
              student_number: stt,
              student_code: stuCode,
              full_name: fullName,
              date_of_birth: dob,
              gender: gender,
              phone: phone,
              status: 'Đang học'
            });
          }
        }

        this.importData.parsedStudents = results;
      },

      async submitImport() {
        if (!this.importData.classId) {
          alert('Vui lòng chọn lớp học để nạp danh sách!');
          return;
        }
        if (this.importData.parsedStudents.length === 0) {
          alert('Chưa có học sinh nào được nhận diện. Vui lòng dán danh sách từ Excel!');
          return;
        }

        try {
          const res = await fetch('/api/classes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'import_students',
              class_id: this.importData.classId,
              students: this.importData.parsedStudents,
              overwrite: this.importData.overwrite
            })
          });
          const data = await res.json();
          if (data.ok) {
            this.showToast('✅ ' + data.message);
            this.showImportModal = false;
            await this.fetchClasses();
            // Nếu đang xem danh sách của chính lớp này, load lại
            if (this.selectedClass && this.selectedClass.id === this.importData.classId) {
              await this.viewClassStudents(this.selectedClass);
            }
          } else {
            alert('Lỗi: ' + data.error);
          }
        } catch (err) {
          alert('Lỗi kết nối khi lưu học sinh vào CSDL D1!');
        }
      },

      async viewClassStudents(cls) {
        this.selectedClass = cls;
        this.loadingStudents = true;
        this.studentFilterText = '';
        this.showStudentListModal = true;
        try {
          const res = await fetch('/api/classes?id=' + encodeURIComponent(cls.id));
          const data = await res.json();
          this.selectedClassStudents = data.data || [];
        } catch (err) {
          this.selectedClassStudents = [];
        } finally {
          this.loadingStudents = false;
        }
      },

      openAddStudentModal() {
        if (!this.selectedClass) return;
        const nextNum = (this.selectedClassStudents.length > 0)
          ? Math.max(...this.selectedClassStudents.map(s => s.student_number || 0)) + 1
          : 1;
        const classPrefix = this.selectedClass.class_code.replace(/[^A-Za-z0-9]/g, '');

        this.studentForm = {
          id: null,
          class_id: this.selectedClass.id,
          student_number: nextNum,
          student_code: classPrefix + '-' + String(nextNum).padStart(2, '0'),
          full_name: '',
          date_of_birth: '',
          gender: 'Nam',
          phone: '',
          status: 'Đang học'
        };
        this.showStudentEditModal = true;
      },

      openEditStudentModal(stu) {
        this.studentForm = {
          id: stu.id,
          class_id: stu.class_id || (this.selectedClass ? this.selectedClass.id : ''),
          student_number: stu.student_number,
          student_code: stu.student_code || '',
          full_name: stu.full_name,
          date_of_birth: stu.date_of_birth || '',
          gender: stu.gender || 'Nam',
          phone: stu.phone || '',
          status: stu.status || 'Đang học'
        };
        this.showStudentEditModal = true;
      },

      async saveSingleStudent() {
        if (!this.studentForm.full_name.trim()) {
          alert('Vui lòng nhập Họ và tên học sinh!');
          return;
        }
        try {
          const res = await fetch('/api/classes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'save_student',
              ...this.studentForm
            })
          });
          const data = await res.json();
          if (data.ok) {
            this.showToast('✅ ' + data.message);
            this.showStudentEditModal = false;
            if (this.selectedClass) {
              await this.viewClassStudents(this.selectedClass);
            }
            await this.fetchClasses();
          } else {
            alert('Lỗi: ' + data.error);
          }
        } catch (e) {
          alert('Lỗi kết nối khi lưu học sinh!');
        }
      },

      async deleteStudent(stuId) {
        if (!confirm('Thầy có chắc chắn muốn xóa học sinh này khỏi lớp?')) return;
        try {
          const res = await fetch('/api/classes?student_id=' + encodeURIComponent(stuId), { method: 'DELETE' });
          const data = await res.json();
          if (data.ok) {
            this.selectedClassStudents = this.selectedClassStudents.filter(s => s.id !== stuId);
            this.showToast('Đã xóa học sinh khỏi danh sách');
            await this.fetchClasses();
          }
        } catch (e) {
          alert('Lỗi xóa học sinh');
        }
      },

      async deleteClass(cls) {
        if (!confirm('Thầy có chắc chắn muốn xóa lớp ' + cls.class_name + '? Toàn bộ danh sách học sinh của lớp này sẽ bị xóa!')) return;
        try {
          const res = await fetch('/api/classes?id=' + encodeURIComponent(cls.id), { method: 'DELETE' });
          const data = await res.json();
          if (data.ok) {
            this.showToast('Đã xóa lớp học');
            await this.fetchClasses();
          } else {
            alert('Lỗi: ' + data.error);
          }
        } catch (e) {
          alert('Lỗi xóa lớp');
        }
      },

      // Xuất danh sách lớp ra file CSV với UTF-8 BOM chuẩn để mở được trong Excel Tiếng Việt
      exportStudentsCSV() {
        if (!this.selectedClass || this.selectedClassStudents.length === 0) return;

        const headers = ['STT', 'MSHS', 'Họ và tên', 'Ngày sinh', 'Giới tính', 'Số điện thoại', 'Trạng thái'];
        const rows = this.selectedClassStudents.map((s, idx) => [
          s.student_number || (idx + 1),
          `"${s.student_code || ''}"`,
          `"${s.full_name || ''}"`,
          `"${s.date_of_birth || ''}"`,
          `"${s.gender || 'Nam'}"`,
          `"${s.phone || ''}"`,
          `"${s.status || 'Đang học'}"`
        ]);

        const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\r\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        const filename = `DS_${this.selectedClass.class_code}_${new Date().toISOString().slice(0, 10)}.csv`;
        link.setAttribute('href', url);
        link.setAttribute('download', filename);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        this.showToast('📊 Đã xuất danh sách lớp ra file Excel (CSV)!');
      }
    }));
  });
</script>
