---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminAuthGuard from '../../components/AdminAuthGuard.astro';
---

<BaseLayout title="Quản lý Lớp học & Học sinh - Cổng Giảng Dạy CNTT" noindex={true}>
  <section class="max-w-6xl mx-auto px-4 py-8">
    <AdminAuthGuard pageTitle="Quản lý Lớp & Học sinh">
      <div x-data="classesManager">
        <!-- Toast Notification -->
    <div
      x-show="toast.show"
      x-cloak
      x-transition
      class="fixed bottom-5 right-5 z-50 px-4 py-3 rounded-2xl shadow-xl border text-xs sm:text-sm font-semibold flex items-center gap-2"
      :class="toast.isError ? 'bg-rose-50 border-rose-200 text-rose-800' : 'bg-emerald-50 border-emerald-200 text-emerald-800'"
    >
      <span x-text="toast.message"></span>
    </div>

    <!-- Header bar -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 border-b border-gray-200 pb-5">
      <div>
        <div class="flex items-center gap-2 text-xs text-gray-500 mb-1">
          <a href="/admin" class="hover:underline text-primary-700 font-semibold">Bảng điều khiển Giảng viên</a>
          <span>/</span>
          <span class="text-gray-900 font-medium">Quản lý Lớp học & Học sinh</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight flex items-center gap-2.5">
          <span>👥</span>
          <span>Quản Lý Lớp Học, Lớp Ghép & Học Sinh</span>
        </h1>
        <p class="text-xs sm:text-sm text-gray-500 mt-1">
          Hệ thống Quản lý Đào tạo · Hỗ trợ Lớp chính khóa, <strong>Lớp ghép liên lớp & Ca sát hạch ghép</strong> · MSHS · Ngày sinh · Lớp gốc
        </p>

        <!-- Trạng thái CSDL -->
        <div class="mt-2.5 flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Cơ sở Dữ liệu Đào tạo: Đang hoạt động đồng bộ</span>
          </span>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 self-start sm:self-center">
        <!-- Nút Tạo Lớp Ghép liên lớp -->
        <button
          type="button"
          @click="openMergeModal()"
          class="px-3.5 py-2.5 rounded-xl bg-purple-700 hover:bg-purple-800 text-white text-xs sm:text-sm font-bold flex items-center gap-1.5 shadow-sm transition-all"
          title="Tạo lớp ghép hoặc ca thi đánh giá năng lực ghép từ nhiều lớp khác nhau"
        >
          <span>🔗</span>
          <span>Ghép Lớp / Ca Thi</span>
        </button>

        <!-- Nút Tạo Lớp Thường -->
        <button
          type="button"
          @click="showCreateClassModal = true"
          class="btn-primary text-xs sm:text-sm px-3.5 py-2.5 font-bold flex items-center gap-1.5 shadow-sm"
        >
          <span>➕</span>
          <span>Tạo Lớp Mới</span>
        </button>

        <!-- Nút Nạp Excel -->
        <button
          type="button"
          @click="openImportModal()"
          class="btn-secondary text-xs sm:text-sm px-3.5 py-2.5 font-bold flex items-center gap-1.5 shadow-sm border-gray-300 hover:bg-gray-50"
        >
          <span>📋</span>
          <span>Dán từ Excel</span>
        </button>
      </div>
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 mb-6">
      <div class="card p-4 flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center text-xl shrink-0">
          🏫
        </div>
        <div>
          <span class="text-xs text-gray-500 block">Lớp chính khóa</span>
          <strong class="text-xl font-bold text-gray-900 font-mono" x-text="classes.filter(c => !c.is_composite).length"></strong>
        </div>
      </div>

      <div class="card p-4 flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-700 flex items-center justify-center text-xl shrink-0">
          🔗
        </div>
        <div>
          <span class="text-xs text-gray-500 block">Lớp ghép / Ca thi</span>
          <strong class="text-xl font-bold text-purple-800 font-mono" x-text="classes.filter(c => c.is_composite).length"></strong>
        </div>
      </div>

      <div class="card p-4 flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl shrink-0">
          🎓
        </div>
        <div>
          <span class="text-xs text-gray-500 block">Tổng học sinh đã nạp</span>
          <strong class="text-xl font-bold text-emerald-800 font-mono" x-text="classes.reduce((sum, c) => sum + (c.student_count || 0), 0)"></strong>
        </div>
      </div>

      <div class="card p-4 flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center text-xl shrink-0">
          📅
        </div>
        <div>
          <span class="text-xs text-gray-500 block">Niên khóa đào tạo</span>
          <strong class="text-sm font-bold text-gray-800">2026 - 2027 (Hệ 9+3)</strong>
        </div>
      </div>
    </div>

    <!-- Filter Tabs (Tất cả / Lớp chính khóa / Lớp ghép) -->
    <div class="flex items-center gap-2 mb-4 border-b border-gray-200 pb-3">
      <button
        type="button"
        @click="classFilterTab = 'all'"
        class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all"
        :class="classFilterTab === 'all' ? 'bg-gray-900 text-white shadow-xs' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
      >
        Tất cả (<span x-text="classes.length"></span>)
      </button>

      <button
        type="button"
        @click="classFilterTab = 'standard'"
        class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5"
        :class="classFilterTab === 'standard' ? 'bg-primary-700 text-white shadow-xs' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
      >
        <span>🏫</span>
        <span>Lớp chính khóa (<span x-text="classes.filter(c => !c.is_composite).length"></span>)</span>
      </button>

      <button
        type="button"
        @click="classFilterTab = 'composite'"
        class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5"
        :class="classFilterTab === 'composite' ? 'bg-purple-700 text-white shadow-xs' : 'bg-purple-50 text-purple-800 hover:bg-purple-100'"
      >
        <span>🔗</span>
        <span>Lớp ghép liên lớp (<span x-text="classes.filter(c => c.is_composite).length"></span>)</span>
      </button>
    </div>

    <!-- Class Grid -->
    <div class="space-y-4">
      <!-- Loading skeleton -->
      <div x-show="loading" class="text-center py-10 text-gray-400 text-sm">
        Đang tải dữ liệu lớp học từ Cloudflare D1...
      </div>

      <!-- Empty state -->
      <div x-show="!loading && displayedClasses.length === 0" class="card text-center py-12 space-y-3">
        <span class="text-4xl block">📂</span>
        <h3 class="text-base font-bold text-gray-800">Chưa có lớp nào trong mục này</h3>
        <p class="text-xs text-gray-500 max-w-sm mx-auto">Thầy có thể bấm nút "Tạo Lớp Mới" hoặc "Ghép Lớp / Ca Thi" ở góc trên!</p>
      </div>

      <!-- Classes cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" x-show="!loading && displayedClasses.length > 0">
        <template x-for="c in displayedClasses" :key="c.id || c.class_code">
          <div
            class="card p-5 flex flex-col justify-between space-y-4 transition-all shadow-xs border"
            :class="c.is_composite ? 'border-purple-200 bg-gradient-to-br from-white to-purple-50/20 hover:border-purple-400' : 'hover:border-primary-400'"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <div class="flex items-center gap-1.5">
                  <span
                    class="text-xs font-mono font-bold px-2.5 py-0.5 rounded-full"
                    :class="c.is_composite ? 'bg-purple-100 text-purple-900 border border-purple-200' : 'bg-primary-100 text-primary-800'"
                    x-text="c.class_code"
                  ></span>
                  <span
                    x-show="c.is_composite"
                    class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-purple-700 text-white"
                  >
                    🔗 LỚP GHÉP
                  </span>
                </div>

                <span
                  class="text-[11px] font-mono px-2 py-0.5 rounded-full font-bold"
                  :class="c.student_count > 0 ? (c.is_composite ? 'bg-purple-100 text-purple-800' : 'bg-emerald-100 text-emerald-800') : 'bg-gray-100 text-gray-500'"
                  x-text="c.student_count > 0 ? (c.student_count + ' Học sinh') : 'Chưa có HS'"
                ></span>
              </div>

              <h3 class="text-base font-bold text-gray-900 leading-snug" x-text="c.class_name"></h3>
              <p class="text-xs text-gray-500 mt-1" x-text="'Niên khóa: ' + (c.academic_year || '2026-2027')"></p>

              <!-- Chi tiết nguồn ghép nếu có -->
              <div x-show="c.is_composite && c.source_classes" class="mt-2 text-[11px] text-purple-800 bg-purple-50/80 px-2.5 py-1.5 rounded-lg border border-purple-100">
                <span class="font-bold">Ghép từ:</span>
                <span class="font-mono" x-text="formatSourceClasses(c.source_classes)"></span>
              </div>
            </div>

            <!-- Action buttons -->
            <div class="pt-3 border-t border-gray-100 flex flex-wrap items-center justify-between gap-2 text-xs">
              <div class="flex items-center gap-1.5">
                <button
                  type="button"
                  @click="viewClassStudents(c)"
                  class="px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold transition-colors flex items-center gap-1"
                  title="Xem và chỉnh sửa danh sách học sinh"
                >
                  <span>👥</span>
                  <span>DS Lớp</span>
                </button>

                <button
                  type="button"
                  @click="openImportModal(c)"
                  class="px-2.5 py-1.5 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold transition-colors flex items-center gap-1"
                  title="Dán nhanh danh sách học sinh từ Excel vào lớp này"
                >
                  <span>📥</span>
                  <span>Nạp Excel</span>
                </button>
              </div>

              <div class="flex items-center gap-2">
                <a
                  :href="'/admin/scores?class=' + encodeURIComponent(c.class_name)"
                  class="text-primary-700 hover:underline font-bold"
                >
                  Bảng điểm →
                </a>

                <button
                  type="button"
                  @click="deleteClass(c)"
                  class="text-gray-400 hover:text-rose-600 p-1 rounded"
                  title="Xóa lớp học"
                >
                  🗑️
                </button>
              </div>
            </div>
          </div>
        </template>
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- MODAL 0: GHÉP LỚP TỰ ĐỘNG TỪ CÁC LỚP CÓ SẴN (MERGE CLASSES)    -->
    <!-- Đột phá: Ghép học sinh từ nhiều lớp thành 1 ca sát hạch chung   -->
    <!-- ============================================================== -->
    <div
      x-show="showMergeModal"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4"
    >
      <div
        class="bg-white rounded-3xl p-6 sm:p-7 max-w-lg w-full shadow-2xl border border-gray-200 space-y-4 max-h-[90vh] overflow-y-auto"
        @click.away="showMergeModal = false"
      >
        <div class="flex items-center justify-between border-b pb-3">
          <div class="flex items-center gap-2">
            <span class="text-2xl">🔗</span>
            <div>
              <h3 class="font-extrabold text-gray-900 text-base">Tạo Lớp Ghép / Ca Sát Hạch Liên Lớp</h3>
              <p class="text-xs text-gray-500">Ghép học sinh từ nhiều lớp gốc thành 1 lớp/ca thi chung</p>
            </div>
          </div>
          <button @click="showMergeModal = false" class="text-gray-400 hover:text-gray-600 text-lg">✕</button>
        </div>

        <form @submit.prevent="submitMergeClasses()" class="space-y-4 text-xs sm:text-sm">
          <div>
            <label class="block font-bold text-gray-700 mb-1">Mã lớp ghép viết tắt (*)</label>
            <input
              type="text"
              x-model="mergeForm.compositeCode"
              required
              placeholder="Ví dụ: GHEP_PHANCUNG_CA1, CA1_THUD_QTM..."
              class="w-full px-3 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 font-mono text-sm uppercase"
            />
          </div>

          <div>
            <label class="block font-bold text-gray-700 mb-1">Tên lớp ghép / Ca sát hạch (*)</label>
            <input
              type="text"
              x-model="mergeForm.compositeName"
              required
              placeholder="Ví dụ: Ca 1: Sát hạch Phần cứng THUD + QTM"
              class="w-full px-3 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 text-sm font-semibold"
            />
          </div>

          <div>
            <label class="block font-bold text-gray-700 mb-1">Niên khóa</label>
            <input
              type="text"
              x-model="mergeForm.academicYear"
              class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm"
            />
          </div>

          <!-- Chọn các lớp nguồn để ghép -->
          <div class="space-y-2 border-t pt-3">
            <div class="flex items-center justify-between">
              <label class="block font-bold text-gray-800">
                Chọn các lớp nguồn để ghép học sinh (*):
              </label>
              <span class="text-xs font-mono font-bold text-purple-800" x-text="'Đã chọn: ' + mergeForm.sourceClassIds.length + ' lớp'"></span>
            </div>

            <div class="max-h-48 overflow-y-auto border border-gray-200 rounded-2xl p-2.5 bg-gray-50 space-y-1.5">
              <template x-for="c in standardClasses" :key="c.id">
                <label class="flex items-center justify-between p-2 rounded-xl bg-white border border-gray-100 hover:border-purple-300 cursor-pointer text-xs">
                  <div class="flex items-center gap-2.5">
                    <input
                      type="checkbox"
                      :value="c.id"
                      x-model="mergeForm.sourceClassIds"
                      class="rounded text-purple-700 w-4 h-4 focus:ring-purple-500"
                    />
                    <div>
                      <strong class="text-gray-900 block font-semibold" x-text="c.class_name"></strong>
                      <span class="text-[11px] font-mono text-gray-500" x-text="'Mã: ' + c.class_code"></span>
                    </div>
                  </div>
                  <span class="font-mono font-bold text-xs px-2 py-0.5 rounded-full bg-gray-100 text-gray-700" x-text="(c.student_count || 0) + ' HS'"></span>
                </label>
              </template>
            </div>

            <!-- Tổng kết số học sinh dự kiến ghép -->
            <div class="p-3 bg-purple-50 border border-purple-200 rounded-xl text-xs text-purple-950 flex items-center justify-between">
              <span>Tổng số học sinh dự kiến nạp vào lớp ghép:</span>
              <strong class="text-sm font-mono text-purple-900" x-text="calculateMergeTotal() + ' học sinh'"></strong>
            </div>
            <p class="text-[11px] text-gray-500 italic">
              💡 Mỗi học sinh khi đưa vào lớp ghép sẽ <strong>tự động lưu kèm Mã lớp gốc</strong>. Khi xuất bảng điểm, thầy có thể xuất toàn bộ ca thi hoặc tách riêng từng lớp gốc cực kỳ tiện lợi!
            </p>
          </div>

          <div class="flex justify-end gap-2 pt-3 border-t">
            <button
              type="button"
              @click="showMergeModal = false"
              class="btn-secondary text-xs px-4 py-2"
            >
              Hủy
            </button>
            <button
              type="submit"
              :disabled="mergeForm.sourceClassIds.length === 0"
              class="btn-primary text-xs px-5 py-2 font-bold shadow bg-purple-700 hover:bg-purple-800"
              :class="mergeForm.sourceClassIds.length === 0 ? 'opacity-50 cursor-not-allowed' : ''"
            >
              <span>🔗 Xác Nhận Tạo Lớp Ghép</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- MODAL 1: TẠO LỚP HỌC MỚI (CHÍNH KHÓA)                           -->
    <!-- ============================================================== -->
    <div
      x-show="showCreateClassModal"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4"
    >
      <div
        class="bg-white rounded-3xl p-6 sm:p-7 max-w-md w-full shadow-2xl border border-gray-200 space-y-4"
        @click.away="showCreateClassModal = false"
      >
        <div class="flex items-center justify-between border-b pb-3">
          <h3 class="font-extrabold text-gray-900 text-base flex items-center gap-2">
            <span>🏫</span>
            <span>Tạo Lớp Học Mới</span>
          </h3>
          <button @click="showCreateClassModal = false" class="text-gray-400 hover:text-gray-600 text-lg">✕</button>
        </div>

        <form @submit.prevent="createClass()" class="space-y-3.5 text-xs sm:text-sm">
          <div>
            <label class="block font-bold text-gray-700 mb-1">Mã lớp viết tắt (*)</label>
            <input
              type="text"
              x-model="newClass.code"
              required
              placeholder="Ví dụ: THUD_K26A, OTO_93..."
              class="w-full px-3 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 font-mono text-sm uppercase"
            />
            <span class="text-[11px] text-gray-500 mt-0.5 block">Nên viết hoa liền không dấu</span>
          </div>

          <div>
            <label class="block font-bold text-gray-700 mb-1">Tên lớp đầy đủ (*)</label>
            <input
              type="text"
              x-model="newClass.name"
              required
              placeholder="Ví dụ: Tin học ứng dụng K26A"
              class="w-full px-3 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 text-sm"
            />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-gray-700 mb-1">Niên khóa đào tạo</label>
              <input
                type="text"
                x-model="newClass.academicYear"
                placeholder="2026-2027"
                class="w-full px-3 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 text-sm"
              />
            </div>

            <div>
              <label class="block font-bold text-gray-700 mb-1">Phân loại lớp</label>
              <select
                x-model.number="newClass.isComposite"
                class="w-full px-3 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 text-sm font-semibold"
              >
                <option value="0">Lớp chính khóa</option>
                <option value="1">Lớp ghép / Học phần</option>
              </select>
            </div>
          </div>

          <div class="flex justify-end gap-2 pt-3 border-t">
            <button
              type="button"
              @click="showCreateClassModal = false"
              class="btn-secondary text-xs px-4 py-2"
            >
              Hủy
            </button>
            <button
              type="submit"
              class="btn-primary text-xs px-5 py-2 font-bold shadow"
            >
              Xác Nhận Tạo Lớp
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- MODAL 2: NHẬP HỌC SINH TỪ EXCEL (1-CLICK PASTE)                -->
    <!-- Hỗ trợ cột Lớp gốc khi nạp vào Lớp ghép                         -->
    <!-- ============================================================== -->
    <div
      x-show="showImportModal"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4"
    >
      <div
        class="bg-white rounded-3xl p-6 sm:p-8 max-w-3xl w-full shadow-2xl border border-gray-200 space-y-4 max-h-[92vh] overflow-y-auto"
        @click.away="showImportModal = false"
      >
        <div class="flex items-center justify-between border-b pb-3">
          <div>
            <h3 class="font-extrabold text-gray-900 text-base sm:text-lg flex items-center gap-2">
              <span>📋</span>
              <span>Dán Danh Sách Học Sinh Từ Excel</span>
            </h3>
            <p class="text-xs text-gray-500 mt-0.5">
              Hệ thống tự nhận diện các cột: <strong>STT | MSHS | Họ và tên | Lớp gốc | Ngày sinh | Giới tính</strong>
            </p>
          </div>
          <button @click="showImportModal = false" class="text-gray-400 hover:text-gray-600 text-lg">✕</button>
        </div>

        <div class="space-y-4 text-xs sm:text-sm">
          <!-- Chọn lớp nhận danh sách -->
          <div>
            <label class="block font-bold text-gray-700 mb-1">Nạp vào Lớp học:</label>
            <select
              x-model="importData.classId"
              @change="onImportClassChange()"
              class="w-full px-3 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 font-semibold"
            >
              <template x-for="c in classes" :key="c.id">
                <option :value="c.id" x-text="(c.is_composite ? '🔗 [Lớp ghép] ' : '🏫 ') + c.class_code + ' - ' + c.class_name"></option>
              </template>
            </select>
          </div>

          <!-- Mẫu định dạng tham khảo -->
          <div class="bg-blue-50/60 border border-blue-200/80 rounded-2xl p-3.5 text-xs text-blue-900 space-y-1">
            <div class="font-bold flex items-center gap-1.5 text-blue-950">
              <span>💡</span>
              <span>Định dạng khuyên dùng (Dán trực tiếp từ Excel / vnEdu / SMAS):</span>
            </div>
            <p class="text-[11px] text-blue-800 font-mono">
              STT [Tab] MSHS [Tab] Họ và tên [Tab] Lớp gốc (Tùy chọn) [Tab] Ngày sinh [Tab] Giới tính
            </p>
            <p class="text-[11px] text-blue-700">
              * Khi nạp vào <strong>Lớp ghép</strong>, nếu dòng học sinh có ghi mã lớp (ví dụ: <code class="bg-white px-1 py-0.5 rounded text-blue-900 font-mono">THUD_K26A</code>), hệ thống sẽ tự động gán vào cột <strong>Lớp gốc</strong>.
            </p>
          </div>

          <!-- Textarea dán từ excel -->
          <div>
            <label class="block font-bold text-gray-700 mb-1">Dán dữ liệu từ file Excel vào đây:</label>
            <textarea
              x-model="importData.rawText"
              @input="parseExcelText()"
              rows="6"
              placeholder="Ví dụ dán từ Excel:&#10;1	24TH0101	Nguyễn Văn An	THUD_K26A	15/04/2009	Nam&#10;2	24TH0102	Trần Thị Bích	THUD_K26A	20/08/2009	Nữ&#10;3	24QM0101	Lê Hoàng Cường	QTM_K26	03/11/2008	Nam&#10;4	24OT0105	Phạm Mỹ Dung	OTO_93	12/01/2009	Nữ"
              class="w-full px-3 py-2 border border-gray-300 rounded-xl font-mono text-xs focus:ring-2 focus:ring-primary-500 leading-relaxed"
            ></textarea>
          </div>

          <!-- Tùy chọn ghi đè -->
          <label class="flex items-center gap-2 cursor-pointer select-none">
            <input type="checkbox" x-model="importData.overwrite" class="rounded text-primary-700 w-4 h-4" />
            <span class="text-xs text-gray-700 font-medium">Ghi đè danh sách (Xóa sạch danh sách cũ của lớp này trước khi nạp mới)</span>
          </label>

          <!-- Live Preview Table -->
          <div x-show="importData.parsedStudents.length > 0" class="border border-gray-200 rounded-2xl p-4 bg-gray-50 space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-bold text-gray-800 text-xs">
                Xem trước kết quả nhận diện:
                <span class="text-emerald-700 font-extrabold" x-text="importData.parsedStudents.length + ' học sinh'"></span>
              </span>
              <span class="text-[11px] text-gray-500 font-mono">Chuẩn CSDL Cloudflare D1</span>
            </div>

            <div class="max-h-52 overflow-y-auto border border-gray-200 rounded-xl bg-white shadow-inner">
              <table class="w-full text-xs text-left">
                <thead class="bg-gray-100 text-gray-600 font-mono sticky top-0 border-b border-gray-200">
                  <tr>
                    <th class="py-2 px-3 w-12 text-center">STT</th>
                    <th class="py-2 px-3 w-28">MSHS</th>
                    <th class="py-2 px-3">Họ và tên học sinh</th>
                    <th class="py-2 px-3 w-28">Lớp gốc</th>
                    <th class="py-2 px-3 w-28">Ngày sinh</th>
                    <th class="py-2 px-3 w-16 text-center">Giới tính</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                  <template x-for="st in importData.parsedStudents.slice(0, 20)" :key="st.student_number + '-' + st.student_code">
                    <tr class="hover:bg-blue-50/50">
                      <td class="py-1.5 px-3 text-center font-mono text-gray-500" x-text="st.student_number"></td>
                      <td class="py-1.5 px-3 font-mono font-bold text-primary-700" x-text="st.student_code"></td>
                      <td class="py-1.5 px-3 font-semibold text-gray-900" x-text="st.full_name"></td>
                      <td class="py-1.5 px-3 font-mono text-purple-800 font-bold" x-text="st.original_class || '-'"></td>
                      <td class="py-1.5 px-3 font-mono text-gray-600" x-text="st.date_of_birth || '-'"></td>
                      <td class="py-1.5 px-3 text-center">
                        <span
                          class="px-2 py-0.5 rounded-full text-[10px] font-bold"
                          :class="st.gender === 'Nữ' ? 'bg-pink-100 text-pink-700' : 'bg-blue-100 text-blue-700'"
                          x-text="st.gender"
                        ></span>
                      </td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>

            <p x-show="importData.parsedStudents.length > 20" class="text-[11px] text-gray-500 italic text-center">
              ... và <span x-text="importData.parsedStudents.length - 20"></span> học sinh nữa tiếp theo.
            </p>
          </div>

          <!-- Submit Buttons -->
          <div class="flex justify-end gap-2.5 pt-3 border-t">
            <button
              type="button"
              @click="showImportModal = false"
              class="btn-secondary text-xs px-4 py-2"
            >
              Đóng
            </button>

            <button
              type="button"
              @click="submitImport()"
              :disabled="importData.parsedStudents.length === 0"
              class="btn-primary text-xs px-5 py-2.5 font-bold shadow-md bg-emerald-600 hover:bg-emerald-700 flex items-center gap-1.5"
              :class="importData.parsedStudents.length === 0 ? 'opacity-50 cursor-not-allowed' : ''"
            >
              <span>💾</span>
              <span>Lưu vào CSDL Cloudflare D1</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- MODAL 3: XEM VÀ QUẢN LÝ DANH SÁCH HỌC SINH CỦA LỚP            -->
    <!-- Hỗ trợ lọc theo Lớp gốc trong Lớp ghép, xuất CSV               -->
    <!-- ============================================================== -->
    <div
      x-show="showStudentListModal"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4"
    >
      <div
        class="bg-white rounded-3xl p-6 sm:p-8 max-w-5xl w-full shadow-2xl border border-gray-200 space-y-4 max-h-[92vh] overflow-y-auto"
        @click.away="showStudentListModal = false"
      >
        <!-- Modal Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b pb-3">
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xl" x-text="selectedClass && selectedClass.is_composite ? '🔗' : '🎓'"></span>
              <h3 class="font-extrabold text-gray-900 text-base sm:text-lg">
                <span x-text="selectedClass ? selectedClass.class_name : 'Danh Sách Học Sinh'"></span>
              </h3>
              <span
                x-show="selectedClass && selectedClass.is_composite"
                class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-700 text-white"
              >
                LỚP GHÉP
              </span>
            </div>
            <div class="flex items-center gap-2 text-xs text-gray-500 font-mono mt-0.5">
              <span>Mã lớp: <strong class="text-primary-800" x-text="selectedClass ? selectedClass.class_code : ''"></strong></span>
              <span>·</span>
              <span>Niên khóa: <span x-text="selectedClass ? selectedClass.academic_year : '2026-2027'"></span></span>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <!-- Xuất file CSV / Excel -->
            <button
              type="button"
              @click="exportStudentsCSV()"
              :disabled="selectedClassStudents.length === 0"
              class="px-3 py-1.5 rounded-xl border border-gray-300 text-gray-700 hover:bg-gray-100 text-xs font-bold flex items-center gap-1 shadow-2xs"
              :class="selectedClassStudents.length === 0 ? 'opacity-50 cursor-not-allowed' : ''"
              title="Xuất danh sách lớp ra file Excel (CSV chuẩn UTF-8)"
            >
              <span>📊</span>
              <span>Xuất Excel</span>
            </button>

            <!-- Nút Thêm 1 học sinh lẻ -->
            <button
              type="button"
              @click="openAddStudentModal()"
              class="btn-primary text-xs px-3.5 py-1.5 font-bold flex items-center gap-1 shadow-xs"
            >
              <span>➕</span>
              <span>Thêm HS</span>
            </button>

            <button @click="showStudentListModal = false" class="text-gray-400 hover:text-gray-600 text-lg p-1">✕</button>
          </div>
        </div>

        <!-- Filter & Search Toolbar -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 bg-gray-50 p-3 rounded-2xl border border-gray-200">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs text-gray-600 font-medium">Sĩ số:</span>
            <span class="px-2 py-0.5 rounded-full bg-primary-100 text-primary-900 font-bold font-mono text-xs" x-text="selectedClassStudents.length + ' học sinh'"></span>
            <span class="text-gray-300">|</span>
            <span class="text-[11px] text-blue-700 font-semibold" x-text="'👦 ' + countGender('Nam') + ' Nam'"></span>
            <span class="text-[11px] text-pink-700 font-semibold" x-text="'👧 ' + countGender('Nữ') + ' Nữ'"></span>

            <!-- Phân loại số lượng theo Lớp gốc nếu là Lớp ghép -->
            <template x-if="selectedClass && selectedClass.is_composite && originalClassList.length > 1">
              <div class="flex items-center gap-1 ml-2">
                <span class="text-gray-300">|</span>
                <label class="text-[11px] text-gray-600 font-bold">Lọc theo Lớp gốc:</label>
                <select
                  x-model="filterOriginalClass"
                  class="text-[11px] py-1 px-2 border border-gray-300 rounded-lg bg-white font-mono font-bold text-purple-900"
                >
                  <option value="">-- Tất cả các lớp gốc --</option>
                  <template x-for="oc in originalClassList" :key="oc">
                    <option :value="oc" x-text="oc"></option>
                  </template>
                </select>
              </div>
            </template>
          </div>

          <div class="flex items-center gap-2">
            <!-- Search input -->
            <div class="relative grow sm:grow-0 sm:w-64">
              <input
                type="text"
                x-model="studentFilterText"
                placeholder="Tìm MSHS, Tên, Lớp gốc..."
                class="w-full pl-8 pr-3 py-1.5 border border-gray-300 rounded-xl text-xs focus:ring-2 focus:ring-primary-500 focus:outline-none bg-white"
              />
              <span class="absolute left-2.5 top-1.5 text-gray-400 text-xs">🔍</span>
            </div>

            <!-- Nạp Excel modal button -->
            <button
              type="button"
              @click="showStudentListModal = false; openImportModal(selectedClass);"
              class="px-2.5 py-1.5 rounded-xl bg-blue-100 hover:bg-blue-200 text-blue-800 text-xs font-bold whitespace-nowrap"
            >
              📥 Nạp Excel
            </button>
          </div>
        </div>

        <!-- Student Table -->
        <div class="space-y-4 text-xs sm:text-sm">
          <!-- Loading skeleton -->
          <div x-show="loadingStudents" class="text-center py-10 text-gray-400 text-xs">
            Đang tải danh sách học sinh từ CSDL D1...
          </div>

          <!-- Empty state -->
          <div x-show="!loadingStudents && selectedClassStudents.length === 0" class="p-8 text-center text-gray-500 border border-dashed rounded-2xl bg-gray-50 space-y-2">
            <span class="text-3xl block">📋</span>
            <p class="font-bold text-gray-700">Lớp này chưa có danh sách học sinh</p>
            <p class="text-xs text-gray-500">Thầy bấm nút "Nạp Excel" để dán danh sách hoặc bấm "Thêm HS" để nhập từng em nhé!</p>
          </div>

          <!-- Main Table -->
          <div x-show="!loadingStudents && selectedClassStudents.length > 0" class="border border-gray-200 rounded-2xl overflow-hidden shadow-2xs">
            <div class="max-h-[50vh] overflow-y-auto">
              <table class="w-full text-xs text-left">
                <thead class="bg-gray-100 text-gray-700 uppercase font-mono sticky top-0 border-b border-gray-200">
                  <tr>
                    <th class="py-2.5 px-3 w-12 text-center">STT</th>
                    <th class="py-2.5 px-3 w-28">MSHS</th>
                    <th class="py-2.5 px-4">Họ và tên học sinh</th>
                    <th class="py-2.5 px-3 w-28">Lớp gốc</th>
                    <th class="py-2.5 px-3 w-28">Ngày sinh</th>
                    <th class="py-2.5 px-3 w-16 text-center">Giới tính</th>
                    <th class="py-2.5 px-3 w-24 text-center">Trạng thái</th>
                    <th class="py-2.5 px-3 text-right w-24">Thao tác</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                  <template x-for="(stu, idx) in filteredStudents" :key="stu.id || (stu.student_code + '-' + idx)">
                    <tr class="hover:bg-blue-50/40 transition-colors">
                      <td class="py-2 px-3 text-center font-mono text-gray-500" x-text="stu.student_number || (idx + 1)"></td>
                      <td class="py-2 px-3 font-mono font-bold text-primary-700" x-text="stu.student_code || '-'"></td>
                      <td class="py-2 px-4 font-semibold text-gray-900" x-text="stu.full_name"></td>
                      <td class="py-2 px-3">
                        <span
                          class="px-2 py-0.5 rounded font-mono font-bold text-[11px]"
                          :class="stu.original_class ? 'bg-purple-100 text-purple-900 border border-purple-200' : 'text-gray-400'"
                          x-text="stu.original_class || (selectedClass ? selectedClass.class_code : '-')"
                        ></span>
                      </td>
                      <td class="py-2 px-3 font-mono text-gray-600">
                        <span x-show="stu.date_of_birth" x-text="'📅 ' + stu.date_of_birth"></span>
                        <span x-show="!stu.date_of_birth" class="text-gray-400 italic">Chưa có</span>
                      </td>
                      <td class="py-2 px-3 text-center">
                        <span
                          class="px-2 py-0.5 rounded-full text-[10px] font-bold inline-block"
                          :class="stu.gender === 'Nữ' ? 'bg-pink-100 text-pink-700' : 'bg-blue-100 text-blue-700'"
                          x-text="stu.gender || 'Nam'"
                        ></span>
                      </td>
                      <td class="py-2 px-3 text-center">
                        <span
                          class="px-2 py-0.5 rounded-full text-[10px] font-bold inline-block"
                          :class="stu.status === 'Đang học' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'"
                          x-text="stu.status || 'Đang học'"
                        ></span>
                      </td>
                      <td class="py-2 px-3 text-right">
                        <div class="flex items-center justify-end gap-1.5">
                          <button
                            type="button"
                            @click="openEditStudentModal(stu)"
                            class="text-blue-600 hover:text-blue-800 p-1 hover:bg-blue-50 rounded"
                            title="Sửa thông tin học sinh"
                          >
                            ✏️
                          </button>
                          <button
                            type="button"
                            @click="deleteStudent(stu.id)"
                            class="text-rose-500 hover:text-rose-700 p-1 hover:bg-rose-50 rounded"
                            title="Xóa học sinh này"
                          >
                            🗑️
                          </button>
                        </div>
                      </td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>

            <!-- No search results -->
            <div x-show="filteredStudents.length === 0 && selectedClassStudents.length > 0" class="py-8 text-center text-gray-500 text-xs">
              Không tìm thấy học sinh nào khớp với bộ lọc hiện tại.
            </div>
          </div>

          <div class="flex items-center justify-between pt-2 border-t text-xs text-gray-500">
            <span>Hiển thị <strong x-text="filteredStudents.length"></strong> / <span x-text="selectedClassStudents.length"></span> học sinh</span>
            <button
              type="button"
              @click="showStudentListModal = false"
              class="btn-secondary text-xs px-4 py-2"
            >
              Đóng
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- MODAL 4: THÊM HOẶC CHỈNH SỬA THÔNG TIN 1 HỌC SINH             -->
    <!-- ============================================================== -->
    <div
      x-show="showStudentEditModal"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4"
    >
      <div
        class="bg-white rounded-3xl p-6 sm:p-7 max-w-md w-full shadow-2xl border border-gray-200 space-y-4"
        @click.away="showStudentEditModal = false"
      >
        <div class="flex items-center justify-between border-b pb-3">
          <h3 class="font-extrabold text-gray-900 text-base flex items-center gap-2">
            <span>🎓</span>
            <span x-text="studentForm.id ? 'Chỉnh Sửa Hồ Sơ Học Sinh' : 'Thêm Học Sinh Mới'"></span>
          </h3>
          <button @click="showStudentEditModal = false" class="text-gray-400 hover:text-gray-600 text-lg">✕</button>
        </div>

        <form @submit.prevent="saveSingleStudent()" class="space-y-3.5 text-xs sm:text-sm">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-gray-700 mb-1">Số thứ tự (STT)</label>
              <input
                type="number"
                min="1"
                x-model.number="studentForm.student_number"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-xl font-mono text-sm focus:ring-2 focus:ring-primary-500"
              />
            </div>

            <div>
              <label class="block font-bold text-gray-700 mb-1">Mã số HS (MSHS) (*)</label>
              <input
                type="text"
                x-model="studentForm.student_code"
                placeholder="24TH0101..."
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-xl font-mono text-sm uppercase focus:ring-2 focus:ring-primary-500"
              />
            </div>
          </div>

          <div>
            <label class="block font-bold text-gray-700 mb-1">Họ và tên học sinh (*)</label>
            <input
              type="text"
              x-model="studentForm.full_name"
              placeholder="Ví dụ: Nguyễn Văn An"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 font-semibold"
            />
          </div>

          <!-- Lớp gốc -->
          <div>
            <label class="block font-bold text-gray-700 mb-1">Lớp gốc / Lớp sinh hoạt</label>
            <input
              type="text"
              x-model="studentForm.original_class"
              placeholder="Ví dụ: THUD_K26A, QTM_K26..."
              class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm font-mono focus:ring-2 focus:ring-primary-500"
            />
            <span class="text-[11px] text-gray-500 mt-0.5 block">Đặc biệt quan trọng với Lớp ghép để tách bảng điểm báo cáo</span>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-gray-700 mb-1">Ngày sinh (DD/MM/YYYY)</label>
              <input
                type="text"
                x-model="studentForm.date_of_birth"
                placeholder="15/04/2009"
                class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm font-mono focus:ring-2 focus:ring-primary-500"
              />
            </div>

            <div>
              <label class="block font-bold text-gray-700 mb-1">Giới tính</label>
              <select
                x-model="studentForm.gender"
                class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-primary-500"
              >
                <option value="Nam">Nam</option>
                <option value="Nữ">Nữ</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-gray-700 mb-1">Số điện thoại liên hệ</label>
              <input
                type="text"
                x-model="studentForm.phone"
                placeholder="0912..."
                class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm font-mono focus:ring-2 focus:ring-primary-500"
              />
            </div>

            <div>
              <label class="block font-bold text-gray-700 mb-1">Trạng thái học</label>
              <select
                x-model="studentForm.status"
                class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-primary-500"
              >
                <option value="Đang học">Đang học</option>
                <option value="Bảo lưu">Bảo lưu</option>
                <option value="Nghỉ học">Nghỉ học</option>
              </select>
            </div>
          </div>

          <div class="flex justify-end gap-2 pt-3 border-t">
            <button
              type="button"
              @click="showStudentEditModal = false"
              class="btn-secondary text-xs px-4 py-2"
            >
              Hủy
            </button>
            <button
              type="submit"
              class="btn-primary text-xs px-5 py-2 font-bold shadow bg-emerald-600 hover:bg-emerald-700"
            >
              <span>💾 Lưu Thông Tin</span>
            </button>
          </div>
        </form>
      </div>
    </div>
      </div>
    </AdminAuthGuard>
  </section>
</BaseLayout>

<script is:inline>
  document.addEventListener('alpine:init', () => {
    Alpine.data('classesManager', () => ({
      classes: [],
      loading: true,
      classFilterTab: 'all', // 'all', 'standard', 'composite'

      showCreateClassModal: false,
      showMergeModal: false,
      showImportModal: false,
      showStudentListModal: false,
      showStudentEditModal: false,

      newClass: {
        code: '',
        name: '',
        academicYear: '2026-2027',
        isComposite: 0
      },

      mergeForm: {
        compositeCode: '',
        compositeName: '',
        academicYear: '2026-2027',
        sourceClassIds: []
      },

      importData: {
        classId: '',
        rawText: '',
        overwrite: true,
        parsedStudents: []
      },

      selectedClass: null,
      selectedClassStudents: [],
      loadingStudents: false,
      studentFilterText: '',
      filterOriginalClass: '',

      studentForm: {
        id: null,
        class_id: '',
        student_number: 1,
        student_code: '',
        full_name: '',
        date_of_birth: '',
        gender: 'Nam',
        phone: '',
        status: 'Đang học',
        original_class: ''
      },

      toast: { show: false, message: '', isError: false },
      showToast(msg, isErr = false) {
        this.toast = { show: true, message: msg, isError: isErr };
        setTimeout(() => { this.toast.show = false; }, 4000);
      },

      init() {
        this.fetchClasses();
      },

      get displayedClasses() {
        if (this.classFilterTab === 'standard') return this.classes.filter(c => !c.is_composite);
        if (this.classFilterTab === 'composite') return this.classes.filter(c => c.is_composite);
        return this.classes;
      },

      get standardClasses() {
        return this.classes.filter(c => !c.is_composite);
      },

      get originalClassList() {
        const set = new Set();
        this.selectedClassStudents.forEach(s => {
          if (s.original_class) set.add(s.original_class);
        });
        return Array.from(set);
      },

      get filteredStudents() {
        const query = (this.studentFilterText || '').trim().toLowerCase();
        const origFilter = (this.filterOriginalClass || '').trim();

        return this.selectedClassStudents.filter(stu => {
          if (origFilter && (stu.original_class || '') !== origFilter) {
            return false;
          }
          if (!query) return true;
          const name = (stu.full_name || '').toLowerCase();
          const code = (stu.student_code || '').toLowerCase();
          const orig = (stu.original_class || '').toLowerCase();
          return name.includes(query) || code.includes(query) || orig.includes(query);
        });
      },

      countGender(g) {
        return this.selectedClassStudents.filter(s => (s.gender || 'Nam') === g).length;
      },

      formatSourceClasses(jsonStr) {
        try {
          const arr = JSON.parse(jsonStr);
          return Array.isArray(arr) ? arr.join(', ') : jsonStr;
        } catch (e) {
          return jsonStr;
        }
      },

      calculateMergeTotal() {
        let sum = 0;
        this.mergeForm.sourceClassIds.forEach(id => {
          const found = this.classes.find(c => c.id === id);
          if (found) sum += (found.student_count || 0);
        });
        return sum;
      },

      findStudentsForClass(store, cls) {
        if (!store || !cls) return [];
        // 1. Kiểm tra chính xác store[cls.id]
        if (Array.isArray(store[cls.id]) && store[cls.id].length > 0) {
          return store[cls.id];
        }
        // 2. Kiểm tra theo mã lớp (ví dụ: '03THA9')
        if (cls.class_code && Array.isArray(store[cls.class_code]) && store[cls.class_code].length > 0) {
          return store[cls.class_code];
        }
        // 3. Quét tất cả các key xem có key nào chứa mã lớp (ví dụ cls_03tha9_xyz)
        const cleanTarget = (cls.class_code || '').toLowerCase().replace(/[^a-z0-9]/g, '');
        if (cleanTarget) {
          for (const val of Object.values(store)) {
            const cleanKey = key.toLowerCase().replace(/[^a-z0-9]/g, '');
            if (cleanKey.includes(cleanTarget) && Array.isArray(val) && val.length > 0) {
              return val;
            }
          }
        }
        // 4. Quét từng học sinh trong tất cả các danh sách
        for (const val of Object.values(store)) {
          if (Array.isArray(val) && val.length > 0) {
            const matched = val.filter(s => 
              (s.original_class && s.original_class.toUpperCase() === (cls.class_code || '').toUpperCase()) ||
              (s.class_id && s.class_id.toLowerCase().replace(/[^a-z0-9]/g, '').includes(cleanTarget))
            );
            if (matched.length > 0) {
              return matched;
            }
          }
        }
        return [];
      },

      async fetchClasses() {
        this.loading = true;
        // 1. Tải tức thì từ localStorage
        const localClasses = (localStorage.getItem('CNTT_CLASSES') || localStorage.getItem('CNTT_CLASSES'));
        if (localClasses) {
          try {
            this.classes = JSON.parse(localClasses);
          } catch(e){}
        }

        // Tự động quét và phục hồi học sinh cho từng lớp
        let allStudentsStore = {};
        try {
          allStudentsStore = JSON.parse((localStorage.getItem('CNTT_STUDENTS') || localStorage.getItem('CNTT_STUDENTS')) || '{}');
        } catch(e){}

        if (Array.isArray(this.classes)) {
          this.classes.forEach(c => {
            const stus = this.findStudentsForClass(allStudentsStore, c);
            c.student_count = stus.length;
            if (stus.length > 0) {
              allStudentsStore[c.id] = stus;
              allStudentsStore[c.class_code] = stus;
            }
          });
          try {
            localStorage.setItem('CNTT_STUDENTS', JSON.stringify(allStudentsStore));
            localStorage.setItem('CNTT_CLASSES', JSON.stringify(this.classes));
          } catch(e){}
        }

        // 2. Thử đồng bộ từ Server CSDL D1 nếu có
        try {
          const res = await fetch('/api/classes');
          const data = await res.json();
          if (data && data.ok && Array.isArray(data.data)) {
            if (!localClasses || (Array.isArray(this.classes) && this.classes.length === 0)) {
              this.classes = data.data;
              localStorage.setItem('CNTT_CLASSES', JSON.stringify(this.classes));
            } else if (data.from_d1) {
              this.classes = data.data;
              localStorage.setItem('CNTT_CLASSES', JSON.stringify(this.classes));
            } else {
              // Server đang dùng memory fallback, đẩy các lớp của Thầy từ localStorage lên Worker
              fetch('/api/classes', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'sync_classes', classes: this.classes })
              }).catch(() => {});
            }
          }
        } catch (e) {
          // Giữ nguyên dữ liệu từ localStorage
        } finally {
          this.loading = false;
        }
      },

      openMergeModal() {
        const dateStr = new Date().toISOString().slice(5, 10).replace('-', '');
        this.mergeForm = {
          compositeCode: 'GHEP_CA1_' + dateStr,
          compositeName: 'Ca sát hạch ghép liên lớp (Ca 1)',
          academicYear: '2026-2027',
          sourceClassIds: []
        };
        this.showMergeModal = true;
      },

      async submitMergeClasses() {
        if (!this.mergeForm.compositeCode.trim() || !this.mergeForm.compositeName.trim()) {
          alert('Vui lòng nhập đầy đủ Mã lớp ghép và Tên lớp ghép!');
          return;
        }
        if (this.mergeForm.sourceClassIds.length === 0) {
          alert('Vui lòng chọn ít nhất một lớp nguồn để ghép!');
          return;
        }

        const compClassId = 'cls_ghep_' + this.mergeForm.compositeCode.toLowerCase().replace(/[^a-z0-9]/g, '_') + '_' + Date.now().toString(36).slice(-4);
        
        let allStudentsStore = {};
        try {
          allStudentsStore = JSON.parse((localStorage.getItem('CNTT_STUDENTS') || localStorage.getItem('CNTT_STUDENTS')) || '{}');
        } catch(e){}

        const mergedStudents = [];
        this.mergeForm.sourceClassIds.forEach(sourceId => {
          const sourceClass = this.classes.find(c => c.id === sourceId);
          const stus = allStudentsStore[sourceId] || [];
          stus.forEach((s) => {
            mergedStudents.push({
              ...s,
              id: 'stu_ghep_' + Date.now() + '_' + mergedStudents.length,
              class_id: compClassId,
              student_number: mergedStudents.length + 1,
              original_class: s.original_class || (sourceClass ? sourceClass.class_code : 'Gốc')
            });
          });
        });

        const newCompClass = {
          id: compClassId,
          class_code: this.mergeForm.compositeCode.trim().toUpperCase(),
          class_name: this.mergeForm.compositeName.trim(),
          academic_year: this.mergeForm.academicYear.trim() || '2026-2027',
          is_composite: 1,
          source_classes: JSON.stringify(this.mergeForm.sourceClassIds.map(id => {
            const found = this.classes.find(c => c.id === id);
            return found ? found.class_code : id;
          })),
          student_count: mergedStudents.length
        };

        allStudentsStore[compClassId] = mergedStudents;
        localStorage.setItem('CNTT_STUDENTS', JSON.stringify(allStudentsStore));

        this.classes.unshift(newCompClass);
        localStorage.setItem('CNTT_CLASSES', JSON.stringify(this.classes));

        this.showToast(`✅ Đã tạo lớp ghép "${newCompClass.class_name}" với ${mergedStudents.length} học sinh!`);
        this.showMergeModal = false;
        this.classFilterTab = 'composite';

        try {
          fetch('/api/classes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'merge_classes',
              id: compClassId,
              composite_code: this.mergeForm.compositeCode,
              composite_name: this.mergeForm.compositeName,
              academic_year: this.mergeForm.academicYear,
              source_class_ids: this.mergeForm.sourceClassIds
            })
          }).catch(() => {});
        } catch (e) {}
      },

      async createClass() {
        if (!this.newClass.code.trim() || !this.newClass.name.trim()) {
          alert('Vui lòng nhập đầy đủ Mã lớp và Tên lớp!');
          return;
        }

        const classCode = this.newClass.code.trim().toUpperCase();
        const className = this.newClass.name.trim();
        const academicYear = this.newClass.academicYear.trim() || '2026-2027';
        const isComposite = this.newClass.isComposite ? 1 : 0;
        const newClassId = (isComposite ? 'cls_ghep_' : 'cls_') + 
          classCode.toLowerCase().replace(/[^a-z0-9]/g, '_');

        const newClassObj = {
          id: newClassId,
          class_code: classCode,
          class_name: className,
          academic_year: academicYear,
          is_composite: isComposite,
          student_count: 0
        };

        // Lưu ngay lập tức vào state và localStorage để không bao giờ bị biến mất!
        this.classes.unshift(newClassObj);
        localStorage.setItem('CNTT_CLASSES', JSON.stringify(this.classes));

        this.showToast('✅ Đã tạo lớp học mới thành công!');
        this.showCreateClassModal = false;
        this.newClass = { code: '', name: '', academicYear: '2026-2027', isComposite: 0 };

        // Đồng bộ lên server
        try {
          fetch('/api/classes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'create_class',
              id: newClassId,
              class_code: classCode,
              class_name: className,
              academic_year: academicYear,
              is_composite: isComposite
            })
          }).catch(() => {});
        } catch (err) {}
      },

      openImportModal(cls = null) {
        if (cls) {
          this.importData.classId = cls.id;
        } else if (this.classes.length > 0 && !this.importData.classId) {
          this.importData.classId = this.classes[0].id;
        }
        this.importData.rawText = '';
        this.importData.parsedStudents = [];
        this.showImportModal = true;
      },

      onImportClassChange() {
        if (this.importData.rawText) {
          this.parseExcelText();
        }
      },

      parseExcelText() {
        const text = this.importData.rawText.trim();
        if (!text) {
          this.importData.parsedStudents = [];
          return;
        }

        const currentClass = this.classes.find(c => c.id === this.importData.classId);
        const classPrefix = currentClass ? currentClass.class_code.replace(/[^A-Za-z0-9]/g, '') : 'HS';
        const defaultOrig = currentClass ? currentClass.class_code : '';

        const lines = text.split(/\r?\n/);
        const results = [];
        let autoIndex = 1;

        for (const line of lines) {
          const trimmed = line.trim();
          if (!trimmed) continue;

          const lower = trimmed.toLowerCase();
          if (
            (lower.includes('stt') && lower.includes('họ')) ||
            (lower.includes('mã') && lower.includes('tên')) ||
            (lower.includes('mshs') && lower.includes('ngày'))
          ) {
            continue;
          }

          const parts = trimmed.split(/\t+/).map(p => p.trim()).filter(Boolean);

          let stt = autoIndex;
          let stuCode = '';
          let fullName = '';
          let origClass = defaultOrig;
          let dob = '';
          let gender = 'Nam';
          let phone = '';

          // Trích xuất ngày sinh
          const dobRegex = /\b(\d{1,2}[\/\-\.]\d{1,2}[\/\-\.]\d{2,4})\b/;
          const dobMatch = trimmed.match(dobRegex);
          if (dobMatch) {
            dob = dobMatch[1].replace(/[\-\.]/g, '/');
          }

          // Trích xuất giới tính
          if (/\b(Nữ|Nu|Female|F)\b/i.test(trimmed)) {
            gender = 'Nữ';
          } else if (/\b(Nam|Male|M)\b/i.test(trimmed)) {
            gender = 'Nam';
          }

          // Trích xuất số điện thoại
          const phoneMatch = trimmed.match(/\b(0\d{9,10})\b/);
          if (phoneMatch) {
            phone = phoneMatch[1];
          }

          // Kiểm tra xem dòng có cột chứa mã lớp gốc (ví dụ: THUD_K26A, QTM_K26, OTO_93...)
          for (const p of parts) {
            if (/^[A-Za-z0-9_\-\+]{4,15}$/.test(p) && !dobRegex.test(p) && !phoneMatch?.includes(p)) {
              const matchedCls = this.classes.find(c => c.class_code.toUpperCase() === p.toUpperCase());
              if (matchedCls) {
                origClass = matchedCls.class_code;
                break;
              }
            }
          }

          if (parts.length >= 3) {
            const parsedStt = parseInt(parts[0].replace(/[^0-9]/g, ''));
            if (!isNaN(parsedStt)) {
              stt = parsedStt;
              autoIndex = stt + 1;
            } else {
              stt = autoIndex++;
            }

            const col1 = parts[1];
            const isCode = /^[A-Za-z0-9_\-\.]{3,15}$/.test(col1) && !dobRegex.test(col1) && !/^(nam|nữ|nu)$/i.test(col1);

            if (isCode) {
              stuCode = col1.toUpperCase();
              fullName = parts[2];
            } else {
              fullName = col1;
            }

            if (parts.length >= 4 && isCode && !dobRegex.test(parts[3]) && !/^(nam|nữ|nu)$/i.test(parts[3])) {
              if (/^[A-Za-z0-9_\-]{3,15}$/.test(parts[3]) && (parts[3].includes('_') || parts[3].includes('-') || parts[3].length >= 5)) {
                origClass = parts[3].toUpperCase();
              } else {
                fullName = (parts[2] + ' ' + parts[3]).trim();
              }
            }
          } else if (parts.length === 2) {
            const num0 = parseInt(parts[0].replace(/[^0-9]/g, ''));
            if (!isNaN(num0) && num0 < 1000) {
              stt = num0;
              autoIndex = stt + 1;
              fullName = parts[1];
            } else if (/^[A-Za-z0-9_\-]{3,15}$/.test(parts[0])) {
              stuCode = parts[0].toUpperCase();
              fullName = parts[1];
              stt = autoIndex++;
            } else {
              fullName = parts.join(' ');
              stt = autoIndex++;
            }
          } else {
            const dotMatch = trimmed.match(/^(\d+)[\.\s\-\:]+(.+)$/);
            if (dotMatch) {
              stt = parseInt(dotMatch[1]) || autoIndex++;
              fullName = dotMatch[2].trim();
            } else {
              stt = autoIndex++;
              fullName = trimmed;
            }
          }

          fullName = fullName
            .replace(dobRegex, '')
            .replace(/\b(Nam|Nữ|Nu)\b/gi, '')
            .replace(/\s+/g, ' ')
            .trim();

          if (!stuCode) {
            stuCode = classPrefix + '-' + String(stt).padStart(2, '0');
          }

          if (fullName) {
            results.push({
              student_number: stt,
              student_code: stuCode,
              full_name: fullName,
              original_class: origClass,
              date_of_birth: dob,
              gender: gender,
              phone: phone,
              status: 'Đang học'
            });
          }
        }

        this.importData.parsedStudents = results;
      },

      async submitImport() {
        if (!this.importData.classId) {
          alert('Vui lòng chọn lớp học để nạp danh sách!');
          return;
        }
        if (this.importData.parsedStudents.length === 0) {
          alert('Chưa có học sinh nào được nhận diện. Vui lòng dán danh sách từ Excel!');
          return;
        }

        const classId = this.importData.classId;
        const targetClass = this.classes.find(c => c.id === classId);
        const classCode = targetClass ? targetClass.class_code : classId;
        const students = [...this.importData.parsedStudents];

        // 1. Lưu học sinh vào localStorage theo CẢ classId VÀ classCode
        let allStudentsStore = {};
        try {
          allStudentsStore = JSON.parse((localStorage.getItem('CNTT_STUDENTS') || localStorage.getItem('CNTT_STUDENTS')) || '{}');
        } catch(e){}

        const mappedStudents = students.map((s, idx) => ({
          ...s,
          id: s.id || ('stu_' + Date.now() + '_' + idx),
          class_id: classId,
          original_class: s.original_class || classCode
        }));

        if (this.importData.overwrite) {
          allStudentsStore[classId] = mappedStudents;
          allStudentsStore[classCode] = mappedStudents;
        } else {
          const current = this.findStudentsForClass(allStudentsStore, targetClass);
          allStudentsStore[classId] = [...current, ...mappedStudents];
          allStudentsStore[classCode] = allStudentsStore[classId];
        }
        localStorage.setItem('CNTT_STUDENTS', JSON.stringify(allStudentsStore));

        // 2. Cập nhật sĩ số trong this.classes và localStorage
        if (targetClass) {
          targetClass.student_count = allStudentsStore[classId].length;
          localStorage.setItem('CNTT_CLASSES', JSON.stringify(this.classes));
        }

        this.showToast(`✅ Đã nạp thành công ${students.length} học sinh vào lớp!`);
        this.showImportModal = false;

        if (this.selectedClass && this.selectedClass.id === classId) {
          await this.viewClassStudents(this.selectedClass);
        }

        // 3. Đồng bộ lên server
        try {
          fetch('/api/classes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'import_students',
              class_id: classId,
              class_code: classCode,
              students: mappedStudents,
              overwrite: this.importData.overwrite
            })
          }).catch(() => {});
        } catch (err) {}
      },

      async viewClassStudents(cls) {
        this.selectedClass = cls;
        this.loadingStudents = true;
        this.studentFilterText = '';
        this.filterOriginalClass = '';
        this.showStudentListModal = true;

        let allStudentsStore = {};
        try {
          allStudentsStore = JSON.parse((localStorage.getItem('CNTT_STUDENTS') || localStorage.getItem('CNTT_STUDENTS')) || '{}');
        } catch(e){}

        // Tìm kiếm thông minh qua id, mã lớp hoặc quét mờ (cứu dữ liệu nếu lệch key)
        let localStudents = this.findStudentsForClass(allStudentsStore, cls);
        this.selectedClassStudents = localStudents;

        if (cls) cls.student_count = localStudents.length;

        // Chỉ đồng bộ nếu server có dữ liệu thật sự (data.length > 0)
        // TUYỆT ĐỐI KHÔNG BAO GIỜ lấy [] từ server đè lên dữ liệu của Thầy!
        try {
          const res = await fetch('/api/classes?id=' + encodeURIComponent(cls.id) + '&code=' + encodeURIComponent(cls.class_code));
          const data = await res.json();
          if (data && data.ok && Array.isArray(data.data) && data.data.length > 0) {
            this.selectedClassStudents = data.data;
            allStudentsStore[cls.id] = data.data;
            allStudentsStore[cls.class_code] = data.data;
            localStorage.setItem('CNTT_STUDENTS', JSON.stringify(allStudentsStore));
            if (cls) cls.student_count = data.data.length;
          } else if (localStudents.length > 0) {
            // Đẩy dữ liệu học sinh của Thầy từ localStorage lên server
            fetch('/api/classes', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'import_students',
                class_id: cls.id,
                class_code: cls.class_code,
                students: localStudents,
                overwrite: true
              })
            }).catch(() => {});
          }
        } catch (err) {
        } finally {
          this.loadingStudents = false;
        }
      },

      openAddStudentModal() {
        if (!this.selectedClass) return;
        const nextNum = (this.selectedClassStudents.length > 0)
          ? Math.max(...this.selectedClassStudents.map(s => s.student_number || 0)) + 1
          : 1;
        const classPrefix = this.selectedClass.class_code.replace(/[^A-Za-z0-9]/g, '');

        this.studentForm = {
          id: null,
          class_id: this.selectedClass.id,
          student_number: nextNum,
          student_code: classPrefix + '-' + String(nextNum).padStart(2, '0'),
          full_name: '',
          date_of_birth: '',
          gender: 'Nam',
          phone: '',
          status: 'Đang học',
          original_class: this.selectedClass.is_composite ? '' : this.selectedClass.class_code
        };
        this.showStudentEditModal = true;
      },

      openEditStudentModal(stu) {
        this.studentForm = {
          id: stu.id,
          class_id: stu.class_id || (this.selectedClass ? this.selectedClass.id : ''),
          student_number: stu.student_number,
          student_code: stu.student_code || '',
          full_name: stu.full_name,
          date_of_birth: stu.date_of_birth || '',
          gender: stu.gender || 'Nam',
          phone: stu.phone || '',
          status: stu.status || 'Đang học',
          original_class: stu.original_class || ''
        };
        this.showStudentEditModal = true;
      },

      async saveSingleStudent() {
        if (!this.studentForm.full_name.trim()) {
          alert('Vui lòng nhập Họ và tên học sinh!');
          return;
        }

        const classId = this.studentForm.class_id || (this.selectedClass ? this.selectedClass.id : '');
        let allStudentsStore = {};
        try {
          allStudentsStore = JSON.parse((localStorage.getItem('CNTT_STUDENTS') || localStorage.getItem('CNTT_STUDENTS')) || '{}');
        } catch(e){}

        const list = allStudentsStore[classId] || [...this.selectedClassStudents];

        if (this.studentForm.id) {
          const idx = list.findIndex(s => s.id === this.studentForm.id);
          if (idx !== -1) {
            list[idx] = { ...this.studentForm };
          }
        } else {
          const newStu = {
            ...this.studentForm,
            id: 'stu_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
            class_id: classId
          };
          list.push(newStu);
        }

        allStudentsStore[classId] = list;
        localStorage.setItem('CNTT_STUDENTS', JSON.stringify(allStudentsStore));

        this.selectedClassStudents = list;
        if (this.selectedClass) {
          this.selectedClass.student_count = list.length;
          localStorage.setItem('CNTT_CLASSES', JSON.stringify(this.classes));
        }

        this.showToast(this.studentForm.id ? '✅ Đã cập nhật hồ sơ học sinh!' : '✅ Đã thêm học sinh mới thành công!');
        this.showStudentEditModal = false;

        try {
          fetch('/api/classes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'save_student',
              ...this.studentForm
            })
          }).catch(() => {});
        } catch (e) {}
      },

      async deleteStudent(stuId) {
        if (!confirm('Thầy có chắc chắn muốn xóa học sinh này khỏi lớp?')) return;

        this.selectedClassStudents = this.selectedClassStudents.filter(s => s.id !== stuId);

        if (this.selectedClass) {
          try {
            const allStudentsStore = JSON.parse((localStorage.getItem('CNTT_STUDENTS') || localStorage.getItem('CNTT_STUDENTS')) || '{}');
            allStudentsStore[this.selectedClass.id] = this.selectedClassStudents;
            localStorage.setItem('CNTT_STUDENTS', JSON.stringify(allStudentsStore));

            this.selectedClass.student_count = this.selectedClassStudents.length;
            localStorage.setItem('CNTT_CLASSES', JSON.stringify(this.classes));
          } catch(e){}
        }

        this.showToast('Đã xóa học sinh khỏi danh sách');

        try {
          fetch('/api/classes?student_id=' + encodeURIComponent(stuId), { method: 'DELETE' }).catch(() => {});
        } catch (e) {}
      },

      async deleteClass(cls) {
        const msg = cls.is_composite
          ? 'Thầy có chắc chắn muốn xóa lớp ghép "' + cls.class_name + '"? Danh sách ghép sẽ bị xóa nhưng học sinh ở các lớp gốc vẫn được giữ nguyên!'
          : 'Thầy có chắc chắn muốn xóa lớp ' + cls.class_name + '? Toàn bộ danh sách học sinh của lớp này sẽ bị xóa!';
        if (!confirm(msg)) return;

        // Xóa ngay lập tức khỏi state và localStorage (không bao giờ xuất hiện lại!)
        this.classes = this.classes.filter(c => c.id !== cls.id && c.class_code !== cls.class_code);
        localStorage.setItem('CNTT_CLASSES', JSON.stringify(this.classes));

        // Xóa cả học sinh của lớp đó trong localStorage
        try {
          const allStudentsStore = JSON.parse((localStorage.getItem('CNTT_STUDENTS') || localStorage.getItem('CNTT_STUDENTS')) || '{}');
          delete allStudentsStore[cls.id];
          localStorage.setItem('CNTT_STUDENTS', JSON.stringify(allStudentsStore));
        } catch(e){}

        this.showToast('Đã xóa lớp học thành công!');

        // Đồng bộ xóa lên server
        try {
          fetch('/api/classes?id=' + encodeURIComponent(cls.id), { method: 'DELETE' }).catch(() => {});
        } catch (e) {}
      },

      exportStudentsCSV() {
        if (!this.selectedClass || this.selectedClassStudents.length === 0) return;

        const headers = ['STT', 'MSHS', 'Họ và tên', 'Lớp gốc', 'Ngày sinh', 'Giới tính', 'Số điện thoại', 'Trạng thái'];
        const rows = this.selectedClassStudents.map((s, idx) => [
          s.student_number || (idx + 1),
          `"${s.student_code || ''}"`,
          `"${s.full_name || ''}"`,
          `"${s.original_class || this.selectedClass.class_code || ''}"`,
          `"${s.date_of_birth || ''}"`,
          `"${s.gender || 'Nam'}"`,
          `"${s.phone || ''}"`,
          `"${s.status || 'Đang học'}"`
        ]);

        const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\r\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        const filename = `DS_${this.selectedClass.class_code}_${new Date().toISOString().slice(0, 10)}.csv`;
        link.setAttribute('href', url);
        link.setAttribute('download', filename);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        this.showToast('📊 Đã xuất danh sách lớp ra file Excel (CSV)!');
      }
    }));
  });
</script>
