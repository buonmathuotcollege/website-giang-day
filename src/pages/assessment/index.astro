---
import BaseLayout from '../../layouts/BaseLayout.astro';

const EXAMS = [
  {
    slug: 'phan-cung',
    name: 'Phần cứng Máy tính',
    icon: '🔧',
    questions: 30,
    time: 45,
    difficulty: 'Trung bình',
    description: 'Kiểm tra kiến thức về linh kiện, lắp ráp và bảo trì máy tính',
  },
  {
    slug: 'mang',
    name: 'Mạng Máy tính',
    icon: '🌐',
    questions: 30,
    time: 45,
    difficulty: 'Trung bình',
    description: 'Kiểm tra kiến thức về mạng máy tính, mô hình OSI, TCP/IP',
  },
];
---

<BaseLayout title="Đánh giá năng lực - Cổng Giảng Dạy CNTT">
  <section class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="mb-2">Đánh giá năng lực</h1>
    <p class="text-gray-500 mb-8">Làm bài kiểm tra trắc nghiệm để đánh giá kiến thức chuyên ngành</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {EXAMS.map((exam) => (
        <a href={`/assessment/${exam.slug}`} class="card no-underline block">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl">{exam.icon}</span>
            <h2 class="text-lg font-bold text-gray-900">{exam.name}</h2>
          </div>
          <p class="text-sm text-gray-600 mb-4">{exam.description}</p>
          <div class="flex flex-wrap gap-2 text-xs">
            <span class="bg-blue-100 text-blue-700 px-2 py-1 rounded-full font-medium">
              {exam.questions} câu hỏi
            </span>
            <span class="bg-green-100 text-green-700 px-2 py-1 rounded-full font-medium">
              {exam.time} phút
            </span>
            <span class="bg-yellow-100 text-yellow-700 px-2 py-1 rounded-full font-medium">
              {exam.difficulty}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
