            </div>

            <!-- Current Question Card -->
            <template x-if="randomMCQs.length > 0">
              <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 shadow-sm space-y-4">
                <div class="flex items-center justify-between gap-2 border-b border-gray-100 pb-3">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-mono font-bold text-primary-800 bg-primary-50 px-2.5 py-0.5 rounded-full uppercase border border-primary-200" x-text="'CHỦ ĐỀ: ' + randomMCQs[mcqCurrentIndex].category"></span>
                    <span x-show="mcqFlagged[mcqCurrentIndex]" class="badge-poka-yoke">🚩 ĐANG CẮM CỜ XEM LẠI</span>
                  </div>

                  <span class="text-xs font-mono text-gray-400" x-text="'Câu ' + (mcqCurrentIndex + 1) + ' / ' + randomMCQs.length"></span>
                </div>

                <h3 class="text-base sm:text-lg font-bold text-gray-900 leading-snug" x-text="'Câu ' + (mcqCurrentIndex + 1) + ': ' + randomMCQs[mcqCurrentIndex].question"></h3>

                <!-- Options with Kanso Keyboard Badges -->
                <div class="space-y-2.5 pt-2">
                  <template x-for="(opt, oIdx) in randomMCQs[mcqCurrentIndex].options" :key="oIdx">
                    <label
                      class="flex items-start gap-3 p-3.5 sm:p-4 rounded-xl border-2 cursor-pointer transition-all text-xs sm:text-sm group"
                      :class="mcqAnswers[mcqCurrentIndex] === oIdx
                        ? 'border-primary-600 bg-primary-50/70 font-semibold shadow-sm'
                        : 'border-gray-200 hover:border-gray-300 hover:bg-gray-50/60 bg-white'"
                    >
                      <input
                        type="radio"
                        :name="'mcq_q_' + mcqCurrentIndex"
                        :value="oIdx"
                        @change="selectMCQOption(oIdx)"
                        :checked="mcqAnswers[mcqCurrentIndex] === oIdx"
                        class="mt-0.5 text-primary-700 accent-primary-700 w-4 h-4"
                      />

                      <div class="flex-1 flex items-start gap-2">
                        <kbd
                          class="font-mono text-[10px] font-bold px-1.5 py-0.5 rounded border transition-colors shadow-sm shrink-0"
                          :class="mcqAnswers[mcqCurrentIndex] === oIdx
                            ? 'bg-primary-700 text-white border-primary-700'
                            : 'bg-gray-100 text-gray-600 border-gray-300 group-hover:bg-white'"
                          x-text="['A (1)', 'B (2)', 'C (3)', 'D (4)'][oIdx]"
                        ></kbd>
                        <span x-text="opt" class="leading-relaxed"></span>
                      </div>
                    </label>
                  </template>
                </div>

                <!-- Keyboard shortcuts helper pill -->
                <div class="bg-slate-50 border border-slate-200/80 rounded-xl px-3 py-2 text-[11px] text-slate-600 flex flex-wrap items-center justify-between gap-2">
                  <div class="flex items-center gap-1.5">
                    <span>💡</span>
                    <span><strong>Phím tắt chuẩn Nhật:</strong> Bấm <kbd>1</kbd>-<kbd>4</kbd> (hoặc <kbd>A</kbd>-<kbd>D</kbd>) chọn nhanh • <kbd>←</kbd>/<kbd>→</kbd> chuyển câu • <kbd>F</kbd> cắm cờ • <kbd>Enter</kbd> câu tiếp</span>
                  </div>
                  <span class="text-slate-400 font-mono text-[10px] hidden sm:inline">Poka-Yoke Auto-Save Active</span>
                </div>

                <!-- Prev / Next Navigation -->
                <div class="flex justify-between items-center pt-5 border-t border-gray-100">
                  <button
                    type="button"
                    @click="mcqPrevQuestion()"
                    :disabled="mcqCurrentIndex === 0"
                    class="btn-secondary text-xs px-4 py-2 flex items-center gap-1.5"
                    :class="mcqCurrentIndex === 0 ? 'opacity-40 cursor-not-allowed' : ''"
                  >
                    <span>←</span>
                    <span>Câu trước</span>
                  </button>

                  <div class="flex items-center gap-2">
                    <button
                      type="button"
                      x-show="mcqCurrentIndex < randomMCQs.length - 1"
                      @click="mcqNextQuestion()"
                      class="btn-primary text-xs px-5 py-2 font-bold flex items-center gap-1.5"
                    >
                      <span>Câu tiếp theo</span>
                      <span>→</span>
                    </button>

                    <button
                      type="button"
                      x-show="mcqCurrentIndex === randomMCQs.length - 1"
                      @click="triggerSubmitMCQ()"
                      class="btn-primary text-xs px-6 py-2.5 font-bold bg-emerald-600 hover:bg-emerald-700 shadow-md flex items-center gap-1.5"
                    >
                      <span>Nộp bài trắc nghiệm</span>
                      <span>🏁</span>
                    </button>
                  </div>
                </div>
              </div>
            </template>
          </div>

          <!-- Poka-Yoke Submit Confirmation Modal -->
          <div
            x-show="showSubmitModal"
            x-cloak
            class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4"
          >
            <div
              class="bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl border border-gray-200 space-y-4 animate-in fade-in zoom-in duration-150"
              @click.away="showSubmitModal = false"
            >
              <div class="flex items-center gap-3">
                <span class="text-3xl">⚠️</span>
                <div>
                  <h3 class="font-extrabold text-gray-900 text-base">Poka-Yoke: Kiểm Tra Trước Khi Nộp</h3>
                  <p class="text-xs text-gray-500">Quy tắc chuẩn Nhật - Không để sót câu hỏi</p>
                </div>
              </div>

              <div class="p-3.5 bg-amber-50 border border-amber-200 rounded-xl text-xs space-y-2">
                <p class="text-amber-900 font-medium">
                  Em vẫn còn <strong class="text-red-700 font-bold" x-text="unansweredMCQList.length"></strong> câu chưa chọn đáp án:
                </p>
                <div class="flex flex-wrap gap-1.5">
                  <template x-for="qNum in unansweredMCQList" :key="qNum">
                    <span class="px-2 py-0.5 rounded bg-amber-200 text-amber-900 font-mono font-bold text-xs" x-text="'Câu ' + qNum"></span>
                  </template>
                </div>
                <p class="text-[11px] text-amber-800 italic mt-1">
                  Nếu nộp bài ngay bây giờ, các câu chưa trả lời sẽ được tính 0 điểm!
                </p>
              </div>

              <div class="flex justify-end gap-2.5 pt-3 border-t border-gray-100">
                <button
                  type="button"
                  @click="showSubmitModal = false"
                  class="btn-secondary text-xs px-4 py-2 font-bold"
                >
                  ← Quay lại làm tiếp
                </button>

                <button
                  type="button"
                  @click="confirmSubmitMCQ()"
                  class="btn-primary text-xs px-5 py-2 font-bold bg-rose-600 hover:bg-rose-700 text-white shadow"
                >
                  Vẫn muốn nộp bài 🏁
                </button>
              </div>
            </div>
          </div>

          <!-- MCQ Result Screen with Explanations & Printable Report -->
          <div x-show="mcqSubmitted" class="space-y-6" x-cloak>
            <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 text-center shadow-sm">
              <span class="text-5xl block mb-2">🏆</span>
              <h2 class="text-2xl font-extrabold text-gray-900 mb-1">Kết Quả Bài Thi Trắc Nghiệm Tình Huống</h2>
              <p class="text-xs text-gray-500 mb-4">Đánh giá theo chuẩn Kỹ thuật viên Thực chiến (Thông tư 55/2026/TT-BGDĐT)</p>

              <div class="text-4xl sm:text-5xl font-extrabold text-primary-700 font-mono mb-2">
                <span x-text="mcqScore"></span> / 10 Điểm
              </div>

              <p class="text-sm font-bold" :class="mcqScore >= 5.0 ? 'text-emerald-700' : 'text-red-700'" x-text="mcqScore >= 5.0 ? 'CHÚC MỪNG EM ĐÃ ĐẠT CHUẨN NĂNG LỰC NGHỀ!' : 'EM CẦN ÔN TẬP THÊM QUY TRÌNH KỸ THUẬT!'"></p>

              <div class="mt-5 flex flex-wrap justify-center gap-3">
                <button type="button" @click="window.print()" class="btn-secondary text-xs px-4 py-2 flex items-center gap-1.5 font-bold shadow-sm">
                  <span>🖨️</span>
                  <span>In Phiếu Điểm Trắc Nghiệm (A4 Chuẩn Nhật)</span>
                </button>

                <button type="button" @click="initRandomMCQ()" class="btn-primary text-xs px-4 py-2 font-bold shadow-sm">
                  🔄 Làm đề trắc nghiệm ngẫu nhiên khác
                </button>
              </div>
            </div>

            <!-- Detailed Answers & Pro Explanations -->
            <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm space-y-4">
              <div class="flex items-center justify-between border-b pb-3">
                <h3 class="text-base font-bold text-gray-900">
                  Chi Tiết Đáp Án & Hướng Dẫn Kỹ Thuật Chuẩn Hóa
                </h3>
                <span class="text-xs text-gray-500 font-mono" x-text="'Đúng ' + mcqCorrectCount + ' / ' + randomMCQs.length + ' câu'"></span>
              </div>

              <div class="space-y-4">
                <template x-for="(q, idx) in randomMCQs" :key="q.id">
                  <div
                    class="p-4 rounded-xl border text-xs space-y-2.5 transition-all"
                    :class="mcqAnswers[idx] === q.correctIndex ? 'border-emerald-200 bg-emerald-50/40' : 'border-rose-200 bg-rose-50/40'"
                  >
                    <div class="flex items-center justify-between gap-2">
                      <span class="font-bold text-gray-900 text-xs sm:text-sm" x-text="'Câu ' + (idx + 1) + ': ' + q.question"></span>
                      <span
                        class="text-[11px] font-bold px-2.5 py-0.5 rounded-full shrink-0 font-mono"
                        :class="mcqAnswers[idx] === q.correctIndex ? 'bg-emerald-200 text-emerald-900' : 'bg-rose-200 text-rose-900'"
                        x-text="mcqAnswers[idx] === q.correctIndex ? 'ĐÚNG (+1.0đ)' : 'SAI (0đ)'"
                      ></span>
                    </div>

                    <div class="text-gray-700 space-y-1">
                      <p>
                        <span class="text-gray-500">Đáp án em chọn: </span>
                        <strong
                          :class="mcqAnswers[idx] === q.correctIndex ? 'text-emerald-800' : 'text-rose-700'"
                          x-text="mcqAnswers[idx] !== undefined ? (['A', 'B', 'C', 'D'][mcqAnswers[idx]] + '. ' + q.options[mcqAnswers[idx]]) : 'Chưa chọn đáp án'"
                        ></strong>
                      </p>

                      <p x-show="mcqAnswers[idx] !== q.correctIndex">
                        <span class="text-gray-500">Đáp án chuẩn kỹ thuật: </span>
                        <strong class="text-emerald-800" x-text="['A', 'B', 'C', 'D'][q.correctIndex] + '. ' + q.options[q.correctIndex]"></strong>
                      </p>
                    </div>

                    <div class="bg-white p-3 rounded-xl border border-gray-200 text-gray-600 text-[11px] leading-relaxed shadow-xs">
                      💡 <strong>Thợ mách nước:</strong> <span x-text="q.explanation"></span>
                    </div>

                    <!-- Nút Thầy ơi giải thích câu này (Gemini AI cho 9+3) -->
                    <div class="pt-1 flex items-center justify-between">
                      <button
                        type="button"
                        @click="askTeacherExplain(q, idx)"
                        class="text-[11px] font-bold text-primary-700 hover:text-primary-900 flex items-center gap-1.5 px-2.5 py-1 rounded-lg hover:bg-primary-50 transition-colors"
                      >
                        <span>👨‍🏫</span>
                        <span x-text="loadingExplain[idx] ? 'Thầy đang soạn giải thích...' : 'Thầy ơi giải thích thêm câu này (AI ngắn gọn)'"></span>
                      </button>
                    </div>

                    <div x-show="aiExplanations[idx]" class="p-3 bg-blue-50 border border-blue-200 rounded-xl text-xs text-blue-950 mt-1.5 animate-in fade-in" x-cloak>
                      <p class="font-bold text-blue-900 flex items-center gap-1.5 mb-1 text-[11px]">
                        <span>💡</span>
                        <span>Thầy Đồng giải thích nhanh bằng lời đời thường:</span>
                      </p>
                      <p class="leading-relaxed text-blue-900 font-medium" x-text="aiExplanations[idx]"></p>
                    </div>
                  </div>
                </template>
              </div>
            </div>
          </div>
        </div>
        </div>

        <!-- ============================================================== -->
        <!-- MODE 3: ORAL & SCENARIO REFERENCE LIBRARY                     -->
        <!-- ============================================================== -->
        <div x-show="activeMode === 'library'" class="space-y-6" x-cloak>
          <!-- Category Tabs -->
          <div class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h2 class="text-lg font-bold text-gray-900">Kho Tư Liệu Vấn Đáp & Tình Huống Nghề Thực Chiến</h2>
                <p class="text-xs text-gray-500">Dành cho Giáo viên ra đề sát hạch và Học sinh ôn luyện trước giờ kiểm tra</p>
              </div>

              <!-- Search Box -->
              <input
                type="text"
                x-model="librarySearch"
                placeholder="🔍 Tìm kiếm câu hỏi, từ khóa..."
                class="px-3 py-1.5 border border-gray-300 rounded-lg text-xs w-full sm:w-64 focus:ring-2 focus:ring-primary-500"
              />
            </div>

            <div class="flex flex-wrap gap-2 border-t pt-3">
              <button
                type="button"
                @click="librarySubTab = 'oral'"
                class="px-3.5 py-1.5 rounded-lg text-xs font-bold border transition-colors"
                :class="librarySubTab === 'oral' ? 'bg-primary-700 text-white border-primary-700' : 'bg-gray-50 text-gray-700 border-gray-200 hover:bg-gray-100'"
              >
                🗣️ 20 Câu Hỏi Vấn Đáp Tại Bàn Máy (Thầy Đồng)
              </button>

              <button
                type="button"
                @click="librarySubTab = 'assembly'"
                class="px-3.5 py-1.5 rounded-lg text-xs font-bold border transition-colors"
                :class="librarySubTab === 'assembly' ? 'bg-primary-700 text-white border-primary-700' : 'bg-gray-50 text-gray-700 border-gray-200 hover:bg-gray-100'"
              >
                🧩 6 Tình Huống Thực Hành Lắp Ráp Thiết Thực
              </button>

              <button
                type="button"
                @click="librarySubTab = 'windows'"
                class="px-3.5 py-1.5 rounded-lg text-xs font-bold border transition-colors"
                :class="librarySubTab === 'windows' ? 'bg-primary-700 text-white border-primary-700' : 'bg-gray-50 text-gray-700 border-gray-200 hover:bg-gray-100'"
              >
                💿 6 Tình Huống Thực Hành Cài Windows & Driver
              </button>
            </div>
          </div>

          <!-- Subtab 1: Oral Questions -->
          <div x-show="librarySubTab === 'oral'" class="space-y-4">
            <template x-for="(oq, idx) in filteredOralQuestions" :key="oq.id">
              <div class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm space-y-3 hover:border-primary-300 transition-colors">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono font-bold text-primary-800 bg-primary-50 px-2 py-0.5 rounded" x-text="'CÂU VẤN ĐÁP #' + (idx + 1) + ' · ' + oq.category"></span>
                  <span class="text-[11px] text-gray-400 font-mono" x-text="oq.id"></span>
                </div>

                <h3 class="text-sm font-bold text-gray-900 leading-snug" x-text="oq.question"></h3>

                <div class="p-3 bg-gray-50 rounded-xl border border-gray-100 text-xs space-y-1.5">
                  <p class="text-gray-500 text-[11px] italic">
                    🎯 <strong>Ý đồ của Thầy khi hỏi:</strong> <span x-text="oq.teacherIntent"></span>
                  </p>
                  <p class="text-emerald-900 font-medium leading-relaxed">
                    ✅ <strong>Câu trả lời chuẩn của thợ lành nghề:</strong> <span x-text="oq.standardAnswer"></span>
                  </p>
                </div>

                <div class="flex flex-wrap items-center gap-1.5 text-[11px]">
                  <span class="text-gray-500 font-medium">Từ khóa bắt buộc có:</span>
                  <template x-for="kw in oq.criticalKeywords" :key="kw">
                    <span class="bg-gray-100 text-gray-800 px-2 py-0.5 rounded-md font-mono" x-text="kw"></span>
                  </template>
                </div>
              </div>
            </template>
          </div>

          <!-- Subtab 2: Assembly Scenarios -->
          <div x-show="librarySubTab === 'assembly'" class="space-y-4">
            <template x-for="(sc, idx) in assemblyScenarios" :key="sc.id">
              <div class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono font-bold text-amber-800 bg-amber-50 px-2 py-0.5 rounded" x-text="'TÌNH HUỐNG LẮP RÁP #' + (idx + 1)"></span>
                  <span class="text-[11px] text-gray-500 font-medium" x-text="'Dụng cụ: ' + sc.toolNeeded"></span>
                </div>

                <h3 class="text-sm font-bold text-gray-900" x-text="sc.title"></h3>

                <div class="text-xs space-y-2">
                  <div class="bg-gray-50 p-3 rounded-lg border border-gray-200">
                    <strong class="text-gray-800 block mb-0.5">Hiện tượng thực tế:</strong>
                    <span class="text-gray-600" x-text="sc.situation"></span>
                  </div>

                  <div class="bg-red-50 p-3 rounded-lg border border-red-200 text-red-900">
                    <strong class="block mb-0.5">⚠️ Cái bẫy thợ non tay hay mắc phải:</strong>
                    <span x-text="sc.trap"></span>
                  </div>

                  <div class="bg-emerald-50 p-3 rounded-lg border border-emerald-200 text-emerald-950">
                    <strong class="block mb-0.5">✅ Quy trình xử lý chuẩn xác:</strong>
                    <span x-text="sc.correctHandling"></span>
                  </div>
                </div>
              </div>
            </template>
          </div>

          <!-- Subtab 3: Windows Scenarios -->
          <div x-show="librarySubTab === 'windows'" class="space-y-4">
            <template x-for="(sc, idx) in windowsScenarios" :key="sc.id">
              <div class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono font-bold text-blue-800 bg-blue-50 px-2 py-0.5 rounded" x-text="'TÌNH HUỐNG CÀI WIN #' + (idx + 1)"></span>
                  <span class="text-[11px] text-gray-500 font-medium" x-text="'Dụng cụ: ' + sc.toolNeeded"></span>
                </div>

                <h3 class="text-sm font-bold text-gray-900" x-text="sc.title"></h3>

                <div class="text-xs space-y-2">
                  <div class="bg-gray-50 p-3 rounded-lg border border-gray-200">
                    <strong class="text-gray-800 block mb-0.5">Hiện tượng thực tế:</strong>
                    <span class="text-gray-600" x-text="sc.situation"></span>
                  </div>

                  <div class="bg-red-50 p-3 rounded-lg border border-red-200 text-red-900">
                    <strong class="block mb-0.5">⚠️ Cái bẫy thợ non tay hay mắc phải:</strong>
                    <span x-text="sc.trap"></span>
                  </div>

                  <div class="bg-emerald-50 p-3 rounded-lg border border-emerald-200 text-emerald-950">
                    <strong class="block mb-0.5">✅ Quy trình xử lý chuẩn xác:</strong>
                    <span x-text="sc.correctHandling"></span>
                  </div>
                </div>
              </div>
            </template>
          </div>
        </div>
      </div>
    ) : (
      <!-- Fallback quiz for other subjects -->
      <div class="card p-6 text-center">
        <h2 class="text-xl font-bold mb-2">{exam.name}</h2>
        <p class="text-sm text-gray-500">Môn học đang được chuẩn hóa ngân hàng câu hỏi.</p>
      </div>
    )}
  </section>
</BaseLayout>

{isHardware && (
  <script is:inline define:vars={{
    initialTickets: FULL_EXAM_TICKETS,
    initialOral: ORAL_QUESTIONS,
    initialAssembly: ASSEMBLY_SCENARIOS,
    initialWindows: WINDOWS_INSTALL_SCENARIOS,
    initialMCQBank: MCQ_PRACTICAL_BANK,
    initialRubric: OFFICIAL_RUBRIC_CRITERIA
  }}>
    document.addEventListener('alpine:init', () => {
      Alpine.data('hardwareMasterEngine', () => ({
        activeMode: 'simulator', // 'simulator' | 'mcq' | 'library'
        librarySubTab: 'oral', // 'oral' | 'assembly' | 'windows'
        librarySearch: '',

        // Zen / Focus Mode
        zenMode: false,

        // Poka-Yoke Recovery & Auto-save state
        showRecoveryBanner: false,
        savedSessionInfo: { name: '', time: '' },
        lastSavedText: '',
        showSubmitModal: false,

        // Timers
        timerSeconds: 10800, // 180 mins for workshop, 900 for MCQ
        timerInterval: null,

        // Data sources
        tickets: initialTickets,
        allOralQuestions: initialOral,
        assemblyScenarios: initialAssembly,
        windowsScenarios: initialWindows,
        allMCQBank: initialMCQBank,
        rubricCriteria: initialRubric,

        // Dynamic Classes and Students from D1 Database
        availableClasses: [],
        classStudentsList: [],

        // AI Teacher Explanation states
        aiExplanations: {},
        loadingExplain: {},

        // Student profile
        student: {
          name: '',
          code: '',
          dob: '',
          gender: 'Nam',
          className: '',
          originalClass: '',
          station: 'Bàn kỹ thuật 01',
          partner: '',
        },

        // Simulator state
        simPhase: 'ticket',
        selectedTicketIndex: 0,
        currentStep: 1,
        safetyViolation: false,
        safetyViolationReason: '',

        step1: { chassisCondition: 'Nguyên vẹn, trầy xước nhẹ cạnh bên', recordedDriveC: '', recordedDriveD: '', completed: false },
        step2: { isVerifiedMatch: false, samplesOpened: false, teacherApprovedStop1: false, completed: false },
        step3: { pullPlugDischargeChecked: false, screenRevived: false, completed: false },
        step4: { fanHeldWhenBlowing: false, thermalPasteBeanSize: false, cpuFanPlugged: false, ramDualSnapAudible: false, teacherApprovedStop2: false, completed: false },
        step5: { targetPartitionGB: '', deviceManagerClean: false, unikeyInstalled: false, completed: false },
        step6: { peripheralsWorking: false, testPagePrinted: false, completed: false },
        step7: { fanQuiet: false, cpuTempLoaded: 54, tempUnder75Checked: false, dataIntact100Checked: false, benchCleaned: false, sheetSigned: false, teacherApprovedStop3: false, completed: false },

        isSubmitting: false,
        submitSuccess: false,
        submitMessage: '',

        // MCQ Engine state
        randomMCQs: [],
        mcqCurrentIndex: 0,
        mcqAnswers: {},
        mcqFlagged: {},
        mcqSubmitted: false,
        mcqScore: 0,

        get currentTicket() {
          return this.tickets[this.selectedTicketIndex] || this.tickets[0];
        },

        get currentOralQuestions() {
          const idx1 = this.selectedTicketIndex % this.allOralQuestions.length;
          const idx2 = (this.selectedTicketIndex + 4) % this.allOralQuestions.length;
          return [this.allOralQuestions[idx1], this.allOralQuestions[idx2]];
        },

        get filteredOralQuestions() {
          if (!this.librarySearch.trim()) return this.allOralQuestions;
          const s = this.librarySearch.toLowerCase();
          return this.allOralQuestions.filter(q =>
            q.question.toLowerCase().includes(s) ||
            q.standardAnswer.toLowerCase().includes(s) ||
            q.category.toLowerCase().includes(s)
          );
        },

        get formattedTimer() {
          const h = Math.floor(this.timerSeconds / 3600);
          const m = Math.floor((this.timerSeconds % 3600) / 60);
          const s = this.timerSeconds % 60;
          if (h > 0) {
            return (h < 10 ? '0' + h : h) + ':' + (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);
          }
          return (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);
        },

        get unansweredMCQList() {
          const missing = [];
          for (let i = 0; i < this.randomMCQs.length; i++) {
            if (this.mcqAnswers[i] === undefined) {
              missing.push(i + 1);
            }
          }
          return missing;
        },

        get mcqCorrectCount() {
          let count = 0;
          this.randomMCQs.forEach((q, idx) => {
            if (this.mcqAnswers[idx] === q.correctIndex) count++;
          });
          return count;
        },

        init() {
          const urlParams = new URLSearchParams(window.location.search);
          if (urlParams.get('mode')) {
            this.activeMode = urlParams.get('mode');
          }
          this.syncTicketData();
          this.initRandomMCQ();
          this.loadClasses();
          this.checkSavedSession();
          this.startTimer();
          this.setupKeyboardListeners();
        },

        async loadClasses() {
          const localClasses = localStorage.getItem('BMTC_CLASSES');
          if (localClasses) {
            try {
              this.availableClasses = JSON.parse(localClasses);
              if (!this.student.className && this.availableClasses.length > 0) {
                this.student.className = this.availableClasses[0].class_name;
                this.onClassChange();
              }
            } catch(e){}
          }
          try {
            const res = await fetch('/api/classes');
            const data = await res.json();
            if (data && data.ok && Array.isArray(data.data) && data.data.length > 0) {
              if (!localClasses || data.from_d1) {
                this.availableClasses = data.data;
                if (!this.student.className && this.availableClasses.length > 0) {
                  this.student.className = this.availableClasses[0].class_name;
                  this.onClassChange();
                }
              }
            }
          } catch (e) {}
        },

        async onClassChange() {
          if (!this.student.className) {
            this.classStudentsList = [];
            return;
          }
          // Kiểm tra trong localStorage trước
          let foundLocal = false;
          try {
            const allStudentsStore = JSON.parse(localStorage.getItem('BMTC_STUDENTS') || '{}');
            const targetCls = (this.availableClasses || []).find(c => c.class_name === this.student.className || c.class_code === this.student.className);
            if (targetCls && allStudentsStore[targetCls.id]) {
              this.classStudentsList = allStudentsStore[targetCls.id];
              foundLocal = true;
            }
          } catch(e){}

          try {
            const res = await fetch('/api/classes?code=' + encodeURIComponent(this.student.className));
            const data = await res.json();
            if (data && data.ok && Array.isArray(data.data) && (data.from_d1 || !foundLocal)) {
              this.classStudentsList = data.data;
            }
          } catch (e) {}
          this.handleNameChange();
        },

        async askTeacherExplain(q, idx) {
          if (this.aiExplanations[idx]) return;
          this.loadingExplain[idx] = true;
          try {
            const res = await fetch('/api/explain', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                question: q.question,
                options: q.options,
                selectedOption: q.options[this.mcqAnswers[idx]] || 'Chưa chọn',
                correctOption: q.options[q.correctIndex],
                fallbackExplanation: q.explanation
              })
            });
            const data = await res.json();
            this.aiExplanations[idx] = data.explanation || q.explanation;
          } catch (err) {
            this.aiExplanations[idx] = q.explanation;
          } finally {
            this.loadingExplain[idx] = false;
          }
        },

        switchMode(mode) {
          this.activeMode = mode;
          if (mode === 'mcq') {
            this.timerSeconds = 900; // 15 mins for MCQ
          } else if (mode === 'simulator') {
            this.timerSeconds = 10800; // 180 mins for workshop
          }
          this.persistSession();
        },

        toggleZenMode() {
          this.zenMode = !this.zenMode;
          if (typeof document !== 'undefined') {
            document.body.classList.toggle('zen-mode', this.zenMode);
          }
        },

        startTimer() {
          if (this.timerInterval) clearInterval(this.timerInterval);
          this.timerInterval = setInterval(() => {
            if (this.timerSeconds > 0) {
              this.timerSeconds--;
            }
          }, 1000);
        },

        // --- POKA-YOKE PERSISTENCE & CRASH RECOVERY ---
        persistSession() {
          try {
            const data = {
              timestamp: new Date().toLocaleTimeString('vi-VN'),
              student: this.student,
              activeMode: this.activeMode,
              simPhase: this.simPhase,
              selectedTicketIndex: this.selectedTicketIndex,
              currentStep: this.currentStep,
              step1: this.step1,
              step2: this.step2,
              step3: this.step3,
              step4: this.step4,
              step5: this.step5,
              step6: this.step6,
              step7: this.step7,
              randomMCQs: this.randomMCQs,
              mcqCurrentIndex: this.mcqCurrentIndex,
              mcqAnswers: this.mcqAnswers,
              mcqFlagged: this.mcqFlagged,
              mcqSubmitted: this.mcqSubmitted,
              timerSeconds: this.timerSeconds,
            };
            localStorage.setItem('bmtc_hardware_state_v2', JSON.stringify(data));
            this.lastSavedText = data.timestamp;
          } catch (e) {}
        },

        checkSavedSession() {
          try {
            const raw = localStorage.getItem('bmtc_hardware_state_v2');
            if (raw) {
              const data = JSON.parse(raw);
              if (data && (data.student?.name || Object.keys(data.mcqAnswers || {}).length > 0)) {
                this.savedSessionInfo = {
                  name: data.student?.name || 'Kỹ thuật viên',
                  time: data.timestamp || 'gần đây'
                };
                this.showRecoveryBanner = true;
              }
            }
          } catch (e) {}
        },

        restoreSavedSession() {
          try {
            const raw = localStorage.getItem('bmtc_hardware_state_v2');
            if (raw) {
              const data = JSON.parse(raw);
              if (data.student) this.student = data.student;
              if (data.activeMode) this.activeMode = data.activeMode;
              if (data.simPhase) this.simPhase = data.simPhase;
              if (data.selectedTicketIndex !== undefined) this.selectedTicketIndex = data.selectedTicketIndex;
              if (data.currentStep) this.currentStep = data.currentStep;
              if (data.step1) this.step1 = data.step1;
              if (data.step2) this.step2 = data.step2;
              if (data.step3) this.step3 = data.step3;
              if (data.step4) this.step4 = data.step4;
              if (data.step5) this.step5 = data.step5;
              if (data.step6) this.step6 = data.step6;
              if (data.step7) this.step7 = data.step7;
              if (data.randomMCQs && data.randomMCQs.length > 0) this.randomMCQs = data.randomMCQs;
              if (data.mcqCurrentIndex !== undefined) this.mcqCurrentIndex = data.mcqCurrentIndex;
              if (data.mcqAnswers) this.mcqAnswers = data.mcqAnswers;
              if (data.mcqFlagged) this.mcqFlagged = data.mcqFlagged;
              if (data.mcqSubmitted !== undefined) this.mcqSubmitted = data.mcqSubmitted;
              if (data.timerSeconds) this.timerSeconds = data.timerSeconds;
              this.showRecoveryBanner = false;
              this.syncTicketData();
            }
          } catch (e) {}
        },

        discardSavedSession() {
          try {
            localStorage.removeItem('bmtc_hardware_state_v2');
          } catch (e) {}
          this.showRecoveryBanner = false;
        },

        // --- KEYBOARD SHORTCUTS (KANSO DESIGN) ---
        setupKeyboardListeners() {
          // Chống mở DevTools / F12 / Xem mã nguồn trong lúc làm bài thi trắc nghiệm
          window.addEventListener('keydown', (e) => {
            if (this.activeMode === 'mcq' && !this.mcqSubmitted) {
              if (
                e.key === 'F12' ||
                (e.ctrlKey && e.shiftKey && ['i', 'j', 'c'].includes(e.key.toLowerCase())) ||
                (e.ctrlKey && ['u', 's'].includes(e.key.toLowerCase()))
              ) {
                e.preventDefault();
                e.stopPropagation();
                return;
              }
            }
          });

          // Chống nhấp chuột phải soi mã nguồn khi làm bài thi
          window.addEventListener('contextmenu', (e) => {
            if (this.activeMode === 'mcq' && !this.mcqSubmitted) {
              e.preventDefault();
            }
          });

          window.addEventListener('keydown', (e) => {
            // Ignore if active in input/textarea/select
            const tag = document.activeElement ? document.activeElement.tagName.toLowerCase() : '';
            if (tag === 'input' || tag === 'textarea' || tag === 'select') return;

            if (this.activeMode === 'mcq' && !this.mcqSubmitted && this.randomMCQs.length > 0) {
              // Keys 1, 2, 3, 4 or A, B, C, D
              if (e.key === '1' || e.key.toLowerCase() === 'a') {
                this.selectMCQOption(0);
                e.preventDefault();
              } else if (e.key === '2' || e.key.toLowerCase() === 'b') {
                this.selectMCQOption(1);
                e.preventDefault();
              } else if (e.key === '3' || e.key.toLowerCase() === 'c') {
                this.selectMCQOption(2);
                e.preventDefault();
              } else if (e.key === '4' || e.key.toLowerCase() === 'd') {
                this.selectMCQOption(3);
                e.preventDefault();
              } else if (e.key === 'ArrowLeft' || e.key.toLowerCase() === 'h') {
                this.mcqPrevQuestion();
                e.preventDefault();
              } else if (e.key === 'ArrowRight' || e.key.toLowerCase() === 'l') {
                this.mcqNextQuestion();
                e.preventDefault();
              } else if (e.key.toLowerCase() === 'f') {
                this.toggleFlagCurrentMCQ();
                e.preventDefault();
              } else if (e.key === 'Enter') {
                if (this.mcqCurrentIndex === this.randomMCQs.length - 1) {
                  this.triggerSubmitMCQ();
                } else {
                  this.mcqNextQuestion();
                }
                e.preventDefault();
              }
            }
          });
        },

        selectMCQOption(oIdx) {
          this.mcqAnswers[this.mcqCurrentIndex] = oIdx;
          this.persistSession();
        },

        mcqPrevQuestion() {
          if (this.mcqCurrentIndex > 0) {
            this.mcqCurrentIndex--;
            this.persistSession();
          }
        },

        mcqNextQuestion() {
          if (this.mcqCurrentIndex < this.randomMCQs.length - 1) {
            this.mcqCurrentIndex++;
            this.persistSession();
          }
        },

        toggleFlagCurrentMCQ() {
          this.mcqFlagged[this.mcqCurrentIndex] = !this.mcqFlagged[this.mcqCurrentIndex];
          this.persistSession();
        },

        handleNameChange() {
          const rawName = (this.student.name || '').trim();
          if (rawName) {
            // Tự động nhận diện học sinh trong danh sách lớp theo Tên hoặc MSHS
            const matched = this.classStudentsList.find(st => 
              (st.full_name && st.full_name.toLowerCase() === rawName.toLowerCase()) ||
              (st.student_code && st.student_code.toLowerCase() === rawName.toLowerCase())
            );
            if (matched) {
              this.student.code = matched.student_code || '';
              this.student.dob = matched.date_of_birth || '';
              this.student.gender = matched.gender || 'Nam';
              this.student.originalClass = matched.original_class || this.student.className;
            } else {
              this.student.code = '';
              this.student.dob = '';
              this.student.originalClass = '';
            }

            let hash = 0;
            const str = rawName + (this.student.code || '') + this.student.station;
            for (let i = 0; i < str.length; i++) {
              hash = (hash << 5) - hash + str.charCodeAt(i);
              hash |= 0;
            }
            this.selectedTicketIndex = Math.abs(hash) % this.tickets.length;
            this.syncTicketData();
            this.persistSession();
          }
        },

        syncTicketData() {
          const t = this.currentTicket;
          this.step1.recordedDriveC = t.targetDriveC_GB;
          this.step1.recordedDriveD = t.targetDriveD_GB;
        },

        pickRandomTicket() {
          this.selectedTicketIndex = Math.floor(Math.random() * this.tickets.length);
          this.syncTicketData();
          this.persistSession();
        },

        startWorkbench() {
          if (!this.student.name.trim()) {
            alert('Vui lòng nhập Họ và tên Kỹ thuật viên tập sự trước khi vào bàn máy!');
            return;
          }
          this.syncTicketData();
          this.simPhase = 'workbench';
          this.currentStep = 1;
          this.persistSession();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        },

        triggerCutSafetyViolation() {
          this.safetyViolation = true;
          this.safetyViolationReason = 'Em đã dùng lệnh CUT thay vì COPY! Nếu cúp điện hoặc đơ máy giữa chừng, toàn bộ file gốc của khách sẽ biến mất vĩnh viễn!';
          this.persistSession();
          alert(this.safetyViolationReason);
        },

        approveStop1() {
          this.step2.teacherApprovedStop1 = true;
          this.persistSession();
          alert('✅ Thầy Phạm Tiến Đồng: Đã kiểm tra đối chiếu khớp 100% dữ liệu. Cho phép em chuyển sang Bước 3 mở máy xử lý!');
        },

        handleCleanRam() {
          if (!this.step3.pullPlugDischargeChecked) {
            alert('Chưa rút điện xả tụ mà thò tay vào tháo RAM là vi phạm an toàn điện!');
            return;
          }
          this.step3.screenRevived = true;
          this.step4.ramDualSnapAudible = true;
          this.persistSession();
          alert('✨ Em đã tháo thanh RAM, dùng CỤC TẨY TRẮNG chà sạch 2 mặt chân vàng mạ vàng, cắm lại nghe 2 tiếng TÁCH sập tai khóa. Bật máy lên hình trơn tru!');
        },

        handleReseatSata() {
          if (!this.step3.pullPlugDischargeChecked) {
            alert('Chưa rút điện xả tụ!');
            return;
          }
          this.step3.screenRevived = true;
          this.persistSession();
          alert('✨ Em đã cắm chặt lại cả 2 đầu cáp SATA và dây nguồn ổ cứng. Vào BIOS chỉnh lại Boot Option #1. Máy đã nhận diện ổ cứng!');
        },

        approveStop2() {
          this.step4.teacherApprovedStop2 = true;
          this.persistSession();
          alert('✅ Thầy Phạm Tiến Đồng: Đã kiểm tra thùng máy an toàn, CPU_FAN cắm chuẩn, không rơi ốc. Cho phép cắm điện thử máy!');
        },

        selectDriveC() {
          this.step5.targetPartitionGB = 'correct';
          this.persistSession();
          alert('✅ CHÍNH XÁC! Em đã chọn đúng phân vùng ' + this.currentTicket.targetDriveC_GB + 'GB (Ổ C) để cài Windows. Dữ liệu trên ổ D được giữ an toàn tuyệt đối!');
        },

        triggerFormatWrongDriveD() {
          this.safetyViolation = true;
          this.safetyViolationReason = 'THẢM HỌA: Em đã bấm Format nhầm vào phân vùng ổ D chứa toàn bộ dữ liệu của khách!';
          this.persistSession();
          alert(this.safetyViolationReason);
        },

        handlePrintTestPage() {
          this.step6.testPagePrinted = true;
          this.persistSession();
          alert('🖨️ RÈ RÈ... TÁCH! Đã xóa sạch lệnh kẹt trong Print Spooler. Máy in kéo giấy và in ra bản Windows Printer Test Page sắc nét hoàn hảo!');
        },

        approveStop3() {
          this.step7.teacherApprovedStop3 = true;
          this.persistSession();
          alert('✅ Thầy Phạm Tiến Đồng: Ca máy xử lý xuất sắc! Máy chạy mát êm, dữ liệu nguyên vẹn, bàn sạch sẽ. Chúc mừng em đã hoàn thành ca sát hạch!');
        },

        finishEvaluation() {
          this.simPhase = 'result';
          this.persistSession();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        },

        get rubricScores() {
          let safety = 0;
          if (this.safetyViolation) {
            safety = 0;
          } else {
            if (this.step3.pullPlugDischargeChecked) safety += 0.75;
            if (this.step7.benchCleaned) safety += 0.5;
            if (this.step2.isVerifiedMatch && this.step2.teacherApprovedStop1) safety += 0.75;
          }

          let diagnosis = 0;
          if (this.step1.completed) diagnosis += 0.75;
          if (this.step3.screenRevived) diagnosis += 1.75;

          let operation = 0;
          if (this.step4.thermalPasteBeanSize && this.step4.fanHeldWhenBlowing && this.step4.cpuFanPlugged) operation += 1.5;
          if (this.step2.samplesOpened) operation += 0.75;
          if (this.step5.deviceManagerClean) operation += 0.75;

          let verification = 0;
          if (this.step6.peripheralsWorking && this.step6.testPagePrinted) verification += 0.75;
          if (this.step7.tempUnder75Checked && this.step7.dataIntact100Checked) verification += 0.75;

          let handover = 0;
          if (this.step7.benchCleaned) handover += 0.25;
          if (this.step7.sheetSigned && this.step7.teacherApprovedStop3) handover += 0.75;

          const total = Number((safety + diagnosis + operation + verification + handover).toFixed(1));
          const isPass = total >= 5.0 && !this.safetyViolation;

          let rank = 'Chưa Đạt';
          if (isPass) {
            if (total >= 8.5) rank = 'Xuất sắc';
            else if (total >= 7.0) rank = 'Khá';
            else rank = 'Đạt yêu cầu';
          }

          return {
            safety: Number(safety.toFixed(2)),
            diagnosis: Number(diagnosis.toFixed(2)),
            operation: Number(operation.toFixed(2)),
            verification: Number(verification.toFixed(2)),
            handover: Number(handover.toFixed(2)),
            total,
            isPass,
            rank,
          };
        },

        async submitSimulationToD1() {
          this.isSubmitting = true;
          this.submitMessage = '';
          try {
            const res = await fetch('/api/assessments', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                slug: 'phan-cung',
                studentName: this.student.code ? ('[' + this.student.code + '] ' + this.student.name) : this.student.name,
                studentCode: this.student.code || '',
                originalClass: this.student.originalClass || this.student.className,
                className: this.student.className,
                station: this.student.station,
                answers: {
                  ticketCode: this.currentTicket.code,
                  ticketTitle: this.currentTicket.title,
                  rubric: this.rubricScores,
                  stepSummary: {
                    step1: this.step1,
                    step2: this.step2,
                    step3: this.step3,
                    step4: this.step4,
                    step5: this.step5,
                    step6: this.step6,
                    step7: this.step7,
                  }
                }
              })
            });
            const data = await res.json();
            if (data.ok) {
              this.submitSuccess = true;
              this.submitMessage = '✅ Hồ sơ sát hạch đã được lưu trữ vĩnh viễn vào CSDL Cloudflare D1 (Đồng bộ Bảng điểm Giảng viên)!';
            } else {
              this.submitSuccess = false;
              this.submitMessage = 'Lưu ý: ' + (data.error || 'Đã lưu trữ cục bộ tại phiên làm việc.');
            }
          } catch (err) {
            this.submitSuccess = true;
            this.submitMessage = '✅ Đã lưu kết quả cục bộ (Sẵn sàng in phiếu nghiệm thu A4).';
          } finally {
            this.isSubmitting = false;
          }
        },

        // --- RANDOMIZED MCQ ENGINE ---
        initRandomMCQ() {
          // Bốc ngẫu nhiên 2 câu từ mỗi chủ đề trong 5 chủ đề
          const categories = ['an-toan', 'lap-rap', 'bat-benh', 'cai-win', 'ngoai-vi'];
          const selected = [];
          categories.forEach(cat => {
            const catPool = this.allMCQBank.filter(q => q.category === cat);
            const shuffled = [...catPool].sort(() => 0.5 - Math.random());
            if (shuffled[0]) selected.push(shuffled[0]);
            if (shuffled[1]) selected.push(shuffled[1]);
          });
          // Xáo trộn 10 câu
          this.randomMCQs = selected.sort(() => 0.5 - Math.random());
          this.mcqCurrentIndex = 0;
          this.mcqAnswers = {};
          this.mcqFlagged = {};
          this.mcqSubmitted = false;
          this.mcqScore = 0;
          this.timerSeconds = 900; // 15 minutes
          this.persistSession();
        },

        triggerSubmitMCQ() {
          if (this.unansweredMCQList.length > 0) {
            this.showSubmitModal = true;
          } else {
            this.confirmSubmitMCQ();
          }
        },

        confirmSubmitMCQ() {
          this.showSubmitModal = false;
          let score = 0;
          this.randomMCQs.forEach((q, idx) => {
            if (this.mcqAnswers[idx] === q.correctIndex) {
              score += 1.0;
            }
          });
          this.mcqScore = score;
          this.mcqSubmitted = true;
          this.persistSession();
          window.scrollTo({ top: 0, behavior: 'smooth' });

          // Lưu bài thi trắc nghiệm lên D1 nếu có tên
          if (this.student.name.trim()) {
            fetch('/api/assessments', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                slug: 'phan-cung',
                studentName: this.student.code ? ('[' + this.student.code + '] ' + this.student.name) : this.student.name,
                studentCode: this.student.code || '',
                originalClass: this.student.originalClass || this.student.className,
                className: this.student.className,
                station: this.student.station,
                answers: {
                  ticketTitle: 'Trắc nghiệm tình huống kỹ thuật (10 câu)',
                  rubric: {
                    total: score,
                    isPass: score >= 5.0,
                    rank: score >= 8.5 ? 'Xuất sắc' : (score >= 7.0 ? 'Khá' : (score >= 5.0 ? 'Đạt' : 'Chưa đạt'))
                  }
                }
              })
            }).catch(() => {});
          }
        }
      }));
    });
  </script>
)}
