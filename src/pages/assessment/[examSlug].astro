---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import {
  HARDWARE_METADATA,
  OFFICIAL_RUBRIC_CRITERIA,
} from '../../data/hardwareCurriculum';
import {
  ORAL_QUESTIONS,
  ASSEMBLY_SCENARIOS,
  WINDOWS_INSTALL_SCENARIOS,
  MCQ_PRACTICAL_BANK,
  FULL_EXAM_TICKETS,
} from '../../data/questionBank';

export const prerender = true;

export function getStaticPaths() {
  return [
    { params: { examSlug: 'phan-cung' } },
    { params: { examSlug: 'mang' } },
  ];
}

const { examSlug } = Astro.params;
const isHardware = examSlug === 'phan-cung';

// Standard quiz for 'mang' or fallback
const STANDARD_EXAMS: Record<string, any> = {
  'mang': {
    name: 'Mạng Căn Bản & LAN/WAN',
    icon: '🌐',
    desc: 'Kiểm tra năng lực mô hình OSI, thiết bị mạng, chia mạng con IPv4 và cấu hình dịch vụ mạng.',
    questions: [
      { text: 'Mô hình tham chiếu OSI chuẩn hóa truyền thông mạng gồm bao nhiêu tầng?', options: ['4 tầng', '5 tầng', '7 tầng', '9 tầng'], correct: 2 },
      { text: 'Thiết bị nào hoạt động ở Tầng 3 (Network Layer) để định tuyến gói tin giữa các mạng logic?', options: ['Hub', 'Switch Layer 2', 'Router (Bộ định tuyến)', 'Repeater'], correct: 2 },
      { text: 'Địa chỉ IPv4 nào sau đây thuộc dải địa chỉ mạng riêng (Private IP)?', options: ['8.8.8.8', '192.168.1.100', '1.1.1.1', '203.162.0.11'], correct: 1 },
      { text: 'Giao thức nào có nhiệm vụ tự động cấp phát địa chỉ IP, Subnet Mask và Gateway cho client?', options: ['DNS', 'DHCP', 'FTP', 'HTTP'], correct: 1 },
      { text: 'Lệnh dòng lệnh nào dùng để kiểm tra tính thông suốt kết nối giữa 2 nút mạng bằng gói tin ICMP?', options: ['ipconfig /all', 'ping', 'tracert', 'netstat'], correct: 1 },
    ],
  },
};

const exam = isHardware
  ? { name: 'Ôn luyện Năng lực Nghề: Phần cứng Máy tính (OL-01)', icon: '🔧' }
  : (STANDARD_EXAMS[examSlug!] || STANDARD_EXAMS['mang']);
---

<BaseLayout title={`${exam.name} - Đánh giá năng lực thực tế`}>
  <section class="max-w-6xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { label: 'Trang chủ', href: '/' },
      { label: 'Đánh giá năng lực', href: '/assessment' },
      { label: exam.name, href: '' },
    ]} />

    {isHardware ? (
      <!-- ==================================================================== -->
      <!-- HARDWARE COMPETENCY SUITE (TỔNG HỢP ĐÁNH GIÁ NĂNG LỰC NGHỀ PC)       -->
      <!-- ==================================================================== -->
      <div class="mt-6" x-data="hardwareMasterEngine">
        <!-- Poka-Yoke Auto-Recovery Notification Banner -->
        <div
          x-show="showRecoveryBanner"
          x-cloak
          x-transition
          class="bg-amber-50 border-2 border-amber-300 rounded-2xl p-4 sm:p-5 shadow-sm mb-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs"
        >
          <div class="flex items-center gap-3">
            <span class="text-2xl">🛡️</span>
            <div>
              <p class="font-bold text-amber-950 text-sm">Poka-Yoke: Phát hiện dữ liệu bài làm trước đó</p>
              <p class="text-amber-800 mt-0.5">
                Hệ thống tự động lưu trữ phiên làm việc của <strong class="text-gray-900" x-text="savedSessionInfo.name || 'Học sinh'"></strong>
                vào lúc <span class="font-mono font-bold" x-text="savedSessionInfo.time"></span>. Em có muốn khôi phục lại không?
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
            <button
              type="button"
              @click="restoreSavedSession()"
              class="btn-primary text-xs px-4 py-2 bg-amber-700 hover:bg-amber-800 font-bold"
            >
              ✓ Khôi phục bài làm
            </button>
            <button
              type="button"
              @click="discardSavedSession()"
              class="btn-secondary text-xs px-3 py-2"
            >
              Bỏ qua & làm mới
            </button>
          </div>
        </div>

        <!-- Japanese Engineering & Zen Mode Toolbar -->
        <div class="flex flex-wrap items-center justify-between gap-3 bg-slate-900 text-white px-4 sm:px-6 py-2.5 rounded-2xl mb-4 shadow">
          <div class="flex items-center gap-3 text-xs">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-300 font-mono font-bold border border-emerald-500/30">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              POKA-YOKE V2.0
            </span>

            <!-- Auto-save state -->
            <span class="text-slate-300 hidden sm:inline-flex items-center gap-1">
              <span>💾</span>
              <span x-text="lastSavedText ? ('Đã lưu: ' + lastSavedText) : 'Tự động lưu vào máy'"></span>
            </span>
          </div>

          <!-- Right: Timer & Zen Mode Button -->
          <div class="flex items-center gap-3">
            <!-- Workshop Timer -->
            <div class="flex items-center gap-1.5 bg-slate-800 px-3 py-1 rounded-xl border border-slate-700 font-mono text-xs">
              <span class="text-slate-400">⏱️</span>
              <span
                class="font-bold tracking-wider"
                :class="timerSeconds < 180 ? 'text-rose-400 animate-pulse' : (timerSeconds < 600 ? 'text-amber-300' : 'text-emerald-400')"
                x-text="formattedTimer"
              ></span>
            </div>

            <!-- Zen / Focus Mode Toggle -->
            <button
              type="button"
              @click="toggleZenMode()"
              class="px-3 py-1 rounded-xl text-xs font-bold transition-all border flex items-center gap-1.5"
              :class="zenMode ? 'bg-primary-600 text-white border-primary-500' : 'bg-slate-800 text-slate-200 border-slate-700 hover:bg-slate-700'"
              title="Chế độ tập trung Zen Mode: Ẩn bớt giao diện thừa để làm bài"
            >
              <span>🎯</span>
              <span x-text="zenMode ? 'Thoát Zen Mode' : 'Chế độ tập trung (Zen)'"></span>
            </button>
          </div>
        </div>

        <!-- Main Top Header -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm mb-6">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-gray-100 pb-4">
            <div class="flex items-center gap-3.5">
              <span class="text-4xl sm:text-5xl">🛠️</span>
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <span class="text-xs font-mono uppercase tracking-wider text-primary-800 font-bold bg-primary-100 px-2.5 py-0.5 rounded-full">
                    Mã môn: {HARDWARE_METADATA.courseCode}
                  </span>
                  <span class="text-xs text-gray-500 font-mono">
                    Chuẩn Thông tư 55/2026/TT-BGDĐT
                  </span>
                </div>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
                  Hệ Thống Đánh Giá Năng Lực Nghề Phần Cứng Máy Tính
                </h1>
              </div>
            </div>

            <div class="text-left md:text-right text-xs text-gray-600">
              <p class="font-bold text-gray-900">GV Huấn luyện: {HARDWARE_METADATA.teacher}</p>
              <p class="text-gray-500">{HARDWARE_METADATA.institution}</p>
            </div>
          </div>

          <!-- Master Mode Navigation Tabs (Shadcn Minimalist Style) -->
          <div class="mt-4 flex flex-wrap gap-2 pt-2">
            <button
              type="button"
              @click="switchMode('mcq')"
              class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-all flex items-center gap-2 border shadow-sm"
              :class="activeMode === 'mcq'
                ? 'bg-slate-900 text-white border-slate-900'
                : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50'"
            >
              <span>🎲</span>
              <span>1. Trắc Nghiệm Sát Hạch (100 Câu AI)</span>
            </button>

            <a
              href="/practice"
              class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center gap-2 border bg-blue-50 text-blue-900 border-blue-200 hover:bg-blue-100 no-underline shadow-sm"
            >
              <span>🛠️</span>
              <span>2. Bàn Máy 10 Nhóm KTV →</span>
            </a>

            <button
              type="button"
              @click="switchMode('simulator')"
              class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center gap-2 border"
              :class="activeMode === 'simulator'
                ? 'bg-slate-900 text-white border-slate-900 shadow-sm'
                : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50'"
            >
              <span>🎮</span>
              <span>3. Mô Phỏng Ca Thi 7 Bước</span>
            </button>

            <button
              type="button"
              @click="switchMode('library')"
              class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center gap-2 border"
              :class="activeMode === 'library'
                ? 'bg-slate-900 text-white border-slate-900 shadow-sm'
                : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50'"
            >
              <span>📚</span>
              <span>4. Ngân Hàng Vấn Đáp</span>
            </button>
          </div>
        </div>

        <!-- ============================================================== -->
        <!-- MODE 1: 7-STEP JOB TICKET SIMULATOR                           -->
        <!-- ============================================================== -->
        <div x-show="activeMode === 'simulator'" class="space-y-6">
          <!-- SCREEN 1A: Ticket Reception -->
          <div x-show="simPhase === 'ticket'" class="space-y-6">
            <!-- Student form -->
            <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 shadow-sm">
              <h2 class="text-base font-bold text-gray-900 mb-4 flex items-center gap-2">
                <span>👤</span>
                <span>Thông Tin Kỹ Thuật Viên Tiếp Nhận Ca Máy</span>
              </h2>

              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                <div>
                  <label class="block text-xs font-bold text-gray-700 mb-1">Lớp chuyên ngành (*)</label>
                  <select
                    x-model="student.className"
                    @change="onClassChange()"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 focus:outline-none font-medium"
                  >
                    <option value="">-- Chọn lớp học --</option>
                    <template x-for="c in availableClasses" :key="c.id || c.class_code">
                      <option :value="c.class_name" x-text="(c.is_composite ? '🔗 [Lớp ghép] ' : '🏫 ') + c.class_code + ' - ' + c.class_name"></option>
                    </template>
                  </select>
                </div>

                <div>
                  <label class="block text-xs font-bold text-gray-700 mb-1">Họ và tên Kỹ thuật viên (*)</label>
                  <input
                    type="text"
                    list="student-names-list"
                    x-model="student.name"
                    @input="handleNameChange()"
                    @change="handleNameChange()"
                    placeholder="Chọn hoặc nhập họ tên..."
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 focus:outline-none font-semibold"
                  />
                  <!-- Danh sách gợi ý họ tên học sinh đã nạp từ Excel (Kèm MSHS, Lớp gốc và Ngày sinh) -->
                  <datalist id="student-names-list">
                    <template x-for="st in classStudentsList" :key="st.id || st.full_name">
                      <option :value="st.full_name" :label="(st.student_code ? ('[' + st.student_code + '] ') : '') + st.full_name + (st.original_class ? (' (Lớp gốc: ' + st.original_class + ')') : '') + (st.date_of_birth ? (' · ' + st.date_of_birth) : '')"></option>
                    </template>
                  </datalist>

                  <!-- Badge thông tin học sinh chuẩn đại học khi được nhận diện -->
                  <div x-show="student.code || student.dob || student.originalClass" class="mt-1 flex flex-wrap items-center gap-1.5 text-[11px]">
                    <span x-show="student.code" class="px-2 py-0.5 rounded bg-blue-100 text-blue-800 font-mono font-bold" x-text="'MSHS: ' + student.code"></span>
                    <span x-show="student.originalClass" class="px-2 py-0.5 rounded bg-purple-100 text-purple-900 font-mono font-bold border border-purple-200" x-text="'🏫 Lớp gốc: ' + student.originalClass"></span>
                    <span x-show="student.dob" class="px-2 py-0.5 rounded bg-gray-100 text-gray-700 font-mono" x-text="'🎂 ' + student.dob"></span>
                    <span x-show="student.gender" class="px-1.5 py-0.5 rounded font-bold" :class="student.gender === 'Nữ' ? 'bg-pink-100 text-pink-700' : 'bg-blue-50 text-blue-700'" x-text="student.gender"></span>
                  </div>
                </div>

                <div>
                  <label class="block text-xs font-bold text-gray-700 mb-1">Bàn kỹ thuật số</label>
                  <select
                    x-model="student.station"
                    @change="handleNameChange()"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 focus:outline-none"
                  >
                    <option value="Bàn kỹ thuật 01">Bàn kỹ thuật 01</option>
                    <option value="Bàn kỹ thuật 02">Bàn kỹ thuật 02</option>
                    <option value="Bàn kỹ thuật 03">Bàn kỹ thuật 03</option>
                    <option value="Bàn kỹ thuật 04">Bàn kỹ thuật 04</option>
                    <option value="Bàn kỹ thuật 05">Bàn kỹ thuật 05</option>
                    <option value="Bàn kỹ thuật 06">Bàn kỹ thuật 06</option>
                    <option value="Bàn kỹ thuật 07">Bàn kỹ thuật 07</option>
                  </select>
                </div>

                <div>
                  <label class="block text-xs font-bold text-gray-700 mb-1">Bạn cùng bàn (đổi vai A-B)</label>
                  <input
                    type="text"
                    x-model="student.partner"
                    placeholder="Ví dụ: Trần Quốc Bảo"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 focus:outline-none"
                  />
                </div>
              </div>
            </div>

            <!-- Ticket Selection from 6 Tickets -->
            <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 shadow-sm">
              <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-4">
                <div>
                  <h2 class="text-base font-bold text-gray-900 flex items-center gap-2">
                    <span>📋</span>
                    <span>Ngân Hàng 6 Ca Bệnh Thực Tế (Bốc Thăm Cá Nhân Hóa)</span>
                  </h2>
                  <p class="text-xs text-gray-500">Mỗi học sinh nhận 1 ca bệnh khác nhau, tỉ lệ trùng lặp giữa các bàn là cực thấp</p>
                </div>

                <button
                  type="button"
                  @click="pickRandomTicket()"
                  class="btn-secondary text-xs px-3 py-2 flex items-center gap-1.5 font-bold"
                >
                  <span>🎲 Bốc thăm ngẫu nhiên ca bệnh</span>
                </button>
              </div>

              <!-- Ticket Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-5">
                <template x-for="(t, idx) in tickets" :key="t.ticketId">
                  <button
                    type="button"
                    @click="selectedTicketIndex = idx; syncTicketData();"
                    class="text-left p-3.5 rounded-xl border-2 transition-all flex flex-col justify-between"
                    :class="selectedTicketIndex === idx ? 'border-primary-600 bg-primary-50/50 shadow-sm' : 'border-gray-200 hover:border-gray-300 bg-white'"
                  >
                    <div>
                      <div class="flex items-center justify-between mb-1.5">
                        <span
                          class="text-[11px] font-bold font-mono px-2 py-0.5 rounded"
                          :class="selectedTicketIndex === idx ? 'bg-primary-700 text-white' : 'bg-gray-100 text-gray-700'"
                          x-text="t.code"
                        ></span>
                        <span class="text-[11px] text-gray-400" x-show="selectedTicketIndex === idx">Đang chọn ✓</span>
                      </div>
                      <h3 class="font-bold text-gray-900 text-xs sm:text-sm leading-snug mb-1" x-text="t.title"></h3>
                    </div>
                    <div class="text-[11px] text-gray-500 pt-2 border-t border-gray-100 mt-2">
                      <span class="font-medium text-gray-700">Khách: </span>
                      <span x-text="t.customerName"></span>
                    </div>
                  </button>
                </template>
              </div>

              <!-- Active Ticket Summary Card -->
              <div class="bg-gray-50 border border-gray-200 rounded-xl p-5 space-y-3">
                <div class="flex items-center justify-between border-b border-gray-200 pb-2">
                  <span class="text-xs font-bold font-mono text-primary-800" x-text="'PHIẾU YÊU CẦU: ' + currentTicket.code + ' · ' + currentTicket.title"></span>
                  <span class="text-xs text-gray-500 font-mono">Thời gian: 180 phút</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                  <div>
                    <p class="font-bold text-gray-800 mb-1">Mô tả sự cố từ khách hàng:</p>
                    <p class="text-gray-600 leading-relaxed bg-white p-3 rounded-lg border border-gray-200" x-text="currentTicket.problemReport"></p>
                  </div>

                  <div>
                    <p class="font-bold text-gray-800 mb-1">Dữ liệu nhạy cảm (Luật giữ nồi cơm):</p>
                    <p class="text-red-700 font-semibold leading-relaxed bg-red-50 p-3 rounded-lg border border-red-200" x-text="currentTicket.dataFolder"></p>
                  </div>
                </div>

                <!-- 2 Random Oral Questions attached to this exam -->
                <div class="mt-3 p-3.5 bg-amber-50/70 border border-amber-200 rounded-xl text-xs space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="font-bold text-amber-900 flex items-center gap-1.5">
                      <span>🗣️</span>
                      <span>2 Câu hỏi vấn đáp ngẫu nhiên Thầy sẽ kiểm tra trực tiếp tại bàn:</span>
                    </span>
                    <span class="text-[11px] text-amber-700 italic">Rút từ Ngân hàng 20 câu</span>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
                    <div class="bg-white p-2.5 rounded-lg border border-amber-200">
                      <strong class="text-gray-900 block mb-1">Câu vấn đáp 1:</strong>
                      <p class="text-gray-700 text-[11px]" x-text="currentOralQuestions[0]?.question"></p>
                    </div>
                    <div class="bg-white p-2.5 rounded-lg border border-amber-200">
                      <strong class="text-gray-900 block mb-1">Câu vấn đáp 2:</strong>
                      <p class="text-gray-700 text-[11px]" x-text="currentOralQuestions[1]?.question"></p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Start Button -->
              <div class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-gray-100">
                <span class="text-xs text-gray-500">🛡️ Yêu cầu tuân thủ nghiêm ngặt 3 Luật sống còn & 3 Điểm dừng an toàn</span>
                <button
                  type="button"
                  @click="startWorkbench()"
                  class="w-full sm:w-auto btn-primary text-base px-8 py-3 shadow-lg flex items-center justify-center gap-2 font-bold"
                >
                  <span>Nhận Ca Máy & Vào Bàn Kỹ Thuật</span>
                  <span>→</span>
                </button>
              </div>
            </div>
          </div>

          <!-- SCREEN 1B: Interactive Workbench (7 Steps) -->
          <div x-show="simPhase === 'workbench'" class="space-y-6" x-cloak>
            <!-- Status Bar -->
            <div class="bg-white border border-gray-200 rounded-2xl p-4 sm:p-5 shadow-sm flex flex-wrap items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-xl bg-primary-700 text-white font-bold flex items-center justify-center text-sm shadow">
                  🔧
                </span>
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-bold font-mono px-2 py-0.5 bg-primary-100 text-primary-800 rounded" x-text="currentTicket.code"></span>
                    <span class="text-sm font-bold text-gray-900" x-text="student.name"></span>
                    <span class="text-xs text-gray-500" x-text="'(' + student.className + ' · ' + student.station + ')'"></span>
                  </div>
                  <p class="text-xs text-gray-600 mt-0.5" x-text="currentTicket.title"></p>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <button
                  type="button"
                  @click="simPhase = 'ticket'"
                  class="btn-secondary text-xs px-3 py-2"
                >
                  ← Đổi ca máy
                </button>
                <button
                  type="button"
                  @click="finishEvaluation()"
                  class="btn-primary text-xs px-4 py-2 font-bold bg-accent-600 hover:bg-accent-700"
                >
                  Hoàn thành ca máy & Chấm điểm 🏁
                </button>
              </div>
            </div>

            <!-- Step Progress Navigator -->
            <div class="bg-white border border-gray-200 rounded-2xl p-4 shadow-sm overflow-x-auto">
              <div class="flex items-center justify-between min-w-[700px] gap-2">
                <template x-for="s in [
                  { num: 1, name: '1. Nhận máy', icon: '📝' },
                  { num: 2, name: '2. Cứu dữ liệu', icon: '💾', stop: true },
                  { num: 3, name: '3. Bắt bệnh 60s', icon: '🩺' },
                  { num: 4, name: '4. Sạch & Lắp', icon: '🧹', stop: true },
                  { num: 5, name: '5. Cài đặt', icon: '💿' },
                  { num: 6, name: '6. Máy in & Ngoại vi', icon: '🖨️' },
