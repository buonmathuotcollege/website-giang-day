          alert('✨ Disk Management: Khởi tạo phân vùng GPT thành công! Ổ đĩa DATA_SSD (240GB) đã hiện trong This PC!');
        },

        approveStop2() {
          this.step4.teacherApprovedStop2 = true;
          alert('✅ Thầy Phạm Tiến Đồng: Đã kiểm tra thùng máy an toàn, CPU_FAN cắm chuẩn, không rơi ốc. Cho phép cắm điện thử máy!');
        },

        selectDriveC120() {
          this.step5.targetPartitionGB = '120';
          alert('✅ CHÍNH XÁC! Em đã chọn đúng phân vùng 120GB (Ổ C) để cài Windows. Dữ liệu trên phân vùng 380GB (Ổ D) được giữ an toàn tuyệt đối!');
        },

        triggerFormatWrongDriveD() {
          this.safetyViolation = true;
          this.safetyViolationReason = 'THẢM HỌA: Em đã bấm Format nhầm vào phân vùng 380GB (Ổ D chứa dữ liệu khách)!';
          alert(this.safetyViolationReason);
        },

        handlePrintTestPage() {
          this.step6.testPagePrinted = true;
          alert('🖨️ RÈ RÈ... TÁCH! Máy in kéo giấy và in ra bản Windows Printer Test Page sắc nét hoàn hảo!');
        },

        approveStop3() {
          this.step7.teacherApprovedStop3 = true;
          alert('✅ Thầy Phạm Tiến Đồng: Ca máy xử lý xuất sắc! Máy chạy mát êm, dữ liệu nguyên vẹn, bàn sạch sẽ. Chúc mừng em đã hoàn thành ca sát hạch!');
        },

        finishEvaluation() {
          this.phase = 'result';
          window.scrollTo({ top: 0, behavior: 'smooth' });
        },

        get rubricScores() {
          let safety = 0;
          if (this.safetyViolation) {
            safety = 0;
          } else {
            if (this.step3.pullPlugDischargeChecked) safety += 0.75;
            if (this.step7.benchCleaned) safety += 0.5;
            if (this.step2.isVerifiedMatch && this.step2.teacherApprovedStop1) safety += 0.75;
          }

          let diagnosis = 0;
          if (this.step1.completed) diagnosis += 0.75;
          if (this.step3.identifiedCause) diagnosis += 1.0;
          if (this.step3.screenRevived) diagnosis += 0.75;

          let operation = 0;
          if (this.step4.thermalPasteBeanSize && this.step4.fanHeldWhenBlowing && this.step4.cpuFanPlugged) operation += 1.0;
          if (this.step4.ramDualSnapAudible || this.step4.diskManagementInitialized) operation += 0.5;
          if (this.step2.destCount === this.step2.sourceCount && this.step2.samplesOpened) operation += 0.75;
          if (this.step5.deviceManagerClean && this.step5.timezoneSetHanoi) operation += 0.75;

          let verification = 0;
          if (this.step6.peripheralsWorking && this.step6.testPagePrinted) verification += 0.75;
          if (this.step7.tempUnder75Checked && this.step7.dataIntact100Checked) verification += 0.75;

          let handover = 0;
          if (this.step7.benchCleaned) handover += 0.25;
          if (this.step7.sheetSigned && this.step7.teacherApprovedStop3) handover += 0.75;

          const total = Number((safety + diagnosis + operation + verification + handover).toFixed(1));
          const isPass = total >= 5.0 && !this.safetyViolation;

          let rank = 'Chưa Đạt';
          if (isPass) {
            if (total >= 8.5) rank = 'Xuất sắc';
            else if (total >= 7.0) rank = 'Khá';
            else rank = 'Đạt yêu cầu';
          }

          return {
            safety: Number(safety.toFixed(2)),
            diagnosis: Number(diagnosis.toFixed(2)),
            operation: Number(operation.toFixed(2)),
            verification: Number(verification.toFixed(2)),
            handover: Number(handover.toFixed(2)),
            total,
            isPass,
            rank,
          };
        },

        async submitToCloudflareD1() {
          this.isSubmitting = true;
          this.submitMessage = '';
          try {
            const res = await fetch('/api/assessments', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                slug: 'phan-cung',
                studentName: this.student.name,
                className: this.student.className,
                station: this.student.station,
                answers: {
                  ticketCode: this.student.ticketCode,
                  ticketTitle: this.currentTicket.title,
                  rubric: this.rubricScores,
                  stepSummary: {
                    step1: this.step1,
                    step2: this.step2,
                    step3: this.step3,
                    step4: this.step4,
                    step5: this.step5,
                    step6: this.step6,
                    step7: this.step7,
                  }
                }
              })
            });
            const data = await res.json();
            if (data.ok) {
              this.submitSuccess = true;
              this.submitMessage = '✅ Hồ sơ đánh giá tay nghề đã được đồng bộ và lưu trữ an toàn vào CSDL Cloudflare D1!';
            } else {
              this.submitSuccess = false;
              this.submitMessage = 'Lưu ý: ' + (data.error || 'Đã ghi nhận kết quả tại phiên làm việc cục bộ.');
            }
          } catch (err) {
            this.submitSuccess = true;
            this.submitMessage = '✅ Đã lưu hồ sơ kỹ thuật viên cục bộ (sẵn sàng in phiếu nghiệm thu A4).';
          } finally {
            this.isSubmitting = false;
          }
        }
      }));
    });
  </script>
)}
