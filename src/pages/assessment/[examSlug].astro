          <p class="text-sm text-gray-400 mb-6">Chọn đáp án đúng nhất cho mỗi câu hỏi</p>
          <button @click="started = true" class="btn-primary text-lg px-8 py-3">
            Bắt đầu làm bài
          </button>
        </div>

        <!-- Quiz area -->
        <div x-show="started && !submitted" x-cloak class="space-y-4">
          <!-- Progress bar -->
          <div class="mb-4">
            <div class="flex justify-between text-xs text-gray-500 mb-1">
              <span>Câu <span x-text="current + 1"></span> / <span x-text="questions.length"></span></span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div class="bg-primary-700 h-2 rounded-full transition-all" :style="'width: ' + (((current + 1) / questions.length) * 100) + '%'"></div>
            </div>
          </div>

          <!-- Question Card -->
          <div class="card p-6">
            <h2 class="text-base font-semibold mb-4" x-text="'Câu ' + (current + 1) + ': ' + questions[current].text"></h2>
            <div class="space-y-2">
              <template x-for="(option, idx) in questions[current].options" :key="idx">
                <label
                  class="flex items-center gap-3 p-3 rounded-lg border cursor-pointer transition-colors text-sm"
                  :class="answers[current] === idx ? 'border-primary-500 bg-primary-50 font-semibold' : 'border-gray-200 hover:bg-gray-50'"
                >
                  <input
                    type="radio"
                    :name="'q-' + current"
                    :value="idx"
                    @change="answers[current] = idx"
                    :checked="answers[current] === idx"
                    class="accent-primary-700"
                  />
                  <span x-text="['A', 'B', 'C', 'D'][idx] + '. ' + option"></span>
                </label>
              </template>
            </div>

            <div class="flex justify-between mt-6 pt-4 border-t border-gray-100">
              <button
                type="button"
                @click="current--"
                :disabled="current === 0"
                class="btn-secondary text-xs px-4 py-2"
                :class="current === 0 ? 'opacity-40 cursor-not-allowed' : ''"
              >
                ← Câu trước
              </button>

              <button
                type="button"
                x-show="current < questions.length - 1"
                @click="current++"
                class="btn-primary text-xs px-4 py-2"
              >
                Câu tiếp theo →
              </button>

              <button
                type="button"
                x-show="current === questions.length - 1"
                @click="submitted = true"
                class="btn-primary text-xs px-5 py-2 font-bold bg-emerald-600 hover:bg-emerald-700"
              >
                Nộp bài thi 🏁
              </button>
            </div>
          </div>
        </div>

        <!-- Result Screen -->
        <div x-show="submitted" x-cloak class="text-center py-12 bg-white rounded-2xl border border-gray-200 p-8 shadow-sm">
          <span class="text-5xl mb-4 block">🏆</span>
          <h2 class="text-2xl font-bold mb-2">Hoàn Thành Bài Kiểm Tra</h2>
          <p class="text-sm text-gray-500 mb-6">Kết quả đánh giá năng lực</p>
          <div class="text-4xl font-extrabold text-primary-700 mb-2 font-mono">
            <span x-text="score"></span> / <span x-text="questions.length"></span>
          </div>
          <p class="text-sm font-semibold mb-6" :class="score >= questions.length / 2 ? 'text-emerald-600' : 'text-red-600'">
            <span x-text="score >= questions.length / 2 ? 'Chúc mừng em đã ĐẠT chuẩn năng lực!' : 'Em cần ôn tập thêm lý thuyết!'"></span>
          </p>
          <div class="flex justify-center gap-3">
            <button @click="started = false; submitted = false; current = 0; answers = {};" class="btn-secondary text-xs px-4 py-2">
              Làm lại bài
            </button>
            <a href="/assessment" class="btn-primary text-xs px-4 py-2">
              Danh sách bài kiểm tra
            </a>
          </div>
        </div>
      </div>
    )}
  </section>
</BaseLayout>

{isHardware && (
