---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import {
  HARDWARE_METADATA,
  PRACTICAL_EXAM_TICKETS,
  OFFICIAL_RUBRIC_CRITERIA,
} from '../../data/hardwareCurriculum';

export function getStaticPaths() {
  return [
    { params: { examSlug: 'phan-cung' } },
    { params: { examSlug: 'mang' } },
  ];
}

const { examSlug } = Astro.params;
const isHardware = examSlug === 'phan-cung';

// Standard quiz for 'mang' or fallback
const STANDARD_EXAMS: Record<string, any> = {
  'mang': {
    name: 'Mạng Căn Bản & LAN/WAN',
    icon: '🌐',
    desc: 'Kiểm tra năng lực mô hình OSI, thiết bị mạng, chia mạng con IPv4 và cấu hình dịch vụ mạng.',
    questions: [
      { text: 'Mô hình tham chiếu OSI chuẩn hóa truyền thông mạng gồm bao nhiêu tầng?', options: ['4 tầng', '5 tầng', '7 tầng', '9 tầng'], correct: 2 },
      { text: 'Thiết bị nào hoạt động ở Tầng 3 (Network Layer) để định tuyến gói tin giữa các mạng logic?', options: ['Hub', 'Switch Layer 2', 'Router (Bộ định tuyến)', 'Repeater'], correct: 2 },
      { text: 'Địa chỉ IPv4 nào sau đây thuộc dải địa chỉ mạng riêng (Private IP)?', options: ['8.8.8.8', '192.168.1.100', '1.1.1.1', '203.162.0.11'], correct: 1 },
      { text: 'Giao thức nào có nhiệm vụ tự động cấp phát địa chỉ IP, Subnet Mask và Gateway cho client?', options: ['DNS', 'DHCP', 'FTP', 'HTTP'], correct: 1 },
      { text: 'Lệnh dòng lệnh nào dùng để kiểm tra tính thông suốt kết nối giữa 2 nút mạng bằng gói tin ICMP?', options: ['ipconfig /all', 'ping', 'tracert', 'netstat'], correct: 1 },
    ],
  },
};

const exam = isHardware
  ? { name: 'Ôn luyện Năng lực Nghề: Phần cứng Máy tính (OL-01)', icon: '🔧' }
  : (STANDARD_EXAMS[examSlug!] || STANDARD_EXAMS['mang']);
---

<BaseLayout title={`${exam.name} - Đánh giá năng lực thực tế`}>
  <section class="max-w-5xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { label: 'Trang chủ', href: '/' },
      { label: 'Đánh giá năng lực', href: '/assessment' },
      { label: exam.name, href: '' },
    ]} />

    {isHardware ? (
      <!-- ==================================================================== -->
      <!-- HARDWARE JOB TICKET SIMULATOR (MÔ PHỎNG SÁT HẠCH TAY NGHỀ THỰC TẾ) -->
      <!-- ==================================================================== -->
      <div class="mt-6" x-data="hardwareSimulator">
        <!-- ============================================================== -->
        <!-- SCREEN 1: RECEPTION DESK & JOB TICKET SELECTION               -->
        <!-- ============================================================== -->
        <div x-show="phase === 'ticket'" class="space-y-6">
          <!-- Top Banner -->
          <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 shadow-sm">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-gray-100 pb-5">
              <div class="flex items-center gap-3">
                <span class="text-4xl">🛠️</span>
                <div>
                  <span class="text-xs font-mono uppercase tracking-wider text-primary-700 font-bold bg-primary-50 px-2 py-0.5 rounded">
                    Mô hình Xưởng Kỹ thuật A-Z
                  </span>
                  <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mt-0.5">
                    Mô Phỏng Đánh Giá Tay Nghề Kỹ Thuật Viên Máy Tính
                  </h1>
                </div>
              </div>
              <div class="text-right hidden sm:block">
                <p class="text-xs text-gray-500 font-mono">Mã môn: {HARDWARE_METADATA.courseCode}</p>
                <p class="text-xs text-primary-700 font-bold">Giảng viên: {HARDWARE_METADATA.teacher}</p>
              </div>
            </div>

            <p class="text-sm text-gray-600 mt-4 leading-relaxed">
              Chào mừng em đến với buổi đánh giá năng lực nghề thực tế. Em sẽ đóng vai trò <strong>Kỹ thuật viên tập sự</strong> tiếp nhận một ca máy thật tại phòng máy, xử lý sự cố xuyên suốt theo <strong>Quy trình 7 Bước thực chiến</strong>, vượt qua <strong>3 Điểm dừng an toàn</strong> và được chấm điểm tự động theo <strong>Rubric 10.0 điểm chuẩn Thông tư 55</strong>.
            </p>
          </div>

          <!-- Student Profile Form -->
          <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 shadow-sm">
            <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
              <span>👤</span>
              <span>Thông Tin Kỹ Thuật Viên Tiếp Nhận Ca Máy</span>
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
              <div>
                <label class="block text-xs font-bold text-gray-700 mb-1">Họ và tên Kỹ thuật viên (*)</label>
                <input
                  type="text"
                  x-model="student.name"
                  placeholder="Ví dụ: Nguyễn Văn An"
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 focus:outline-none"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-700 mb-1">Lớp chuyên ngành</label>
                <input
                  type="text"
                  x-model="student.className"
                  placeholder="Ví dụ: THUD_K26A"
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 focus:outline-none"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-700 mb-1">Bàn kỹ thuật số</label>
                <select
                  x-model="student.station"
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 focus:outline-none"
                >
                  <option value="Bàn kỹ thuật 01">Bàn kỹ thuật 01</option>
                  <option value="Bàn kỹ thuật 02">Bàn kỹ thuật 02</option>
                  <option value="Bàn kỹ thuật 03">Bàn kỹ thuật 03</option>
                  <option value="Bàn kỹ thuật 04">Bàn kỹ thuật 04</option>
                  <option value="Bàn kỹ thuật 05">Bàn kỹ thuật 05</option>
                  <option value="Bàn kỹ thuật 06">Bàn kỹ thuật 06</option>
                  <option value="Bàn kỹ thuật 07">Bàn kỹ thuật 07</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-700 mb-1">Bạn cùng bàn (đổi vai A-B)</label>
                <input
                  type="text"
                  x-model="student.partner"
                  placeholder="Ví dụ: Trần Quốc Bảo"
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 focus:outline-none"
                />
              </div>
            </div>
          </div>

          <!-- Ticket Selection -->
          <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 shadow-sm">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-4">
              <div>
                <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                  <span>📋</span>
                  <span>Bốc Thăm / Lựa Chọn Ca Bệnh Thực Tế (Phiếu Yêu Cầu Kỹ Thuật)</span>
                </h2>
                <p class="text-xs text-gray-500">Mỗi đề thi mô phỏng 1 tình huống sự cố điển hình thường gặp tại các trung tâm dịch vụ</p>
              </div>

              <button
                type="button"
                @click="pickRandomTicket()"
                class="btn-secondary text-xs px-3 py-2 flex items-center gap-1.5 font-bold"
              >
                <span>🎲 Bốc thăm ngẫu nhiên ca bệnh</span>
              </button>
            </div>

            <!-- Ticket Tabs -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
              <template x-for="(t, idx) in tickets" :key="t.id">
                <button
                  type="button"
                  @click="selectedTicketIndex = idx; syncTicketData();"
                  class="text-left p-4 rounded-xl border-2 transition-all flex flex-col justify-between"
                  :class="selectedTicketIndex === idx ? 'border-primary-600 bg-primary-50/50 shadow-sm' : 'border-gray-200 hover:border-gray-300 bg-white'"
                >
                  <div>
                    <div class="flex items-center justify-between mb-2">
                      <span
                        class="text-xs font-bold font-mono px-2 py-0.5 rounded"
                        :class="selectedTicketIndex === idx ? 'bg-primary-700 text-white' : 'bg-gray-100 text-gray-700'"
                        x-text="t.code"
                      ></span>
                      <span class="text-xs text-gray-400" x-show="selectedTicketIndex === idx">Đang chọn ✓</span>
                    </div>
                    <h3 class="font-bold text-gray-900 text-sm leading-snug mb-2" x-text="t.title"></h3>
                  </div>
                  <div class="text-[11px] text-gray-500 pt-2 border-t border-gray-100 mt-2">
                    <span class="font-semibold text-gray-700">Yêu cầu chính:</span>
                    <span x-text="t.hardwareTask"></span>
                  </div>
                </button>
              </template>
            </div>

            <!-- Active Ticket Detail Card -->
            <div class="bg-gray-50 border border-gray-200 rounded-xl p-5 space-y-3">
              <div class="flex items-center justify-between border-b border-gray-200 pb-2">
                <span class="text-xs font-bold font-mono text-primary-800" x-text="'CHI TIẾT PHIẾU YÊU CẦU: ' + currentTicket.code"></span>
                <span class="text-xs text-gray-500">Thời gian quy định: 180 phút</span>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                <div>
                  <p class="font-bold text-gray-800 mb-1">Mô tả sự cố từ khách hàng:</p>
                  <p class="text-gray-600 leading-relaxed bg-white p-3 rounded-lg border border-gray-200" x-text="currentTicket.customerProblem"></p>
                </div>

                <div>
                  <p class="font-bold text-gray-800 mb-1">Mục tiêu dữ liệu nhạy cảm (Luật giữ nồi cơm):</p>
                  <p class="text-red-700 font-semibold leading-relaxed bg-red-50 p-3 rounded-lg border border-red-200" x-text="currentTicket.dataTarget"></p>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-xs">
                <div class="bg-white p-2.5 rounded-lg border border-gray-200">
                  <span class="text-gray-500 block mb-0.5 font-medium">Phần cứng & Sửa chữa:</span>
                  <span class="text-gray-800 font-semibold" x-text="currentTicket.hardwareTask"></span>
                </div>
                <div class="bg-white p-2.5 rounded-lg border border-gray-200">
                  <span class="text-gray-500 block mb-0.5 font-medium">Hệ điều hành & Driver:</span>
                  <span class="text-gray-800 font-semibold" x-text="currentTicket.softwareTask"></span>
                </div>
                <div class="bg-white p-2.5 rounded-lg border border-gray-200">
                  <span class="text-gray-500 block mb-0.5 font-medium">Nghiệm thu bàn giao:</span>
                  <span class="text-gray-800 font-semibold" x-text="currentTicket.verificationTask"></span>
                </div>
              </div>
            </div>

            <!-- Start Action Button -->
            <div class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-gray-100">
              <div class="flex items-center gap-2 text-xs text-gray-500">
                <span>🛡️</span>
                <span>Yêu cầu tuân thủ 3 Luật sống còn & 3 Điểm dừng an toàn</span>
              </div>

              <button
                type="button"
                @click="startWorkbench()"
                class="w-full sm:w-auto btn-primary text-base px-8 py-3 shadow-lg flex items-center justify-center gap-2 font-bold"
              >
                <span>Nhận Ca Máy & Vào Bàn Kỹ Thuật</span>
                <span>→</span>
              </button>
            </div>
          </div>
        </div>

        <!-- ============================================================== -->
        <!-- SCREEN 2: 7-STEP INTERACTIVE WORKBENCH SIMULATOR              -->
        <!-- ============================================================== -->
        <div x-show="phase === 'workbench'" class="space-y-6" x-cloak>
          <!-- Workbench Top Status Bar -->
          <div class="bg-white border border-gray-200 rounded-2xl p-4 sm:p-5 shadow-sm flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-xl bg-primary-700 text-white font-bold flex items-center justify-center text-sm shadow">
                🔧
              </span>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold font-mono px-2 py-0.5 bg-primary-100 text-primary-800 rounded" x-text="student.ticketCode"></span>
                  <span class="text-sm font-bold text-gray-900" x-text="student.name"></span>
                  <span class="text-xs text-gray-500" x-text="'(' + student.className + ' · ' + student.station + ')'"></span>
                </div>
                <p class="text-xs text-gray-600 mt-0.5" x-text="currentTicket.title"></p>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                @click="phase = 'ticket'"
                class="btn-secondary text-xs px-3 py-2"
              >
                ← Đổi ca máy
              </button>
              <button
                type="button"
                @click="finishEvaluation()"
                class="btn-primary text-xs px-4 py-2 font-bold bg-accent-600 hover:bg-accent-700"
              >
                Hoàn thành ca máy & Chấm điểm 🏁
              </button>
            </div>
          </div>

          <!-- Step Progression Navigator -->
          <div class="bg-white border border-gray-200 rounded-2xl p-4 shadow-sm overflow-x-auto">
            <div class="flex items-center justify-between min-w-[700px] gap-2">
              <template x-for="s in [
                { num: 1, name: '1. Nhận máy', icon: '📝' },
                { num: 2, name: '2. Cứu dữ liệu', icon: '💾', stop: true },
                { num: 3, name: '3. Bắt bệnh 60s', icon: '🩺' },
                { num: 4, name: '4. Sạch & Lắp', icon: '🧹', stop: true },
                { num: 5, name: '5. Cài đặt', icon: '💿' },
                { num: 6, name: '6. Máy in & Ngoại vi', icon: '🖨️' },
                { num: 7, name: '7. Nghiệm thu', icon: '📋', stop: true },
              ]" :key="s.num">
                <button
                  type="button"
                  @click="currentStep = s.num"
                  class="flex-1 py-2 px-2 rounded-xl text-xs font-bold transition-all flex flex-col items-center gap-1 border"
                  :class="currentStep === s.num
                    ? 'border-primary-600 bg-primary-600 text-white shadow'
                    : 'border-gray-200 bg-gray-50 text-gray-700 hover:bg-gray-100'"
                >
                  <div class="flex items-center gap-1">
                    <span x-text="s.icon"></span>
                    <span x-text="s.name"></span>
                    <span x-show="s.stop" class="text-[10px] bg-red-500 text-white px-1 rounded-full font-mono">🛑</span>
                  </div>
                </button>
              </template>
            </div>
          </div>

          <!-- Safety Violation Warning banner (if triggered) -->
          <div x-show="safetyViolation" class="p-4 rounded-xl bg-red-100 border-2 border-red-500 text-red-900 shadow">
            <div class="flex items-center gap-2 font-bold text-sm mb-1">
              <span>🚨</span>
              <span>BÁO ĐỘNG VI PHẠM AN TOÀN NGHỀ NGHIỆP:</span>
            </div>
            <p class="text-xs leading-relaxed" x-text="safetyViolationReason"></p>
            <p class="text-[11px] font-bold text-red-800 mt-2">Hậu quả thi: Điểm tiêu chí 1 (An toàn) bị 0 ĐIỂM và ca thi bị đánh giá CHƯA ĐẠT!</p>
          </div>

          <!-- Main Interactive Bench Grid -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left Column: Live Machine State Monitor -->
            <div class="bg-gray-900 text-gray-100 rounded-2xl p-5 shadow-lg border border-gray-800 space-y-4">
              <div class="flex items-center justify-between border-b border-gray-800 pb-3">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-emerald-400 font-mono">Màn Hình Kiểm Tra Trực Tiếp</h3>
                </div>
                <span class="text-[10px] text-gray-400 font-mono">DIAGNOSTIC 2.0</span>
              </div>

              <!-- Visual Status Monitor -->
              <div class="space-y-3 font-mono text-xs">
                <!-- Power & Screen -->
                <div class="bg-gray-800/80 p-3 rounded-xl border border-gray-700 space-y-1.5">
                  <div class="flex justify-between items-center">
                    <span class="text-gray-400 text-[11px]">Trạng thái nguồn:</span>
                    <span
                      class="px-2 py-0.5 rounded text-[10px] font-bold"
                      :class="step3.pullPlugDischargeChecked ? 'bg-amber-900/60 text-amber-300' : 'bg-emerald-900/60 text-emerald-300'"
                      x-text="step3.pullPlugDischargeChecked ? 'ĐÃ RÚT ĐIỆN & XẢ TỤ' : 'ĐANG CẮM NGUỒN'"
                    ></span>
                  </div>

                  <div class="flex justify-between items-center">
                    <span class="text-gray-400 text-[11px]">Màn hình hiển thị:</span>
                    <span
                      class="px-2 py-0.5 rounded text-[10px] font-bold"
                      :class="step3.screenRevived ? 'bg-emerald-900/60 text-emerald-300' : 'bg-red-900/60 text-red-300'"
                      x-text="step3.screenRevived ? 'ĐÃ LÊN HÌNH (UEFI BIOS)' : 'ĐEN THUI (NO SIGNAL / LỖI)'"
                    ></span>
                  </div>

                  <div class="flex justify-between items-center">
                    <span class="text-gray-400 text-[11px]">Âm báo Mainboard:</span>
                    <span
                      class="text-[10px]"
                      :class="step3.screenRevived ? 'text-emerald-400' : 'text-gray-400'"
                      x-text="step3.screenRevived ? '1 Tiếng Bíp ngắn (POST OK)' : 'Không có tiếng Bíp'"
                    ></span>
                  </div>
                </div>

                <!-- Hardware Detected -->
                <div class="bg-gray-800/80 p-3 rounded-xl border border-gray-700 space-y-1.5 text-[11px]">
                  <p class="text-gray-400 font-bold uppercase text-[10px] border-b border-gray-700 pb-1 mb-1">Cấu Hình Phần Cứng</p>
                  <p><span class="text-gray-400">CPU:</span> <span class="text-gray-200" x-text="step1.cpuModel"></span></p>
                  <p>
                    <span class="text-gray-400">Tổng RAM:</span>
                    <span
                      class="font-bold"
                      :class="step4.ramDualSnapAudible ? 'text-emerald-400' : 'text-gray-200'"
                      x-text="step4.ramDualSnapAudible ? '16 GB DDR4 (Đã nhận đủ 2 thanh)' : step1.ramDetected"
                    ></span>
                  </p>
                  <p><span class="text-gray-400">Phân vùng:</span> <span class="text-gray-200" x-text="step1.diskConfig"></span></p>
                  <p x-show="step4.diskManagementInitialized" class="text-emerald-400">
                    ✓ Đã nhận ổ phụ: DATA_SSD (240 GB)
                  </p>
                </div>

                <!-- Thermal & Health -->
                <div class="bg-gray-800/80 p-3 rounded-xl border border-gray-700 space-y-1.5 text-[11px]">
                  <div class="flex justify-between items-center">
                    <span class="text-gray-400">Nhiệt độ CPU (Tải):</span>
                    <span
                      class="font-bold px-2 py-0.5 rounded text-[10px]"
                      :class="step4.thermalPasteBeanSize ? 'bg-emerald-950 text-emerald-400' : 'bg-red-950 text-red-400'"
                      x-text="step4.thermalPasteBeanSize ? step7.cpuTempLoaded + '°C (Ổn định mát)' : '92°C (CỰC NÓNG)'"
                    ></span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-gray-400">Tốc độ quạt CPU:</span>
                    <span
                      class="text-[10px]"
                      :class="step4.cpuFanPlugged ? 'text-emerald-400' : 'text-red-400'"
                      x-text="step4.cpuFanPlugged ? '1,450 RPM (Quay êm ái)' : '0 RPM (Chưa cắm CPU_FAN!)'"
                    ></span>
                  </div>
                </div>

                <!-- Data Safety Status -->
                <div class="bg-gray-800/80 p-3 rounded-xl border border-gray-700 space-y-1 text-[11px]">
                  <p class="text-gray-400 font-bold uppercase text-[10px] border-b border-gray-700 pb-1 mb-1">Bảo Toàn Dữ Liệu</p>
                  <p>
                    <span class="text-gray-400">Dữ liệu gốc:</span>
                    <span class="text-amber-300" x-text="step2.sourceCount + ' files (' + step2.sourceMB + ' MB)'"></span>
                  </p>
                  <p>
                    <span class="text-gray-400">Đã chép sang D:</span>
                    <span
                      class="font-bold"
                      :class="step2.isVerifiedMatch ? 'text-emerald-400' : 'text-gray-400'"
                      x-text="step2.isVerifiedMatch ? step2.destCount + ' files (' + step2.destMB + ' MB) - KHỚP 100%' : 'Chưa đối chiếu'"
                    ></span>
                  </p>
                </div>
              </div>

              <!-- Lego reminder -->
              <div class="p-3 rounded-xl bg-gray-800/40 border border-gray-700 text-[11px] text-gray-400 space-y-1">
                <p class="font-bold text-gray-300">💡 3 Luật sống còn nhắc em:</p>
                <p>1. Rút điện - Bấm xả tụ 3 lần - Ốc vào khay.</p>
                <p>2. Dữ liệu là nồi cơm, chưa cứu thì không format.</p>
                <p>3. Rãnh khuyết Lego, thấy cấn tay thì xoay lại.</p>
              </div>
            </div>

            <!-- Right Column (2 cols): Step-by-Step Action Workspace -->
            <div class="lg:col-span-2 space-y-6">
              <!-- ============================================== -->
              <!-- STEP 1: NHẬN MÁY & ĐỌC CẤU HÌNH                -->
              <!-- ============================================== -->
              <div x-show="currentStep === 1" class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm space-y-5">
                <div class="flex items-center justify-between border-b border-gray-200 pb-3">
                  <div>
                    <span class="text-xs font-mono font-bold text-primary-700 uppercase">Bước 1 / 7</span>
                    <h3 class="text-lg font-bold text-gray-900">Tiếp Nhận Máy & Đọc Cấu Hình Trong 3 Phút</h3>
                  </div>
                  <span class="text-xs bg-gray-100 text-gray-600 px-2.5 py-1 rounded-full font-mono">15-20 phút</span>
                </div>

                <div class="p-3.5 bg-blue-50 border border-blue-200 rounded-xl text-xs text-blue-900">
                  <strong>Nhiệm vụ:</strong> Khám vỏ ngoài, cắm điện thử máy để phân loại 4 trạng thái khởi động (A/B/C/D), đọc nhanh cấu hình máy và đặc biệt là <strong>ghi lại dung lượng ổ C và ổ D</strong> để không format nhầm ở Bước 5.
                </div>

                <!-- Action 1.1: Chassis check -->
                <div class="space-y-2">
                  <label class="block text-xs font-bold text-gray-800">1.1 Khám vỏ ngoài máy tính lúc tiếp nhận:</label>
                  <select x-model="step1.chassisCondition" class="w-full text-xs p-2.5 border border-gray-300 rounded-lg">
                    <option value="Nguyên vẹn, trầy nhẹ cạnh bên">Nguyên vẹn, trầy xước nhẹ vỏ thùng máy (bình thường)</option>
                    <option value="Móp méo góc thùng, thiếu 2 ốc sau">Vỏ thùng máy móp méo, thiếu 2 ốc vít sau lưng</option>
                    <option value="Bể mặt nạ nhựa trước, đứt dây audio">Bể mặt nạ nhựa trước, đứt dây jack audio cổng trước</option>
                  </select>
                </div>

                <!-- Action 1.2: Power button test -->
                <div class="space-y-2">
                  <label class="block text-xs font-bold text-gray-800">1.2 Cắm điện bật thử máy — Quan sát thấy triệu chứng gì?</label>
                  <div class="space-y-2 text-xs">
                    <label class="flex items-center gap-2 p-2.5 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer">
                      <input type="radio" value="A" x-model="step1.powerTestOutcome" name="power_state" />
                      <span><strong>Trường hợp A:</strong> Máy vào Windows bình thường, lên hình trơn tru.</span>
                    </label>
                    <label class="flex items-center gap-2 p-2.5 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer">
                      <input type="radio" value="B" x-model="step1.powerTestOutcome" name="power_state" />
                      <span><strong>Trường hợp B:</strong> Bấm nút nguồn IM RE, quạt không quay, đèn không sáng.</span>
                    </label>
                    <label class="flex items-center gap-2 p-2.5 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer">
                      <input type="radio" value="C" x-model="step1.powerTestOutcome" name="power_state" />
                      <span><strong>Trường hợp C:</strong> Quạt quay VÙ VÙ nhưng MÀN HÌNH ĐEN THUI (No Signal).</span>
                    </label>
                    <label class="flex items-center gap-2 p-2.5 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer">
                      <input type="radio" value="D" x-model="step1.powerTestOutcome" name="power_state" />
                      <span><strong>Trường hợp D:</strong> Hiện logo rồi báo chữ trắng "No Bootable Device" hoặc màn hình xanh.</span>
                    </label>
                  </div>
                </div>

                <!-- Action 1.3: Record Drive C and D -->
                <div class="space-y-2 bg-amber-50 p-4 rounded-xl border border-amber-200 text-xs">
                  <p class="font-bold text-amber-900">1.3 Con số sống còn: Ghi lại dung lượng Ổ C và Ổ D vào phiếu:</p>
                  <p class="text-amber-800 text-[11px]">Nhìn thông số ổ cứng của máy này: C: 120 GB, D: 380 GB. Em hãy điền đúng số GB vào ô dưới:</p>
                  <div class="grid grid-cols-2 gap-3 pt-1">
                    <div>
                      <label class="block font-medium text-gray-700 mb-0.5">Dung lượng ổ C (GB):</label>
                      <input
                        type="number"
                        x-model="step1.recordedDriveC"
                        placeholder="120"
                        class="w-full p-2 border border-gray-300 rounded text-xs"
                      />
                    </div>
                    <div>
                      <label class="block font-medium text-gray-700 mb-0.5">Dung lượng ổ D (GB):</label>
                      <input
                        type="number"
                        x-model="step1.recordedDriveD"
                        placeholder="380"
                        class="w-full p-2 border border-gray-300 rounded text-xs"
                      />
                    </div>
                  </div>
                </div>

                <div class="pt-3 flex justify-between items-center">
                  <span class="text-xs text-emerald-700 font-semibold" x-show="step1.recordedDriveC == 120 && step1.recordedDriveD == 380">
                    ✓ Đã ghi nhận chính xác dung lượng 2 ổ đĩa!
                  </span>
                  <button
                    type="button"
                    @click="step1.completed = true; currentStep = 2;"
                    class="btn-primary text-xs px-5 py-2.5 font-bold ml-auto"
                  >
                    Hoàn thành Bước 1 → Sang Bước 2 Cứu Dữ Liệu
                  </button>
                </div>
              </div>

              <!-- ============================================== -->
              <!-- STEP 2: CỨU DỮ LIỆU — GIỮ NỒI CƠM (STOP 1)     -->
              <!-- ============================================== -->
              <div x-show="currentStep === 2" class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm space-y-5">
                <div class="flex items-center justify-between border-b border-gray-200 pb-3">
                  <div>
                    <span class="text-xs font-mono font-bold text-red-600 uppercase flex items-center gap-1">
                      <span>Bước 2 / 7</span>
                      <span class="bg-red-100 text-red-800 px-2 py-0.2 rounded font-bold">🛑 ĐIỂM DỪNG AN TOÀN SỐ 1</span>
                    </span>
                    <h3 class="text-lg font-bold text-gray-900 mt-0.5">Cứu Dữ Liệu — Luật "Giữ Nồi Cơm Của Khách"</h3>
                  </div>
                  <span class="text-xs bg-gray-100 text-gray-600 px-2.5 py-1 rounded-full font-mono">10-25 phút</span>
                </div>

                <div class="p-3.5 bg-red-50 border-l-4 border-red-500 rounded-xl text-xs text-red-900 leading-relaxed">
                  <strong>NGUYÊN TẮC BẤT DI BẤT DỊCH:</strong> Chưa cứu dữ liệu thì TUYỆT ĐỐI KHÔNG mở máy sửa chữa phần cứng, không format ổ đĩa. Dữ liệu khách là nồi cơm, mất là phải đền!
                </div>

                <!-- Simulation Action 2.1: Select Method -->
                <div class="space-y-2 text-xs">
                  <label class="block font-bold text-gray-800">2.1 Chọn phương án cứu dữ liệu phù hợp với hiện trạng máy:</label>
                  <div class="space-y-2">
                    <label class="flex items-center gap-2 p-2.5 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer">
                      <input type="radio" value="direct" x-model="step2.backupMethod" />
                      <span><strong>Phương án 1:</strong> Máy vẫn vào được Win -> Copy trực tiếp thư mục nhạy cảm sang ổ D:\\BACKUP_KHACH_HANG</span>
                    </label>
                    <label class="flex items-center gap-2 p-2.5 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer">
                      <input type="radio" value="winpe" x-model="step2.backupMethod" />
                      <span><strong>Phương án 2:</strong> Máy lỗi không vào Win -> Cắm USB Boot cứu hộ WinPE mini để vào cứu dữ liệu</span>
                    </label>
                  </div>
                </div>

                <!-- Action 2.2: Copy rule -->
                <div class="space-y-2 text-xs">
                  <label class="block font-bold text-gray-800">2.2 Khi sao lưu thư mục tài liệu của khách, em dùng lệnh nào?</label>
                  <div class="grid grid-cols-2 gap-3">
                    <button
                      type="button"
                      @click="triggerCutSafetyViolation()"
                      class="p-3 rounded-lg border border-red-300 bg-red-50 text-red-800 font-semibold hover:bg-red-100 text-center"
                    >
                      Dùng lệnh CUT (Cắt rồi dán) ❌
                    </button>
                    <button
                      type="button"
                      @click="step2.isVerifiedMatch = true;"
                      class="p-3 rounded-lg border border-emerald-300 bg-emerald-50 text-emerald-800 font-semibold hover:bg-emerald-100 text-center"
                    >
                      Dùng lệnh COPY (Sao chép rồi dán) ✅
                    </button>
                  </div>
                </div>

                <!-- Action 2.3: Verification comparison -->
                <div class="p-4 bg-gray-50 rounded-xl border border-gray-200 space-y-3 text-xs">
                  <p class="font-bold text-gray-800">2.3 Đối chiếu kiểm tra chéo sau khi sao chép:</p>
                  <div class="grid grid-cols-2 gap-4">
                    <div class="bg-white p-3 rounded border">
                      <span class="text-gray-500 block mb-1">Thư mục gốc:</span>
                      <p class="font-bold text-gray-900" x-text="step2.sourceCount + ' files · ' + step2.sourceMB + ' MB'"></p>
                    </div>
                    <div class="bg-white p-3 rounded border">
                      <span class="text-gray-500 block mb-1">Thư mục đã sao lưu (Ổ D):</span>
                      <p class="font-bold text-emerald-700" x-text="step2.destCount + ' files · ' + step2.destMB + ' MB'"></p>
                    </div>
                  </div>

                  <div class="flex flex-wrap items-center gap-4 pt-2">
                    <label class="flex items-center gap-2 cursor-pointer">
                      <input type="checkbox" x-model="step2.isVerifiedMatch" class="w-4 h-4 rounded text-primary-700 accent-primary-700" />
                      <span>Đã đối chiếu khớp 100% số file và số MB</span>
                    </label>

                    <label class="flex items-center gap-2 cursor-pointer">
                      <input type="checkbox" x-model="step2.samplesOpened" class="w-4 h-4 rounded text-primary-700 accent-primary-700" />
                      <span>Đã mở thử 2 file tài liệu kiểm tra đọc tốt</span>
                    </label>
                  </div>
                </div>

                <!-- Stop Point 1 Signoff -->
                <div class="p-4 rounded-xl border-2 border-red-200 bg-red-50/60 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
                  <div>
                    <p class="font-bold text-red-900">🛑 ĐIỂM DỪNG AN TOÀN 1: BÁO CÁO THẦY GIÁO DUYỆT</p>
                    <p class="text-red-700 text-[11px]">Thầy kiểm tra thấy dữ liệu đã an toàn mới ký duyệt cho phép tháo máy hoặc format.</p>
                  </div>

                  <button
                    type="button"
                    :disabled="!step2.isVerifiedMatch || !step2.samplesOpened"
                    @click="approveStop1()"
                    class="btn-primary text-xs px-4 py-2 font-bold whitespace-nowrap"
                    :class="(!step2.isVerifiedMatch || !step2.samplesOpened) ? 'opacity-50 cursor-not-allowed' : 'bg-red-700 hover:bg-red-800'"
                  >
                    <span x-text="step2.teacherApprovedStop1 ? '✓ Thầy đã ký duyệt Điểm dừng 1' : 'Báo Thầy ký duyệt Điểm dừng 1'"></span>
                  </button>
                </div>

                <div class="pt-3 flex justify-between items-center">
                  <button type="button" @click="currentStep = 1" class="btn-secondary text-xs px-4 py-2">← Bước 1</button>
                  <button
                    type="button"
                    :disabled="!step2.teacherApprovedStop1"
                    @click="step2.completed = true; currentStep = 3;"
                    class="btn-primary text-xs px-5 py-2.5 font-bold"
                    :class="!step2.teacherApprovedStop1 ? 'opacity-50 cursor-not-allowed' : ''"
                  >
                    Hoàn thành Bước 2 → Sang Bước 3 Bắt Bệnh
                  </button>
                </div>
              </div>

              <!-- ============================================== -->
              <!-- STEP 3: BẮT BỆNH 60 GIÂY & CỨU MÁY LÊN HÌNH   -->
              <!-- ============================================== -->
              <div x-show="currentStep === 3" class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm space-y-5">
                <div class="flex items-center justify-between border-b border-gray-200 pb-3">
                  <div>
                    <span class="text-xs font-mono font-bold text-primary-700 uppercase">Bước 3 / 7</span>
                    <h3 class="text-lg font-bold text-gray-900">Bắt Bệnh 60 Giây & Cứu Máy Lên Hình</h3>
                  </div>
                  <span class="text-xs bg-gray-100 text-gray-600 px-2.5 py-1 rounded-full font-mono">15-30 phút</span>
                </div>

                <!-- Survival Rule 1 Check -->
                <div class="p-4 rounded-xl bg-amber-50 border border-amber-300 text-xs text-amber-950 space-y-2">
                  <p class="font-bold text-amber-900">⚠️ BẮT BUỘC THỰC HIỆN LUẬT 1: RÚT — BẤM — KHAY</p>
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-[11px]">
                    <div class="bg-white p-2.5 rounded border border-amber-200">
                      <strong>1. RÚT:</strong> Rút phích điện, gạt công tắc PSU sang O.
                    </div>
                    <div class="bg-white p-2.5 rounded border border-amber-200">
                      <strong>2. BẤM:</strong> Bấm nút Power ngoài thùng 3 lần xả tụ.
                    </div>
                    <div class="bg-white p-2.5 rounded border border-amber-200">
                      <strong>3. KHAY:</strong> Chuẩn bị khay đựng ốc, tháo ốc bỏ vào khay.
                    </div>
                  </div>

                  <label class="flex items-center gap-2 pt-1 font-bold text-amber-900 cursor-pointer">
                    <input type="checkbox" x-model="step3.pullPlugDischargeChecked" class="w-4 h-4 rounded text-amber-700 accent-amber-700" />
                    <span>Em đã thực hiện đủ RÚT ĐIỆN, BẤM XẢ TỤ 3 LẦN và ĐỂ ỐC VÀO KHAY!</span>
                  </label>
                </div>

                <!-- Simulation Action 3.1: Cause identification -->
                <div class="space-y-2 text-xs">
                  <label class="block font-bold text-gray-800">3.1 Khoanh vùng và chẩn đoán nguyên nhân gốc rễ của ca máy này:</label>
                  <div class="space-y-2">
                    <label class="flex items-center gap-2 p-2.5 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer">
                      <input type="radio" value="ram_oxide" x-model="step3.identifiedCause" />
                      <span><strong>Nguyên nhân A:</strong> Chân mạ vàng của thanh RAM bị bụi bẩn, oxy hóa tiếp xúc kém dẫn đến màn hình đen.</span>
                    </label>
                    <label class="flex items-center gap-2 p-2.5 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer">
                      <input type="radio" value="sata_loose" x-model="step3.identifiedCause" />
                      <span><strong>Nguyên nhân B:</strong> Tuột cáp tín hiệu SATA hoặc lỏng dây nguồn ổ cứng dẫn đến báo No Bootable Device.</span>
                    </label>
                    <label class="flex items-center gap-2 p-2.5 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer">
                      <input type="radio" value="cmos_dead" x-model="step3.identifiedCause" />
                      <span><strong>Nguyên nhân C:</strong> Pin CMOS CR2032 cạn kiệt điện tích khiến máy sai ngày giờ và bắt bấm F1.</span>
                    </label>
                    <label class="flex items-center gap-2 p-2.5 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer">
                      <input type="radio" value="paste_dry" x-model="step3.identifiedCause" />
                      <span><strong>Nguyên nhân D:</strong> Keo tản nhiệt CPU khô cứng làm máy quá nhiệt 92°C tự ngắt nguồn.</span>
                    </label>
                  </div>
                </div>

                <!-- Simulation Action 3.2: Technical Treatment -->
                <div class="space-y-2 text-xs">
                  <label class="block font-bold text-gray-800">3.2 Thao tác kỹ thuật xử lý để cứu máy lên hình:</label>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <button
                      type="button"
                      :disabled="!step3.pullPlugDischargeChecked"
                      @click="handleCleanRam()"
                      class="p-3 rounded-lg border border-primary-200 bg-primary-50 text-primary-900 font-semibold hover:bg-primary-100 text-left flex items-start gap-2"
                      :class="!step3.pullPlugDischargeChecked ? 'opacity-50 cursor-not-allowed' : ''"
                    >
                      <span>🧽</span>
                      <div>
                        <strong>Dùng cục tẩy chà sạch chân RAM</strong>
                        <p class="text-[11px] text-gray-600 font-normal">Tháo RAM, lấy gôm học sinh chà sạch oxit chân vàng, quét bụi khe RAM và cắm lại sập tai khóa.</p>
                      </div>
                    </button>

                    <button
                      type="button"
                      :disabled="!step3.pullPlugDischargeChecked"
                      @click="handleReseatSata()"
                      class="p-3 rounded-lg border border-primary-200 bg-primary-50 text-primary-900 font-semibold hover:bg-primary-100 text-left flex items-start gap-2"
                      :class="!step3.pullPlugDischargeChecked ? 'opacity-50 cursor-not-allowed' : ''"
                    >
                      <span>🔌</span>
                      <div>
                        <strong>Cắm chặt lại 2 đầu cáp SATA ổ cứng</strong>
                        <p class="text-[11px] text-gray-600 font-normal">Cắm chắc chắn cáp dữ liệu SATA và dây nguồn SATA, kiểm tra trong BIOS.</p>
                      </div>
                    </button>
                  </div>
                </div>

                <div class="pt-3 flex justify-between items-center">
                  <button type="button" @click="currentStep = 2" class="btn-secondary text-xs px-4 py-2">← Bước 2</button>
                  <button
                    type="button"
                    :disabled="!step3.screenRevived"
                    @click="step3.completed = true; currentStep = 4;"
                    class="btn-primary text-xs px-5 py-2.5 font-bold"
                    :class="!step3.screenRevived ? 'opacity-50 cursor-not-allowed' : ''"
                  >
                    Hoàn thành Bước 3 → Sang Bước 4 Sạch & Lắp Nâng Cấp
                  </button>
                </div>
              </div>

              <!-- ============================================== -->
              <!-- STEP 4: SẠCH & LẮP NÂNG CẤP (STOP 2)           -->
              <!-- ============================================== -->
              <div x-show="currentStep === 4" class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm space-y-5">
                <div class="flex items-center justify-between border-b border-gray-200 pb-3">
                  <div>
                    <span class="text-xs font-mono font-bold text-red-600 uppercase flex items-center gap-1">
                      <span>Bước 4 / 7</span>
                      <span class="bg-red-100 text-red-800 px-2 py-0.2 rounded font-bold">🛑 ĐIỂM DỪNG AN TOÀN SỐ 2</span>
                    </span>
                    <h3 class="text-lg font-bold text-gray-900 mt-0.5">Vệ Sinh Thổi Bụi, Tra Keo Hạt Đậu Xanh & Lắp Nâng Cấp</h3>
                  </div>
                  <span class="text-xs bg-gray-100 text-gray-600 px-2.5 py-1 rounded-full font-mono">30-45 phút</span>
                </div>

                <!-- Simulation Action 4.1: Clean & Paste -->
                <div class="space-y-3 text-xs">
                  <p class="font-bold text-gray-800">4.1 Thao tác vệ sinh và tản nhiệt CPU chuẩn thợ 20 năm:</p>
                  
                  <label class="flex items-start gap-2.5 p-3 rounded-lg border border-gray-200 bg-gray-50 cursor-pointer">
                    <input type="checkbox" x-model="step4.fanHeldWhenBlowing" class="mt-0.5 w-4 h-4 rounded text-primary-700 accent-primary-700" />
                    <div>
                      <strong class="text-gray-900">Giữ đứng cánh quạt khi xịt bụi:</strong>
                      <span class="text-gray-600 block text-[11px]">Dùng ngón tay giữ cố định cánh quạt khi dùng bóng thổi/bình xịt để tránh quạt quay quá tốc độ phát điện ngược làm cháy bo mạch.</span>
                    </div>
                  </label>

                  <label class="flex items-start gap-2.5 p-3 rounded-lg border border-gray-200 bg-gray-50 cursor-pointer">
                    <input type="checkbox" x-model="step4.thermalPasteBeanSize" class="mt-0.5 w-4 h-4 rounded text-primary-700 accent-primary-700" />
                    <div>
                      <strong class="text-gray-900">Tra keo tản nhiệt đúng lượng "HẠT ĐẬU XANH":</strong>
                      <span class="text-gray-600 block text-[11px]">Lau sạch lớp keo cũ khô giòn, bơm đúng 1 giọt nhỏ bằng hạt đậu xanh ở giữa lưng CPU, ấn chốt theo đường chéo đối xứng.</span>
                    </div>
                  </label>

                  <label class="flex items-start gap-2.5 p-3 rounded-lg border border-gray-200 bg-gray-50 cursor-pointer">
                    <input type="checkbox" x-model="step4.cpuFanPlugged" class="mt-0.5 w-4 h-4 rounded text-primary-700 accent-primary-700" />
                    <div>
                      <strong class="text-gray-900">Cắm dây quạt vào đúng chân CPU_FAN:</strong>
                      <span class="text-gray-600 block text-[11px]">Cắm chặt dây nguồn quạt vào chân cắm có chữ CPU_FAN trên bo mạch chủ.</span>
                    </div>
                  </label>
                </div>

                <!-- Simulation Action 4.2: Hardware Upgrade (RAM or SSD) -->
                <div class="space-y-3 text-xs pt-2 border-t border-gray-100">
                  <p class="font-bold text-gray-800">4.2 Lắp linh kiện nâng cấp theo yêu cầu đề bài:</p>
                  
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="p-3 rounded-xl border border-gray-200 bg-white">
