---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HelpdeskWorkflowSection from '../../components/assessment/HelpdeskWorkflowSection.astro';
import ExamTicketSimulator from '../../components/assessment/ExamTicketSimulator.astro';
import {
  HARDWARE_METADATA,
  OFFICIAL_RUBRIC_CRITERIA,
  FIVE_CLASSIC_CASES,
  THREE_SURVIVAL_RULES,
} from '../../data/hardwareCurriculum';
import {
  ORAL_QUESTIONS,
  ASSEMBLY_SCENARIOS,
  WINDOWS_INSTALL_SCENARIOS,
  MCQ_PRACTICAL_BANK,
  FULL_EXAM_TICKETS,
} from '../../data/questionBank';
import {
  DIAGNOSTIC_SCENARIOS,
  DIAGNOSTIC_STEPS,
} from '../../data/diagnosticTree';

export const prerender = true;

const exam = {
  name: 'Ôn luyện Năng lực Nghề: Phần cứng Máy tính (OL-01)',
  icon: '🔧',
};
---

<BaseLayout title={`${exam.name} - Đánh giá năng lực thực tế`}>
  <section class="max-w-6xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { label: 'Trang chủ', href: '/' },
      { label: 'Đánh giá năng lực', href: '/assessment' },
      { label: exam.name, href: '' },
    ]} />

    <div class="mt-6" x-data="hardwareMasterEngine">
        <!-- Poka-Yoke Auto-Recovery Notification Banner -->
        <div
          x-show="showRecoveryBanner"
          x-cloak
          x-transition
          class="bg-amber-50 border-2 border-amber-300 rounded-2xl p-4 sm:p-5 shadow-sm mb-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs"
        >
          <div class="flex items-center gap-3">
            <span class="text-2xl">🛡️</span>
            <div>
              <p class="font-bold text-amber-950 text-sm">Poka-Yoke: Phát hiện dữ liệu bài làm trước đó</p>
              <p class="text-amber-800 mt-0.5">
                Hệ thống tự động lưu trữ phiên làm việc của <strong class="text-gray-900" x-text="savedSessionInfo.name || 'Học sinh'"></strong>
                vào lúc <span class="font-mono font-bold" x-text="savedSessionInfo.time"></span>. Em có muốn khôi phục lại không?
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
            <button
              type="button"
              @click="restoreSavedSession()"
              class="btn-primary text-xs px-4 py-2 bg-amber-700 hover:bg-amber-800 font-bold"
            >
              ✓ Khôi phục bài làm
            </button>
            <button
              type="button"
              @click="discardSavedSession()"
              class="btn-secondary text-xs px-3 py-2"
            >
              Bỏ qua & làm mới
            </button>
          </div>
        </div>

        <!-- Japanese Engineering & Zen Mode Toolbar -->
        <div class="flex flex-wrap items-center justify-between gap-3 bg-slate-900 text-white px-4 sm:px-6 py-2.5 rounded-2xl mb-4 shadow">
          <div class="flex items-center gap-3 text-xs">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-300 font-mono font-bold border border-emerald-500/30">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              POKA-YOKE V2.0
            </span>

            <!-- Auto-save state -->
            <span class="text-slate-300 hidden sm:inline-flex items-center gap-1">
              <span>💾</span>
              <span x-text="lastSavedText ? ('Đã lưu: ' + lastSavedText) : 'Tự động lưu vào máy'"></span>
            </span>
          </div>

          <!-- Right: Timer & Zen Mode Button -->
          <div class="flex items-center gap-3">
            <!-- Workshop Timer -->
            <div class="flex items-center gap-1.5 bg-slate-800 px-3 py-1 rounded-xl border border-slate-700 font-mono text-xs">
              <span class="text-slate-400">⏱️</span>
              <span
                class="font-bold tracking-wider"
                :class="timerSeconds < 180 ? 'text-rose-400 animate-pulse' : (timerSeconds < 600 ? 'text-amber-300' : 'text-emerald-400')"
                x-text="formattedTimer"
              ></span>
            </div>

            <!-- Zen / Focus Mode Toggle -->
            <button
              type="button"
              @click="toggleZenMode()"
              class="px-3 py-1 rounded-xl text-xs font-bold transition-all border flex items-center gap-1.5"
              :class="zenMode ? 'bg-primary-600 text-white border-primary-500' : 'bg-slate-800 text-slate-200 border-slate-700 hover:bg-slate-700'"
              title="Chế độ tập trung Zen Mode: Ẩn bớt giao diện thừa để làm bài"
            >
              <span>🎯</span>
              <span x-text="zenMode ? 'Thoát Zen Mode' : 'Chế độ tập trung (Zen)'"></span>
            </button>
          </div>
        </div>

        <!-- Main Top Header -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm mb-6">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-gray-100 pb-4">
            <div class="flex items-center gap-3.5">
              <span class="text-4xl sm:text-5xl">🛠️</span>
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <span class="text-xs font-mono uppercase tracking-wider text-primary-800 font-bold bg-primary-100 px-2.5 py-0.5 rounded-full">
                    Mã môn: {HARDWARE_METADATA.courseCode}
                  </span>
                  <span class="text-xs text-gray-500 font-mono">
                    Chuẩn Thông tư 55/2026/TT-BGDĐT
                  </span>
                </div>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
                  Hệ Thống Đánh Giá Năng Lực Nghề Phần Cứng Máy Tính
                </h1>
              </div>
            </div>

            <div class="text-left md:text-right text-xs text-gray-600">
              <p class="font-bold text-gray-900">GV Huấn luyện: {HARDWARE_METADATA.teacher}</p>
              <p class="text-gray-500">{HARDWARE_METADATA.institution}</p>
            </div>
          </div>

          <!-- SPECIALIZED 4-TAB SUITE BANNER -->
          <div class="mt-4 p-3 bg-blue-50 border border-blue-200 rounded-xl flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
            <div class="flex items-center gap-2 text-blue-900">
              <span class="text-base">🚀</span>
              <span><strong>Chuyên đề 01 (Mã: OL-01_PHAN_CUNG):</strong> Bàn Kỹ Thuật 5 Bước & H510 Hotspot · Trắc Nghiệm 100 Câu · Bốc Thăm Sát Hạch · In Phiếu Nghiệm Thu A4</span>
            </div>
            <a href="/courses/ol-01-phan-cung" class="shrink-0 px-4 py-2 bg-blue-700 hover:bg-blue-800 text-white font-bold rounded-lg transition-colors flex items-center gap-1.5 min-h-[40px]">
              <span>Mở Chuyên Đề 01</span>
              <span>➔</span>
            </a>
          </div>

          <!-- MASTER 2-ZONE SELECTOR: MÔ HÌNH CBT HELPDESK WORKFLOW -->
          <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- PHÂN KHU 1 -->
            <button
              type="button"
              @click="switchMode('workflow')"
              class="p-4 sm:p-5 rounded-2xl border-2 text-left transition-all relative overflow-hidden flex items-center justify-between min-h-[96px]"
              :class="activeMode === 'workflow'
                ? 'bg-slate-900 text-white border-slate-900 shadow-lg ring-2 ring-primary-500/50'
                : 'bg-white text-slate-800 border-slate-200 hover:border-slate-300 hover:bg-slate-50 shadow-sm'"
            >
              <div class="flex items-start gap-3.5">
                <span class="text-3xl sm:text-4xl p-2 rounded-xl bg-slate-800/20">📘</span>
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded-full"
                      :class="activeMode === 'workflow' ? 'bg-amber-400 text-slate-950' : 'bg-primary-100 text-primary-900'">
                      PHÂN KHU 1: HỌC THEO LUỒNG CÔNG VIỆC
                    </span>
                  </div>
                  <h3 class="text-base sm:text-lg font-black tracking-tight leading-snug">
                    Sổ Tay Nghiệp Vụ KTV (5 Bước)
                  </h3>
                  <p class="text-xs mt-1 leading-relaxed" :class="activeMode === 'workflow' ? 'text-slate-300' : 'text-slate-500'">
                    Khớp 100% 5 tiêu chí Rubric: An toàn (2.0đ) • Chẩn đoán (2.5đ) • Thao tác (3.0đ) • Xác nhận (1.5đ) • Bàn giao (1.0đ)
                  </p>
                </div>
              </div>
              <span class="text-2xl font-bold ml-2 shrink-0" :class="activeMode === 'workflow' ? 'text-amber-400' : 'text-slate-400'">→</span>
            </button>

            <!-- PHÂN KHU 2 -->
            <button
              type="button"
              @click="switchMode('simulator')"
              class="p-4 sm:p-5 rounded-2xl border-2 text-left transition-all relative overflow-hidden flex items-center justify-between min-h-[96px]"
              :class="activeMode === 'simulator'
                ? 'bg-slate-900 text-white border-slate-900 shadow-lg ring-2 ring-amber-500/50'
                : 'bg-white text-slate-800 border-slate-200 hover:border-slate-300 hover:bg-slate-50 shadow-sm'"
            >
              <div class="flex items-start gap-3.5">
                <span class="text-3xl sm:text-4xl p-2 rounded-xl bg-amber-500/20">🎲</span>
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded-full"
                      :class="activeMode === 'simulator' ? 'bg-amber-400 text-slate-950' : 'bg-amber-100 text-amber-900'">
                      PHÂN KHU 2: GIẢ LẬP BÀI THI 4 GIỜ
                    </span>
                  </div>
                  <h3 class="text-base sm:text-lg font-black tracking-tight leading-snug">
                    Máy Bốc Thăm Tình Huống & Form Rubric
                  </h3>
                  <p class="text-xs mt-1 leading-relaxed" :class="activeMode === 'simulator' ? 'text-slate-300' : 'text-slate-500'">
                    Bốc đề thi ngẫu nhiên + Đồng hồ 4 giờ (240:00) + Form Rubric chấm điểm trực tiếp & Xuất phiếu A4
                  </p>
                </div>
              </div>
              <span class="text-2xl font-bold ml-2 shrink-0" :class="activeMode === 'simulator' ? 'text-amber-400' : 'text-slate-400'">→</span>
            </button>
          </div>

          <!-- COMPACT UTILITY BAR FOR SUPPLEMENTARY TOOLS -->
          <div class="mt-4 p-2.5 bg-slate-100 border border-slate-200 rounded-xl flex flex-wrap items-center justify-between gap-2 text-xs">
            <span class="font-bold text-slate-600 px-1.5 flex items-center gap-1.5">
              <span>⚡</span>
              <span>Công Cụ Ôn Luyện Bổ Trợ:</span>
            </span>

            <div class="flex flex-wrap gap-1.5">
              <button
                type="button"
                @click="switchMode('mcq')"
                class="px-3 py-1.5 rounded-lg border font-bold transition-all flex items-center gap-1"
                :class="activeMode === 'mcq' ? 'bg-slate-900 text-white border-slate-900 shadow-sm' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50'"
              >
                <span>🎲</span>
                <span>100 Câu Trắc Nghiệm TT55</span>
              </button>

              <button
                type="button"
                @click="switchMode('library')"
                class="px-3 py-1.5 rounded-lg border font-bold transition-all flex items-center gap-1"
                :class="activeMode === 'library' ? 'bg-slate-900 text-white border-slate-900 shadow-sm' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50'"
              >
                <span>📚</span>
                <span>20 Câu Vấn Đáp</span>
              </button>

              <button
                type="button"
                @click="switchMode('diagnostic')"
                class="px-3 py-1.5 rounded-lg border font-bold transition-all flex items-center gap-1"
                :class="activeMode === 'diagnostic' ? 'bg-slate-900 text-white border-slate-900 shadow-sm' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50'"
              >
                <span>🩺</span>
                <span>Cây Chẩn Đoán 60s</span>
              </button>

              <button
                type="button"
                @click="switchMode('flashcards')"
                class="px-3 py-1.5 rounded-lg border font-bold transition-all flex items-center gap-1"
                :class="activeMode === 'flashcards' ? 'bg-slate-900 text-white border-slate-900 shadow-sm' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50'"
              >
                <span>🗂️</span>
                <span>Thẻ Lật Flashcards</span>
              </button>

              <a
                href="/practice"
                class="px-3 py-1.5 rounded-lg border font-bold bg-blue-50 text-blue-900 border-blue-200 hover:bg-blue-100 flex items-center gap-1 no-underline"
              >
                <span>🛠️</span>
                <span>Bàn Máy 10 Nhóm →</span>
              </a>
            </div>
          </div>
        </div>

        <!-- ============================================================== -->
        <!-- PHÂN KHU 1: SỔ TAY NGHIỆP VỤ (LUỒNG 5 BƯỚC KHỚP RUBRIC 10.0)   -->
        <!-- ============================================================== -->
        <div x-show="activeMode === 'workflow'" class="space-y-6">
          <HelpdeskWorkflowSection />
        </div>

        <!-- ============================================================== -->
        <!-- MODE: CÂY CHẨN ĐOÁN BẮT BỆNH 60 GIÂY                          -->
        <!-- ============================================================== -->
        <div x-show="activeMode === 'diagnostic'" class="space-y-6" x-cloak>
          <!-- Hero Bar -->
          <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
              <div>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900 mb-2">
                  <span>⚡</span>
                  <span>CÂY QUYẾT ĐỊNH KHOANH VÙNG SỰ CỐ 60 GIÂY</span>
                </span>
                <h2 class="text-xl sm:text-2xl font-black text-slate-900">
                  Cây Chẩn Đoán Bắt Bệnh Kỹ Thuật Viên
                </h2>
                <p class="text-xs sm:text-sm text-slate-600 mt-1">
                  Nguyên tắc vàng: Quan sát triệu chứng → Đo đạc / Khoanh vùng → Loại trừ → Xử lý dứt điểm. Không đoán mò!
                </p>
              </div>

              <div class="flex items-center gap-2">
                <button
                  type="button"
                  @click="resetDiagnostic()"
                  class="px-3.5 py-2 rounded-xl text-xs font-bold border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 flex items-center gap-1.5"
                >
                  <span>🔄</span>
                  <span>Bắt đầu lại ca này</span>
                </button>
              </div>
            </div>

            <!-- Scenario Selector 5 Classic Cases -->
            <div class="mt-5 pt-4 border-t border-slate-100">
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2.5">
                Chọn 1 trong 5 Ca Bệnh Kinh Điển (Chiếm 85% Thực Tế Xưởng):
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5">
                <template x-for="sc in diagnosticScenarios" :key="sc.id">
                  <button
                    type="button"
                    @click="selectDiagnosticScenario(sc.id)"
                    class="p-3 rounded-xl border text-left transition-all flex flex-col justify-between"
                    :class="currentScenarioId === sc.id
                      ? 'bg-slate-900 text-white border-slate-900 shadow-md ring-2 ring-slate-900/10'
                      : 'bg-white text-slate-800 border-slate-200 hover:border-slate-300 hover:bg-slate-50'"
                  >
                    <div>
                      <div class="flex items-center justify-between gap-1 mb-1">
                        <span class="text-lg" x-text="sc.icon"></span>
                        <span
                          class="text-[10px] font-mono font-extrabold px-1.5 py-0.5 rounded"
                          :class="currentScenarioId === sc.id ? 'bg-white/20 text-white' : 'bg-slate-100 text-slate-600'"
                          x-text="sc.code"
                        ></span>
                      </div>
                      <h3 class="text-xs font-bold line-clamp-1" x-text="sc.title"></h3>
                      <p
                        class="text-[11px] mt-1 line-clamp-2"
                        :class="currentScenarioId === sc.id ? 'text-slate-300' : 'text-slate-500'"
                        x-text="sc.shortDesc"
                      ></p>
                    </div>
                    <div class="mt-2.5 pt-2 border-t text-[10px] flex items-center justify-between" :class="currentScenarioId === sc.id ? 'border-white/10 text-slate-300' : 'border-slate-100 text-slate-400'">
                      <span>Ước tính:</span>
                      <span class="font-bold" x-text="sc.estimatedTime"></span>
                    </div>
                  </button>
                </template>
              </div>
            </div>
          </div>

          <!-- DIAGNOSTIC INTERACTION CONTAINER -->
          <div class="space-y-4">
            <!-- Active Step Card -->
            <div x-show="!diagnosticCompleted && currentDiagnosticStep" class="bg-white border-2 border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm">
              <!-- Breadcrumb & Back action -->
              <div class="flex items-center justify-between gap-2 mb-4 pb-3 border-b border-slate-100">
                <div class="flex items-center gap-2">
                  <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-blue-50 text-blue-900 border border-blue-200" x-text="currentDiagnosticStep ? currentDiagnosticStep.caseCode : ''"></span>
                  <span class="text-xs text-slate-500 font-semibold" x-text="currentDiagnosticStep ? currentDiagnosticStep.caseName : ''"></span>
                </div>

                <button
                  type="button"
                  x-show="diagnosticHistory.length > 0"
                  @click="backDiagnosticStep()"
                  class="text-xs font-bold text-slate-600 hover:text-slate-900 flex items-center gap-1 px-2.5 py-1 rounded-lg border border-slate-200 hover:bg-slate-50"
                >
                  <span>←</span>
                  <span>Quay lại bước trước</span>
                </button>
              </div>

              <!-- Question & Instruction -->
              <div class="mb-6">
                <h3 class="text-lg sm:text-xl font-black text-slate-900 leading-snug" x-text="currentDiagnosticStep ? currentDiagnosticStep.question : ''"></h3>
                <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed" x-text="currentDiagnosticStep ? currentDiagnosticStep.instruction : ''"></p>
              </div>

              <!-- Visual Hint Box -->
              <div x-show="currentDiagnosticStep && currentDiagnosticStep.visualHint" class="mb-6 p-4 rounded-xl bg-amber-50/80 border border-amber-200 text-amber-950 text-xs flex items-start gap-3">
                <span class="text-xl flex-shrink-0">💡</span>
                <div>
                  <strong class="font-bold block mb-0.5">Dấu hiệu nhận biết nhanh từ giảng viên:</strong>
                  <span class="leading-relaxed" x-text="currentDiagnosticStep ? currentDiagnosticStep.visualHint : ''"></span>
                </div>
              </div>

              <!-- Options Selection (Tactile Buttons >= 48px height) -->
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">
                  Chọn kết quả kiểm tra hoặc bước tiếp theo:
                </label>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <template x-for="(opt, oIdx) in (currentDiagnosticStep ? currentDiagnosticStep.options : [])" :key="oIdx">
                    <button
                      type="button"
                      @click="chooseDiagnosticOption(opt)"
                      class="min-h-[52px] p-4 rounded-xl border-2 border-slate-200 hover:border-slate-900 bg-white hover:bg-slate-50 text-slate-900 font-bold text-xs sm:text-sm transition-all flex items-center justify-between gap-3 text-left group shadow-sm active:scale-[0.99]"
                    >
                      <div class="flex items-center gap-3">
                        <span class="text-xl flex-shrink-0" x-text="opt.icon || (opt.isSolution ? '🎯' : '➡️')"></span>
                        <span x-text="opt.label"></span>
                      </div>
                      <span class="text-slate-400 group-hover:text-slate-900 font-mono text-sm transition-transform group-hover:translate-x-1">→</span>
                    </button>
                  </template>
                </div>
              </div>
            </div>

            <!-- Solved Solution Card -->
            <div x-show="diagnosticCompleted && currentSolution" class="bg-white border-2 border-emerald-500 rounded-2xl p-6 sm:p-8 shadow-md space-y-6">
              <!-- Success Banner -->
              <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-5 border-b border-slate-100">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-900 flex items-center justify-center text-2xl font-bold flex-shrink-0">
                    ✓
                  </div>
                  <div>
                    <span class="text-[11px] font-mono uppercase tracking-wider font-extrabold text-emerald-700 block">
                      ĐÃ KHOANH VÙNG CHÍNH XÁC NGUYÊN NHÂN GỐC RỄ
                    </span>
                    <h3 class="text-xl sm:text-2xl font-black text-slate-900">
                      Kết Quả Chẩn Đoán & Phương Án Xử Lý Tiêu Chuẩn
                    </h3>
                  </div>
                </div>

                <button
                  type="button"
                  @click="backDiagnosticStep()"
                  class="text-xs font-bold text-slate-600 hover:text-slate-900 flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-50"
                >
                  <span>←</span>
                  <span>Xem lại bước trước</span>
                </button>
              </div>

              <!-- Root Cause -->
              <div class="bg-emerald-50/70 border border-emerald-200 rounded-xl p-4 sm:p-5">
                <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-950 mb-1 flex items-center gap-1.5">
                  <span>🎯</span>
                  <span>Nguyên nhân kỹ thuật gốc rễ:</span>
                </h4>
                <p class="text-sm sm:text-base font-bold text-slate-900 leading-relaxed" x-text="currentSolution ? currentSolution.rootCause : ''"></p>
              </div>

              <!-- Standard Action Steps -->
              <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2 flex items-center gap-1.5">
                  <span>🛠️</span>
                  <span>Quy trình thao tác chuẩn của Kỹ thuật viên:</span>
                </h4>
