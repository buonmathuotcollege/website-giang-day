---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import QuickLookupAndNetworkQuiz from '../../components/assessment/QuickLookupAndNetworkQuiz.astro';

export const prerender = true;
---

<BaseLayout
  title="Tra Cứu Lỗi Phần Cứng & Trắc Nghiệm Mạng - Cổng Giảng Dạy CNTT · CN. Phạm Tiến Đông"
  description="Kho dữ liệu tra cứu sự cố phần cứng máy tính phòng lab H510 và ngân hàng trắc nghiệm mạng căn bản, bấm cáp UTP, chia mạng con IPv4 Subnetting."
  hideChatbot={false}
>
  <div class="bg-slate-50 min-h-screen py-6 sm:py-8 border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 mb-4">
      <Breadcrumb items={[
        { label: 'Trang chủ', href: '/' },
        { label: 'Đánh giá năng lực nghề', href: '/assessment' },
        { label: 'Tra cứu lỗi phần cứng & Trắc nghiệm mạng', href: '' },
      ]} />
    </div>

    <!-- MAIN COMPONENT (DUAL-MODULE TABS) -->
    <QuickLookupAndNetworkQuiz />
  </div>
</BaseLayout>
