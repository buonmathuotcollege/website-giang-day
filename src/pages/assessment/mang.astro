---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export const prerender = true;
---

<BaseLayout title="Mạng Căn Bản & LAN/WAN - Đánh giá năng lực thực tế">
  <section class="max-w-4xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { label: 'Trang chủ', href: '/' },
      { label: 'Đánh giá năng lực', href: '/assessment' },
      { label: 'Mạng Căn Bản & LAN/WAN', href: '' },
    ]} />

    <div class="card p-8 sm:p-12 text-center mt-6 bg-white border border-slate-200 rounded-3xl shadow-sm space-y-6">
      <div class="w-16 h-16 rounded-2xl bg-blue-50 text-blue-700 flex items-center justify-center text-3xl mx-auto">
        🌐
      </div>
      <div>
        <span class="text-xs font-mono font-bold text-blue-700 bg-blue-50 px-3 py-1 rounded-full uppercase tracking-wider">
          MÔN HỌC MẠNG MÁY TÍNH
        </span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-3">
          Mạng Căn Bản & Quản Trị LAN / WAN
        </h1>
        <p class="text-slate-600 text-sm max-w-xl mx-auto mt-2 leading-relaxed">
          Kiểm tra năng lực mô hình OSI, thiết bị mạng Tầng 2 - Tầng 3, kỹ thuật chia mạng con IPv4 (Subnetting) và cấu hình dịch vụ mạng DHCP/DNS.
        </p>
      </div>

      <div class="max-w-md mx-auto p-4 rounded-2xl bg-slate-50 border border-slate-200 text-xs text-slate-700 text-left space-y-2">
        <div class="flex justify-between border-b border-slate-200 pb-1.5">
          <span>Chuẩn đánh giá:</span>
          <strong class="text-slate-900 font-mono">Thông tư 55/2026/TT-BGDĐT</strong>
        </div>
        <div class="flex justify-between border-b border-slate-200 pb-1.5">
          <span>Thời gian làm bài:</span>
          <strong class="text-slate-900 font-mono">45 phút</strong>
        </div>
        <div class="flex justify-between pb-0.5">
          <span>Trạng thái:</span>
          <strong class="text-blue-700 font-bold">Đang cập nhật ngân hàng câu hỏi chuẩn hóa</strong>
        </div>
      </div>

      <div class="pt-4 flex flex-wrap items-center justify-center gap-3">
        <a href="/assessment" class="btn-secondary text-xs px-4 py-2.5">
          ← Quay lại danh mục sát hạch
        </a>
        <a href="/assessment/phan-cung" class="btn-primary text-xs px-5 py-2.5 font-bold shadow-md">
          🔧 Vào Sát Hạch Phần Cứng PC (OL-01) →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
