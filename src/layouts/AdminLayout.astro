---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;

const navItems = [
  { label: 'Dashboard', href: '/admin' },
  { label: 'Quản lý lớp', href: '/admin/classes' },
  { label: 'Bảng điểm', href: '/admin/grades' },
  { label: 'Nội dung', href: '/admin/content' },
];

const currentPath = Astro.url.pathname;
---

<BaseLayout title={`${title} - Trang quản trị`}>
  <div class="max-w-7xl mx-auto px-4 py-6">
    <!-- Admin header -->
    <div class="mb-6 pb-4 border-b border-gray-200">
      <h1 class="text-xl font-bold text-gray-900">Trang quản trị Giảng viên</h1>
    </div>

    <div class="lg:flex lg:gap-8" x-data="{ sidebarOpen: false }">
      <!-- Mobile sidebar toggle -->
      <button
        class="lg:hidden flex items-center gap-2 mb-4 px-3 py-2 border border-gray-300 rounded-lg text-sm text-gray-700 hover:bg-gray-50"
        @click="sidebarOpen = !sidebarOpen"
        aria-label="Mở menu quản trị"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
        Menu quản trị
      </button>

      <!-- Sidebar -->
      <aside
        class="lg:w-56 lg:flex-shrink-0 mb-6 lg:mb-0"
        :class="sidebarOpen ? 'block' : 'hidden lg:block'"
      >
        <nav class="border border-gray-200 rounded-lg p-4 bg-white sticky top-6" aria-label="Menu quản trị">
          <ul class="space-y-1">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'sidebar-link',
                    { active: currentPath === item.href || (item.href !== '/admin' && currentPath.startsWith(item.href)) },
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>

      <!-- Main content -->
      <div class="flex-1 min-w-0">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
