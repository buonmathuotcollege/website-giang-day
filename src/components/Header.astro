---
// Header.astro — Top navigation bar
---

<header class="w-full bg-white border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" x-data="{ open: false }">
    <div class="flex items-center justify-between h-14">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 text-primary-700 font-bold text-lg shrink-0">
        <span class="text-xl">🎓</span>
        <span class="hidden sm:inline">Cổng Giảng Dạy CNTT</span>
        <span class="sm:hidden">CNTT</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1">
        <a href="/" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-primary-700 transition-colors">Trang chủ</a>
        <a href="/courses" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-primary-700 transition-colors">Môn học</a>
        <a href="/practice" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-primary-700 transition-colors">Thực hành</a>
        <a href="/assessment" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-primary-700 transition-colors">Đánh giá</a>
      </nav>

      <!-- Login button + hamburger -->
      <div class="flex items-center gap-2">
        <a href="/admin" class="hidden sm:inline-flex btn-primary text-xs">GV Đăng nhập</a>
        <!-- Mobile hamburger -->
        <button
          class="md:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100"
          @click="open = !open"
          aria-label="Menu"
        >
          <svg x-show="!open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg x-show="open" x-cloak class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div x-show="open" x-cloak x-transition class="md:hidden border-t border-gray-100 py-2 pb-3">
      <a href="/" class="block px-3 py-2 rounded-lg text-sm text-gray-700 hover:bg-gray-100">Trang chủ</a>
      <a href="/courses" class="block px-3 py-2 rounded-lg text-sm text-gray-700 hover:bg-gray-100">Môn học</a>
      <a href="/practice" class="block px-3 py-2 rounded-lg text-sm text-gray-700 hover:bg-gray-100">Thực hành</a>
      <a href="/assessment" class="block px-3 py-2 rounded-lg text-sm text-gray-700 hover:bg-gray-100">Đánh giá</a>
      <a href="/admin" class="block px-3 py-2 mt-1 rounded-lg text-sm font-semibold text-primary-700 hover:bg-primary-50">GV Đăng nhập</a>
    </div>
  </div>
</header>

<style>
  [x-cloak] { display: none !important; }
</style>
