---
// LessonQuickSearch.astro — Thanh Tìm Kiếm Nhanh Bài Học & Từ Khóa Kỹ Thuật
// Tối ưu 100% cho màn hình điện thoại di động (Mobile-First, Chữ rõ ràng, Nút bấm to)
import { COURSES } from '../../data/courses';

// Tạo danh mục bài học tìm kiếm toàn hệ thống
interface SearchableLesson {
  id: string;
  courseSlug: string;
  courseName: string;
  courseIcon: string;
  chapterSlug: string;
  title: string;
  description: string;
  url: string;
  category: 'all' | 'phan-cung' | 'mang' | 'windows-linux' | 'nang-luc-so' | 'kien-truc';
}

const ALL_SEARCHABLE_LESSONS: SearchableLesson[] = [];

// 1. Thêm 2 Chuyên đề trọng điểm
ALL_SEARCHABLE_LESSONS.push(
  {
    id: 'chuyen-de-01',
    courseSlug: 'ol-01-phan-cung',
    courseName: 'Chuyên Đề 01',
    courseIcon: '🛠️',
    chapterSlug: 'ol-01',
    title: 'Đánh Giá Năng Lực Phần Cứng Máy Tính (Chuẩn TT55 Phụ Lục II)',
    description: 'Bàn kỹ thuật 7 bước Poka-Yoke, 100 câu trắc nghiệm tình huống, 20 câu vấn đáp và in phiếu nghiệm thu chuẩn A4.',
    url: '/courses/ol-01-phan-cung',
    category: 'phan-cung',
  },
  {
    id: 'chuyen-de-02',
    courseSlug: 'hsg-phan-cung-mang',
    courseName: 'Chuyên Đề 02',
    courseIcon: '🏆',
    chapterSlug: 'hsg-02',
    title: 'Thi Học Sinh Giỏi Phần Cứng & Mạng (Đội Tuyển 04THA3 Ea H\'leo)',
    description: 'Bí quyết tính nhẩm Subnetting IPv4 & VLSM trong 30 giây, phân tích bo mạch H510 & CPU, sa bàn 5 chặng thi công và Rubric 100đ.',
    url: '/courses/hsg-phan-cung-mang',
    category: 'mang',
  },
  {
    id: 'tra-cuu-mang',
    courseSlug: 'assessment-mang',
    courseName: 'Phân Hệ Sát Hạch',
    courseIcon: '⚡',
    chapterSlug: 'tra-cuu-mang',
    title: 'Tra Cứu Nhanh Lỗi Phần Cứng & Ngân Hàng 25 Câu Trắc Nghiệm Mạng',
    description: 'Bắt bệnh 60 giây bo mạch H510/RAM DDR4/VGA GT 730 và trắc nghiệm thực chiến bấm cáp, IP Subnetting, mô hình OSI/TCP-IP.',
    url: '/assessment/mang',
    category: 'mang',
  }
);

// 2. Thêm toàn bộ các chương bài học của 6 môn học cốt lõi
COURSES.forEach((course) => {
  let cat: SearchableLesson['category'] = 'all';
  if (course.slug === 'phan-cung-may-tinh') cat = 'phan-cung';
  else if (course.slug === 'mang-can-ban' || course.slug === 'thiet-ke-quan-tri-lan-wan') cat = 'mang';
  else if (course.slug === 'quan-tri-windows-linux') cat = 'windows-linux';
  else if (course.slug === 'nang-luc-so') cat = 'nang-luc-so';
  else if (course.slug === 'kien-truc-may-tinh') cat = 'kien-truc';

  course.chapters.forEach((ch) => {
    ALL_SEARCHABLE_LESSONS.push({
      id: `${course.slug}-${ch.slug}`,
      courseSlug: course.slug,
      courseName: course.name,
      courseIcon: course.icon,
      chapterSlug: ch.slug,
      title: ch.title,
      description: ch.description,
      url: `/courses/${course.slug}/${ch.slug}`,
      category: cat,
    });
  });
});

const payloadJson = JSON.stringify(ALL_SEARCHABLE_LESSONS);

const POPULAR_KEYWORDS = [
  'Bấm cáp TIA-568B',
  'Subnetting CIDR',
  'RAM màn hình đen',
  'Cài Windows 10',
  'Công thức Excel',
  'Lệnh ping / ipconfig',
  'Mainboard H510',
  'VLAN Switch',
];
---

<!-- JSON PAYLOAD -->
<script id="lesson-search-payload" type="application/json" set:html={payloadJson}></script>

<!-- ALPINE SEARCH ENGINE -->
<script is:inline>
  function lessonSearchEngine() {
    var raw = [];
    try {
      var el = document.getElementById('lesson-search-payload');
      if (el && el.textContent) {
        raw = JSON.parse(el.textContent);
      }
    } catch(e) {}

    function stripAccents(str) {
      if (!str) return '';
      return str
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/đ/g, 'd')
        .replace(/Đ/g, 'D')
        .toLowerCase();
    }

    return {
      lessons: raw,
      query: '',
      selectedCategory: 'all',
      maxDisplay: 12,

      categories: [
        { id: 'all', label: 'Tất Cả Bài Học' },
        { id: 'phan-cung', label: 'Phần Cứng Máy Tính' },
        { id: 'mang', label: 'Mạng & LAN/WAN' },
        { id: 'windows-linux', label: 'Windows & Linux' },
        { id: 'nang-luc-so', label: 'Năng Lực Số & Excel' },
        { id: 'kien-truc', label: 'Kiến Trúc Máy Tính' },
      ],

      setKeyword: function(kw) {
        this.query = kw;
      },

      clearQuery: function() {
        this.query = '';
      },

      get filteredLessons() {
        var self = this;
        var q = stripAccents(self.query.trim());
        var cat = self.selectedCategory;

        return self.lessons.filter(function(item) {
          if (cat !== 'all' && item.category !== cat) {
            return false;
          }
          if (!q) return true;

          var corpus = stripAccents(
            item.title + ' ' +
            item.description + ' ' +
            item.courseName
          );
          return corpus.indexOf(q) !== -1;
        });
      },

      get displayedLessons() {
        return this.filteredLessons.slice(0, this.maxDisplay);
      }
    };
  }
  window.lessonSearchEngine = lessonSearchEngine;
</script>

<div
  x-data="lessonSearchEngine()"
  class="w-full bg-white rounded-3xl border border-slate-200 p-5 sm:p-7 shadow-sm space-y-4 text-slate-900"
  id="lesson-quick-search-box"
>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-3">
    <div>
      <div class="flex items-center gap-1.5 mb-1">
        <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase bg-blue-600 text-white font-mono">
          TRA CỨU BÀI GIẢNG
        </span>
        <span class="text-xs font-bold text-slate-500">
          Toàn Bộ 48+ Bài Học & Chuyên Đề
        </span>
      </div>
      <h2 class="text-base sm:text-xl font-black text-slate-900 tracking-tight">
        Tìm Kiếm Nhanh Từ Khóa Bài Học
      </h2>
    </div>

    <span class="text-xs font-semibold text-slate-500 hidden sm:inline-block">
      Tìm kiếm tức thì không cần dấu
    </span>
  </div>

  <!-- Thanh Input Tìm Kiếm To Bấm Êm (Touch Friendly) -->
  <div class="relative">
    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-base">
      🔍
    </span>
    <input
      type="text"
      id="lesson-search-input"
      x-model="query"
      placeholder="Gõ từ khóa bài học: 'bấm cáp', 'subnetting', 'cài win', 'ram', 'excel', 'ipconfig'..."
      class="w-full pl-10 pr-20 py-3 rounded-2xl border border-slate-200 bg-slate-50 text-slate-900 text-xs sm:text-sm font-semibold focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-slate-900 focus:border-slate-900 transition-all min-h-[48px]"
    />
    <button
      type="button"
      id="btn-clear-lesson-search"
      x-show="query.length > 0"
      @click="clearQuery()"
      aria-label="Xóa nội dung tìm kiếm"
      class="absolute inset-y-0 right-0 pr-3.5 pl-2 flex items-center justify-center text-xs font-bold text-slate-500 hover:text-slate-900 cursor-pointer min-h-[48px] min-w-[44px] touch-manipulation"
    >
      ✕ Xóa
    </button>
  </div>

  <!-- Từ Khóa Gợi Ý Nhanh 1-Chạm (Popular Search Pills) -->
  <div class="space-y-1.5">
    <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block">
      Từ khóa hay tra cứu:
    </span>
    <div class="flex flex-wrap items-center gap-1.5">
      {POPULAR_KEYWORDS.map((kw) => (
        <button
          type="button"
          @click={`setKeyword('${kw}')`}
          class="px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold transition-colors cursor-pointer border border-slate-200/80 active:scale-95 min-h-[36px] flex items-center touch-manipulation"
        >
          {kw}
        </button>
      ))}
    </div>
  </div>

  <!-- Bộ Lọc Phân Nhóm Môn Học (Horizontal Scrolling Pills) -->
  <div class="flex items-center gap-1.5 overflow-x-auto pb-1 pt-1 scrollbar-none" id="lesson-category-filter-pills">
    <template x-for="cat in categories" :key="cat.id">
      <button
        type="button"
        @click="selectedCategory = cat.id"
        class="px-3.5 py-2 rounded-xl text-xs font-bold shrink-0 transition-all cursor-pointer min-h-[44px] border touch-manipulation flex items-center justify-center"
        :class="selectedCategory === cat.id ? 'bg-slate-900 text-white border-slate-900 font-black shadow-sm' : 'bg-slate-50 hover:bg-slate-100 text-slate-700 border-slate-200'"
        x-text="cat.label"
      ></button>
    </template>
  </div>

  <!-- Báo Cáo Kết Quả -->
  <div class="flex items-center justify-between text-xs text-slate-500 pt-1 border-t border-slate-100">
    <span>
      Tìm thấy: <strong class="text-slate-900 font-bold" x-text="filteredLessons.length"></strong> bài học phù hợp
    </span>
    <template x-if="filteredLessons.length > maxDisplay">
      <span class="text-[11px] text-slate-400">
        Hiển thị <span x-text="maxDisplay"></span> kết quả hàng đầu
      </span>
    </template>
  </div>

  <!-- Danh Sách Kết Quả Bài Học (Cards) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3" id="lesson-search-results">
    <template x-for="item in displayedLessons" :key="item.id">
      <a
        :href="item.url"
        class="p-4 rounded-2xl border border-slate-200 hover:border-slate-400 bg-white hover:bg-slate-50/80 transition-all flex items-start gap-3 text-left no-underline group shadow-sm min-h-[80px]"
      >
        <span class="w-10 h-10 rounded-xl bg-slate-100 group-hover:scale-105 transition-transform flex items-center justify-center text-xl shrink-0 mt-0.5" x-text="item.courseIcon"></span>
        <div class="flex-1 min-w-0 space-y-1">
          <div class="flex items-center gap-2">
            <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-slate-100 text-slate-700 font-mono truncate" x-text="item.courseName"></span>
          </div>
          <h3 class="text-xs sm:text-sm font-black text-slate-900 group-hover:text-blue-700 transition-colors line-clamp-2 leading-snug" x-text="item.title"></h3>
          <p class="text-[11px] sm:text-xs text-slate-500 line-clamp-2 leading-relaxed" x-text="item.description"></p>
        </div>
        <span class="text-slate-400 group-hover:text-slate-900 transition-colors font-bold text-sm shrink-0 self-center pl-1">
          →
        </span>
      </a>
    </template>
  </div>

  <!-- Trường Hợp Không Tìm Thấy Kết Quả -->
  <div
    x-show="filteredLessons.length === 0"
    x-cloak
    class="p-6 text-center rounded-2xl bg-slate-50 border border-slate-200 text-slate-500 space-y-1"
  >
    <div class="text-2xl">📚</div>
    <div class="font-bold text-slate-800 text-xs sm:text-sm">Không tìm thấy bài học nào khớp với từ khóa</div>
    <p class="text-[11px] text-slate-400">Hãy thử từ khóa ngắn gọn hơn như "ram", "ip", "cáp", "excel"...</p>
    <button
      type="button"
      @click="clearQuery(); selectedCategory = 'all';"
      class="mt-2 px-3.5 py-1.5 rounded-xl bg-slate-900 text-white text-xs font-bold cursor-pointer"
    >
      Xem tất cả bài học
    </button>
  </div>
</div>
