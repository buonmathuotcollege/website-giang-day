---
import {
  HARDWARE_METADATA,
  HELPDESK_5_STEPS,
  PRACTICAL_EXAM_TICKETS,
  THREE_SURVIVAL_RULES,
  FIVE_CLASSIC_CASES,
} from '../../data/hardwareCurriculum';
import {
  LAB_MOTHERBOARDS,
  H510_HOTSPOTS,
} from '../../data/hardwareTrainingPackage';
import {
  MCQ_PRACTICAL_BANK,
  ORAL_QUESTIONS,
} from '../../data/questionBank';

// Enrich hotspots to include Front Panel 9-pin
const ENRICHED_HOTSPOTS = [
  ...H510_HOTSPOTS,
  {
    id: "fpanel-header",
    stepId: "step-3",
    title: "6. Cụm Chân Front Panel (9-Pin F_PANEL)",
    badge: "POWER SW · Sát Chân Khuyết",
    top: "88%",
    left: "86%",
    color: "bg-purple-600",
    description: "Cụm 9 chân kim kết nối nút Power, Reset, đèn HDD LED và đèn Power LED của vỏ case.",
    pokaYoke: "Khẩu quyết F_PANEL: Chân POWER SW nằm ở hàng trên ngay sát cạnh chân trống bị khuyết; nút nguồn & reset không phân cực âm dương.",
    componentImg: "/images/ol-01/fpanel-header.jpg"
  }
];

// Map 100 MCQs into 4 core topics requested
const MCQ_TOPIC_MAPPING = MCQ_PRACTICAL_BANK.map((item, idx) => {
  let topicKey: 'power_ram' | 'bios_uefi' | 'disk_os' | 'safety_esd' = 'safety_esd';
  if (item.category === 'an-toan') {
    topicKey = 'safety_esd';
  } else if (item.category === 'bat-benh') {
    topicKey = 'power_ram';
  } else if (item.category === 'cai-win') {
    // Separate BIOS/UEFI vs Disk Partition
    if (item.question.toLowerCase().includes('bios') || item.question.toLowerCase().includes('uefi') || item.question.toLowerCase().includes('boot') || item.question.toLowerCase().includes('f11') || item.question.toLowerCase().includes('f8') || item.question.toLowerCase().includes('cmos')) {
      topicKey = 'bios_uefi';
    } else {
      topicKey = 'disk_os';
    }
  } else if (item.category === 'lap-rap') {
    topicKey = 'power_ram';
  } else {
    topicKey = 'disk_os';
  }
  return {
    ...item,
    topicKey,
    index: idx + 1
  };
});

// JSON data payload for Alpine.js
const appDataPayload = {
  steps: HELPDESK_5_STEPS,
  tickets: PRACTICAL_EXAM_TICKETS,
  rules: THREE_SURVIVAL_RULES,
  hotspots: ENRICHED_HOTSPOTS,
  boards: LAB_MOTHERBOARDS,
  mcqs: MCQ_TOPIC_MAPPING,
  oralQuestions: ORAL_QUESTIONS,
};
---

<!-- Pass backend data payload safely to Alpine.js BEFORE component renders -->
<script type="application/json" id="ol01-data-payload" set:html={JSON.stringify(appDataPayload)}></script>

<script is:inline>
  function ol01CourseEngine() {
    var rawPayload = {};
    try {
      var el = document.getElementById('ol01-data-payload');
      if (el && el.textContent) {
        rawPayload = JSON.parse(el.textContent);
      }
    } catch (e) {
      console.error('Payload parse error:', e);
    }
    var firstHotspot = (rawPayload.hotspots && rawPayload.hotspots.length > 0) ? rawPayload.hotspots[0] : null;
    var firstTicket = (rawPayload.tickets && rawPayload.tickets.length > 0) ? rawPayload.tickets[0] : {};

    return {
      activeTab: 'tab-1',
      quizViewMode: 'mcq',
      selectedBoard: 'msi',
      openAccordion: 1,
      activeHotspot: firstHotspot ? firstHotspot.id : 'socket-cpu',
      activeHotspotData: firstHotspot,
      hotspots: rawPayload.hotspots || [],

      // Safety step checkboxes
      safetyChecked: {
        step1: false,
        step2: false,
        step3: false,
        step4: false,
        step5: false,
      },

      // MCQ State
      mcqFilter: 'all',
      userAnswers: {},
      allMCQs: rawPayload.mcqs || [],

      // Oral State
      openOralCard: null,
      oralQuestionsList: rawPayload.oralQuestions || [],

      // Sát hạch State (Tab 3)
      ticketsList: rawPayload.tickets || [],
      currentTicket: firstTicket,
      candidateClass: '04THA2',
      candidateStation: 'Máy 01',
      candidateName: '',

      // Rubric Scores
      rubricScores: {
        safety: 2.0,
        diagnosis: 2.5,
        operation: 3.0,
        verification: 1.5,
        handover: 1.0,
      },
      rubricSafetyDisqualified: false,

      // Timer
      timerSeconds: 14400, // 4 hours
      timerRunning: false,
      timerInterval: null,

      init: function() {
        if (this.hotspots && this.hotspots.length > 0) {
          this.activeHotspot = this.hotspots[0].id;
          this.activeHotspotData = this.hotspots[0];
        }
        if (this.ticketsList && this.ticketsList.length > 0) {
          this.currentTicket = this.ticketsList[0];
        }
        this.loadFromStorage();
      },

      toggleAccordion: function(step) {
        this.openAccordion = this.openAccordion === step ? null : step;
      },

      selectHotspot: function(spotId) {
        this.activeHotspot = spotId;
        var found = this.hotspots.find(function(h) { return h.id === spotId; });
        if (found) {
          this.activeHotspotData = found;
        }
      },

      get completedSafetyStepsCount() {
        return Object.values(this.safetyChecked).filter(Boolean).length;
      },

      // MCQ Helpers
      get filteredMCQs() {
        if (this.mcqFilter === 'all') return this.allMCQs;
        var f = this.mcqFilter;
        return this.allMCQs.filter(function(q) { return q.topicKey === f; });
      },

      get mcqCorrectCount() {
        var count = 0;
        for (var i = 0; i < this.allMCQs.length; i++) {
          var q = this.allMCQs[i];
          if (this.userAnswers[q.id] === q.correctIndex) {
            count++;
          }
        }
        return count;
      },

      getCategoryLabel: function(cat) {
        var map = {
          'an-toan': 'An Toàn Kỹ Thuật',
          'lap-rap': 'Lắp Ráp Cơ Khí',
          'bat-benh': 'Chẩn Đoán Sự Cố',
          'cai-win': 'Cài Đặt Windows 10',
          'ngoai-vi': 'Thiết Bị Ngoại Vi'
        };
        return map[cat] || cat;
      },

      selectOption: function(questionId, optionIndex, correctIndex) {
        this.userAnswers[questionId] = optionIndex;
        this.saveToStorage();
      },

      getOptionClass: function(questionId, optIdx, correctIndex) {
        var answered = this.userAnswers[questionId];
        if (answered === undefined) {
          return 'border-slate-200 bg-white hover:bg-slate-50 text-slate-800';
        }
        if (optIdx === correctIndex) {
          return 'border-emerald-500 bg-emerald-50 text-emerald-950 font-bold';
        }
        if (answered === optIdx && optIdx !== correctIndex) {
          return 'border-rose-500 bg-rose-50 text-rose-950 font-bold';
        }
        return 'border-slate-200 bg-slate-50 text-slate-400 opacity-60';
      },

      getOptionBadgeClass: function(questionId, optIdx, correctIndex) {
        var answered = this.userAnswers[questionId];
        if (answered === undefined) {
          return 'bg-slate-100 text-slate-700 border-slate-300';
        }
        if (optIdx === correctIndex) {
          return 'bg-emerald-600 text-white border-emerald-600';
        }
        if (answered === optIdx && optIdx !== correctIndex) {
          return 'bg-rose-600 text-white border-rose-600';
        }
        return 'bg-slate-100 text-slate-400 border-slate-200';
      },

      toggleOralCard: function(cardId) {
        this.openOralCard = this.openOralCard === cardId ? null : cardId;
      },

      // Exam Ticket Randomizer
      drawRandomTicket: function() {
        if (!this.ticketsList || this.ticketsList.length === 0) return;
        var randIdx = Math.floor(Math.random() * this.ticketsList.length);
        this.currentTicket = this.ticketsList[randIdx];
        this.saveToStorage();
      },

      // Rubric Computations
      get rubricTotalScore() {
        if (this.rubricSafetyDisqualified) {
          return 0;
        }
        var sum = (
          (this.rubricScores.safety || 0) +
          (this.rubricScores.diagnosis || 0) +
          (this.rubricScores.operation || 0) +
          (this.rubricScores.verification || 0) +
          (this.rubricScores.handover || 0)
        );
        return Math.min(10.0, Math.max(0, sum));
      },

      // Printable Certificate Meta
      get certificateCode() {
        var stationClean = (this.candidateStation || 'M01').replace('Máy ', 'M');
        var classClean = this.candidateClass || '04THA2';
        return 'PKTV-2026-' + stationClean + '-' + classClean;
      },

      get certificateDate() {
        var now = new Date();
        var day = String(now.getDate()).padStart(2, '0');
        var month = String(now.getMonth() + 1).padStart(2, '0');
        var year = now.getFullYear();
        return 'Ngày ' + day + ' tháng ' + month + ' năm ' + year;
      },

      // Timer
      toggleTimer: function() {
        var self = this;
        if (this.timerRunning) {
          clearInterval(this.timerInterval);
          this.timerRunning = false;
        } else {
          this.timerRunning = true;
          this.timerInterval = setInterval(function() {
            if (self.timerSeconds > 0) {
              self.timerSeconds--;
            } else {
              clearInterval(self.timerInterval);
              self.timerRunning = false;
              alert('Hết giờ làm bài sát hạch!');
            }
          }, 1000);
        }
      },

      resetTimer: function(seconds) {
        if (this.timerInterval) clearInterval(this.timerInterval);
        this.timerRunning = false;
        this.timerSeconds = seconds;
      },

      get formattedTimer() {
        var h = Math.floor(this.timerSeconds / 3600);
        var m = Math.floor((this.timerSeconds % 3600) / 60);
        var s = this.timerSeconds % 60;
        return h + 'h ' + String(m).padStart(2, '0') + 'm ' + String(s).padStart(2, '0') + 's';
      },

      // Dual-Layer Storage
      saveAssessmentResult: function() {
        this.saveToStorage();
        alert('Đã lưu kết quả sát hạch thành công!');
      },

      saveToStorage: function() {
        try {
          var data = {
            candidateName: this.candidateName,
            candidateClass: this.candidateClass,
            candidateStation: this.candidateStation,
            ticketId: this.currentTicket ? this.currentTicket.id : null,
            safetyChecked: this.safetyChecked,
            userAnswers: this.userAnswers,
            rubricScores: this.rubricScores,
            rubricSafetyDisqualified: this.rubricSafetyDisqualified,
            timestamp: new Date().toISOString()
          };
          localStorage.setItem('ol01_assessment_session', JSON.stringify(data));
        } catch (e) {
          console.error('Storage save error:', e);
        }
      },

      loadFromStorage: function() {
        try {
          var raw = localStorage.getItem('ol01_assessment_session');
          if (raw) {
            var data = JSON.parse(raw);
            if (data.candidateName) this.candidateName = data.candidateName;
            if (data.candidateClass) this.candidateClass = data.candidateClass;
            if (data.candidateStation) this.candidateStation = data.candidateStation;
            if (data.safetyChecked) this.safetyChecked = data.safetyChecked;
            if (data.userAnswers) this.userAnswers = data.userAnswers;
            if (data.rubricScores) this.rubricScores = data.rubricScores;
            if (data.rubricSafetyDisqualified !== undefined) this.rubricSafetyDisqualified = data.rubricSafetyDisqualified;
            if (data.ticketId && this.ticketsList) {
              var found = this.ticketsList.find(function(t) { return t.id === data.ticketId; });
              if (found) this.currentTicket = found;
            }
          }
        } catch (e) {
          console.error('Storage load error:', e);
        }
      }
    };
  }

  // Register globally for Alpine
  window.ol01CourseEngine = ol01CourseEngine;

  // Also register with Alpine.data
  if (window.Alpine) {
    window.Alpine.data('ol01CourseEngine', ol01CourseEngine);
  } else {
    document.addEventListener('alpine:init', function() {
      window.Alpine.data('ol01CourseEngine', ol01CourseEngine);
    });
  }
</script>

