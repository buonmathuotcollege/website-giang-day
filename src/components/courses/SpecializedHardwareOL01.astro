        <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm">
          <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div>
              <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                <span>📋</span> Sổ Tay Nghiệp Vụ Kỹ Thuật Viên 5 Bước
              </h2>
              <p class="text-xs text-slate-500 mt-0.5">Khớp 100% với 5 tiêu chuẩn đầu ra Thông tư 55/2026/TT-BGDĐT</p>
            </div>
            <span class="text-xs font-mono font-bold bg-slate-100 text-slate-700 px-2.5 py-1 rounded-lg">
              KTV Standard
            </span>
          </div>

          <!-- Accordion List -->
          <div class="mt-4 space-y-3">
            
            <!-- BƯỚC 1 -->
            <div class="border rounded-2xl transition-all duration-200 overflow-hidden"
              :class="safetyChecked.step1 ? 'border-emerald-300 bg-emerald-50/20' : 'border-slate-200 bg-white'">
              <button
                type="button"
                @click="toggleAccordion(1)"
                class="w-full flex items-center justify-between p-4 text-left font-semibold text-slate-900 min-h-[48px] hover:bg-slate-50 transition-colors"
              >
                <div class="flex items-center gap-3">
                  <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold"
                    :class="safetyChecked.step1 ? 'bg-emerald-600 text-white' : 'bg-slate-900 text-white'">
                    <span x-show="!safetyChecked.step1">1</span>
                    <span x-show="safetyChecked.step1">✓</span>
                  </span>
                  <div>
                    <div class="text-xs font-mono font-bold text-slate-500">TIÊU CHÍ 1 (2.0 ĐIỂM)</div>
                    <div class="text-sm font-bold text-slate-900">Bước 1: Tiếp Nhận & An Toàn Tĩnh Điện ESD</div>
                  </div>
                </div>
                <svg class="w-5 h-5 text-slate-400 transform transition-transform duration-200" :class="openAccordion === 1 ? 'rotate-180' : ''" fill="none" viewBox="0 0 24 24" stroke="currentColor">
