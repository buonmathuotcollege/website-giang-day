  <!-- ==================================================================== -->
  <div x-show="activeTab === 'tab-1'" x-cloak class="space-y-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- CỘT TRÁI (50% / 6 cols): Shadcn Accordion 5 Bước nghiệp vụ -->
