          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            100% Thao tác thực tế trên Windows 10
          </span>
        </div>
      </div>

      <!-- Quick Action / Status Badge -->
      <div class="shrink-0 flex flex-col sm:flex-row lg:flex-col gap-3">
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-center">
          <div class="text-xs text-slate-500 font-medium">Tiến độ quy trình an toàn</div>
          <div class="text-2xl font-black text-slate-900 mt-0.5">
