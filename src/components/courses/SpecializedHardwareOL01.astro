          </div>
        </div>
      </div>
    </div>

    <!-- Navigation Tabs (Shadcn Tabs Style) -->
    <div class="mt-8 border-t border-slate-200 pt-6">
      <div class="flex flex-wrap gap-2 p-1.5 bg-slate-100/90 rounded-2xl border border-slate-200" role="tablist">
