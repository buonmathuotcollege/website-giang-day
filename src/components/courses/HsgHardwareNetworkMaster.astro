---
import {
  HSG_QUESTION_BANK,
  SUBNET_CHEAT_SHEET,
  SUBNET_PRACTICE_PROBLEMS,
  HSG_PROJECT_TEAMS,
  HSG_PROJECT_STAGES,
  HSG_RUBRIC_CRITERIA,
  HSG_PRACTICAL_STATIONS,
  HSG_PRACTICAL_EXAMS,
} from '../../data/hsgCurriculum';

// Group MCQs count for badges
const countArch = HSG_QUESTION_BANK.filter(q => q.group === 'kien-truc-phan-cung').length;
const countOsi = HSG_QUESTION_BANK.filter(q => q.group === 'osi-tcpip').length;
const countSec = HSG_QUESTION_BANK.filter(q => q.group === 'routing-switching-security').length;

// Payload for Alpine.js
const hsgPayload = {
  teams: HSG_PROJECT_TEAMS,
  stages: HSG_PROJECT_STAGES,
  rubric: HSG_RUBRIC_CRITERIA,
  questions: HSG_QUESTION_BANK,
  cheatSheet: SUBNET_CHEAT_SHEET,
  subnetProblems: SUBNET_PRACTICE_PROBLEMS,
  practicalStations: HSG_PRACTICAL_STATIONS,
  practicalExams: HSG_PRACTICAL_EXAMS,
};
---

<!-- JSON Data Payload -->
<script type="application/json" id="hsg-data-payload" set:html={JSON.stringify(hsgPayload)}></script>

<!-- Alpine Engine Setup Ahead of DOM -->
<script is:inline>
  function hsgMasterEngine() {
    var rawPayload = {};
    try {
      var el = document.getElementById('hsg-data-payload');
      if (el && el.textContent) {
        rawPayload = JSON.parse(el.textContent);
      }
    } catch (e) {
      console.error('HSG Payload parse error:', e);
    }

    var problems = rawPayload.subnetProblems || [];
    var initialProblem = problems.length > 0 ? problems[0] : {
      id: 'sp_default',
      department: 'Phòng Kế Toán',
      teamTarget: '04THA3 - Đội 1 (Ea H\'leo)',
      ipInput: '192.168.10.55/26',
      requiredHosts: 58,
      cidr: '/26',
      correctMask: '255.255.255.192',
      correctNetwork: '192.168.10.0',
      correctFirstHost: '192.168.10.1',
      correctLastHost: '192.168.10.62',
      correctBroadcast: '192.168.10.63',
      magicNumber: 64,
      explanationFormula: 'Prefix /26 có bước nhảy = 256 - 192 = 64. Dải [0 - 63].'
    };

    return {
      activeTab: 'hands-on', // 'hands-on' | 'subnetting' | 'mcq'
      practicalSubTab: 'stations', // 'stations' | 'exams' | 'rubric'

      // =======================================================================
      // MODULE 1: THỰC HÀNH TAY NGHỀ THỰC CHIẾN (4 TRẠM + 4 ĐỀ THI + RUBRIC)
      // =======================================================================
      practicalStations: rawPayload.practicalStations || [],
      practicalExams: rawPayload.practicalExams || [],
      currentStationIdx: 0,
      currentExamIdx: 0,
      examChecklistState: {},
      examDurationMinutes: 90,
      examTimerSeconds: 90 * 60,
      examTimerRunning: false,
      examTimerInterval: null,
      showExamSolution: false,

      get currentStation() {
        var self = this;
        return self.practicalStations[self.currentStationIdx] || self.practicalStations[0] || {};
      },

      get currentExam() {
        var self = this;
        return self.practicalExams[self.currentExamIdx] || self.practicalExams[0] || {};
      },

      startExamTimer() {
        if (this.examTimerInterval) clearInterval(this.examTimerInterval);
        this.examTimerRunning = true;
        var self = this;
        this.examTimerInterval = setInterval(function() {
          if (self.examTimerSeconds > 0) {
            self.examTimerSeconds--;
          } else {
            self.pauseExamTimer();
            alert('Hết giờ làm bài thi thực hành! Mời KTV dừng tay để Ban Giám khảo chấm điểm.');
          }
        }, 1000);
      },

      pauseExamTimer() {
        if (this.examTimerInterval) {
          clearInterval(this.examTimerInterval);
          this.examTimerInterval = null;
        }
        this.examTimerRunning = false;
      },

      resetExamTimer(mins) {
        this.pauseExamTimer();
        this.examDurationMinutes = mins || 90;
        this.examTimerSeconds = this.examDurationMinutes * 60;
      },

      formatExamTime() {
        var hrs = Math.floor(this.examTimerSeconds / 3600);
        var mins = Math.floor((this.examTimerSeconds % 3600) / 60);
        var secs = this.examTimerSeconds % 60;
        var pad = function(n) { return n < 10 ? '0' + n : n; };
        return pad(hrs) + ':' + pad(mins) + ':' + pad(secs);
      },

      toggleExamTask(taskId) {
        this.examChecklistState[taskId] = !this.examChecklistState[taskId];
      },

      get examScoreCalculated() {
        var self = this;
        var exam = self.currentExam;
        if (!exam || !exam.taskChecklist) return 0;
        var total = 0;
        exam.taskChecklist.forEach(function(t) {
          if (self.examChecklistState[t.id]) {
            total += t.points;
          }
        });
        return total;
      },

      // =======================================================================
      // MODULE 2: SUBNETTING REFLEX 30s
      // =======================================================================
      problemsList: problems,
      problemIndex: 0,
      currentProblem: initialProblem,
      
      // User inputs
      inputMask: '',
      inputNetwork: '',
      inputFirstHost: '',
      inputLastHost: '',
      inputBroadcast: '',
      
      // State
      timerSeconds: 30,
      timerRunning: false,
      timerInterval: null,
      isSubnetChecked: false,
      subnetResults: { mask: null, net: null, first: null, last: null, bc: null },
      subnetScore: 0,
      showCheatSheet: false,
      totalSolved: 0,
      
      startSubnetTimer() {
        if (this.timerInterval) clearInterval(this.timerInterval);
        this.timerSeconds = 30;
        this.timerRunning = true;
        var self = this;
        this.timerInterval = setInterval(function() {
          if (self.timerSeconds > 0) {
            self.timerSeconds--;
          } else {
            self.stopSubnetTimer();
            if (!self.isSubnetChecked) {
              self.checkSubnetAnswers();
            }
          }
        }, 1000);
      },
      
      stopSubnetTimer() {
        if (this.timerInterval) {
          clearInterval(this.timerInterval);
          this.timerInterval = null;
        }
        this.timerRunning = false;
      },
      
      selectProblem(idx) {
        this.problemIndex = idx;
        this.currentProblem = this.problemsList[idx];
        this.inputMask = '';
        this.inputNetwork = '';
        this.inputFirstHost = '';
        this.inputLastHost = '';
        this.inputBroadcast = '';
        this.isSubnetChecked = false;
        this.subnetResults = { mask: null, net: null, first: null, last: null, bc: null };
        this.startSubnetTimer();
      },
      
      nextSubnetProblem() {
        var nextIdx = (this.problemIndex + 1) % this.problemsList.length;
        this.selectProblem(nextIdx);
      },

      randomSubnetProblem() {
        var randIdx = Math.floor(Math.random() * this.problemsList.length);
        this.selectProblem(randIdx);
      },
      
      checkSubnetAnswers() {
        this.stopSubnetTimer();
        this.isSubnetChecked = true;
        
        var clean = function(s) { return (s || '').trim(); };
        var isMaskOk = clean(this.inputMask) === this.currentProblem.correctMask;
        var isNetOk = clean(this.inputNetwork) === this.currentProblem.correctNetwork;
        var isFirstOk = clean(this.inputFirstHost) === this.currentProblem.correctFirstHost;
        var isLastOk = clean(this.inputLastHost) === this.currentProblem.correctLastHost;
        var isBcOk = clean(this.inputBroadcast) === this.currentProblem.correctBroadcast;
        
        this.subnetResults = {
          mask: isMaskOk,
          net: isNetOk,
          first: isFirstOk,
          last: isLastOk,
          bc: isBcOk
        };
        
        var pointsEarned = 0;
        if (isMaskOk) pointsEarned += 10;
        if (isNetOk) pointsEarned += 10;
        if (isFirstOk) pointsEarned += 10;
        if (isLastOk) pointsEarned += 10;
        if (isBcOk) pointsEarned += 10;
        
        this.subnetScore += pointsEarned;
        this.totalSolved++;
      },

      // =======================================================================
      // MODULE 2: MCQS 50+ HIGH-DIFFICULTY
      // =======================================================================
      questionsList: rawPayload.questions || [],
      mcqFilter: 'all',
      mcqAnswers: {},
      
      get filteredQuestions() {
        if (this.mcqFilter === 'all') return this.questionsList;
        var f = this.mcqFilter;
        return this.questionsList.filter(function(q) { return q.group === f; });
      },
      
      get mcqStats() {
        var total = this.filteredQuestions.length;
        var answered = 0;
        var correct = 0;
        var self = this;
        this.filteredQuestions.forEach(function(q) {
          if (self.mcqAnswers[q.id] !== undefined) {
            answered++;
            if (self.mcqAnswers[q.id] === q.correctIndex) {
              correct++;
            }
          }
        });
        var percent = answered > 0 ? Math.round((correct / answered) * 100) : 0;
        return { total: total, answered: answered, correct: correct, percent: percent };
      },
      
      pickMcqAnswer(qId, optIdx) {
        if (this.mcqAnswers[qId] !== undefined) return; // Chỉ chọn 1 lần
        this.mcqAnswers[qId] = optIdx;
      },
      
      resetMcqAnswers() {
        if (confirm('Bạn có muốn xóa toàn bộ kết quả làm bài trắc nghiệm này để làm lại từ đầu?')) {
          this.mcqAnswers = {};
        }
      },

      // =======================================================================
      // MODULE 3: 5 STAGES PROJECT & 100-POINT RUBRIC
      // =======================================================================
      teamsList: rawPayload.teams || [],
      stagesList: rawPayload.stages || [],
      rubricList: rawPayload.rubric || [],
      
      selectedTeamId: 'team_04tha3_1',
      currentStageIndex: 0,
      checklistState: {},
      
      // Members roster
      memberLead: 'Nguyễn Văn An (Kỹ sư trưởng)',
      memberCable: 'Trần Thị Bình (Kỹ sư cáp & cơ khí)',
      memberSys: 'Lê Hoàng Cường (Kỹ sư Windows & dịch vụ)',
      memberNet: 'Phạm Minh Đức (Kỹ sư mạng & bảo mật)',
      
      // Project Overall Timer (180 mins default)
      projectTotalMinutes: 180,
      projectTimerSeconds: 180 * 60,
      projectTimerRunning: false,
      projectInterval: null,
      
      startProjectTimer() {
        if (this.projectInterval) clearInterval(this.projectInterval);
        this.projectTimerRunning = true;
        var self = this;
        this.projectInterval = setInterval(function() {
          if (self.projectTimerSeconds > 0) {
            self.projectTimerSeconds--;
          } else {
            self.pauseProjectTimer();
            alert('Hết giờ làm bài thi tổng hợp! Mời Đội thi dừng tay để Ban Giám khảo chấm điểm Rubric.');
          }
        }, 1000);
      },
      
      pauseProjectTimer() {
        if (this.projectInterval) {
          clearInterval(this.projectInterval);
          this.projectInterval = null;
        }
        this.projectTimerRunning = false;
      },
      
      setProjectDuration(mins) {
        this.pauseProjectTimer();
        this.projectTotalMinutes = mins;
        this.projectTimerSeconds = mins * 60;
      },
      
      formatProjectTime() {
        var hrs = Math.floor(this.projectTimerSeconds / 3600);
        var mins = Math.floor((this.projectTimerSeconds % 3600) / 60);
        var secs = this.projectTimerSeconds % 60;
        var pad = function(n) { return n < 10 ? '0' + n : n; };
        return pad(hrs) + ':' + pad(mins) + ':' + pad(secs);
      },
      
      toggleChecklist(itemId) {
        this.checklistState[itemId] = !this.checklistState[itemId];
      },
      
      // Rubric Scores State (default good starting scores)
      rubricScores: {
        rubric_c1: 23,
        rubric_c2: 18,
        rubric_c3: 22,
        rubric_c4: 14,
        rubric_c5: 14
      },
      judgeRemarks: 'Đội thi công nhanh nhẹn, đường cáp đẹp thẩm mỹ, mạng nội bộ ping thông suốt 100%, bảo vệ đề tài tự tin.',
      
      get activeTeam() {
        var id = this.selectedTeamId;
        return this.teamsList.find(function(t) { return t.id === id; }) || this.teamsList[0];
      },
      
      get totalRubricPoints() {
        var s = this.rubricScores;
        var total = (Number(s.rubric_c1) || 0) +
                    (Number(s.rubric_c2) || 0) +
                    (Number(s.rubric_c3) || 0) +
                    (Number(s.rubric_c4) || 0) +
                    (Number(s.rubric_c5) || 0);
        return Math.round(total * 10) / 10;
      },
      
      get rubricScale10() {
        return Math.round((this.totalRubricPoints / 10) * 10) / 10;
      },
      
      get rubricRank() {
        var p = this.totalRubricPoints;
        if (p >= 80) {
          return { text: 'GIẢI XUẤT SẮC · ĐẠT CHUẨN HSG', badgeClass: 'bg-emerald-600 text-white', icon: '🏆' };
        } else if (p >= 50) {
          return { text: 'MỨC CẦN CỐ GẮNG', badgeClass: 'bg-amber-600 text-white', icon: '⚠️' };
        } else {
          return { text: 'MỨC CHƯA ĐẠT CHUẨN', badgeClass: 'bg-rose-600 text-white', icon: '❌' };
        }
      },
      
      printJudgeRecord() {
        window.print();
      },

      init() {
        // Ready state
      }
    };
  }

  // Bind globally
  window.hsgMasterEngine = hsgMasterEngine;
</script>

<div x-data="hsgMasterEngine()" class="space-y-6">

  <!-- ========================================================================= -->
  <!-- HERO BANNER & NAVIGATION TABS                                            -->
  <!-- ========================================================================= -->
  <section class="bg-white border border-slate-200 rounded-2xl p-5 md:p-6 shadow-sm print:hidden">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-5 pb-5 border-b border-slate-100">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-blue-50 border border-blue-200 text-blue-800 text-xs font-bold rounded-full">
          <span class="inline-block w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
          CHUYÊN ĐỀ 02: HSG-02_PHAN_CUNG_MANG
        </div>
        <h1 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">
          Thi Học Sinh Giỏi Phần Cứng & Mạng Máy Tính
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-3xl">
          Chương trình bồi dưỡng Đội tuyển Học sinh Giỏi cấp trường: Trọng tâm huấn luyện 4 Trạm thực hành kỹ năng nghề thực chiến (80% tổng điểm), bộ đề thi tay nghề có bấm giờ 90 phút và ngân hàng kiến thức chuyên sâu.
        </p>
      </div>

      <!-- Quick stats badges -->
      <div class="flex flex-wrap items-center gap-2.5 shrink-0">
        <div class="px-3.5 py-2 rounded-xl bg-slate-50 border border-slate-200 text-center min-w-[90px]">
          <div class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Đội Tuyển</div>
          <div class="text-sm font-black text-slate-800">Ea H'leo</div>
        </div>
        <div class="px-3.5 py-2 rounded-xl bg-slate-50 border border-slate-200 text-center min-w-[90px]">
          <div class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Kỹ Năng Nghề</div>
          <div class="text-sm font-black text-emerald-600">4 Trạm Lab</div>
        </div>
        <div class="px-3.5 py-2 rounded-xl bg-slate-50 border border-slate-200 text-center min-w-[90px]">
          <div class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Đề Thi Mẫu</div>
          <div class="text-sm font-black text-blue-600">4 Đề 90 Phút</div>
        </div>
        <div class="px-3.5 py-2 rounded-xl bg-slate-50 border border-slate-200 text-center min-w-[90px]">
          <div class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Đánh Giá</div>
          <div class="text-sm font-black text-amber-600">Rubric 100đ</div>
        </div>
      </div>
    </div>

    <!-- 3 SHADCN TABS CONTROLLER (TOUCH TARGET >= 48px) -->
    <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-2 sm:gap-3">
      <button
        type="button"
        @click="activeTab = 'hands-on'"
        :class="activeTab === 'hands-on' ? 'bg-slate-900 text-white shadow-sm ring-2 ring-slate-900' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'"
        class="flex-1 flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-xs sm:text-sm font-bold transition-all min-h-[48px] cursor-pointer"
      >
        <span class="text-base">🛠️</span>
        <span>Phần 1: Trạm Thực Hành Kỹ Năng Nghề (80% Điểm)</span>
      </button>

      <button
        type="button"
        @click="activeTab = 'subnetting'"
        :class="activeTab === 'subnetting' ? 'bg-slate-900 text-white shadow-sm ring-2 ring-slate-900' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'"
        class="flex-1 flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-xs sm:text-sm font-bold transition-all min-h-[48px] cursor-pointer"
      >
        <span class="text-base">⚡</span>
        <span>Phần 2: Tính Nhẩm Quy Hoạch IP 30s</span>
      </button>

      <button
        type="button"
        @click="activeTab = 'mcq'"
        :class="activeTab === 'mcq' ? 'bg-slate-900 text-white shadow-sm ring-2 ring-slate-900' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'"
        class="flex-1 flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-xs sm:text-sm font-bold transition-all min-h-[48px] cursor-pointer"
      >
        <span class="text-base">📚</span>
        <span>Phần 3: Kiến Thức Bổ Trợ & Vấn Đáp (54 Câu HSG)</span>
      </button>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- PHẦN 1 (TRỌNG TÂM 80%): TRẠM THỰC HÀNH TAY NGHỀ THỰC CHIẾN              -->
  <!-- ========================================================================= -->
  <section x-show="activeTab === 'hands-on'" class="space-y-6" x-transition>
    
    <!-- Top Cockpit: Team Selector, Practical Timer & Print Trigger (Hidden when printing) -->
    <div class="bg-white border border-slate-200 rounded-2xl p-5 md:p-6 shadow-sm space-y-5 print:hidden">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-5 pb-4 border-b border-slate-100">
        <!-- Team Selector -->
        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Đội Tuyển Thực Hành (Cơ Sở Ea H'leo):</label>
          <div class="flex flex-wrap items-center gap-2">
            <template x-for="team in teamsList" :key="team.id">
              <button
                type="button"
                @click="selectedTeamId = team.id"
                :class="selectedTeamId === team.id ? 'bg-slate-900 text-white shadow-sm ring-2 ring-slate-900' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'"
                class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all min-h-[44px] cursor-pointer"
              >
                <span x-text="team.code"></span>
                <span class="opacity-75 font-normal ml-1" x-text="'(' + team.branch.replace('Cơ sở ', '') + ')'"></span>
              </button>
            </template>
          </div>
        </div>

        <!-- Practical Countdown Clock (90 mins default) -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="p-3 bg-slate-900 text-white rounded-xl flex items-center gap-3 shadow-inner">
            <div>
              <div class="text-[9px] uppercase font-bold text-slate-400 tracking-wider">Đồng Hồ Bài Thi Thực Hành</div>
              <div class="text-xl sm:text-2xl font-mono font-black" x-text="formatExamTime()">01:30:00</div>
            </div>
            <div class="flex flex-col gap-1">
              <button
                type="button"
                @click="examTimerRunning ? pauseExamTimer() : startExamTimer()"
                class="px-2.5 py-1 rounded bg-blue-600 hover:bg-blue-500 text-white text-[11px] font-bold transition-colors cursor-pointer"
                x-text="examTimerRunning ? '⏸ Tạm dừng' : '▶ Bắt đầu'"
              ></button>
              <button
                type="button"
                @click="resetExamTimer(examDurationMinutes === 90 ? 120 : 90)"
                class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[10px] font-mono transition-colors cursor-pointer"
                x-text="examDurationMinutes + 'm (Đổi)'"
              ></button>
            </div>
          </div>

          <button
            type="button"
            @click="printJudgeRecord()"
            class="min-h-[48px] px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs sm:text-sm font-bold rounded-xl shadow-sm transition-all flex items-center gap-2 cursor-pointer"
          >
            <span>🖨️</span>
            <span>Xuất Biên Bản A4</span>
          </button>
        </div>
      </div>

      <!-- Sub-Tab Navigation (Touch-friendly >= 44px) -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar border-b border-slate-100">
        <button
          type="button"
          @click="practicalSubTab = 'stations'"
          :class="practicalSubTab === 'stations' ? 'border-b-2 border-slate-900 text-slate-900 font-black' : 'text-slate-500 hover:text-slate-800 font-semibold'"
          class="px-4 py-2.5 text-xs sm:text-sm whitespace-nowrap transition-all cursor-pointer flex items-center gap-1.5"
        >
          <span>📍</span>
          <span>4 Trạm Thao Tác Kỹ Thuật Nghề</span>
        </button>

        <button
          type="button"
          @click="practicalSubTab = 'exams'"
          :class="practicalSubTab === 'exams' ? 'border-b-2 border-slate-900 text-slate-900 font-black' : 'text-slate-500 hover:text-slate-800 font-semibold'"
          class="px-4 py-2.5 text-xs sm:text-sm whitespace-nowrap transition-all cursor-pointer flex items-center gap-1.5"
        >
          <span>⏱️</span>
          <span>Bộ 4 Đề Thi Thực Hành Mẫu (90m)</span>
        </button>

        <button
          type="button"
          @click="practicalSubTab = 'rubric'"
          :class="practicalSubTab === 'rubric' ? 'border-b-2 border-slate-900 text-slate-900 font-black' : 'text-slate-500 hover:text-slate-800 font-semibold'"
          class="px-4 py-2.5 text-xs sm:text-sm whitespace-nowrap transition-all cursor-pointer flex items-center gap-1.5"
        >
          <span>⚖️</span>
          <span>Phiếu Chấm Điểm Rubric 100đ</span>
        </button>
      </div>

      <!-- Team Members Roster Inputs -->
      <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 text-xs">
        <div>
