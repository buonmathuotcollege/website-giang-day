                :disabled="isSubnetChecked"
                :class="isSubnetChecked ? (subnetResults.last ? 'border-emerald-500 bg-emerald-50 text-emerald-900' : 'border-rose-500 bg-rose-50 text-rose-900') : 'border-slate-300 bg-white'"
                class="w-full px-3.5 py-2.5 rounded-xl text-sm font-mono border focus:ring-2 focus:ring-slate-900 focus:outline-none transition-colors"
              />
              <template x-if="isSubnetChecked && !subnetResults.last">
                <div class="text-[11px] text-rose-600 font-mono">Đáp án đúng: <span class="font-bold" x-text="currentProblem.correctLastHost"></span></div>
              </template>
            </div>

            <!-- 5. Broadcast IP (Spans 2 columns on tablet) -->
            <div class="space-y-1.5 sm:col-span-2">
              <label class="text-xs font-bold text-slate-700 flex items-center justify-between">
                <span>5. Broadcast IP (Địa chỉ quảng bá mạng con)</span>
                <template x-if="isSubnetChecked">
                  <span :class="subnetResults.bc ? 'text-emerald-600' : 'text-rose-600'" class="text-xs font-black">
                    <span x-text="subnetResults.bc ? '✓ ĐÚNG' : '✗ SAI'"></span>
                  </span>
                </template>
              </label>
              <input
                type="text"
                x-model="inputBroadcast"
                placeholder="VD: 192.168.10.63"
                :disabled="isSubnetChecked"
                :class="isSubnetChecked ? (subnetResults.bc ? 'border-emerald-500 bg-emerald-50 text-emerald-900' : 'border-rose-500 bg-rose-50 text-rose-900') : 'border-slate-300 bg-white'"
                class="w-full px-3.5 py-2.5 rounded-xl text-sm font-mono border focus:ring-2 focus:ring-slate-900 focus:outline-none transition-colors"
              />
              <template x-if="isSubnetChecked && !subnetResults.bc">
                <div class="text-[11px] text-rose-600 font-mono">Đáp án đúng: <span class="font-bold" x-text="currentProblem.correctBroadcast"></span></div>
              </template>
            </div>

          </div>
        </div>

        <!-- Action Button Controls -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <template x-if="!isSubnetChecked">
            <button
              type="button"
              @click="checkSubnetAnswers()"
              class="flex-1 min-h-[48px] px-5 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm shadow-sm transition-all cursor-pointer flex items-center justify-center gap-2"
            >
              <span>✅ Kiểm Tra & Xem Bí Quyết</span>
            </button>
          </template>

          <template x-if="isSubnetChecked">
            <button
              type="button"
              @click="nextSubnetProblem()"
              class="flex-1 min-h-[48px] px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-sm transition-all cursor-pointer flex items-center justify-center gap-2"
            >
              <span>Tiếp Tục Bài Kế Tiếp ➔</span>
            </button>
          </template>

          <button
            type="button"
            @click="randomSubnetProblem()"
            class="min-h-[48px] px-4 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs sm:text-sm transition-colors cursor-pointer"
          >
            🎲 Đổi Bài Ngẫu Nhiên
          </button>
        </div>

        <!-- Magic Number Explanation Revealed after Check -->
        <template x-if="isSubnetChecked">
          <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-950 space-y-2 animate-fadeIn">
            <div class="flex items-center gap-2 font-bold text-sm text-amber-900">
              <span>💡</span>
              <span>BÍ QUYẾT TÍNH NHẨM THẦN TỐC (MAGIC NUMBER):</span>
            </div>
            <p class="text-xs leading-relaxed text-amber-900" x-text="currentProblem.explanationFormula"></p>
            <div class="pt-2 border-t border-amber-200/60 text-[11px] text-amber-800 font-mono">
              Công thức cốt lõi: <strong>Magic Number = 256 - OctetMask</strong> = <span x-text="currentProblem.magicNumber"></span>. 
              Các dải mạng con sẽ nhảy đều theo bội số của <span class="font-bold" x-text="currentProblem.magicNumber"></span> (0, <span x-text="currentProblem.magicNumber"></span>, <span x-text="currentProblem.magicNumber * 2"></span>, ...).
            </div>
          </div>
        </template>

      </div>

      <!-- Right Column: Cheat Sheet & Practice Quick List -->
      <div class="lg:col-span-4 space-y-5">
        
        <!-- Score & Stats Widget -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm space-y-3">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Thành Tích Luyện Phản Xạ</h3>
          <div class="grid grid-cols-2 gap-3 text-center">
            <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
              <div class="text-[10px] text-slate-500 uppercase font-semibold">Tổng Điểm Tích Lũy</div>
              <div class="text-2xl font-black text-slate-900 font-mono" x-text="subnetScore">0</div>
            </div>
            <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
              <div class="text-[10px] text-slate-500 uppercase font-semibold">Số Bài Hoàn Thành</div>
              <div class="text-2xl font-black text-blue-600 font-mono" x-text="totalSolved">0</div>
            </div>
          </div>
        </div>

        <!-- Cheat Sheet Card -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 flex items-center gap-1.5">
              <span>📖</span>
              <span>Bảng Bước Nhảy /24 ➔ /30</span>
            </h3>
            <span class="text-[10px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-mono">Magic Number</span>
          </div>

          <div class="overflow-x-auto text-xs">
            <table class="w-full border-collapse">
              <thead>
                <tr class="border-b border-slate-200 text-slate-500 text-[11px] text-left">
                  <th class="py-1.5 font-bold">Prefix</th>
                  <th class="py-1.5 font-bold">Octet Mask</th>
                  <th class="py-1.5 font-bold text-center">Bước Nhảy</th>
                  <th class="py-1.5 font-bold text-right">Host</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 font-mono text-[11px]">
                {SUBNET_CHEAT_SHEET.map((item) => (
                  <tr class="hover:bg-slate-50">
                    <td class="py-1.5 font-bold text-blue-700">{item.cidr}</td>
                    <td class="py-1.5 text-slate-700">{item.subnetMask.split('.').pop()}</td>
                    <td class="py-1.5 text-center font-bold text-amber-700">{item.magicNumber}</td>
                    <td class="py-1.5 text-right text-slate-900">{item.usableHosts}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="text-[11px] text-slate-500 italic">
            Quy tắc: Số host sử dụng = 2<sup>h</sup> - 2 (trừ 1 NetID và 1 Broadcast).
          </div>
        </div>

        <!-- Department Problems Drawer -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm space-y-3">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">6 Tình Huống Đề Bài Mẫu:</h3>
          <div class="space-y-2">
            <template x-for="(prob, idx) in problemsList" :key="prob.id">
              <button
                type="button"
                @click="selectProblem(idx)"
                :class="problemIndex === idx ? 'border-slate-900 bg-slate-50 font-bold' : 'border-slate-200 hover:border-slate-300 text-slate-700'"
                class="w-full text-left p-2.5 rounded-xl border text-xs transition-all flex items-center justify-between cursor-pointer"
              >
                <div class="truncate pr-2">
                  <span class="text-slate-400 font-mono mr-1" x-text="'#' + (idx + 1)"></span>
                  <span x-text="prob.department"></span>
                </div>
                <span class="font-mono text-[11px] bg-slate-200/70 px-1.5 py-0.5 rounded text-slate-800 shrink-0" x-text="prob.cidr"></span>
              </button>
            </template>
          </div>
        </div>

      </div>

    </div>

  </section>

  <!-- ========================================================================= -->
  <!-- TAB 2: MODULE 2 - NGÂN HÀNG 54 CÂU TRẮC NGHIỆM PHÂN LOẠI CAO            -->
  <!-- ========================================================================= -->
  <section x-show="activeTab === 'mcq'" class="space-y-6 print:hidden" x-transition>
    
    <!-- Filter bar & Progress Stats -->
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold text-slate-900">Ngân Hàng 54 Câu Hỏi Phân Loại Cao (Đội Tuyển HSG)</h2>
          <p class="text-xs text-slate-500">Kiểm tra tư duy giải thích bản chất kỹ thuật, sơ đồ khối và giao thức mạng chuẩn quốc tế</p>
        </div>

        <!-- Real-time performance pills -->
        <div class="flex items-center gap-2">
          <div class="px-3 py-1.5 rounded-xl bg-slate-100 text-xs font-semibold text-slate-700">
            Đã làm: <strong class="text-slate-900" x-text="mcqStats.answered + '/' + mcqStats.total"></strong>
          </div>
          <div class="px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-800 text-xs font-bold border border-emerald-200">
            Đúng: <strong x-text="mcqStats.correct"></strong> (<span x-text="mcqStats.percent + '%'"></span>)
          </div>
          <button
            type="button"
            @click="resetMcqAnswers()"
            class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-semibold transition-colors"
            title="Làm lại từ đầu"
          >
            🔄 Reset
          </button>
        </div>
      </div>

      <!-- Filter Buttons (Touch targets >= 48px) -->
      <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-slate-100">
        <button
          type="button"
          @click="mcqFilter = 'all'"
          :class="mcqFilter === 'all' ? 'bg-slate-900 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'"
          class="px-4 py-2.5 rounded-xl text-xs font-bold transition-all min-h-[44px] cursor-pointer"
        >
          Tất cả (54 câu)
        </button>

        <button
          type="button"
          @click="mcqFilter = 'kien-truc-phan-cung'"
          :class="mcqFilter === 'kien-truc-phan-cung' ? 'bg-slate-900 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'"
          class="px-4 py-2.5 rounded-xl text-xs font-bold transition-all min-h-[44px] cursor-pointer"
        >
          Bo mạch & Vi xử lý ({countArch})
        </button>

        <button
          type="button"
          @click="mcqFilter = 'osi-tcpip'"
          :class="mcqFilter === 'osi-tcpip' ? 'bg-slate-900 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'"
          class="px-4 py-2.5 rounded-xl text-xs font-bold transition-all min-h-[44px] cursor-pointer"
        >
          OSI 7 Tầng & TCP/IP ({countOsi})
        </button>

        <button
          type="button"
          @click="mcqFilter = 'routing-switching-security'"
          :class="mcqFilter === 'routing-switching-security' ? 'bg-slate-900 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'"
          class="px-4 py-2.5 rounded-xl text-xs font-bold transition-all min-h-[44px] cursor-pointer"
        >
          Định Tuyến & Bảo Mật ({countSec})
        </button>
      </div>
    </div>

    <!-- Questions Feed -->
    <div class="space-y-4">
      <template x-for="(q, index) in filteredQuestions" :key="q.id">
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm space-y-4">
          
          <!-- Question Header -->
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded text-[11px] font-bold bg-slate-900 text-white font-mono" x-text="'Câu ' + (index + 1)"></span>
              <span class="px-2 py-0.5 rounded text-[10px] font-semibold uppercase bg-slate-100 text-slate-600" x-text="q.subtopic"></span>
            </div>
            <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-blue-50 text-blue-800" x-text="q.level === 'VanDungCao' ? 'Vận Dụng Cao' : q.level === 'VanDung' ? 'Vận Dụng' : 'Thông Hiểu'"></span>
          </div>

          <!-- Question Body -->
          <div class="text-sm sm:text-base font-semibold text-slate-900 leading-relaxed" x-text="q.question"></div>

          <!-- 4 Options -->
          <div class="grid grid-cols-1 gap-2.5 pt-1">
            <template x-for="(opt, optIdx) in q.options" :key="optIdx">
              <button
                type="button"
                @click="pickMcqAnswer(q.id, optIdx)"
                :disabled="mcqAnswers[q.id] !== undefined"
                :class="mcqAnswers[q.id] === undefined 
                  ? 'border-slate-200 hover:border-slate-400 hover:bg-slate-50 text-slate-800' 
                  : optIdx === q.correctIndex 
                    ? 'border-emerald-500 bg-emerald-50 text-emerald-900 font-bold shadow-sm' 
                    : mcqAnswers[q.id] === optIdx 
                      ? 'border-rose-500 bg-rose-50 text-rose-900' 
                      : 'border-slate-100 bg-slate-50/50 text-slate-400 opacity-60'"
                class="w-full text-left p-3.5 rounded-xl border text-xs sm:text-sm transition-all flex items-start gap-3 min-h-[48px] cursor-pointer"
              >
                <span 
                  :class="mcqAnswers[q.id] !== undefined && optIdx === q.correctIndex ? 'bg-emerald-600 text-white' : 'bg-slate-200 text-slate-700'"
                  class="w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5 font-mono"
                  x-text="String.fromCharCode(65 + optIdx)"
                ></span>
                <span class="leading-relaxed" x-text="opt"></span>
              </button>
            </template>
          </div>

          <!-- In-depth Technical Explanation -->
          <template x-if="mcqAnswers[q.id] !== undefined">
            <div 
              :class="mcqAnswers[q.id] === q.correctIndex ? 'bg-emerald-50 border-emerald-200 text-emerald-950' : 'bg-slate-50 border-slate-200 text-slate-800'"
              class="p-4 rounded-xl border space-y-1.5 animate-fadeIn"
            >
              <div class="flex items-center gap-1.5 font-bold text-xs">
                <span x-text="mcqAnswers[q.id] === q.correctIndex ? '✅ GIẢI THÍCH KỸ THUẬT CHUẨN XÁC:' : '⚠️ BẢN CHẤT KỸ THUẬT CHUYÊN SÂU:'"></span>
              </div>
              <p class="text-xs leading-relaxed" x-text="q.explanation"></p>
            </div>
          </template>

        </div>
      </template>
    </div>

  </section>

</div>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fadeIn {
    animation: fadeIn 0.25s ease-out forwards;
  }
  
  @media print {
    body {
      background: white !important;
      color: black !important;
    }
    header, footer, nav, .print\:hidden {
      display: none !important;
    }
    #printable-hsg-record {
      display: block !important;
    }
  }
</style>
