---
import {
  HSG_QUESTION_BANK,
  SUBNET_CHEAT_SHEET,
  SUBNET_PRACTICE_PROBLEMS,
  HSG_PROJECT_TEAMS,
  HSG_PROJECT_STAGES,
  HSG_RUBRIC_CRITERIA,
} from '../../data/hsgCurriculum';

// Group MCQs count for badges
const countArch = HSG_QUESTION_BANK.filter(q => q.group === 'kien-truc-phan-cung').length;
const countOsi = HSG_QUESTION_BANK.filter(q => q.group === 'osi-tcpip').length;
const countSec = HSG_QUESTION_BANK.filter(q => q.group === 'routing-switching-security').length;

// Payload for Alpine.js
const hsgPayload = {
  teams: HSG_PROJECT_TEAMS,
  stages: HSG_PROJECT_STAGES,
  rubric: HSG_RUBRIC_CRITERIA,
  questions: HSG_QUESTION_BANK,
  cheatSheet: SUBNET_CHEAT_SHEET,
  subnetProblems: SUBNET_PRACTICE_PROBLEMS,
};
---

<!-- JSON Data Payload -->
<script type="application/json" id="hsg-data-payload" set:html={JSON.stringify(hsgPayload)}></script>

<!-- Alpine Engine Setup Ahead of DOM -->
<script is:inline>
  function hsgMasterEngine() {
    var rawPayload = {};
    try {
      var el = document.getElementById('hsg-data-payload');
      if (el && el.textContent) {
        rawPayload = JSON.parse(el.textContent);
      }
    } catch (e) {
      console.error('HSG Payload parse error:', e);
    }

    var problems = rawPayload.subnetProblems || [];
    var initialProblem = problems.length > 0 ? problems[0] : {
      id: 'sp_default',
      department: 'Phòng Kế Toán',
      teamTarget: '04THA3 - Đội 1 (Ea H\'leo)',
      ipInput: '192.168.10.55/26',
      requiredHosts: 58,
      cidr: '/26',
      correctMask: '255.255.255.192',
      correctNetwork: '192.168.10.0',
      correctFirstHost: '192.168.10.1',
      correctLastHost: '192.168.10.62',
      correctBroadcast: '192.168.10.63',
      magicNumber: 64,
      explanationFormula: 'Prefix /26 có bước nhảy = 256 - 192 = 64. Dải [0 - 63].'
    };

    return {
      activeTab: 'subnetting', // 'subnetting' | 'mcq' | 'stages'
      
      // =======================================================================
      // MODULE 1: SUBNETTING REFLEX 30s
      // =======================================================================
      problemsList: problems,
      problemIndex: 0,
      currentProblem: initialProblem,
      
      // User inputs
      inputMask: '',
      inputNetwork: '',
      inputFirstHost: '',
      inputLastHost: '',
      inputBroadcast: '',
      
      // State
      timerSeconds: 30,
      timerRunning: false,
      timerInterval: null,
      isSubnetChecked: false,
      subnetResults: { mask: null, net: null, first: null, last: null, bc: null },
      subnetScore: 0,
      showCheatSheet: false,
      totalSolved: 0,
      
      startSubnetTimer() {
        if (this.timerInterval) clearInterval(this.timerInterval);
        this.timerSeconds = 30;
        this.timerRunning = true;
        var self = this;
        this.timerInterval = setInterval(function() {
          if (self.timerSeconds > 0) {
            self.timerSeconds--;
          } else {
            self.stopSubnetTimer();
            if (!self.isSubnetChecked) {
              self.checkSubnetAnswers();
            }
          }
        }, 1000);
      },
      
      stopSubnetTimer() {
        if (this.timerInterval) {
          clearInterval(this.timerInterval);
          this.timerInterval = null;
        }
        this.timerRunning = false;
      },
      
      selectProblem(idx) {
        this.problemIndex = idx;
        this.currentProblem = this.problemsList[idx];
        this.inputMask = '';
        this.inputNetwork = '';
        this.inputFirstHost = '';
        this.inputLastHost = '';
        this.inputBroadcast = '';
        this.isSubnetChecked = false;
        this.subnetResults = { mask: null, net: null, first: null, last: null, bc: null };
        this.startSubnetTimer();
      },
      
      nextSubnetProblem() {
        var nextIdx = (this.problemIndex + 1) % this.problemsList.length;
        this.selectProblem(nextIdx);
      },

      randomSubnetProblem() {
        var randIdx = Math.floor(Math.random() * this.problemsList.length);
        this.selectProblem(randIdx);
      },
      
      checkSubnetAnswers() {
        this.stopSubnetTimer();
        this.isSubnetChecked = true;
        
        var clean = function(s) { return (s || '').trim(); };
        var isMaskOk = clean(this.inputMask) === this.currentProblem.correctMask;
        var isNetOk = clean(this.inputNetwork) === this.currentProblem.correctNetwork;
        var isFirstOk = clean(this.inputFirstHost) === this.currentProblem.correctFirstHost;
        var isLastOk = clean(this.inputLastHost) === this.currentProblem.correctLastHost;
        var isBcOk = clean(this.inputBroadcast) === this.currentProblem.correctBroadcast;
        
        this.subnetResults = {
          mask: isMaskOk,
          net: isNetOk,
          first: isFirstOk,
          last: isLastOk,
          bc: isBcOk
        };
        
        var pointsEarned = 0;
        if (isMaskOk) pointsEarned += 10;
        if (isNetOk) pointsEarned += 10;
        if (isFirstOk) pointsEarned += 10;
        if (isLastOk) pointsEarned += 10;
        if (isBcOk) pointsEarned += 10;
        
        this.subnetScore += pointsEarned;
        this.totalSolved++;
      },

      // =======================================================================
      // MODULE 2: MCQS 50+ HIGH-DIFFICULTY
      // =======================================================================
      questionsList: rawPayload.questions || [],
      mcqFilter: 'all',
      mcqAnswers: {},
      
      get filteredQuestions() {
        if (this.mcqFilter === 'all') return this.questionsList;
        var f = this.mcqFilter;
        return this.questionsList.filter(function(q) { return q.group === f; });
      },
      
      get mcqStats() {
        var total = this.filteredQuestions.length;
        var answered = 0;
        var correct = 0;
        var self = this;
        this.filteredQuestions.forEach(function(q) {
          if (self.mcqAnswers[q.id] !== undefined) {
            answered++;
            if (self.mcqAnswers[q.id] === q.correctIndex) {
              correct++;
            }
          }
        });
        var percent = answered > 0 ? Math.round((correct / answered) * 100) : 0;
        return { total: total, answered: answered, correct: correct, percent: percent };
      },
      
      pickMcqAnswer(qId, optIdx) {
        if (this.mcqAnswers[qId] !== undefined) return; // Chỉ chọn 1 lần
        this.mcqAnswers[qId] = optIdx;
      },
      
      resetMcqAnswers() {
        if (confirm('Bạn có muốn xóa toàn bộ kết quả làm bài trắc nghiệm này để làm lại từ đầu?')) {
          this.mcqAnswers = {};
        }
      },

      // =======================================================================
      // MODULE 3: 5 STAGES PROJECT & 100-POINT RUBRIC
      // =======================================================================
      teamsList: rawPayload.teams || [],
      stagesList: rawPayload.stages || [],
      rubricList: rawPayload.rubric || [],
      
      selectedTeamId: 'team_04tha3_1',
      currentStageIndex: 0,
      checklistState: {},
      
      // Members roster
      memberLead: 'Nguyễn Văn An (Kỹ sư trưởng)',
      memberCable: 'Trần Thị Bình (Kỹ sư cáp & cơ khí)',
      memberSys: 'Lê Hoàng Cường (Kỹ sư Windows & dịch vụ)',
      memberNet: 'Phạm Minh Đức (Kỹ sư mạng & bảo mật)',
      
      // Project Overall Timer (180 mins default)
      projectTotalMinutes: 180,
      projectTimerSeconds: 180 * 60,
      projectTimerRunning: false,
      projectInterval: null,
      
      startProjectTimer() {
        if (this.projectInterval) clearInterval(this.projectInterval);
        this.projectTimerRunning = true;
        var self = this;
        this.projectInterval = setInterval(function() {
          if (self.projectTimerSeconds > 0) {
            self.projectTimerSeconds--;
          } else {
            self.pauseProjectTimer();
            alert('Hết giờ làm bài thi tổng hợp! Mời Đội thi dừng tay để Ban Giám khảo chấm điểm Rubric.');
          }
        }, 1000);
      },
      
      pauseProjectTimer() {
        if (this.projectInterval) {
          clearInterval(this.projectInterval);
          this.projectInterval = null;
        }
        this.projectTimerRunning = false;
      },
      
      setProjectDuration(mins) {
        this.pauseProjectTimer();
        this.projectTotalMinutes = mins;
        this.projectTimerSeconds = mins * 60;
      },
      
      formatProjectTime() {
        var hrs = Math.floor(this.projectTimerSeconds / 3600);
        var mins = Math.floor((this.projectTimerSeconds % 3600) / 60);
        var secs = this.projectTimerSeconds % 60;
        var pad = function(n) { return n < 10 ? '0' + n : n; };
        return pad(hrs) + ':' + pad(mins) + ':' + pad(secs);
      },
      
      toggleChecklist(itemId) {
        this.checklistState[itemId] = !this.checklistState[itemId];
      },
      
      // Rubric Scores State (default good starting scores)
      rubricScores: {
        rubric_c1: 23,
        rubric_c2: 18,
        rubric_c3: 22,
        rubric_c4: 14,
        rubric_c5: 14
      },
      judgeRemarks: 'Đội thi công nhanh nhẹn, đường cáp đẹp thẩm mỹ, mạng nội bộ ping thông suốt 100%, bảo vệ đề tài tự tin.',
      
      get activeTeam() {
        var id = this.selectedTeamId;
        return this.teamsList.find(function(t) { return t.id === id; }) || this.teamsList[0];
      },
      
      get totalRubricPoints() {
        var s = this.rubricScores;
        var total = (Number(s.rubric_c1) || 0) +
                    (Number(s.rubric_c2) || 0) +
                    (Number(s.rubric_c3) || 0) +
                    (Number(s.rubric_c4) || 0) +
                    (Number(s.rubric_c5) || 0);
        return Math.round(total * 10) / 10;
      },
      
      get rubricScale10() {
        return Math.round((this.totalRubricPoints / 10) * 10) / 10;
      },
      
      get rubricRank() {
        var p = this.totalRubricPoints;
        if (p >= 80) {
          return { text: 'GIẢI XUẤT SẮC · ĐẠT CHUẨN HSG', badgeClass: 'bg-emerald-600 text-white', icon: '🏆' };
        } else if (p >= 50) {
          return { text: 'MỨC CẦN CỐ GẮNG', badgeClass: 'bg-amber-600 text-white', icon: '⚠️' };
        } else {
          return { text: 'MỨC CHƯA ĐẠT CHUẨN', badgeClass: 'bg-rose-600 text-white', icon: '❌' };
        }
      },
      
      printJudgeRecord() {
        window.print();
      },

      init() {
        // Auto start 30s timer for module 1
        this.startSubnetTimer();
      }
    };
  }

  // Bind globally
  window.hsgMasterEngine = hsgMasterEngine;
</script>

<div x-data="hsgMasterEngine()" class="space-y-6">

  <!-- ========================================================================= -->
  <!-- HERO BANNER & NAVIGATION TABS                                            -->
  <!-- ========================================================================= -->
  <section class="bg-white border border-slate-200 rounded-2xl p-5 md:p-6 shadow-sm print:hidden">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-5 pb-5 border-b border-slate-100">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-blue-50 border border-blue-200 text-blue-800 text-xs font-bold rounded-full">
          <span class="inline-block w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
          CHUYÊN ĐỀ 02: HSG-02_PHAN_CUNG_MANG
        </div>
        <h1 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">
          Thi Học Sinh Giỏi Phần Cứng & Mạng Máy Tính
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-3xl">
          Chương trình bồi dưỡng Đội tuyển Học sinh Giỏi cấp trường: Huấn luyện phản xạ Subnetting trong 30 giây, 
          ngân hàng 54 câu hỏi vận dụng cao và Sa bàn mô phỏng dự án thi công trọn gói 180 - 240 phút.
        </p>
      </div>

      <!-- Quick stats badges -->
      <div class="flex flex-wrap items-center gap-2.5 shrink-0">
        <div class="px-3.5 py-2 rounded-xl bg-slate-50 border border-slate-200 text-center min-w-[90px]">
          <div class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Đội Tuyển</div>
          <div class="text-sm font-black text-slate-800">Ea H'leo</div>
        </div>
        <div class="px-3.5 py-2 rounded-xl bg-slate-50 border border-slate-200 text-center min-w-[90px]">
          <div class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Trắc Nghiệm</div>
          <div class="text-sm font-black text-blue-600">54 Câu HSG</div>
        </div>
        <div class="px-3.5 py-2 rounded-xl bg-slate-50 border border-slate-200 text-center min-w-[90px]">
          <div class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Sa Bàn Dự Án</div>
          <div class="text-sm font-black text-emerald-600">5 Chặng 100đ</div>
        </div>
      </div>
    </div>

    <!-- 3 SHADCN TABS CONTROLLER (TOUCH TARGET >= 48px) -->
    <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-2 sm:gap-3">
      <button
        type="button"
        @click="activeTab = 'subnetting'"
        :class="activeTab === 'subnetting' ? 'bg-slate-900 text-white shadow-sm' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'"
        class="flex-1 flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-xs sm:text-sm font-bold transition-all min-h-[48px] cursor-pointer"
      >
        <span class="text-base">⚡</span>
        <span>Module 1: Phản Xạ Subnetting 30s</span>
      </button>

      <button
        type="button"
        @click="activeTab = 'mcq'"
        :class="activeTab === 'mcq' ? 'bg-slate-900 text-white shadow-sm' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'"
        class="flex-1 flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-xs sm:text-sm font-bold transition-all min-h-[48px] cursor-pointer"
      >
        <span class="text-base">📚</span>
        <span>Module 2: 54 Câu Phân Loại Cao</span>
      </button>

      <button
        type="button"
        @click="activeTab = 'stages'"
        :class="activeTab === 'stages' ? 'bg-slate-900 text-white shadow-sm' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'"
        class="flex-1 flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-xs sm:text-sm font-bold transition-all min-h-[48px] cursor-pointer"
      >
        <span class="text-base">🛠️</span>
        <span>Module 3: Sa Bàn 5 Chặng & Rubric 100đ</span>
      </button>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- TAB 1: MODULE 1 - LUYỆN PHẢN XẠ SUBNETTING & VLSM TRONG 30 GIÂY         -->
  <!-- ========================================================================= -->
  <section x-show="activeTab === 'subnetting'" class="space-y-6 print:hidden" x-transition>
    
    <!-- Header with 30s Timer -->
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded text-[11px] font-bold bg-amber-100 text-amber-900 border border-amber-200">
              Đồng Hồ Tốc Độ 30 Giây
            </span>
            <span class="text-xs text-slate-500">Mục tiêu: Đạt tốc độ tính nhẩm chuẩn KTV</span>
          </div>
          <h2 class="text-lg font-bold text-slate-900 mt-1">Luyện Phản Xạ Chia Mạng IPv4 (Magic Number)</h2>
        </div>

        <!-- 30-Second Countdown Display -->
        <div class="flex items-center gap-3">
          <div 
            :class="timerSeconds <= 5 ? 'bg-rose-500 text-white animate-pulse border-rose-600' : 'bg-slate-900 text-white border-slate-800'"
            class="flex items-center gap-2 px-4 py-2.5 rounded-xl border font-mono text-xl sm:text-2xl font-black shadow-inner"
          >
            <span x-text="timerSeconds < 10 ? '0' + timerSeconds : timerSeconds">30</span>
            <span class="text-xs font-sans font-bold uppercase tracking-wider">Giây</span>
          </div>

          <button
            type="button"
            @click="startSubnetTimer()"
            class="px-3.5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition-colors min-h-[44px]"
            title="Đếm lại 30 giây"
          >
            🔄 Reset 30s
          </button>
        </div>
      </div>

      <!-- Visual progress bar -->
      <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden">
        <div 
          class="h-full transition-all duration-1000 ease-linear rounded-full"
          :class="timerSeconds <= 5 ? 'bg-rose-500' : timerSeconds <= 15 ? 'bg-amber-500' : 'bg-blue-600'"
          :style="'width: ' + ((timerSeconds / 30) * 100) + '%'"
        ></div>
      </div>
    </div>

    <!-- Active Challenge Board & 5 Quick Inputs -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <!-- Left Column: Department Context & Inputs -->
      <div class="lg:col-span-8 bg-white border border-slate-200 rounded-2xl p-5 md:p-6 shadow-sm space-y-6">
        
        <!-- Challenge details card -->
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="text-[11px] font-bold uppercase px-2 py-0.5 rounded bg-blue-100 text-blue-800" x-text="currentProblem.teamTarget"></span>
              <span class="text-xs text-slate-500">Quy hoạch mạng phòng ban</span>
            </div>
            <div class="text-base sm:text-lg font-extrabold text-slate-900" x-text="currentProblem.department"></div>
            <div class="text-xs text-slate-600">
              Yêu cầu số lượng máy: <strong class="text-slate-900 font-bold" x-text="currentProblem.requiredHosts + ' thiết bị'"></strong>
            </div>
          </div>

          <!-- Highlighted IP Input Box -->
          <div class="p-3.5 rounded-xl bg-white border-2 border-slate-900 text-center shrink-0 shadow-sm">
            <div class="text-[10px] uppercase font-bold text-slate-500">Địa Chỉ IP / Prefix Đề Bài</div>
            <div class="text-xl sm:text-2xl font-black font-mono text-blue-700 mt-0.5" x-text="currentProblem.ipInput"></div>
          </div>
        </div>

        <!-- Sơ đồ Topo logic mạng phòng ban (Minh họa trực quan) -->
        <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-900 shadow-sm">
          <div class="relative group">
            <img src="/images/hsg-02/topology-packet-tracer-vlsm.svg" alt="Sơ đồ Topo nguyên lý mạng logic trên Cisco Packet Tracer" class="w-full h-auto max-h-56 object-cover" loading="lazy" />
            <div class="absolute bottom-0 inset-x-0 bg-slate-950/85 px-3 py-2 flex items-center justify-between text-[11px] text-white">
              <span>📷 Sơ đồ Topo nguyên lý logic Cisco Packet Tracer & Quy hoạch dải IP VLSM</span>
              <a href="/images/hsg-02/topology-packet-tracer-vlsm.svg" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:text-blue-300 font-bold inline-flex items-center gap-1">
                <span>Xem ảnh to ↗</span>
              </a>
            </div>
          </div>
        </div>

        <!-- 5 Fast Input Boxes (Shadcn style with verification status) -->
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-600">5 Thông Số Kỹ Thuật Cần Xác Định:</h3>
            <span class="text-[11px] text-slate-500">Mỗi ô đúng = 10 điểm</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            
            <!-- 1. Subnet Mask -->
            <div class="space-y-1.5">
              <label class="text-xs font-bold text-slate-700 flex items-center justify-between">
                <span>1. Subnet Mask (Dạng 255.255.255.xxx)</span>
                <template x-if="isSubnetChecked">
                  <span :class="subnetResults.mask ? 'text-emerald-600' : 'text-rose-600'" class="text-xs font-black">
                    <span x-text="subnetResults.mask ? '✓ ĐÚNG' : '✗ SAI'"></span>
                  </span>
                </template>
              </label>
              <input
                type="text"
                x-model="inputMask"
                placeholder="VD: 255.255.255.192"
                :disabled="isSubnetChecked"
                :class="isSubnetChecked ? (subnetResults.mask ? 'border-emerald-500 bg-emerald-50 text-emerald-900' : 'border-rose-500 bg-rose-50 text-rose-900') : 'border-slate-300 bg-white'"
                class="w-full px-3.5 py-2.5 rounded-xl text-sm font-mono border focus:ring-2 focus:ring-slate-900 focus:outline-none transition-colors"
              />
              <template x-if="isSubnetChecked && !subnetResults.mask">
                <div class="text-[11px] text-rose-600 font-mono">Đáp án đúng: <span class="font-bold" x-text="currentProblem.correctMask"></span></div>
              </template>
            </div>

            <!-- 2. Network ID -->
            <div class="space-y-1.5">
              <label class="text-xs font-bold text-slate-700 flex items-center justify-between">
                <span>2. Network ID (Địa chỉ mạng)</span>
                <template x-if="isSubnetChecked">
                  <span :class="subnetResults.net ? 'text-emerald-600' : 'text-rose-600'" class="text-xs font-black">
                    <span x-text="subnetResults.net ? '✓ ĐÚNG' : '✗ SAI'"></span>
                  </span>
                </template>
              </label>
              <input
                type="text"
                x-model="inputNetwork"
                placeholder="VD: 192.168.10.0"
                :disabled="isSubnetChecked"
                :class="isSubnetChecked ? (subnetResults.net ? 'border-emerald-500 bg-emerald-50 text-emerald-900' : 'border-rose-500 bg-rose-50 text-rose-900') : 'border-slate-300 bg-white'"
                class="w-full px-3.5 py-2.5 rounded-xl text-sm font-mono border focus:ring-2 focus:ring-slate-900 focus:outline-none transition-colors"
              />
              <template x-if="isSubnetChecked && !subnetResults.net">
                <div class="text-[11px] text-rose-600 font-mono">Đáp án đúng: <span class="font-bold" x-text="currentProblem.correctNetwork"></span></div>
              </template>
            </div>

            <!-- 3. First Usable Host -->
            <div class="space-y-1.5">
              <label class="text-xs font-bold text-slate-700 flex items-center justify-between">
                <span>3. First Host IP (Máy đầu tiên)</span>
                <template x-if="isSubnetChecked">
                  <span :class="subnetResults.first ? 'text-emerald-600' : 'text-rose-600'" class="text-xs font-black">
                    <span x-text="subnetResults.first ? '✓ ĐÚNG' : '✗ SAI'"></span>
                  </span>
                </template>
              </label>
              <input
                type="text"
                x-model="inputFirstHost"
