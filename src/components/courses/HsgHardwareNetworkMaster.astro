            <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-blue-50 text-blue-800" x-text="q.level === 'VanDungCao' ? 'Vận Dụng Cao' : q.level === 'VanDung' ? 'Vận Dụng' : 'Thông Hiểu'"></span>
