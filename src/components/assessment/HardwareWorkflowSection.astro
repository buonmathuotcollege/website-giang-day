  <!-- LIGHTBOX MODAL: PHÓNG TO ẢNH THỰC TẾ ĐỘ PHÂN GIẢI CAO                  -->
  <!-- ===================================================================== -->
  <div
    x-show="zoomedImage"
    x-cloak
    class="fixed inset-0 z-50 bg-black/85 backdrop-blur-sm flex items-center justify-center p-3 sm:p-6"
    @keydown.escape.window="zoomedImage = null"
    @click.self="zoomedImage = null"
  >
    <div class="relative max-w-5xl w-full bg-slate-900 rounded-2xl overflow-hidden border border-slate-700 shadow-2xl flex flex-col max-h-[95vh]">
      <div class="flex items-center justify-between px-4 py-3 bg-slate-800 border-b border-slate-700 text-white">
        <div class="flex items-center gap-2 overflow-hidden">
          <span class="text-amber-400 font-bold shrink-0">🔍 PHÓNG TO ẢNH THỰC TẾ:</span>
          <span class="text-xs text-slate-300 font-mono truncate" x-text="zoomedImageTitle"></span>
        </div>
        <button
          type="button"
          @click="zoomedImage = null"
          class="w-8 h-8 rounded-full bg-slate-700 hover:bg-rose-600 text-white flex items-center justify-center font-bold text-sm transition-colors shrink-0 ml-2"
        >
          ✕
        </button>
      </div>

      <div class="p-3 sm:p-6 overflow-auto flex items-center justify-center bg-slate-950/60 min-h-[300px]">
        <img
          :src="zoomedImage"
          :alt="zoomedImageTitle"
          class="max-h-[75vh] w-auto max-w-full rounded-lg object-contain shadow-md"
        />
      </div>

      <div class="px-4 py-2.5 bg-slate-800 border-t border-slate-700 text-center text-xs text-slate-400">
        Ấn phím <kbd class="px-1.5 py-0.5 bg-slate-700 rounded text-slate-200 font-mono">ESC</kbd> hoặc chạm vùng đen bên ngoài để đóng ảnh
      </div>
    </div>
  </div>
