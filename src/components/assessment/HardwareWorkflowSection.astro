---
import {
  KTV_7_STEPS,
  DISASSEMBLY_STEPS,
  ASSEMBLY_STEPS,
  CORE_SKILLS,
  LAB_MOTHERBOARDS,
  H510_HOTSPOTS,
} from '../../data/hardwareTrainingPackage';
---

<div class="space-y-6">
  <!-- 1. Hero Formula Banner (Công thức 3 Giây Là Nhớ) -->
  <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-indigo-950 text-white rounded-2xl p-5 sm:p-6 shadow-md border border-slate-700">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-amber-400 text-slate-950">
            ★ PHƯƠNG PHÁP THỰC CHIẾN 9+3
          </span>
          <span class="text-xs text-slate-300 font-medium">Mắt thấy – Tay làm – Chuẩn hóa KTV</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight">
          Công Thức 3 Giây Là Nhớ: LÀM GÌ – THẤY GÌ – CẤM GÌ
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-3xl leading-relaxed">
          Không cần đọc những bức tường chữ dài. Mỗi thao tác nghề chỉ cần nhớ <strong>3 chữ khẩu quyết</strong> và tự trả lời đúng 3 câu hỏi:
          <span class="text-emerald-300 font-bold">1. Tay làm gì?</span> •
          <span class="text-sky-300 font-bold">2. Mắt thấy gì thì đạt?</span> •
          <span class="text-rose-300 font-bold">3. Tuyệt đối cấm làm gì?</span>
        </p>
      </div>

      <!-- Quick progress pill -->
      <div class="bg-slate-800/90 border border-slate-700 rounded-xl p-3 text-center shrink-0 min-w-[170px] shadow-inner">
        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Tiến Độ Quy Trình</p>
        <p class="text-2xl font-black text-emerald-400 mt-0.5 font-mono">
          <span x-text="Object.values(workflowProgress).filter(Boolean).length"></span> / {KTV_7_STEPS.length}
        </p>
        <p class="text-[11px] text-slate-400">bước đã kiểm tra an toàn</p>
      </div>
    </div>

    <!-- 4 Sub-navigation Pills -->
    <div class="mt-5 pt-4 border-t border-slate-700/70 flex flex-wrap gap-2">
      <button
        type="button"
        @click="workflowSubTab = 'workflow7'"
        class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center gap-1.5"
        :class="workflowSubTab === 'workflow7' ? 'bg-amber-400 text-slate-950 font-black shadow-md' : 'bg-slate-800 text-slate-200 hover:bg-slate-700 border border-slate-700'"
      >
        <span>🎯</span>
        <span>1. Quy Trình 7 Bước KTV</span>
      </button>

      <button
        type="button"
        @click="workflowSubTab = 'assembly'"
        class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center gap-1.5"
        :class="workflowSubTab === 'assembly' ? 'bg-amber-400 text-slate-950 font-black shadow-md' : 'bg-slate-800 text-slate-200 hover:bg-slate-700 border border-slate-700'"
      >
        <span>⚙️</span>
        <span>2. Tháo Máy (6b) & Lắp Máy (7b)</span>
      </button>

      <button
        type="button"
        @click="workflowSubTab = 'skills'"
        class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center gap-1.5"
        :class="workflowSubTab === 'skills' ? 'bg-amber-400 text-slate-950 font-black shadow-md' : 'bg-slate-800 text-slate-200 hover:bg-slate-700 border border-slate-700'"
      >
        <span>🔧</span>
        <span>3. 4 Kỹ Năng Cơ Khí & Bẫy Lỗi</span>
      </button>

      <button
        type="button"
        @click="workflowSubTab = 'components'"
        class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center gap-1.5"
        :class="workflowSubTab === 'components' ? 'bg-amber-400 text-slate-950 font-black shadow-md' : 'bg-slate-800 text-slate-200 hover:bg-slate-700 border border-slate-700'"
      >
        <span>🧠</span>
        <span>4. 5 Món Đồ = Đời Thường & Bản Đồ Thị Trường</span>
      </button>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- SUBTAB 1: QUY TRÌNH 7 BƯỚC THỰC CHIẾN KTV                              -->
  <!-- ===================================================================== -->
  <div x-show="workflowSubTab === 'workflow7'" class="space-y-6">
    <!-- Step Navigation Buttons Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-7 gap-2">
      {KTV_7_STEPS.map((step, idx) => (
        <button
          type="button"
          @click={`activeStep7Index = ${idx}`}
          class="p-2.5 rounded-xl border text-left transition-all relative overflow-hidden"
          :class={`activeStep7Index === ${idx} ? 'bg-slate-900 text-white border-slate-900 shadow-md ring-2 ring-primary-500/40' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50'`}
        >
          <div class="flex items-center justify-between text-[11px] font-bold">
            <span class="font-mono">BƯỚC {step.stepNumber}</span>
            <span
              x-show={`workflowProgress['${step.id}']`}
              class="text-emerald-400 font-bold"
              title="Đã xác nhận an toàn"
            >✓</span>
          </div>
          <p class="text-xs font-bold truncate mt-1">{step.shortName}</p>
          <span class="text-[10px] text-slate-400 block truncate">{step.timeEstimate}</span>
        </button>
      ))}
    </div>

    <!-- Active Step Detail Cards -->
    {KTV_7_STEPS.map((step, idx) => (
      <div
        x-show={`activeStep7Index === ${idx}`}
        class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm space-y-6"
      >
        <!-- Step Header -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-1.5">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-slate-900 text-white">
                BƯỚC {step.stepNumber} / 7
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-900">
                👤 {step.role}
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-slate-100 text-slate-700">
                ⏱️ {step.timeEstimate}
              </span>
            </div>
            <h3 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
              {step.title}
            </h3>
          </div>

          <!-- Poka-Yoke Checkbox in Header -->
          <label class="flex items-center gap-2 cursor-pointer bg-slate-50 hover:bg-emerald-50 border border-slate-200 hover:border-emerald-300 p-2.5 rounded-xl transition-all select-none">
            <input
              type="checkbox"
              class="w-5 h-5 rounded text-emerald-600 focus:ring-emerald-500 cursor-pointer"
              :checked={`workflowProgress['${step.id}']`}
              @change={`toggleStepProgress('${step.id}')`}
            />
            <span class="text-xs font-bold text-slate-800">
              Xác nhận đã hoàn thành an toàn
            </span>
          </label>
        </div>

        <!-- 3-Second Formula Box (Khẩu quyết 3 chữ + 3 ô xúc giác) -->
        <div class="bg-slate-50 border-2 border-slate-300 rounded-2xl p-4 sm:p-5">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-lg">⚡</span>
            <h4 class="text-xs font-extrabold uppercase tracking-wider text-slate-600">
              Công Thức 3 Giây Là Nhớ: Khẩu Quyết Thực Chiến
            </h4>
          </div>

          <div class="p-3 bg-slate-900 text-amber-400 font-mono font-black text-center text-sm sm:text-base rounded-xl tracking-wider mb-4 border border-slate-700 shadow-sm">
            « {step.motto} »
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
            <!-- 1. LÀM GÌ -->
            <div class="bg-emerald-50 border-2 border-emerald-300/80 rounded-xl p-3.5 flex flex-col">
              <div class="flex items-center gap-2 mb-1.5 text-emerald-900 font-bold text-xs uppercase tracking-wide">
                <span>🟢</span>
                <span>1. Tay Làm Gì?</span>
              </div>
              <p class="text-xs sm:text-sm text-emerald-950 font-medium leading-relaxed">
                {step.quickAction}
              </p>
            </div>

            <!-- 2. THẤY GÌ -->
            <div class="bg-sky-50 border-2 border-sky-300/80 rounded-xl p-3.5 flex flex-col">
              <div class="flex items-center gap-2 mb-1.5 text-sky-900 font-bold text-xs uppercase tracking-wide">
                <span>🔵</span>
                <span>2. Mắt Thấy Gì?</span>
              </div>
              <p class="text-xs sm:text-sm text-sky-950 font-medium leading-relaxed">
                {step.quickSign}
              </p>
            </div>

            <!-- 3. CẤM GÌ -->
            <div class="bg-rose-50 border-2 border-rose-300/80 rounded-xl p-3.5 flex flex-col">
              <div class="flex items-center gap-2 mb-1.5 text-rose-900 font-bold text-xs uppercase tracking-wide">
                <span>🔴</span>
                <span>3. Tuyệt Đối Cấm Gì?</span>
              </div>
              <p class="text-xs sm:text-sm text-rose-950 font-bold leading-relaxed">
                {step.quickDont}
              </p>
            </div>
          </div>
        </div>

        <!-- Grid 2 Cột: Bên Trái Hướng Dẫn & Poka-Yoke, Bên Phải Ảnh Thực Tế -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <!-- Cột Trái: Chi Tiết & Poka-Yoke -->
          <div class="lg:col-span-7 space-y-4">
            <!-- Poka-Yoke Điểm Dừng An Toàn & Ví Von Đời Thường -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="bg-amber-50 border border-amber-200 rounded-xl p-3.5">
                <div class="flex items-center gap-1.5 text-amber-900 font-bold text-xs uppercase tracking-wider mb-1">
                  <span>🛡️</span>
                  <span>Điểm Dừng Poka-Yoke</span>
                </div>
                <p class="text-xs text-amber-950 font-medium leading-relaxed">
                  {step.pokaYoke}
                </p>
              </div>

              <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-3.5">
                <div class="flex items-center gap-1.5 text-indigo-900 font-bold text-xs uppercase tracking-wider mb-1">
                  <span>💡</span>
                  <span>Ví Von Đời Thường</span>
                </div>
                <p class="text-xs text-indigo-950 font-medium leading-relaxed">
                  {step.analogy}
                </p>
              </div>
            </div>

            <!-- Chi Tiết Các Thao Tác Chuẩn Bị -->
            <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
              <h5 class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-2.5 flex items-center gap-1.5">
                <span>📋</span>
                <span>Các Thao Tác Kỹ Thuật Chi Tiết Tại Bàn Máy:</span>
              </h5>
              <ul class="space-y-2 text-xs sm:text-sm text-slate-700">
                {step.instructions.map((inst) => (
                  <li class="flex items-start gap-2">
                    <span class="text-primary-600 font-bold mt-0.5">•</span>
                    <span class="leading-relaxed">{inst}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Cột Phải: Hình Ảnh Thực Tế Linh Kiện Phòng Lab -->
          <div class="lg:col-span-5 flex flex-col">
            <div class="relative bg-slate-900 rounded-2xl overflow-hidden border border-slate-200 shadow-sm group">
              <img
                src={step.imageSrc}
                alt={step.imageAlt}
                class="w-full h-64 sm:h-72 object-cover transition-transform duration-300 group-hover:scale-105 cursor-pointer"
                @click={`openZoom('${step.imageSrc}', '${step.imageAlt.replace(/'/g, "\\'")}')`}
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>

              <!-- Zoom Button Overlay -->
              <button
                type="button"
                @click={`openZoom('${step.imageSrc}', '${step.imageAlt.replace(/'/g, "\\'")}')`}
                class="absolute bottom-3 right-3 px-3 py-1.5 bg-slate-900/90 hover:bg-slate-900 text-white text-xs font-bold rounded-lg border border-slate-600 flex items-center gap-1.5 shadow-md backdrop-blur-sm transition-all"
              >
                <span>🔍</span>
                <span>Phóng to xem chi tiết</span>
              </button>

              <div class="absolute bottom-3 left-3 right-20 pointer-events-none">
                <span class="text-[11px] text-slate-200 font-medium line-clamp-1">
                  {step.imageAlt}
                </span>
              </div>
            </div>

            <!-- Hotspot Jump Button if applicable -->
            {step.hotspotTarget && (
              <p class="text-[11px] text-slate-500 mt-2 text-center">
                💡 Xem vị trí linh kiện này trên bo mạch H510 ở module bên dưới
              </p>
            )}
          </div>
        </div>
      </div>
    ))}

    <!-- ================================================================= -->
    <!-- MODULE: SƠ ĐỒ BO MẠCH H510 THỰC TẾ PHÒNG LAB (MSI · ASUS · WINNFOX) -->
    <!-- ================================================================= -->
    <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm space-y-6">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
        <div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-indigo-100 text-indigo-900 mb-1.5">
            <span>🗺️</span>
            <span>BẢN ĐỒ BO MẠCH THỰC TẾ PHÒNG MÁY</span>
          </span>
          <h3 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
            Sơ Đồ 3 Dòng Bo Mạch H510 (MSI · ASUS · WINNFOX)
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-1">
            Mỗi hãng có phím Boot, phím BIOS và đèn báo lỗi khác nhau. Học sinh nắm vững để không bị lúng túng khi đổi bàn máy!
          </p>
        </div>
      </div>

      <!-- Motherboard Selector (4 Tabs) -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
        {LAB_MOTHERBOARDS.map((mb) => (
          <button
            type="button"
            @click={`selectedBoardId = '${mb.id}'`}
            class="p-3 rounded-xl border text-left transition-all"
            :class={`selectedBoardId === '${mb.id}' ? 'bg-slate-900 text-white border-slate-900 shadow-md ring-2 ring-indigo-500/40' : 'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100'`}
          >
            <span class="text-[10px] font-mono block opacity-80">{mb.badge}</span>
            <p class="text-xs sm:text-sm font-bold truncate mt-0.5">{mb.name}</p>
          </button>
        ))}
      </div>

      <!-- Motherboard Detail Views -->
      {LAB_MOTHERBOARDS.map((mb) => (
        <div x-show={`selectedBoardId === '${mb.id}'`} class="space-y-5">
          <!-- 4 Spec Metric Cards -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <div class="bg-slate-50 border border-slate-200 rounded-xl p-3">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 block">🔑 Phím Boot USB</span>
              <p class="text-xs sm:text-sm font-black text-slate-900 mt-1 font-mono">{mb.bootKey}</p>
            </div>

            <div class="bg-slate-50 border border-slate-200 rounded-xl p-3">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 block">⚙️ Phím BIOS</span>
              <p class="text-xs sm:text-sm font-black text-slate-900 mt-1 font-mono">{mb.biosKey}</p>
            </div>

            <div class="bg-slate-50 border border-slate-200 rounded-xl p-3">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 block">🚨 Báo Lỗi Phần Cứng</span>
              <p class="text-xs sm:text-sm font-bold text-slate-900 mt-1">{mb.debugMethod}</p>
            </div>

            <div class="bg-slate-50 border border-slate-200 rounded-xl p-3">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 block">🔌 Kiểu Ngàm RAM</span>
              <p class="text-xs sm:text-sm font-bold text-slate-900 mt-1">{mb.ramLatchType}</p>
            </div>
          </div>

          <!-- KTV Practical Tip -->
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-3.5 flex items-start gap-2.5">
            <span class="text-xl shrink-0 mt-0.5">💡</span>
            <div class="text-xs sm:text-sm text-amber-950">
              <strong class="font-bold block mb-0.5">Kinh nghiệm thực chiến KTV:</strong>
              <span>{mb.ktvTip}</span>
            </div>
          </div>

          <!-- High-res Image & Hotspots Container -->
          <div class="relative bg-slate-950 rounded-2xl overflow-hidden border border-slate-800 shadow-md">
            <img
              src={mb.imageSrc}
              alt={mb.imageAlt}
              class="w-full max-h-[500px] object-contain mx-auto py-2 cursor-pointer"
              @click={`openZoom('${mb.imageSrc}', '${mb.imageAlt.replace(/'/g, "\\'")}')`}
              loading="lazy"
            />

            <!-- Hotspots overlay (only for MSI H510 interactive diagram) -->
            {mb.id === 'msi' && H510_HOTSPOTS.map((hs) => (
              <div
                class="absolute hidden md:block cursor-pointer group"
                style={`top: ${hs.top}; left: ${hs.left}; transform: translate(-50%, -50%);`}
                @click={`openZoom('${mb.imageSrc}', '${hs.title}: ${hs.description.replace(/'/g, "\\'")}')`}
              >
                <!-- Pulse animation pin -->
                <span class={`relative flex h-5 w-5`}>
                  <span class={`animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 ${hs.color}`}></span>
                  <span class={`relative inline-flex rounded-full h-5 w-5 ${hs.color} text-white text-[10px] font-bold items-center justify-center border-2 border-white shadow-md`}>
                    •
                  </span>
                </span>

                <!-- Hover Card Tooltip -->
                <div class="absolute left-6 -top-2 hidden group-hover:block z-30 w-64 bg-slate-900 text-white text-xs p-3 rounded-xl shadow-xl border border-slate-700 pointer-events-none">
                  <p class="font-bold text-amber-400">{hs.title}</p>
                  <p class="text-slate-300 mt-1">{hs.description}</p>
                  <p class="text-[11px] text-emerald-300 mt-1 font-mono">🛡️ {hs.pokaYoke}</p>
                </div>
              </div>
            ))}

            <!-- Zoom Button Overlay -->
            <button
              type="button"
              @click={`openZoom('${mb.imageSrc}', '${mb.imageAlt.replace(/'/g, "\\'")}')`}
              class="absolute bottom-3 right-3 px-3 py-1.5 bg-slate-900/90 hover:bg-slate-900 text-white text-xs font-bold rounded-lg border border-slate-600 flex items-center gap-1.5 shadow-md backdrop-blur-sm transition-all"
            >
              <span>🔍</span>
              <span>Phóng to ảnh toàn màn hình</span>
            </button>
          </div>

          <!-- Hotspots Legend List for Mobile / Touch Screens -->
          {mb.id === 'msi' && (
            <div class="mt-4 pt-4 border-t border-slate-100">
              <h5 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2.5">
                Các Điểm Linh Kiện Cốt Lõi Trên Bo Mạch H510 (Nhấp để xem chi tiết):
              </h5>
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5">
                {H510_HOTSPOTS.map((hs) => (
                  <div
                    class="bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-xl p-3 cursor-pointer transition-colors"
                    @click={`openZoom('${mb.imageSrc}', '${hs.title}: ${hs.description.replace(/'/g, "\\'")}')`}
                  >
                    <div class="flex items-center gap-2 mb-1">
                      <span class={`w-2.5 h-2.5 rounded-full ${hs.color}`}></span>
                      <strong class="text-xs font-bold text-slate-900">{hs.title}</strong>
                    </div>
                    <p class="text-[11px] text-slate-600 line-clamp-2">{hs.description}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- SUBTAB 2: THÁO MÁY (6 BƯỚC) & LẮP MÁY (7 BƯỚC) KTV                      -->
  <!-- ===================================================================== -->
  <div x-show="workflowSubTab === 'assembly'" class="space-y-6">
    <!-- Assembly Subtab Switcher -->
    <div class="flex items-center gap-2 p-1.5 bg-slate-100 rounded-xl border border-slate-200 w-fit">
      <button
        type="button"
        @click="assemblySubTab = 'disassembly'"
        class="px-4 py-2 rounded-lg text-xs sm:text-sm font-bold transition-all flex items-center gap-1.5"
        :class="assemblySubTab === 'disassembly' ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900'"
      >
        <span>🔩</span>
        <span>Quy Trình Tháo Máy (6 Bước Chuẩn)</span>
      </button>

      <button
        type="button"
        @click="assemblySubTab = 'assembly'"
        class="px-4 py-2 rounded-lg text-xs sm:text-sm font-bold transition-all flex items-center gap-1.5"
        :class="assemblySubTab === 'assembly' ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900'"
      >
        <span>🛠️</span>
        <span>Quy Trình Lắp Máy (7 Bước Poka-Yoke)</span>
      </button>
    </div>

    <!-- VIEW 1: THÁO MÁY (6 BƯỚC) -->
    <div x-show="assemblySubTab === 'disassembly'" class="space-y-6">
      <!-- Overview Infographic Card -->
      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
