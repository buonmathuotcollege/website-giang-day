---
// QuickLookupAndNetworkQuiz.astro — Tra Cứu Nhanh Sự Cố Phần Cứng & Trắc Nghiệm Mạng Thực Chiến
// Dữ liệu lấy trực tiếp từ file Single Source of Truth: src/data/quickLookupNetworkData.ts
import {
  HARDWARE_TROUBLESHOOTING_LIST,
  HARDWARE_CATEGORIES,
  NETWORK_QUIZ_QUESTIONS,
  NETWORK_QUIZ_CATEGORIES,
} from '../../data/quickLookupNetworkData';

const payloadJson = JSON.stringify({
  hardwareList: HARDWARE_TROUBLESHOOTING_LIST,
  hardwareCategories: HARDWARE_CATEGORIES,
  quizQuestions: NETWORK_QUIZ_QUESTIONS,
  quizCategories: NETWORK_QUIZ_CATEGORIES,
});
---

<!-- 1. DỮ LIỆU JSON ĐỘC LẬP CHO CLIENT ENGINE -->
<script id="quick-lookup-network-payload" type="application/json" set:html={payloadJson}></script>

<!-- 2. CLIENT ENGINE ALPINES TỰ ĐỘNG HÓA 100% -->
<script is:inline>
  function quickLookupNetworkEngine() {
    var raw = { hardwareList: [], hardwareCategories: [], quizQuestions: [], quizCategories: [] };
    try {
      var el = document.getElementById('quick-lookup-network-payload');
      if (el && el.textContent) {
        raw = JSON.parse(el.textContent);
      }
    } catch(e) {}

    function stripAccents(str) {
      if (!str) return '';
      return str
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/đ/g, 'd')
        .replace(/Đ/g, 'D')
        .toLowerCase();
    }

    return {
      activeTab: 'hardware', // 'hardware' | 'quiz'

      // ==========================================
      // MODULE 1: TRA CỨU SỰ CỐ PHẦN CỨNG
      // ==========================================
      hwList: raw.hardwareList || [],
      hwCategories: raw.hardwareCategories || [],
      hwSearchQuery: '',
      hwSelectedCategory: 'all',
      expandedHwId: (raw.hardwareList && raw.hardwareList.length > 0) ? raw.hardwareList[0].id : null,

      get filteredHwList() {
        var self = this;
        var q = stripAccents(self.hwSearchQuery.trim());
        var cat = self.hwSelectedCategory;

        return self.hwList.filter(function(item) {
          // Lọc theo danh mục
          if (cat !== 'all' && item.category !== cat) {
            return false;
          }
          // Lọc theo từ khóa tìm kiếm
          if (!q) return true;
          var searchCorpus = stripAccents(
            item.code + ' ' +
            item.title + ' ' +
            item.categoryLabel + ' ' +
            item.hardware + ' ' +
            item.symptom + ' ' +
            item.rootCause + ' ' +
            (item.tools ? item.tools.join(' ') : '')
          );
          return searchCorpus.indexOf(q) !== -1;
        });
      },

      toggleHwCard: function(id) {
        if (this.expandedHwId === id) {
          this.expandedHwId = null;
        } else {
          this.expandedHwId = id;
        }
      },

      selectHwCategory: function(catId) {
        this.hwSelectedCategory = catId;
      },

      clearHwSearch: function() {
        this.hwSearchQuery = '';
      },

      // ==========================================
      // MODULE 2: TRẮC NGHIỆM MẠNG THỰC CHIẾN
      // ==========================================
      allQuestions: raw.quizQuestions || [],
      quizCategories: raw.quizCategories || [],
      quizSelectedCategory: 'all',
      quizMode: 'all', // 'all' | 'random10'
      activeQuestionList: [],
      currentQuestionIdx: 0,
      userAnswers: {}, // { [questionId]: selectedOptionIndex }
      revealedNotes: {}, // { [questionId]: boolean }
      quizCompleted: false,

      initQuiz: function() {
        this.filterQuestions();
      },

      filterQuestions: function() {
        var self = this;
        var list = self.allQuestions;

        if (self.quizSelectedCategory !== 'all') {
          list = list.filter(function(q) {
            return q.category === self.quizSelectedCategory;
          });
        }

        if (self.quizMode === 'random10') {
          // Trộn ngẫu nhiên chuẩn Fisher-Yates và bốc 10 câu
          var copy = list.slice();
          for (var i = copy.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var tmp = copy[i];
            copy[i] = copy[j];
            copy[j] = tmp;
          }
          self.activeQuestionList = copy.slice(0, 10);
        } else {
          self.activeQuestionList = list.slice();
        }

        self.currentQuestionIdx = 0;
        self.userAnswers = {};
        self.revealedNotes = {};
        self.quizCompleted = false;
      },

      selectQuizCategory: function(catId) {
        if (this.quizSelectedCategory === catId) return;
        if (!this.quizCompleted && Object.keys(this.userAnswers).length > 0) {
          if (!confirm('Bạn đang làm dở bài trắc nghiệm. Đổi chuyên đề sẽ làm mới câu trả lời hiện tại, tiếp tục?')) return;
        }
        this.quizSelectedCategory = catId;
        this.filterQuestions();
      },

      setQuizMode: function(mode) {
        if (this.quizMode === mode && mode !== 'random10') return;
        if (!this.quizCompleted && Object.keys(this.userAnswers).length > 0) {
          if (!confirm('Bạn đang làm dở bài trắc nghiệm. Đổi chế độ sẽ làm mới câu trả lời hiện tại, tiếp tục?')) return;
        }
        this.quizMode = mode;
        this.filterQuestions();
      },

      get currentQuestion() {
        return this.activeQuestionList[this.currentQuestionIdx] || null;
      },

      selectOption: function(qId, optIdx) {
        if (this.quizCompleted) return;
        this.userAnswers[qId] = optIdx;
      },

      toggleExplanation: function(qId) {
        this.revealedNotes[qId] = !this.revealedNotes[qId];
      },

      goToQuestion: function(idx) {
        if (idx >= 0 && idx < this.activeQuestionList.length) {
          this.currentQuestionIdx = idx;
        }
      },

      nextQuestion: function() {
        if (this.currentQuestionIdx < this.activeQuestionList.length - 1) {
          this.currentQuestionIdx++;
        }
      },

      prevQuestion: function() {
        if (this.currentQuestionIdx > 0) {
          this.currentQuestionIdx--;
        }
      },

      finishQuiz: function() {
        this.quizCompleted = true;
      },

      restartQuiz: function() {
        this.filterQuestions();
      },

      get scoreSummary() {
        var self = this;
        var total = self.activeQuestionList.length;
        if (total === 0) return { correct: 0, total: 0, percent: 0, rank: 'N/A' };

        var correctCount = 0;
        self.activeQuestionList.forEach(function(q) {
          if (self.userAnswers[q.id] === q.correctIndex) {
            correctCount++;
          }
        });

        var percent = Math.round((correctCount / total) * 100);
        var rank = 'CẦN ÔN TẬP THÊM';
        if (percent >= 90) rank = 'XUẤT SẮC (KTV BẬC CAO)';
        else if (percent >= 75) rank = 'KHÁ - GIỎI (ĐẠT CHUẨN)';
        else if (percent >= 50) rank = 'ĐẠT YÊU CẦU';

        return {
          correct: correctCount,
          total: total,
          percent: percent,
          rank: rank
        };
      }
    };
  }
  window.quickLookupNetworkEngine = quickLookupNetworkEngine;
</script>

<div
  x-data="quickLookupNetworkEngine()"
  x-init="initQuiz()"
  class="space-y-6 max-w-6xl mx-auto px-4 sm:px-6 py-6"
>
  <!-- TOP BANNER TIÊU CHUẨN KỸ THUẬT VIÊN THỰC CHIẾN -->
  <div class="p-6 sm:p-8 rounded-3xl bg-slate-900 text-white shadow-md border border-slate-800">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="px-2.5 py-0.5 rounded-md text-[11px] font-black uppercase tracking-wider bg-blue-600 text-white font-mono">
            HỆ THỐNG HUẤN LUYỆN CNTT
          </span>
          <span class="text-xs font-bold text-slate-300">
            📍 Lớp 04THA3 · Cơ sở Ea H'leo
          </span>
          <span class="text-xs px-2 py-0.5 rounded bg-slate-800 text-emerald-400 font-mono font-semibold">
            Intel H510 / DDR4 / Win 10 Pro
          </span>
        </div>
        <h1 class="text-xl sm:text-3xl font-black text-white tracking-tight">
          Tra Cứu Lỗi Phần Cứng & Trắc Nghiệm Mạng Thực Chiến
        </h1>
        <p class="text-xs sm:text-sm text-slate-300 mt-1.5 max-w-2xl leading-relaxed">
          Kho tri thức xử lý sự cố máy tính chuẩn Poka-Yoke và ngân hàng câu hỏi trắc nghiệm mạng phân loại cao. Dữ liệu độc lập 100%, tự động đồng bộ khi cập nhật.
        </p>
      </div>

      <!-- TAB NAVIGATION BUTTONS (TACTILE SHADCN STYLE) -->
      <div class="flex items-center gap-2 p-1.5 rounded-2xl bg-slate-800 border border-slate-700 shrink-0">
        <button
          type="button"
          id="btn-tab-hardware"
          @click="activeTab = 'hardware'"
          class="flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs transition-all cursor-pointer min-h-[44px]"
          :class="activeTab === 'hardware' ? 'bg-white text-slate-950 shadow-md font-black' : 'text-slate-300 hover:text-white hover:bg-slate-700/60'"
        >
          <span>🔍</span>
          <span>Tra Cứu Lỗi Phần Cứng</span>
          <span
            class="px-2 py-0.5 rounded-md text-[10px] font-black font-mono"
            :class="activeTab === 'hardware' ? 'bg-slate-100 text-slate-900' : 'bg-slate-900 text-slate-400'"
            x-text="hwList.length"
          >
            {HARDWARE_TROUBLESHOOTING_LIST.length}
          </span>
        </button>

        <button
          type="button"
          id="btn-tab-quiz"
          @click="activeTab = 'quiz'"
          class="flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs transition-all cursor-pointer min-h-[44px]"
          :class="activeTab === 'quiz' ? 'bg-amber-500 text-slate-950 shadow-md font-black' : 'text-slate-300 hover:text-white hover:bg-slate-700/60'"
        >
          <span>🌐</span>
          <span>Trắc Nghiệm Mạng</span>
          <span
            class="px-2 py-0.5 rounded-md text-[10px] font-black font-mono"
            :class="activeTab === 'quiz' ? 'bg-amber-400 text-slate-950' : 'bg-slate-900 text-slate-400'"
            x-text="allQuestions.length"
          >
            {NETWORK_QUIZ_QUESTIONS.length}
          </span>
        </button>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- TAB 1: TRA CỨU SỰ CỐ PHẦN CỨNG MÁY TÍNH                                  -->
  <!-- ========================================================================= -->
  <section x-show="activeTab === 'hardware'" x-cloak class="space-y-5">
    
    <!-- THANH TÌM KIẾM THÔNG MINH & BỘ LỌC LINH KIỆN -->
    <div class="p-5 sm:p-6 rounded-3xl bg-white border border-slate-200 shadow-xs space-y-4">
      
      <!-- Input Search Real-time (Fuzzy Search không dấu) -->
      <div class="relative">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-base">
          🔎
        </span>
        <input
          type="text"
          id="hw-search-input"
          x-model="hwSearchQuery"
          placeholder="Gõ triệu chứng hoặc linh kiện: 'màn hình đen', 'quạt quay', 'ram', 'ssd', 'usb', 'h510'..."
          class="w-full pl-10 pr-24 py-3 rounded-2xl border border-slate-200 bg-slate-50 text-slate-900 text-xs sm:text-sm font-medium focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-slate-900 focus:border-slate-900 transition-all min-h-[48px]"
        />
        <button
          type="button"
          x-show="hwSearchQuery.length > 0"
          @click="clearHwSearch()"
          class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-xs font-bold text-slate-400 hover:text-slate-700 cursor-pointer"
        >
          ✕ Xóa
        </button>
      </div>

      <!-- Bộ Lọc Linh Kiện Tự Động Sinh Từ File Data (Filter Pills) -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 pt-1 scrollbar-none" id="hw-category-filters">
        <template x-for="cat in hwCategories" :key="cat.id">
          <button
            type="button"
            @click="selectHwCategory(cat.id)"
            class="px-3.5 py-2 rounded-xl text-xs font-bold shrink-0 transition-all cursor-pointer min-h-[44px] touch-manipulation flex items-center gap-1.5 border"
            :class="hwSelectedCategory === cat.id ? 'bg-slate-900 text-white border-slate-900 shadow-xs font-black' : 'bg-slate-50 hover:bg-slate-100 text-slate-700 border-slate-200'"
          >
            <span x-text="cat.icon"></span>
            <span x-text="cat.label"></span>
          </button>
        </template>
      </div>

      <!-- Đếm kết quả tìm kiếm -->
      <div class="flex items-center justify-between text-xs text-slate-500 pt-1 border-t border-slate-100">
        <span>
          Đang hiển thị: <strong class="text-slate-900" x-text="filteredHwList.length"></strong> ca sự cố kỹ thuật
        </span>
        <span class="text-[11px] text-slate-400 italic">
          Bấm vào từng ca để xem quy trình Poka-Yoke & dụng cụ xử lý
        </span>
      </div>
    </div>

    <!-- DANH SÁCH THẺ SỰ CỐ PHẦN CỨNG 3 LỚP (TỰ CO GIÃN THEO DỮ LIỆU) -->
    <div class="space-y-3" id="hw-cards-container">
      <template x-for="item in filteredHwList" :key="item.id">
        <div
          class="rounded-2xl border transition-all bg-white shadow-xs overflow-hidden"
          :class="expandedHwId === item.id ? 'border-slate-900 ring-1 ring-slate-900' : 'border-slate-200 hover:border-slate-300'"
        >
          <!-- Card Header (Click to expand) -->
          <button
            type="button"
            @click="toggleHwCard(item.id)"
            class="w-full p-4 sm:p-5 text-left flex items-start justify-between gap-3 cursor-pointer"
          >
            <div class="space-y-1.5 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <span
                  class="px-2 py-0.5 rounded text-[11px] font-black font-mono tracking-wider"
                  :class="item.severity === 'critical' ? 'bg-rose-100 text-rose-800' : (item.severity === 'high' ? 'bg-amber-100 text-amber-900' : 'bg-blue-100 text-blue-900')"
                  x-text="item.code"
                ></span>
                <span class="text-[11px] font-bold text-slate-600 bg-slate-100 px-2 py-0.5 rounded" x-text="item.categoryLabel"></span>
                <span class="text-[11px] font-mono text-slate-400" x-text="item.hardware"></span>
              </div>

              <h2 class="text-sm sm:text-base font-black text-slate-900 leading-snug" x-text="item.title"></h2>
            </div>

            <div class="shrink-0 w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 font-bold text-xs mt-1">
              <span x-text="expandedHwId === item.id ? '▲' : '▼'"></span>
            </div>
          </button>

          <!-- Card Body Chi Tiết 3 Lớp (Accordion Content) -->
          <div
            x-show="expandedHwId === item.id"
            x-collapse
            class="px-4 sm:px-5 pb-5 pt-2 border-t border-slate-100 bg-slate-50/50 space-y-3.5 text-xs"
          >
            <!-- 1. Triệu chứng lâm sàng (Vàng nhạt) -->
            <div class="p-3.5 rounded-xl bg-amber-50/80 border border-amber-200/80 text-amber-950">
              <div class="flex items-center gap-1.5 font-black text-[11px] uppercase tracking-wider text-amber-800 mb-1">
                <span>👁️</span>
                <span>Triệu chứng lâm sàng (Mắt thấy - Tai nghe):</span>
              </div>
              <p class="leading-relaxed font-medium" x-text="item.symptom"></p>
            </div>

            <!-- 2. Nguyên nhân cốt lõi (Xám) -->
            <div class="p-3.5 rounded-xl bg-white border border-slate-200 text-slate-800">
              <div class="flex items-center gap-1.5 font-black text-[11px] uppercase tracking-wider text-slate-700 mb-1">
                <span>🧠</span>
                <span>Nguyên nhân kỹ thuật gốc rễ:</span>
              </div>
              <p class="leading-relaxed font-medium text-slate-600" x-text="item.rootCause"></p>
            </div>

            <!-- 3. Quy trình Poka-Yoke & Dụng cụ (Xanh lá) -->
            <div class="p-3.5 rounded-xl bg-emerald-50/80 border border-emerald-200 text-emerald-950 space-y-2">
              <div class="flex items-center gap-1.5 font-black text-[11px] uppercase tracking-wider text-emerald-800">
                <span>🛡️</span>
                <span>Quy trình xử lý chuẩn KTV & Poka-Yoke từng bước:</span>
              </div>
              
              <ol class="list-decimal list-inside space-y-1.5 pl-1 font-medium text-slate-800">
                <template x-for="(step, sIdx) in item.pokaYokeSteps" :key="sIdx">
                  <li class="leading-relaxed" x-text="step"></li>
                </template>
              </ol>

              <!-- Cảnh báo an toàn nếu có -->
              <template x-if="item.safetyAlert">
                <div class="p-2.5 rounded-lg bg-rose-50 border border-rose-200 text-rose-900 text-[11px] font-bold flex items-start gap-2 mt-2">
                  <span class="text-sm">⚠️</span>
                  <span x-text="item.safetyAlert"></span>
                </div>
              </template>

              <!-- Dụng cụ KTV cần chuẩn bị -->
              <div class="pt-2 border-t border-emerald-200/60 flex flex-wrap items-center gap-2 text-[11px]">
                <span class="font-bold text-emerald-900">Dụng cụ cần dùng:</span>
                <template x-for="(tool, tIdx) in item.tools" :key="tIdx">
                  <span class="px-2 py-0.5 rounded-md bg-white border border-emerald-300 font-semibold text-slate-700" x-text="tool"></span>
                </template>
              </div>
            </div>
          </div>
        </div>
      </template>

      <!-- Trường hợp không tìm thấy kết quả -->
      <div
        x-show="filteredHwList.length === 0"
        x-cloak
        class="p-8 text-center rounded-3xl bg-white border border-slate-200 text-slate-500 space-y-2"
      >
        <div class="text-3xl">🔍</div>
        <h3 class="font-bold text-slate-800 text-sm">Không tìm thấy ca sự cố phù hợp với từ khóa</h3>
        <p class="text-xs text-slate-400">Hãy thử tìm từ khóa đơn giản hơn như "ram", "màn hình", "nguồn", "bios"...</p>
        <button
          type="button"
          @click="clearHwSearch(); selectHwCategory('all');"
          class="mt-2 px-4 py-2 rounded-xl bg-slate-900 text-white text-xs font-bold cursor-pointer"
        >
          Đặt lại bộ lọc
        </button>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- TAB 2: TRẮC NGHIỆM MẠNG THỰC CHIẾN (CHIA 5 CHUYÊN ĐỀ)                     -->
  <!-- ========================================================================= -->
  <section x-show="activeTab === 'quiz'" x-cloak class="space-y-5">
    
    <!-- THANH ĐIỀU KHIỂN BÀI THI & CHUYÊN ĐỀ -->
    <div class="p-5 sm:p-6 rounded-3xl bg-white border border-slate-200 shadow-xs space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100">
        <div>
          <span class="text-[11px] font-black uppercase text-amber-700 tracking-wider">
            NGÂN HÀNG SÁT HẠCH KIẾN THỨC MẠNG
          </span>
          <h2 class="text-base sm:text-lg font-black text-slate-900">
            Luyện Thi Mạng Căn Bản & Quản Trị Hệ Thống
          </h2>
        </div>

        <!-- Chế độ làm bài -->
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-quiz-mode-all"
            @click="setQuizMode('all')"
            class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all border cursor-pointer min-h-[40px]"
            :class="quizMode === 'all' ? 'bg-slate-900 text-white border-slate-900 font-black' : 'bg-slate-50 text-slate-700 hover:bg-slate-100 border-slate-200'"
          >
            Làm Toàn Bộ (<span x-text="allQuestions.length">{NETWORK_QUIZ_QUESTIONS.length}</span> Câu)
          </button>

          <button
            type="button"
            id="btn-quiz-mode-random10"
            @click="setQuizMode('random10')"
            class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all border cursor-pointer min-h-[40px] flex items-center gap-1.5"
            :class="quizMode === 'random10' ? 'bg-amber-500 text-slate-950 border-amber-500 font-black shadow-xs' : 'bg-amber-50 text-amber-900 hover:bg-amber-100 border-amber-200'"
          >
            <span>🎲</span>
            <span>Bốc 10 Câu Ngẫu Nhiên</span>
          </button>
        </div>
      </div>

      <!-- Bộ lọc chuyên đề mạng tự động -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 pt-1 scrollbar-none" id="quiz-category-filters">
        <template x-for="cat in quizCategories" :key="cat.id">
          <button
            type="button"
            @click="selectQuizCategory(cat.id)"
            class="px-3.5 py-2 rounded-xl text-xs font-bold shrink-0 transition-all cursor-pointer min-h-[44px] touch-manipulation flex items-center gap-1.5 border"
            :class="quizSelectedCategory === cat.id ? 'bg-slate-900 text-white border-slate-900 font-black' : 'bg-slate-50 hover:bg-slate-100 text-slate-700 border-slate-200'"
          >
            <span x-text="cat.icon"></span>
            <span x-text="cat.label"></span>
          </button>
        </template>
      </div>

      <!-- Stepper tiến độ câu hỏi -->
      <div class="flex items-center justify-between text-xs text-slate-600 pt-1">
        <div class="flex items-center gap-2">
          <span>Câu hỏi:</span>
          <strong class="text-slate-900 font-mono text-sm" x-text="(currentQuestionIdx + 1) + ' / ' + activeQuestionList.length"></strong>
        </div>

        <div class="flex items-center gap-2">
          <span>Đã trả lời:</span>
          <strong class="text-blue-600 font-mono text-sm" x-text="Object.keys(userAnswers).length + ' / ' + activeQuestionList.length"></strong>
        </div>
      </div>
    </div>

    <!-- KHU VỰC CÂU HỎI TRẮC NGHIỆM CHI TIẾT -->
    <template x-if="currentQuestion">
      <div class="p-6 sm:p-8 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-6" id="quiz-card">
        
        <!-- Header câu hỏi -->
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-1 rounded-md text-xs font-black bg-slate-900 text-white font-mono" x-text="'CÂU ' + (currentQuestionIdx + 1)"></span>
            <span class="text-xs font-bold text-slate-600 bg-slate-100 px-2.5 py-1 rounded-md" x-text="currentQuestion.categoryLabel"></span>
          </div>

          <span
            class="text-[11px] font-bold px-2 py-0.5 rounded"
            :class="currentQuestion.difficulty === 'nang-cao' ? 'bg-purple-100 text-purple-900' : (currentQuestion.difficulty === 'thuc-chien' ? 'bg-blue-100 text-blue-900' : 'bg-emerald-100 text-emerald-900')"
            x-text="currentQuestion.difficulty === 'nang-cao' ? 'Vận dụng cao' : (currentQuestion.difficulty === 'thuc-chien' ? 'Thực chiến KTV' : 'Cơ bản')"
          ></span>
        </div>

        <!-- Nội dung câu hỏi -->
        <h3 class="text-base sm:text-lg font-black text-slate-900 leading-snug" x-text="currentQuestion.question"></h3>

        <!-- 4 Lựa chọn A, B, C, D -->
        <div class="grid grid-cols-1 gap-3">
          <template x-for="(opt, optIdx) in currentQuestion.options" :key="optIdx">
            <button
              type="button"
              :id="'btn-option-' + optIdx"
              @click="selectOption(currentQuestion.id, optIdx)"
              class="w-full p-4 rounded-2xl border text-left text-xs sm:text-sm font-semibold transition-all cursor-pointer flex items-start gap-3 min-h-[52px]"
              :class="userAnswers[currentQuestion.id] === optIdx
                ? (quizCompleted
                    ? (optIdx === currentQuestion.correctIndex
                        ? 'bg-emerald-100 border-emerald-500 text-emerald-950 font-black shadow-xs ring-2 ring-emerald-500'
                        : 'bg-rose-100 border-rose-500 text-rose-950 font-black ring-2 ring-rose-500')
                    : 'bg-slate-900 text-white border-slate-900 shadow-md font-black')
                : (quizCompleted && optIdx === currentQuestion.correctIndex
                    ? 'bg-emerald-50 border-emerald-400 text-emerald-950 font-black'
                    : 'bg-slate-50 hover:bg-slate-100 border-slate-200 text-slate-800')"
            >
              <!-- Nhãn chữ A, B, C, D -->
              <span
                class="w-7 h-7 rounded-xl flex items-center justify-center font-black text-xs shrink-0 font-mono"
                :class="userAnswers[currentQuestion.id] === optIdx
                  ? (quizCompleted
                      ? (optIdx === currentQuestion.correctIndex ? 'bg-emerald-700 text-white' : 'bg-rose-700 text-white')
                      : 'bg-white text-slate-950')
                  : 'bg-white text-slate-700 border border-slate-200'"
                x-text="['A', 'B', 'C', 'D'][optIdx]"
              ></span>

              <span class="flex-1 pt-0.5 leading-relaxed" x-text="opt"></span>
            </button>
          </template>
        </div>

        <!-- Khối Giải Thích Sư Phạm 9+3 (Hiện khi bấm nút hoặc sau khi nộp bài) -->
        <div class="pt-2 border-t border-slate-100 space-y-3">
          <div class="flex items-center justify-between">
            <button
              type="button"
              id="btn-toggle-explain"
              @click="toggleExplanation(currentQuestion.id)"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold transition-all cursor-pointer"
            >
              <span>💡</span>
              <span x-text="revealedNotes[currentQuestion.id] || quizCompleted ? 'Ẩn Lời Giải Thích' : 'Xem Giải Thích Kỹ Thuật'"></span>
            </button>

            <span class="text-[11px] text-slate-400 italic">
              Nhấn phím 1, 2, 3, 4 trên bàn phím để chọn nhanh
            </span>
          </div>

          <!-- Nội dung giải thích -->
          <div
            x-show="revealedNotes[currentQuestion.id] || quizCompleted"
            x-collapse
            class="p-4 rounded-2xl bg-amber-50/70 border border-amber-200 text-xs text-amber-950 space-y-2"
          >
            <div class="font-black text-amber-900 flex items-center gap-1.5">
              <span>🎯</span>
              <span>Đáp án đúng: <strong class="underline font-mono" x-text="['A', 'B', 'C', 'D'][currentQuestion.correctIndex]"></strong></span>
            </div>
            <p class="leading-relaxed font-medium" x-text="currentQuestion.explanation"></p>

            <template x-if="currentQuestion.technicianTip">
              <div class="p-2.5 rounded-xl bg-white border border-amber-300 text-amber-900 text-[11px] font-semibold flex items-start gap-2">
                <span>📌</span>
                <span x-text="'Mẹo KTV thực chiến: ' + currentQuestion.technicianTip"></span>
              </div>
            </template>
          </div>
        </div>

        <!-- Nút Điều Hướng Câu Tiếp / Câu Trước -->
        <div class="flex items-center justify-between pt-4 border-t border-slate-100 gap-3">
          <button
            type="button"
            id="btn-quiz-prev"
            @click="prevQuestion()"
            :disabled="currentQuestionIdx === 0"
            class="px-4 py-2.5 rounded-xl border border-slate-200 text-xs font-bold transition-all cursor-pointer min-h-[44px] disabled:opacity-40 disabled:cursor-not-allowed"
          >
            ← Câu Trước
          </button>

          <!-- Bảng số chuyển nhanh câu hỏi -->
          <div class="hidden sm:flex items-center gap-1 max-w-md overflow-x-auto p-1">
            <template x-for="(q, qIdx) in activeQuestionList" :key="q.id">
              <button
                type="button"
                @click="goToQuestion(qIdx)"
                class="w-8 h-8 rounded-lg text-xs font-bold font-mono transition-all flex items-center justify-center cursor-pointer border"
                :class="currentQuestionIdx === qIdx
                  ? 'bg-slate-900 text-white border-slate-900 font-black'
                  : (userAnswers[q.id] !== undefined
                      ? 'bg-blue-100 text-blue-900 border-blue-200'
                      : 'bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100')"
                x-text="qIdx + 1"
              ></button>
            </template>
          </div>

          <div class="flex items-center gap-2">
            <template x-if="currentQuestionIdx < activeQuestionList.length - 1">
              <button
                type="button"
                id="btn-quiz-next"
                @click="nextQuestion()"
                class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-black transition-all cursor-pointer min-h-[44px]"
              >
                Câu Tiếp Theo →
              </button>
            </template>

            <template x-if="currentQuestionIdx === activeQuestionList.length - 1 && !quizCompleted">
              <button
                type="button"
                id="btn-quiz-finish"
                @click="finishQuiz()"
                class="px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-black transition-all shadow-md cursor-pointer min-h-[44px]"
              >
                Nộp Bài & Chấm Điểm
              </button>
            </template>
          </div>
        </div>

      </div>
    </template>

    <!-- BẢNG BÁO CÁO KẾT QUẢ SÁT HẠCH (HIỆN SAU KHI NỘP BÀI) -->
    <div
      x-show="quizCompleted"
      x-cloak
      class="p-6 sm:p-8 rounded-3xl bg-slate-900 text-white shadow-xl border border-slate-800 space-y-6 text-center"
      id="quiz-result-board"
    >
      <div>
        <span class="text-xs font-black uppercase tracking-wider text-amber-400 font-mono">
          BẢNG TỔNG KẾT NĂNG LỰC NGHỀ MẠNG
        </span>
        <h3 class="text-xl sm:text-2xl font-black text-white mt-1">
          Kết Quả Sát Hạch Mạng Thực Chiến
        </h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-2xl mx-auto">
        <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700">
          <span class="text-xs text-slate-400 block mb-1">Số câu trả lời đúng</span>
          <span class="text-2xl font-black text-emerald-400 font-mono" x-text="scoreSummary.correct + ' / ' + scoreSummary.total"></span>
        </div>

        <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700">
          <span class="text-xs text-slate-400 block mb-1">Tỷ lệ chính xác</span>
          <span class="text-2xl font-black text-amber-400 font-mono" x-text="scoreSummary.percent + '%'"></span>
        </div>

        <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700">
          <span class="text-xs text-slate-400 block mb-1">Xếp loại tay nghề</span>
          <span class="text-xs font-black text-white block mt-1.5" x-text="scoreSummary.rank"></span>
        </div>
      </div>

      <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
        <button
          type="button"
          id="btn-quiz-retry"
          @click="restartQuiz()"
          class="px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs font-black transition-all cursor-pointer min-h-[48px]"
        >
          Luyện Tập Lại Đề Này
        </button>

        <button
          type="button"
          @click="setQuizMode('random10')"
          class="px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold transition-all border border-slate-700 cursor-pointer min-h-[48px]"
        >
          Đổi Đề Bốc Thăm 10 Câu Khác
        </button>
      </div>
    </div>

  </section>
</div>
