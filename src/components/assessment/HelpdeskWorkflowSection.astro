---
import {
  DISASSEMBLY_STEPS,
  ASSEMBLY_STEPS,
  CORE_SKILLS,
  LAB_MOTHERBOARDS,
  H510_HOTSPOTS,
} from '../../data/hardwareTrainingPackage';
import { HELPDESK_5_STEPS } from '../../data/hardwareCurriculum';
---

<div class="space-y-6" x-data="{
  workflowSubTab: 'workflow5',
  activeStep5Index: 0,
  assemblySubTab: 'disassembly',
  activeDisassemblyStep: 0,
  activeAssemblyStep: 0,
  selectedSkillId: 'ram',
  selectedBoardId: 'msi',
  zoomedImage: null,
  zoomedImageTitle: '',
  workflowProgress: {},
  openZoom(src, title) {
    if (window.openImageLightbox) {
      window.openImageLightbox(src, title);
    } else {
      this.zoomedImage = src;
      this.zoomedImageTitle = title;
    }
  },
  closeZoom() {
    this.zoomedImage = null;
    this.zoomedImageTitle = '';
  },
  toggleStep(key) {
    this.workflowProgress[key] = !this.workflowProgress[key];
    try {
      localStorage.setItem('ktv_helpdesk_progress', JSON.stringify(this.workflowProgress));
    } catch(e) {}
  },
  init() {
    try {
      const saved = localStorage.getItem('ktv_helpdesk_progress');
      if (saved) this.workflowProgress = JSON.parse(saved);
    } catch(e) {}
  }
}">
  <!-- 1. Hero Formula Banner (Công thức 3 Giây Là Nhớ) -->
  <div class="bg-gradient-to-r from-slate-950 via-slate-900 to-indigo-950 text-white rounded-2xl p-5 sm:p-7 shadow-md border border-slate-700">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-amber-400 text-slate-950">
            ★ CBT HELPDESK WORKFLOW (KHỚP 100% RUBRIC 10.0)
          </span>
          <span class="text-xs text-slate-300 font-medium">Mắt thấy – Tay làm – Chuẩn hóa KTV</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight">
          Sổ Tay Nghiệp Vụ KTV: 5 Bước Quy Trình Thực Chiến
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-3xl leading-relaxed">
          Đào tạo theo năng lực thực tế (CBT). Không chia theo buổi lý thuyết rời rạc, mà học theo đúng luồng công việc của kỹ thuật viên,
          khớp 100% với 5 tiêu chí chấm điểm bài thi thực hành 4 giờ:
          <span class="text-amber-300 font-bold">B1: An toàn (2.0đ)</span> •
          <span class="text-sky-300 font-bold">B2: Chẩn đoán (2.5đ)</span> •
          <span class="text-emerald-300 font-bold">B3: Xử lý kỹ thuật (3.0đ)</span> •
          <span class="text-purple-300 font-bold">B4: Xác nhận (1.5đ)</span> •
          <span class="text-rose-300 font-bold">B5: Bàn giao (1.0đ)</span>
        </p>
      </div>

      <!-- Quick progress pill -->
      <div class="bg-slate-800/90 border border-slate-700 rounded-xl p-3 text-center shrink-0 min-w-[170px] shadow-inner">
        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Tiến Độ Quy Trình</p>
        <p class="text-2xl font-black text-emerald-400 mt-0.5 font-mono">
          <span x-text="Object.values(workflowProgress).filter(Boolean).length"></span> / {HELPDESK_5_STEPS.length}
        </p>
        <p class="text-[11px] text-slate-400">bước đã xác nhận an toàn</p>
      </div>
    </div>

    <!-- 4 Sub-navigation Pills (Min 48px touch targets) -->
    <div class="mt-5 pt-4 border-t border-slate-700/70 flex flex-wrap gap-2">
      <button
        type="button"
        @click="workflowSubTab = 'workflow5'"
        class="min-h-[44px] px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center gap-1.5"
        :class="workflowSubTab === 'workflow5' ? 'bg-amber-400 text-slate-950 font-black shadow-md' : 'bg-slate-800 text-slate-200 hover:bg-slate-700 border border-slate-700'"
      >
        <span>🎯</span>
        <span>1. Luồng 5 Bước Helpdesk (Khớp Rubric)</span>
      </button>

      <button
        type="button"
        @click="workflowSubTab = 'assembly'"
        class="min-h-[44px] px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center gap-1.5"
        :class="workflowSubTab === 'assembly' ? 'bg-amber-400 text-slate-950 font-black shadow-md' : 'bg-slate-800 text-slate-200 hover:bg-slate-700 border border-slate-700'"
      >
        <span>⚙️</span>
        <span>2. Tháo Máy (6b) & Lắp Máy (7b)</span>
      </button>

      <button
        type="button"
        @click="workflowSubTab = 'skills'"
        class="min-h-[44px] px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center gap-1.5"
        :class="workflowSubTab === 'skills' ? 'bg-amber-400 text-slate-950 font-black shadow-md' : 'bg-slate-800 text-slate-200 hover:bg-slate-700 border border-slate-700'"
      >
        <span>🔧</span>
        <span>3. 4 Kỹ Năng Cơ Khí & Bẫy Lỗi</span>
      </button>

      <button
        type="button"
        @click="workflowSubTab = 'components'"
        class="min-h-[44px] px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center gap-1.5"
        :class="workflowSubTab === 'components' ? 'bg-amber-400 text-slate-950 font-black shadow-md' : 'bg-slate-800 text-slate-200 hover:bg-slate-700 border border-slate-700'"
      >
        <span>🧠</span>
        <span>4. So Sánh 3 Bo Mạch H510 & Thị Trường</span>
      </button>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- SUBTAB 1: LUỒNG 5 BƯỚC HELPDESK WORKFLOW (KHỚP 5 TIÊU CHÍ RUBRIC 10Đ)  -->
  <!-- ===================================================================== -->
  <div x-show="workflowSubTab === 'workflow5'" class="space-y-6">
    <!-- Step Navigation Buttons Grid (5 Steps) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-2.5">
      {HELPDESK_5_STEPS.map((step, idx) => (
        <button
          type="button"
          @click={`activeStep5Index = ${idx}`}
          class="p-3.5 rounded-xl border text-left transition-all relative overflow-hidden flex flex-col justify-between min-h-[85px]"
          :class={`activeStep5Index === ${idx} ? 'bg-slate-900 text-white border-slate-900 shadow-md ring-2 ring-amber-500/40' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50'`}
        >
          <div>
            <div class="flex items-center justify-between text-[11px] font-bold">
              <span class="font-mono">BƯỚC {step.stepNumber}</span>
              <span class="text-[10px] px-1.5 py-0.2 rounded font-mono font-bold" :class={`activeStep5Index === ${idx} ? 'bg-amber-400 text-slate-950' : 'bg-slate-100 text-slate-700'`}>
                {step.maxScore.toFixed(1)}đ
              </span>
            </div>
            <p class="text-xs font-black mt-1 leading-snug">{step.title.replace(`BƯỚC ${step.stepNumber}: `, '')}</p>
          </div>
          <div class="flex items-center justify-between mt-2 pt-1 border-t border-slate-100/20 text-[10px] text-slate-400 font-mono">
            <span>⏱️ {step.timeEstimate}</span>
            <span x-show={`workflowProgress['step_${step.stepNumber}']`} class="text-emerald-400 font-bold">✓ Đã xác nhận</span>
          </div>
        </button>
      ))}
    </div>

    <!-- Active Step Detail Cards (5 Steps) -->
    {HELPDESK_5_STEPS.map((step, idx) => (
      <div
        x-show={`activeStep5Index === ${idx}`}
        class="bg-white border-2 border-slate-300 rounded-2xl p-5 sm:p-7 shadow-sm space-y-6"
      >
        <!-- Step Header -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-slate-200 pb-4">
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-1.5">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-slate-900 text-white">
                BƯỚC {step.stepNumber} / 5
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-900 border border-amber-300">
                ★ {step.rubricCriteria} ({step.maxScore.toFixed(1)} điểm)
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-900">
                👤 {step.role}
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-slate-100 text-slate-700">
                ⏱️ {step.timeEstimate}
              </span>
            </div>
            <h3 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
              {step.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-1">
              {step.summary}
            </p>
          </div>

          <!-- Confirm Checkbox in Header -->
          <label class="flex items-center gap-2 cursor-pointer bg-slate-50 hover:bg-emerald-50 border border-slate-200 hover:border-emerald-300 p-2.5 rounded-xl transition-all select-none shrink-0 min-h-[44px]">
            <input
              type="checkbox"
              class="w-5 h-5 rounded text-emerald-600 focus:ring-emerald-500 cursor-pointer"
              :checked={`workflowProgress['step_${step.stepNumber}']`}
              @change={`toggleStep('step_${step.stepNumber}')`}
            />
            <span class="text-xs font-bold text-slate-800">
              Xác nhận đã nắm vững an toàn
            </span>
          </label>
        </div>

        <!-- 3-Second Formula Box (Khẩu quyết 3 chữ + 3 ô xúc giác) -->
        <div class="bg-slate-50 border-2 border-slate-300 rounded-2xl p-4 sm:p-5">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-lg">⚡</span>
            <h4 class="text-xs font-extrabold uppercase tracking-wider text-slate-600">
              Công Thức 3 Giây Là Nhớ: Khẩu Quyết Thực Chiến
            </h4>
          </div>

          <div class="p-3 bg-slate-900 text-amber-400 font-mono font-black text-center text-sm sm:text-base rounded-xl tracking-wider mb-4 border border-slate-700 shadow-sm">
            « {step.motto} »
          </div>

          <!-- Checkpoint & Danger Warning -->
          <div class="space-y-2">
            {step.checkpoint && (
              <div class="bg-amber-50 border-2 border-amber-300 rounded-xl p-3.5 flex items-start gap-2.5">
                <span class="text-xl shrink-0">🛑</span>
                <div class="text-xs">
                  <p class="font-bold text-amber-950 uppercase">{step.checkpoint.name}</p>
                  <p class="text-amber-900 mt-0.5 leading-relaxed">{step.checkpoint.requirement}</p>
                  <p class="text-amber-800 font-semibold mt-1">→ Ký duyệt: {step.checkpoint.signoff}</p>
                </div>
              </div>
            )}

            <div class="bg-rose-50 border border-rose-200 rounded-xl p-3.5 flex items-start gap-2.5">
              <span class="text-xl shrink-0">⚠️</span>
              <div class="text-xs">
                <p class="font-bold text-rose-950 uppercase">Cảnh Báo Lỗi Nguy Hiểm & Vi Phạm:</p>
                <p class="text-rose-900 mt-0.5 leading-relaxed font-medium">{step.dangerNote}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Grid 2 Cột: Bên Trái Hướng Dẫn & ProTip, Bên Phải Ảnh Thực Tế -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <!-- Cột Trái: Chi Tiết Thao Tác -->
          <div class="lg:col-span-7 space-y-4">
            <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-2.5">
              <h5 class="text-xs font-bold uppercase tracking-wider text-slate-800 flex items-center gap-1.5">
                <span>📋</span>
                <span>Các Thao Tác Kỹ Thuật Bắt Buộc Tại Bàn Máy:</span>
              </h5>
              <ul class="space-y-2 text-xs sm:text-sm text-slate-700">
                {step.actions.map((act) => (
                  <li class="flex items-start gap-2">
                    <span class="text-primary-600 font-bold mt-0.5">•</span>
                    <span class="leading-relaxed">{act}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Pro Tip -->
            <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-3.5 text-xs flex items-start gap-2">
              <span class="text-base shrink-0">💡</span>
              <div>
                <strong class="text-indigo-950 block mb-0.5">Kinh Nghiệm Thực Chiến KTV:</strong>
                <p class="text-indigo-900 leading-relaxed font-medium">{step.proTip}</p>
              </div>
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5 pt-1">
              {step.tags.map((tg) => (
                <span class="px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 text-[11px] font-medium border border-slate-200">
                  #{tg}
                </span>
              ))}
            </div>
          </div>

          <!-- Cột Phải: Hình Ảnh Thực Tế Linh Kiện -->
          <div class="lg:col-span-5 space-y-3">
            <div class="bg-slate-900 rounded-2xl overflow-hidden border border-slate-200 shadow-sm group">
              <div class="relative">
                <img
                  src={step.imageSrc}
                  alt={step.imageAlt}
                  class="w-full h-56 sm:h-64 object-cover transition-transform duration-300 group-hover:scale-105 cursor-pointer"
                  @click={`openZoom('${step.imageSrc}', '${step.imageAlt.replace(/'/g, "\\'")}')`}
                  loading="lazy"
                />
              </div>
              <div class="px-3 py-2 bg-slate-900 text-white flex items-center justify-between text-xs border-t border-slate-800">
                <span class="truncate pr-2 font-medium text-slate-200 text-[11px]">📷 {step.imageAlt}</span>
                <button
                  type="button"
                  @click={`openZoom('${step.imageSrc}', '${step.imageAlt.replace(/'/g, "\\'")}')`}
                  class="text-blue-400 hover:text-blue-300 font-bold shrink-0 text-xs flex items-center gap-1 cursor-pointer py-1 px-2 rounded hover:bg-slate-800 transition-colors"
                >
                  <span>🔍 Phóng to</span>
                </button>
              </div>
            </div>

            {step.secondaryImageSrc && (
              <div class="bg-slate-900 rounded-xl overflow-hidden border border-slate-200 shadow-sm group">
                <div class="relative">
                  <img
                    src={step.secondaryImageSrc}
                    alt={`${step.title} - Ảnh chi tiết bổ sung`}
                    class="w-full h-40 object-cover transition-transform duration-300 group-hover:scale-105 cursor-pointer"
                    @click={`openZoom('${step.secondaryImageSrc}', '${step.title.replace(/'/g, "\\'")}')`}
                    loading="lazy"
                  />
                </div>
                <div class="px-3 py-1.5 bg-slate-900 text-white flex items-center justify-between text-xs border-t border-slate-800">
                  <span class="truncate pr-2 text-slate-300 text-[11px]">📷 Ảnh chi tiết</span>
                  <button
                    type="button"
                    @click={`openZoom('${step.secondaryImageSrc}', '${step.title.replace(/'/g, "\\'")}')`}
                    class="text-blue-400 hover:text-blue-300 font-bold shrink-0 text-[11px] flex items-center gap-1 cursor-pointer py-0.5 px-1.5 rounded hover:bg-slate-800 transition-colors"
                  >
                    <span>🔍 Chi tiết</span>
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- ===================================================================== -->
  <!-- SUBTAB 2: THÁO MÁY (6 BƯỚC) & LẮP MÁY (7 BƯỚC)                       -->
  <!-- ===================================================================== -->
  <div x-show="workflowSubTab === 'assembly'" class="space-y-6" x-cloak>
    <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm space-y-6">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
        <div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900 mb-1.5">
            <span>⚙️</span>
            <span>QUY TRÌNH CƠ KHÍ CHUẨN KỸ THUẬT VIÊN</span>
          </span>
          <h3 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
            Thao Tác Tháo Máy (6 Bước) & Lắp Máy (7 Bước)
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-1">
            Mọi thao tác đều có thứ tự cơ khí chuẩn xác, không làm xước vỏ, không gãy chân socket và không rơi ốc vào bo mạch.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            @click="assemblySubTab = 'disassembly'"
            class="px-4 py-2 rounded-xl text-xs font-bold transition-all border"
            :class="assemblySubTab === 'disassembly' ? 'bg-slate-900 text-white border-slate-900 shadow-sm' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50'"
          >
            <span>🔄 Tháo Máy (6 Bước)</span>
          </button>
          <button
            type="button"
            @click="assemblySubTab = 'assembly'"
            class="px-4 py-2 rounded-xl text-xs font-bold transition-all border"
            :class="assemblySubTab === 'assembly' ? 'bg-slate-900 text-white border-slate-900 shadow-sm' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50'"
          >
            <span>⚡ Lắp Máy (7 Bước)</span>
          </button>
        </div>
      </div>

      <!-- DISASSEMBLY STEPS (6 BƯỚC) -->
      <div x-show="assemblySubTab === 'disassembly'" class="space-y-6">
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2">
          {DISASSEMBLY_STEPS.map((s, idx) => (
            <button
              type="button"
              @click={`activeDisassemblyStep = ${idx}`}
              class="p-2.5 rounded-xl border text-left transition-all"
              :class={`activeDisassemblyStep === ${idx} ? 'bg-slate-900 text-white border-slate-900 shadow-sm' : 'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100'`}
            >
              <span class="text-[10px] font-mono block opacity-80">BƯỚC {s.stepNumber}</span>
              <p class="text-xs font-bold truncate mt-0.5">{s.shortName}</p>
            </button>
          ))}
        </div>

        {DISASSEMBLY_STEPS.map((s, idx) => (
          <div x-show={`activeDisassemblyStep === ${idx}`} class="bg-slate-50 border border-slate-200 rounded-xl p-5 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-200 pb-3">
              <div>
                <span class="text-xs font-mono font-bold text-slate-500 uppercase">Bước Tháo {s.stepNumber} / 6</span>
                <h4 class="text-base sm:text-lg font-black text-slate-900">{s.title}</h4>
              </div>
              <span class="text-xs font-mono bg-white px-2.5 py-1 rounded-lg border border-slate-200 text-slate-700">Dụng cụ: {s.tool}</span>
            </div>

            <div class="p-3 bg-slate-900 text-amber-400 font-mono font-bold text-xs sm:text-sm rounded-lg text-center">
              « {s.motto} »
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
              <div class="space-y-2 bg-white p-3.5 rounded-lg border border-slate-200">
                <strong class="text-slate-900 block">Thao tác kỹ thuật chi tiết:</strong>
                <p class="text-slate-700 leading-relaxed">{s.action}</p>
                <div class="pt-2 border-t border-slate-100">
                  <span class="text-emerald-700 font-bold">🛡️ Poka-Yoke:</span>
                  <span class="text-slate-600"> {s.pokaYoke}</span>
                </div>
              </div>

              <div class="space-y-2 bg-rose-50 p-3.5 rounded-lg border border-rose-200">
                <strong class="text-rose-950 block">Các sai sót học sinh dễ mắc phải:</strong>
                <ul class="space-y-1.5 text-rose-900 list-disc list-inside">
                  {s.commonMistakes.map(m => (
                    <li class="leading-relaxed">{m}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- ASSEMBLY STEPS (7 BƯỚC) -->
      <div x-show="assemblySubTab === 'assembly'" class="space-y-6" x-cloak>
        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-7 gap-2">
          {ASSEMBLY_STEPS.map((s, idx) => (
            <button
              type="button"
              @click={`activeAssemblyStep = ${idx}`}
              class="p-2.5 rounded-xl border text-left transition-all"
              :class={`activeAssemblyStep === ${idx} ? 'bg-slate-900 text-white border-slate-900 shadow-sm' : 'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100'`}
            >
              <span class="text-[10px] font-mono block opacity-80">BƯỚC {s.stepNumber}</span>
              <p class="text-xs font-bold truncate mt-0.5">{s.shortName}</p>
            </button>
          ))}
        </div>

        {ASSEMBLY_STEPS.map((s, idx) => (
          <div x-show={`activeAssemblyStep === ${idx}`} class="bg-slate-50 border border-slate-200 rounded-xl p-5 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-200 pb-3">
              <div>
                <span class="text-xs font-mono font-bold text-slate-500 uppercase">Bước Lắp {s.stepNumber} / 7</span>
                <h4 class="text-base sm:text-lg font-black text-slate-900">{s.title}</h4>
              </div>
              <span class="text-xs font-mono bg-white px-2.5 py-1 rounded-lg border border-slate-200 text-slate-700">Dụng cụ: {s.tool}</span>
            </div>

            <div class="p-3 bg-slate-900 text-amber-400 font-mono font-bold text-xs sm:text-sm rounded-lg text-center">
              « {s.motto} »
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
