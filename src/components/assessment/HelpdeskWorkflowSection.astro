  <!-- FLOATING MODAL PHÓNG TO HÌNH ẢNH THỰC TẾ -->
  <div
    x-show="zoomedImage"
    x-cloak
    class="fixed inset-0 z-50 bg-black/90 flex flex-col items-center justify-center p-4 backdrop-blur-sm"
    @keydown.escape.window="closeZoom()"
  >
    <div class="relative max-w-5xl w-full max-h-[90vh] flex flex-col bg-slate-900 rounded-2xl overflow-hidden border border-slate-700 shadow-2xl">
      <div class="flex items-center justify-between p-3.5 bg-slate-950 border-b border-slate-800 text-white">
        <div class="flex items-center gap-2">
          <span class="text-amber-400 font-bold text-xs uppercase font-mono">🔍 Ảnh Chi Tiết Thực Tế:</span>
          <span class="text-xs text-slate-300 font-semibold truncate max-w-md" x-text="zoomedImageTitle"></span>
        </div>
        <button
          type="button"
          @click="closeZoom()"
          class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-rose-600 text-white text-xs font-bold border border-slate-600 min-h-[44px] min-w-[44px] flex items-center justify-center cursor-pointer transition-colors"
          aria-label="Đóng ảnh"
        >
          ✕ Đóng (ESC)
        </button>
      </div>

      <div class="p-2 flex-1 flex items-center justify-center overflow-auto bg-slate-950">
        <img :src="zoomedImage" :alt="zoomedImageTitle" class="max-h-[75vh] max-w-full object-contain rounded" loading="eager" decoding="async" />
      </div>

      <div class="p-3 bg-slate-950 border-t border-slate-800 text-center text-xs text-slate-400">
        💡 Bấm ra ngoài hoặc phím ESC để đóng ảnh
      </div>
    </div>
  </div>
