---
interface Props {
  pageTitle?: string;
}

const { pageTitle = "Bảng điều khiển Giảng viên" } = Astro.props;
---

<div x-data="adminAuthGuard" x-cloak class="min-h-[70vh]">
  <!-- 1. MÀN HÌNH ĐĂNG NHẬP BẢO MẬT (KHI CHƯA XÁC THỰC MÃ BÍ MẬT) -->
  <div x-show="!isAuthenticated" class="max-w-md mx-auto py-12 px-4">
    <div class="card p-7 sm:p-8 bg-white border border-gray-200 rounded-3xl shadow-xl space-y-6">
      <div class="text-center space-y-2">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-primary-50 text-primary-700 flex items-center justify-center text-3xl shadow-inner">
          🔐
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-gray-900 tracking-tight">{pageTitle}</h2>
        <p class="text-xs sm:text-sm text-gray-500">
          Cổng Giảng Dạy CNTT · CN. Phạm Tiến Đông
        </p>
      </div>

      <!-- Thông báo lỗi khi nhập sai mã -->
      <div 
        x-show="errorMessage" 
        x-transition
        class="p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs sm:text-sm font-semibold flex items-center gap-2"
      >
        <span>⚠️</span>
        <span x-text="errorMessage"></span>
      </div>

      <!-- Form nhập mã bí mật -->
      <form @submit.prevent="submitLogin()" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">
            Mã Bí Mật Của Giảng Viên
          </label>
          <div class="relative">
            <input 
              :type="showPassword ? 'text' : 'password'" 
              x-model="secretInput"
              required
              autofocus
              placeholder="Nhập mã bí mật..."
              class="w-full px-4 py-2.5 pr-10 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none font-mono"
            />
            <button 
              type="button" 
              @click="showPassword = !showPassword"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 text-xs font-semibold select-none cursor-pointer"
            >
              <span x-text="showPassword ? 'Ẩn' : 'Hiện'"></span>
            </button>
          </div>
          <div class="flex items-center justify-between text-xs text-gray-600 mt-2">
            <label class="flex items-center gap-2 cursor-pointer select-none">
              <input type="checkbox" x-model="rememberMe" class="rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
              <span>Ghi nhớ trên máy tính này</span>
            </label>
            <span class="text-[11px] text-gray-400">(Tự xóa khi đóng tab nếu không chọn)</span>
          </div>
        </div>

        <button 
          type="submit" 
          :disabled="isSubmitting"
          class="btn-primary w-full py-2.5 text-sm font-bold shadow-md flex items-center justify-center gap-2"
        >
          <span x-show="!isSubmitting">Xác Nhận Đăng Nhập</span>
          <span x-show="isSubmitting" class="inline-flex items-center gap-1.5">
            <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
            <span>Đang kiểm tra...</span>
          </span>
        </button>
      </form>
    </div>
  </div>

  <!-- 2. NỘI DUNG QUẢN TRỊ (CHỈ HIỂN THỊ KHI ĐÃ XÁC THỰC THÀNH CÔNG) -->
  <div x-show="isAuthenticated">
    <!-- Thanh điều hướng Giảng viên chuẩn đại học -->
    <div class="bg-white border border-gray-200 px-4 py-3 mb-6 rounded-2xl shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-blue-100 text-blue-800 font-extrabold flex items-center justify-center text-sm shrink-0">
          GV
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xs sm:text-sm font-extrabold text-gray-900" x-text="teacherInfo.name || 'Thầy Phạm Tiến Đông'"></span>
            <span class="text-[10px] px-2 py-0.5 rounded-full font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
              Đã xác thực
            </span>
          </div>
          <span class="text-[11px] text-gray-500 block">Cổng Học Tập & Giảng Dạy Chuyên Ngành CNTT</span>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 self-stretch sm:self-auto justify-end">
        <a href="/admin" class="text-xs px-3 py-1.5 rounded-xl border border-gray-200 hover:bg-gray-50 font-bold text-gray-700 no-underline transition-all">
          🏠 Trang chủ
        </a>
        <a href="/admin/classes" class="text-xs px-3 py-1.5 rounded-xl border border-gray-200 hover:bg-gray-50 font-bold text-gray-700 no-underline transition-all">
          👥 Lớp & Học sinh
        </a>
        <a href="/admin/scores" class="text-xs px-3 py-1.5 rounded-xl border border-gray-200 hover:bg-gray-50 font-bold text-gray-700 no-underline transition-all">
          📊 Bảng điểm
        </a>
        <button 
          type="button" 
          @click="logout()" 
          class="text-xs px-3 py-1.5 rounded-xl bg-rose-50 text-rose-700 hover:bg-rose-100 font-bold border border-rose-200 flex items-center gap-1 cursor-pointer transition-all ml-1"
        >
          <span>🚪</span>
          <span>Đăng xuất</span>
        </button>
      </div>
    </div>

    <!-- Nội dung của từng trang quản trị -->
    <slot />
  </div>
</div>

<script is:inline>
  // Tự động đính kèm Token xác thực vào toàn bộ các lệnh fetch() gọi đến /api/
  (function() {
    if (window.__cntt_fetch_intercepted) return;
    window.__cntt_fetch_intercepted = true;

    const originalFetch = window.fetch;
    window.fetch = function(url, options = {}) {
      const token = sessionStorage.getItem('CNTT_ADMIN_TOKEN') || localStorage.getItem('CNTT_ADMIN_TOKEN') ||
                    sessionStorage.getItem('BMTC_ADMIN_TOKEN') || localStorage.getItem('BMTC_ADMIN_TOKEN');
      if (token && typeof url === 'string' && url.includes('/api/')) {
        options = options || {};
        options.headers = options.headers || {};
        if (options.headers instanceof Headers) {
          if (!options.headers.has('Authorization')) options.headers.set('Authorization', 'Bearer ' + token);
        } else if (Array.isArray(options.headers)) {
          options.headers.push(['Authorization', 'Bearer ' + token]);
        } else {
          if (!options.headers['Authorization']) options.headers['Authorization'] = 'Bearer ' + token;
        }
      }
      return originalFetch.call(this, url, options);
    };
  })();

  document.addEventListener('alpine:init', () => {
    Alpine.data('adminAuthGuard', () => ({
      isAuthenticated: false,
      secretInput: '',
      showPassword: false,
      isSubmitting: false,
      rememberMe: false,
      errorMessage: '',
      teacherInfo: {
        name: 'CN. Phạm Tiến Đông',
        role: 'Giảng viên CNTT'
      },

      async init() {
        const storedToken = sessionStorage.getItem('CNTT_ADMIN_TOKEN') || localStorage.getItem('CNTT_ADMIN_TOKEN') ||
                            sessionStorage.getItem('BMTC_ADMIN_TOKEN') || localStorage.getItem('BMTC_ADMIN_TOKEN');
        if (!storedToken) {
          this.isAuthenticated = false;
          return;
        }

        try {
          const rawTeacher = sessionStorage.getItem('CNTT_TEACHER_INFO') || localStorage.getItem('CNTT_TEACHER_INFO') ||
                             sessionStorage.getItem('BMTC_TEACHER_INFO') || localStorage.getItem('BMTC_TEACHER_INFO');
          if (rawTeacher) this.teacherInfo = JSON.parse(rawTeacher);
        } catch(e) {}

        // Xác thực thực tế với máy chủ thay vì chỉ tin tưởng chuỗi trong storage
        try {
          const res = await fetch('/api/auth', {
            headers: { 'Authorization': 'Bearer ' + storedToken }
          });
          const data = await res.json();
          if (data && data.ok && data.valid) {
            this.isAuthenticated = true;
          } else {
            // Token không hợp lệ hoặc đã hết hạn
            this.logout(false);
          }
        } catch(e) {
          // Mạng chập chờn -> tạm giữ nếu token có cấu trúc hợp lệ
          if (storedToken.startsWith('cntt_sec_') || storedToken.startsWith('bmtc_sec_')) {
            this.isAuthenticated = true;
          } else {
            this.logout(false);
          }
        }
      },

      async submitLogin() {
        this.errorMessage = '';
        if (!this.secretInput.trim()) {
          this.errorMessage = 'Vui lòng nhập mã bí mật!';
          return;
        }

        this.isSubmitting = true;
        try {
          const res = await fetch('/api/auth', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ secret: this.secretInput.trim() })
          });

          const data = await res.json();
          if (data && data.ok && data.token) {
            this.isAuthenticated = true;
            this.teacherInfo = data.teacher || this.teacherInfo;
            sessionStorage.setItem('CNTT_ADMIN_TOKEN', data.token);
            sessionStorage.setItem('CNTT_TEACHER_INFO', JSON.stringify(this.teacherInfo));
            if (this.rememberMe) {
              localStorage.setItem('CNTT_ADMIN_TOKEN', data.token);
              localStorage.setItem('CNTT_TEACHER_INFO', JSON.stringify(this.teacherInfo));
            } else {
              localStorage.removeItem('CNTT_ADMIN_TOKEN');
              localStorage.removeItem('CNTT_TEACHER_INFO');
            }
            // Dọn sạch các key cũ nếu có
            sessionStorage.removeItem('BMTC_ADMIN_TOKEN');
            sessionStorage.removeItem('BMTC_TEACHER_INFO');
            localStorage.removeItem('BMTC_ADMIN_TOKEN');
            localStorage.removeItem('BMTC_TEACHER_INFO');
            this.secretInput = '';
          } else {
            this.errorMessage = data.error || 'Mã bí mật không chính xác. Quyền truy cập bị từ chối!';
            this.secretInput = '';
          }
        } catch(e) {
          this.errorMessage = 'Lỗi kết nối máy chủ khi xác thực!';
        } finally {
          this.isSubmitting = false;
        }
      },

      logout(confirmPrompt = true) {
        if (confirmPrompt && !confirm('Thầy có chắc chắn muốn đăng xuất khỏi trang quản trị?')) return;
        sessionStorage.removeItem('CNTT_ADMIN_TOKEN');
        sessionStorage.removeItem('CNTT_TEACHER_INFO');
        localStorage.removeItem('CNTT_ADMIN_TOKEN');
        localStorage.removeItem('CNTT_TEACHER_INFO');
        sessionStorage.removeItem('BMTC_ADMIN_TOKEN');
        sessionStorage.removeItem('BMTC_TEACHER_INFO');
        localStorage.removeItem('BMTC_ADMIN_TOKEN');
        localStorage.removeItem('BMTC_TEACHER_INFO');
        this.isAuthenticated = false;
        this.secretInput = '';
      }
    }));
  });
</script>
