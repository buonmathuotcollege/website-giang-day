---
// AiChatbot.astro — Widget Trợ giảng AI Gemini
---

<div
  x-data="aiChatbot()"
  x-cloak
  class="fixed bottom-3 right-3 sm:bottom-5 sm:right-5 z-50 font-sans"
  @keydown.escape.window="isOpen = false"
>
  <!-- Nút mở chat nổi ở góc màn hình -->
  <button
    x-show="!isOpen"
    x-transition:enter="transition ease-out duration-300 transform"
    x-transition:enter-start="opacity-0 scale-75 translate-y-4"
    x-transition:enter-end="opacity-100 scale-100 translate-y-0"
    @click="openChat()"
    type="button"
    class="group flex items-center gap-2.5 px-4 py-3 bg-slate-900 hover:bg-slate-800 text-white rounded-full shadow-lg hover:shadow-xl transition-all duration-200 border border-slate-700 cursor-pointer min-h-[48px] touch-manipulation"
    aria-label="Mở Trợ lý AI"
  >
    <div class="relative flex items-center justify-center w-8 h-8 rounded-full bg-slate-800 border border-slate-700">
      <span class="text-base">🤖</span>
      <span class="absolute -top-1 -right-1 flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
      </span>
    </div>
    <div class="text-left pr-1">
      <div class="text-[11px] font-medium text-slate-400 leading-tight">Hỏi đáp học tập</div>
      <div class="text-xs font-bold tracking-wide text-white">Trợ Lý AI</div>
    </div>
  </button>

  <!-- Khung cửa sổ chat -->
  <div
    x-show="isOpen"
    x-transition:enter="transition ease-out duration-300 transform"
    x-transition:enter-start="opacity-0 scale-90 translate-y-6"
    x-transition:enter-end="opacity-100 scale-100 translate-y-0"
    x-transition:leave="transition ease-in duration-200 transform"
    x-transition:leave-start="opacity-100 scale-100 translate-y-0"
    x-transition:leave-end="opacity-0 scale-90 translate-y-6"
    class="flex flex-col w-[92vw] sm:w-[410px] h-[580px] max-h-[85vh] bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden"
  >
    <!-- Header Minimalist Slate -->
    <div class="flex items-center justify-between px-4 py-3.5 bg-slate-900 text-white shrink-0 border-b border-slate-800">
      <div class="flex items-center gap-3">
        <div class="relative w-9 h-9 rounded-xl bg-slate-800 flex items-center justify-center border border-slate-700">
          <span class="text-lg">🤖</span>
          <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-500 border-2 border-slate-900 rounded-full"></span>
        </div>
        <div>
          <h3 class="text-xs font-bold flex items-center gap-1.5 text-white">
            Trợ Lý AI CNTT
            <span class="text-[10px] font-mono font-semibold uppercase tracking-wider bg-slate-800 text-slate-300 px-1.5 py-0.5 rounded border border-slate-700">Gemini</span>
          </h3>
          <p class="text-[11px] text-slate-400 flex items-center gap-1">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Hỗ Trợ Học Tập Trực Tuyến
          </p>
        </div>
      </div>
      <div class="flex items-center gap-1">
        <button
          @click="resetChat()"
          title="Xóa hội thoại"
          aria-label="Xóa hội thoại"
          class="min-h-[44px] min-w-[44px] flex items-center justify-center p-2 text-white/80 hover:text-white hover:bg-white/10 rounded-xl transition-colors cursor-pointer touch-manipulation"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
        </button>
        <button
          @click="isOpen = false"
          title="Thu nhỏ"
          aria-label="Thu nhỏ cửa sổ chat"
          class="min-h-[44px] min-w-[44px] flex items-center justify-center p-2 text-white/80 hover:text-white hover:bg-white/10 rounded-xl transition-colors cursor-pointer touch-manipulation"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Hộp tin nhắn -->
    <div
      x-ref="messageBox"
      class="flex-1 p-4 overflow-y-auto space-y-3.5 bg-gray-50/70 text-sm"
    >
      <!-- Tin nhắn chào mặc định -->
      <div class="flex items-start gap-2.5">
        <div class="w-7 h-7 rounded-full bg-blue-100 flex items-center justify-center text-xs shrink-0 mt-0.5">
          🤖
        </div>
        <div class="max-w-[85%] bg-white p-3 rounded-2xl rounded-tl-none shadow-sm border border-gray-100 text-gray-800 space-y-2">
          <p>Xin chào bạn! Mình là <strong>Trợ Lý AI</strong> hỗ trợ học tập CNTT.</p>
          <p class="text-xs text-gray-600">Bạn đang gặp khó ở bài học nào? Cứ hỏi mình nhé, mình giải thích <strong>ngắn gọn, dễ hiểu</strong> ngay!</p>
          
          <!-- Gợi ý câu hỏi -->
          <div class="pt-2 border-t border-gray-100">
            <div class="text-[11px] font-semibold text-gray-500 mb-1.5">Gợi ý câu hỏi nhanh:</div>
            <div class="flex flex-wrap gap-1.5">
              <template x-for="q in quickQuestions" :key="q">
                <button
                  type="button"
                  @click="sendQuick(q)"
                  class="text-xs text-left px-2.5 py-1 bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-lg transition-colors border border-blue-100"
                  x-text="q"
                ></button>
              </template>
            </div>
          </div>
        </div>
      </div>

      <!-- Danh sách tin nhắn qua lại -->
      <template x-for="(msg, index) in messages" :key="index">
        <div
          class="flex items-start gap-2.5"
          :class="msg.role === 'user' ? 'justify-end' : 'justify-start'"
        >
          <!-- Avatar AI -->
          <div
            x-show="msg.role === 'assistant'"
            class="w-7 h-7 rounded-full bg-blue-100 flex items-center justify-center text-xs shrink-0 mt-0.5"
          >
            🤖
          </div>

          <!-- Nội dung tin nhắn -->
          <div
            class="max-w-[85%] p-3 rounded-2xl text-sm leading-relaxed"
            :class="msg.role === 'user' 
              ? 'bg-blue-600 text-white rounded-tr-none shadow-md' 
              : 'bg-white text-gray-800 rounded-tl-none shadow-sm border border-gray-100'"
          >
            <div x-html="formatMessage(msg.content)"></div>

            <!-- Footer tiện ích cho tin nhắn của AI (Sao chép, Đánh giá) -->
            <template x-if="msg.role === 'assistant' && !msg.content.startsWith('⚠️')">
              <div class="mt-2.5 pt-2 border-t border-gray-100 flex items-center justify-between text-[11px] text-gray-500 select-none">
                <button
                  type="button"
                  @click="copyText(msg)"
                  class="hover:text-blue-600 transition-colors flex items-center gap-1 cursor-pointer font-medium"
                  title="Sao chép câu trả lời"
                >
                  <span x-text="msg.copied ? '✓' : '📋'"></span>
                  <span x-text="msg.copied ? 'Đã sao chép' : 'Sao chép'"></span>
                </button>

                <div class="flex items-center gap-1.5">
                  <button
                    type="button"
                    @click="sendFeedback(msg, 'like')"
                    class="p-0.5 rounded hover:bg-gray-100 transition-colors cursor-pointer"
                    :class="msg.feedback === 'like' ? 'scale-110 text-emerald-600' : 'opacity-60 hover:opacity-100'"
                    title="Hữu ích"
                  >
                    👍
                  </button>
                  <button
                    type="button"
                    @click="sendFeedback(msg, 'dislike')"
                    class="p-0.5 rounded hover:bg-gray-100 transition-colors cursor-pointer"
                    :class="msg.feedback === 'dislike' ? 'scale-110 text-rose-600' : 'opacity-60 hover:opacity-100'"
                    title="Chưa rõ"
                  >
                    👎
                  </button>
                </div>
              </div>
            </template>
          </div>

          <!-- Avatar User -->
          <div
            x-show="msg.role === 'user'"
            class="w-7 h-7 rounded-full bg-blue-600 text-white flex items-center justify-center text-xs font-semibold shrink-0 mt-0.5"
          >
            Bạn
          </div>
        </div>
      </template>

      <!-- Đang phản hồi (Loading animation) -->
      <div x-show="isLoading" class="flex items-start gap-2.5">
        <div class="w-7 h-7 rounded-full bg-blue-100 flex items-center justify-center text-xs shrink-0 mt-0.5">
          🤖
        </div>
        <div class="bg-white p-3 rounded-2xl rounded-tl-none shadow-sm border border-gray-100 flex items-center gap-1.5">
          <span class="w-2 h-2 bg-blue-500 rounded-full animate-bounce [animation-delay:-0.3s]"></span>
          <span class="w-2 h-2 bg-blue-500 rounded-full animate-bounce [animation-delay:-0.15s]"></span>
          <span class="w-2 h-2 bg-blue-500 rounded-full animate-bounce"></span>
          <span class="text-xs text-gray-400 ml-1.5">Trợ giảng đang suy nghĩ...</span>
        </div>
      </div>
    </div>

    <!-- Input footer -->
    <div class="p-3 bg-white border-t border-gray-100 shrink-0">
      <form @submit.prevent="sendMessage()" class="flex items-center gap-2">
        <input
          x-ref="inputField"
          x-model="inputMessage"
          type="text"
          placeholder="Nhập câu hỏi học tập..."
          :disabled="isLoading"
          class="flex-1 px-3.5 py-2.5 text-sm bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 disabled:opacity-60 transition-all"
        />
        <button
          type="submit"
          :disabled="isLoading || !inputMessage.trim()"
          class="flex items-center justify-center w-10 h-10 bg-slate-900 hover:bg-slate-800 disabled:bg-slate-200 text-white disabled:text-slate-400 rounded-xl transition-colors shadow-sm disabled:shadow-none shrink-0 cursor-pointer"
          aria-label="Gửi tin nhắn"
        >
          <svg class="w-4 h-4 transform rotate-90" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
          </svg>
        </button>
      </form>
      <div class="mt-1.5 flex items-center justify-between text-[10px] text-gray-400 px-1">
        <span>Hỗ trợ môn học CNTT</span>
        <span>Powered by Gemini</span>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  function aiChatbot() {
    return {
      isOpen: false,
      isLoading: false,
      inputMessage: '',
      messages: [],
      quickQuestions: [
        'RAM và ổ cứng khác nhau thế nào?',
        'Địa chỉ IP là gì, có giống số nhà không?',
        'Cách bấm dây mạng chuẩn B dễ nhớ',
        'Vì sao máy tính bị đơ, giật lag?'
      ],

      init() {
        try {
          const saved = sessionStorage.getItem('ai_chat_messages');
          if (saved) {
            const parsed = JSON.parse(saved);
            if (Array.isArray(parsed) && parsed.length > 0) {
              this.messages = parsed;
            }
          }
        } catch (e) {}
      },

      saveHistory() {
        try {
          // Lưu tối đa 20 tin nhắn gần nhất trong phiên
          sessionStorage.setItem('ai_chat_messages', JSON.stringify(this.messages.slice(-20)));
        } catch (e) {}
      },

      openChat() {
        this.isOpen = true;
        this.$nextTick(() => {
          this.scrollToBottom();
          if (this.$refs.inputField) {
            this.$refs.inputField.focus();
          }
        });
      },

      resetChat() {
        if (confirm('Bạn có muốn xóa cuộc trò chuyện này và bắt đầu lại?')) {
          this.messages = [];
          try { sessionStorage.removeItem('ai_chat_messages'); } catch (e) {}
        }
      },

      sendQuick(question) {
        this.inputMessage = question;
        this.sendMessage();
      },

      copyText(msg) {
        if (!navigator.clipboard) return;
        navigator.clipboard.writeText(msg.content).then(() => {
          msg.copied = true;
          setTimeout(() => { msg.copied = false; }, 2000);
        });
      },

      scrollToBottom() {
        this.$nextTick(() => {
          if (this.$refs.messageBox) {
            this.$refs.messageBox.scrollTop = this.$refs.messageBox.scrollHeight;
          }
        });
      },

      formatMessage(text) {
        if (!text) return '';

        // Trích xuất các thẻ ảnh Markdown ![mô tả](đường_dẫn)
        const images = [];
        let processed = text.replace(/!\[(.*?)\]\((.*?)\)/g, (match, alt, src) => {
          const placeholder = `__CHAT_IMG_TOKEN_${images.length}__`;
          images.push({ alt: alt || 'Hình ảnh minh họa', src: src.trim() });
          return placeholder;
        });

        // Escape HTML các đoạn text thông thường để đảm bảo an toàn
        let safe = processed
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');
        
        // Định dạng in đậm **text**
        safe = safe.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        // Định dạng inline code `code`
        safe = safe.replace(/`([^`]+)`/g, '<code class="px-1.5 py-0.5 bg-slate-100 text-slate-800 rounded text-xs font-mono">$1</code>');
        // Xuống dòng
        safe = safe.replace(/\n/g, '<br/>');

        // Phục hồi và render thẻ hình ảnh minh họa thực tế trực quan
        images.forEach((img, idx) => {
          const token = `__CHAT_IMG_TOKEN_${idx}__`;
          const cleanSrc = img.src.replace(/[^\w\d\.\-\_\/\:\?]/g, '');
          const cleanAlt = img.alt.replace(/[<>"']/g, '');
          const imgHtml = `
            <div class="my-2 rounded-xl overflow-hidden border border-slate-200 bg-slate-900 shadow-sm">
              <div onclick="window.openImageLightbox && window.openImageLightbox('${cleanSrc}', '${cleanAlt}')" class="block relative group cursor-pointer" title="Bấm vào để xem ảnh phóng to trong trang">
                <img src="${cleanSrc}" alt="${cleanAlt}" loading="lazy" class="w-full h-auto max-h-48 object-cover group-hover:opacity-90 transition-opacity duration-200" />
                <div class="absolute inset-0 bg-slate-950/20 group-hover:bg-slate-950/0 transition-colors flex items-center justify-center">
                  <span class="opacity-0 group-hover:opacity-100 bg-slate-900/90 text-white text-[10px] font-medium px-2.5 py-1 rounded-full shadow-md transition-opacity">🔍 Bấm để phóng to trong trang</span>
                </div>
              </div>
              <div class="px-2.5 py-1.5 bg-slate-900 text-white flex items-center justify-between text-[11px]">
                <span class="font-medium truncate pr-2">📷 ${cleanAlt}</span>
                <button type="button" onclick="window.openImageLightbox && window.openImageLightbox('${cleanSrc}', '${cleanAlt}')" class="text-blue-400 hover:text-blue-300 text-[10px] shrink-0 font-bold hover:underline cursor-pointer">Phóng to 🔍</button>
              </div>
            </div>
          `;
          safe = safe.replace(token, imgHtml);
        });

        return safe;
      },

      async sendMessage() {
        const text = this.inputMessage.trim();
        if (!text || this.isLoading) return;

        // Thêm câu hỏi của user
        this.messages.push({ role: 'user', content: text });
        this.saveHistory();
        this.inputMessage = '';
        this.isLoading = true;
        this.scrollToBottom();

        // Nhận diện bối cảnh môn học từ URL
        const path = window.location.pathname;
        let courseContext = document.title || '';
        if (path.includes('mang')) courseContext += ' [Môn: Mạng máy tính]';
        else if (path.includes('phan-cung') || path.includes('kien-truc')) courseContext += ' [Môn: Phần cứng & Kiến trúc máy tính]';
        else if (path.includes('winlinux') || path.includes('windows-linux')) courseContext += ' [Môn: Quản trị Windows/Linux]';

        try {
          const historyPayload = this.messages.slice(-4).map(m => ({
            role: m.role === 'user' ? 'user' : 'model',
            text: m.content
          }));

          const res = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: text,
              courseContext: courseContext,
              history: historyPayload
            })
          });

          let data = {};
          try {
            data = await res.json();
          } catch (jsonErr) {
            data = {};
          }

          if (data && data.reply) {
            this.messages.push({ role: 'assistant', content: data.reply, copied: false, feedback: null });
            this.saveHistory();
          } else {
            let errorMsg = (data && (data.error || data.message)) || '';
            if (typeof errorMsg === 'object') {
              try { errorMsg = JSON.stringify(errorMsg); } catch(e) { errorMsg = ''; }
            }
            // Triệt tiêu hoàn toàn chuỗi JSON thô hoặc lỗi kỹ thuật địa chỉ IP/Location
            if (typeof errorMsg === 'string' && (errorMsg.includes('{') || errorMsg.includes('location') || errorMsg.includes('FAILED_PRECONDITION') || errorMsg.includes('400'))) {
              errorMsg = 'Hệ thống đang đồng bộ dữ liệu. Bạn hãy bấm vào các câu hỏi gợi ý nhanh bên trên hoặc hỏi về bo mạch chủ (ASUS, MSI, Winnfox), RAM, SSD để mình hỗ trợ ngay nhé!';
            }
            this.messages.push({
              role: 'assistant',
              content: errorMsg ? '💡 ' + errorMsg : '💡 Bạn có thể đặt câu hỏi về phím tắt Boot/BIOS, cách bấm cáp mạng, tra keo tản nhiệt hoặc tháo lắp linh kiện để mình giải đáp nhanh nhé!'
            });
            this.saveHistory();
          }
        } catch (err) {
          this.messages.push({
            role: 'assistant',
            content: '⚠️ Không thể gửi tin nhắn. Vui lòng kiểm tra lại kết nối mạng!'
          });
        } finally {
          this.isLoading = false;
          this.scrollToBottom();
          this.$nextTick(() => {
            if (this.$refs.inputField) this.$refs.inputField.focus();
          });
        }
      },

      sendFeedback(msg, rating) {
        if (msg.feedback === rating) {
          msg.feedback = null;
          return;
        }
        msg.feedback = rating;
        fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'feedback', rating: rating, message: msg.content })
        }).catch(() => {});
      }
    };
  }
</script>
