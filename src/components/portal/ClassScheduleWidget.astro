---
// ClassScheduleWidget.astro — Bảng tin tiến độ phòng máy & Lịch tuần Lớp 04THA3 (Ea H'leo)
import { getCollection } from 'astro:content';
import { DEFAULT_SCHEDULES, DEFAULT_ANNOUNCEMENTS } from '../../data/portalHub';

let schedules: any[] = [];
let announcements: any[] = [];

try {
  const collSchedules = await getCollection('schedules');
  if (collSchedules && collSchedules.length > 0) {
    schedules = collSchedules.map((s) => ({ id: s.id, ...s.data }));
  }
} catch (e) {
  // Silent fallback
}

try {
  const collAnnounce = await getCollection('announcements');
  if (collAnnounce && collAnnounce.length > 0) {
    announcements = collAnnounce.map((a) => ({ id: a.id, ...a.data }));
  }
} catch (e) {
  // Silent fallback
}

if (!schedules || schedules.length === 0) {
  schedules = DEFAULT_SCHEDULES;
}
if (!announcements || announcements.length === 0) {
  announcements = DEFAULT_ANNOUNCEMENTS;
}

schedules.sort((a, b) => b.weekNumber - a.weekNumber);
const activeSchedule = schedules.find((s) => s.status === 'active') || schedules[0];
---

<section class="max-w-6xl mx-auto px-4 sm:px-6 py-6">
  <div class="p-6 sm:p-8 rounded-3xl bg-white border border-slate-200 shadow-sm">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-100">
      <div>
        <div class="flex items-center gap-2 mb-1.5">
          <span class="px-2.5 py-0.5 rounded-md text-[11px] font-black uppercase tracking-wider bg-blue-600 text-white">
            TIẾN ĐỘ THỰC HÀNH
          </span>
          <span class="text-xs font-bold text-slate-800">
            Lớp 04THA3 · Cơ sở Ea H'leo
          </span>
        </div>
        <h2 class="text-lg sm:text-2xl font-black text-slate-900 tracking-tight">
          Lịch Phòng Máy & Nhiệm Vụ Huấn Luyện Tuần
        </h2>
      </div>

      <div class="flex items-center gap-2 self-start sm:self-auto">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Phòng Máy: Sẵn sàng 20 Bàn KTV
        </span>
      </div>
    </div>

    <!-- Active Week Spotlight -->
    {activeSchedule && (
      <div class="py-6 border-b border-slate-100 grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-1 rounded-lg text-xs font-black bg-slate-900 text-white">
              TUẦN {activeSchedule.weekNumber}
            </span>
            <span class="text-xs font-bold text-slate-500">
              {activeSchedule.dateRange}
            </span>
            <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase bg-emerald-100 text-emerald-800">
              ĐANG DIỄN RA
            </span>
            <span class="text-xs text-slate-500 font-medium">
              📍 {activeSchedule.labRoom}
            </span>
          </div>

          <h3 class="text-base sm:text-lg font-black text-slate-900 leading-snug">
            {activeSchedule.title}
          </h3>

          <!-- Focus Skills Checklist -->
          <div class="space-y-2 pt-1">
            <span class="text-[11px] font-black text-slate-500 uppercase tracking-wider block">
              3 Kỹ năng nghề trọng tâm tuần này:
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              {activeSchedule.focusSkills && activeSchedule.focusSkills.map((skill: string) => (
                <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 text-xs text-slate-800 flex items-start gap-2">
                  <span class="text-emerald-600 font-black shrink-0">✓</span>
                  <span class="font-medium leading-relaxed">{skill}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Safety Notice Callout -->
          {activeSchedule.safetyNotice && (
            <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 flex items-start gap-2.5">
              <span class="text-base shrink-0">⚠️</span>
              <div>
                <strong class="font-bold block mb-0.5">Nhắc nhở an toàn Poka-Yoke:</strong>
                <span>{activeSchedule.safetyNotice}</span>
              </div>
            </div>
          )}
        </div>

        <!-- Right Side: Lab Specs & Announcements -->
        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-4 flex flex-col justify-between">
          <div>
            <span class="text-[11px] font-black text-slate-500 uppercase tracking-wider block mb-2">
              Cấu hình phần cứng phòng máy:
            </span>
            <ul class="text-xs text-slate-700 space-y-2">
              <li class="flex items-center gap-2">
                <span>🎛️</span>
                <span>Mainboard: <strong>Intel H510 (ASUS/MSI)</strong></span>
              </li>
              <li class="flex items-center gap-2">
                <span>🧠</span>
                <span>RAM: <strong>8GB DDR4 Bus 2666MHz</strong></span>
              </li>
              <li class="flex items-center gap-2">
                <span>🎮</span>
                <span>VGA rời: <strong>GT 730 2GB GDDR5</strong></span>
              </li>
              <li class="flex items-center gap-2">
                <span>💾</span>
                <span>Ổ cứng: <strong>SSD SATA III / NVMe</strong></span>
              </li>
              <li class="flex items-center gap-2">
                <span>🪟</span>
                <span>HĐH: <strong>Windows 10 Pro 64-bit</strong></span>
              </li>
            </ul>
          </div>

          <div class="pt-3 border-t border-slate-200">
            <a
              href="/courses/ol-01-phan-cung"
              class="w-full py-2.5 px-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-black text-center block transition-all shadow-xs no-underline min-h-[44px] flex items-center justify-center gap-1.5"
            >
              <span>Vào Bàn Kỹ Thuật 7 Bước</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    )}

    <!-- Announcements Row -->
    {announcements.length > 0 && (
      <div class="pt-5 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2 text-xs">
          <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase bg-purple-100 text-purple-900">
            THÔNG BÁO
          </span>
          <span class="text-slate-700 font-semibold truncate">
            {announcements[0].title}
          </span>
          <span class="text-[11px] text-slate-400 font-mono hidden md:inline">
            ({announcements[0].date})
          </span>
        </div>

        {announcements[0].link && (
          <a
            href={announcements[0].link}
            class="text-xs font-bold text-blue-700 hover:text-blue-900 hover:underline shrink-0 flex items-center gap-1 min-h-[44px] py-2 px-2 rounded-lg touch-manipulation"
          >
            <span>Chi tiết thông báo</span>
            <span>→</span>
          </a>
        )}
      </div>
    )}

  </div>
</section>
