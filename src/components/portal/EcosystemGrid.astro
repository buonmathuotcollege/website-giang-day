---
// EcosystemGrid.astro — Lưới dịch vụ và các phân hệ tên miền phụ (subdomain)
import { getCollection } from 'astro:content';
import { DEFAULT_ECOSYSTEM } from '../../data/portalHub';

let items: any[] = [];
try {
  const collectionItems = await getCollection('ecosystem');
  if (collectionItems && collectionItems.length > 0) {
    items = collectionItems.map((c) => ({
      id: c.id,
      ...c.data,
    }));
  }
} catch (e) {
  // Fallback to default
}

if (!items || items.length === 0) {
  items = DEFAULT_ECOSYSTEM;
}
items.sort((a, b) => (a.order || 0) - (b.order || 0));
---

<section class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6">
    <div>
      <div class="flex items-center gap-2 mb-1.5">
        <span class="px-2.5 py-0.5 rounded-md text-[11px] font-black uppercase tracking-wider bg-slate-900 text-white">
          HỆ SINH THÁI
        </span>
        <span class="text-xs text-slate-500 font-semibold">Tên miền phụ & Phân hệ trực thuộc</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
        Hạ Tầng Giảng Dạy & Các Trang Con Chuyên Sâu
      </h2>
    </div>

    <span class="text-xs text-slate-500 hidden sm:inline-block">
      🌐 Cổng chính: <code class="px-1.5 py-0.5 rounded bg-slate-100 font-bold text-slate-800">phamtiendong.name.vn</code>
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
    {items.map((item) => {
      const isPcSubdomain = item.subdomain === 'pc' || item.id === 'pc-subdomain';
      const borderClass = isPcSubdomain 
        ? 'border-2 border-emerald-400 bg-gradient-to-b from-emerald-50/40 via-white to-white shadow-md' 
        : 'border border-slate-200 bg-white hover:border-slate-300 shadow-xs';
      
      const badgeClass = item.tagColor === 'emerald'
        ? 'bg-emerald-100 text-emerald-800 border-emerald-200'
        : item.tagColor === 'purple'
        ? 'bg-purple-100 text-purple-800 border-purple-200'
        : item.tagColor === 'amber'
        ? 'bg-amber-100 text-amber-800 border-amber-200'
        : 'bg-blue-100 text-blue-800 border-blue-200';

      return (
        <div class={`rounded-2xl p-5 flex flex-col justify-between transition-all duration-200 hover:shadow-lg hover:-translate-y-0.5 group ${borderClass}`}>
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class={`text-[10px] font-black px-2 py-0.5 rounded-full border uppercase tracking-wider ${badgeClass}`}>
                {item.tag}
              </span>
              {item.isExternal && (
                <span class="text-[11px] font-mono font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md flex items-center gap-1">
                  <span>↗ External</span>
                </span>
              )}
            </div>

            <div class="flex items-start gap-3 mb-3">
              <span class="text-3xl shrink-0 p-2 rounded-xl bg-slate-50 group-hover:scale-110 transition-transform">
                {item.icon}
              </span>
              <div>
                <h3 class="text-sm font-black text-slate-900 group-hover:text-blue-700 transition-colors leading-snug">
                  {item.title}
                </h3>
                {item.subdomain && (
                  <span class="text-[11px] font-mono text-slate-500 font-semibold block mt-0.5">
                    {item.subdomain}.phamtiendong.name.vn
                  </span>
                )}
              </div>
            </div>

            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              {item.description}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100">
            {item.highlight && (
              <div class="text-[11px] text-slate-500 font-medium mb-3 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                <span class="line-clamp-1">{item.highlight}</span>
              </div>
            )}

            <a
              href={item.url}
              target={item.isExternal ? '_blank' : '_self'}
              rel={item.isExternal ? 'noopener noreferrer' : undefined}
              class={`w-full py-2.5 px-3 rounded-xl text-xs font-black transition-all flex items-center justify-center gap-1.5 no-underline min-h-[44px] ${
                isPcSubdomain
                  ? 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm'
                  : 'bg-slate-900 hover:bg-slate-800 text-white shadow-xs'
              }`}
            >
              <span>{isPcSubdomain ? 'Mở Chuyên Trang PC' : 'Vào Phân Hệ'}</span>
              <span>{item.isExternal ? '↗' : '→'}</span>
            </a>
          </div>
        </div>
      );
    })}
  </div>
</section>
