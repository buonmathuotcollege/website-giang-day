---
// Breadcrumb.astro — Breadcrumb navigation
interface Props {
  items: Array<{ label: string; href?: string }>;
}

const { items } = Astro.props;

// Prepend "Trang chủ" if not already the first item
const allItems = items[0]?.href === '/' && items[0]?.label === 'Trang chủ'
  ? items
  : [{ label: 'Trang chủ', href: '/' }, ...items];
---

<nav aria-label="Breadcrumb" class="text-sm text-gray-500 mb-4">
  <ol class="flex flex-wrap items-center gap-1">
    {allItems.map((item, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <span class="text-gray-400">/</span>}
        {i < allItems.length - 1 && item.href ? (
          <a href={item.href} class="hover:text-primary-700 hover:underline transition-colors">{item.label}</a>
        ) : (
          <span class="text-gray-700 font-medium">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
