{
  "name": "website-giang-day",
  "type": "module",
  "version": "1.0.0",
  "description": "Cổng Giảng Dạy CNTT - Trường CĐ Buôn Ma Thuột",
  "scripts": {
    "dev": "node -e \"process.env.ASTRO_TELEMETRY_DISABLED='1'; require('child_process').spawnSync('astro', ['dev'], {stdio:'inherit', shell:true})\"",
    "build": "node -e \"process.env.ASTRO_TELEMETRY_DISABLED='1'; const res = require('child_process').spawnSync('astro', ['build'], {stdio:'inherit', shell:true}); process.exit(res.status || 0)\"",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.5.0",
    "@astrojs/mdx": "^4.2.0",
    "@astrojs/tailwind": "^6.0.2",
    "@google/genai": "^3.3.0",
    "astro": "^5.8.0",
    "tailwindcss": "^3.4.17"
  }
}
